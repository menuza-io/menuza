{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": ["**/.env.*local", "packages/**/.env.schema"],
	"tasks": {
		"//#generate:icons": {
			"inputs": [
				"packages/ui/generate-icons.js",
				"packages/ui/other/svg-icons/**"
			],
			"outputs": [
				"apps/app/app/components/ui/icons/**",
				"apps/admin/app/components/ui/icons/**",
				"packages/ui/components/icons/**"
			]
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["build/**", "public/build/**", "dist/**", ".expo/**"],
			"cache": true
		},
		"@repo/auth#build": {
			"dependsOn": ["^build", "@repo/cache#build"]
		},
		"@repo/email#build": {
			"dependsOn": ["^build", "@repo/cache#build", "@repo/observability#build"]
		},
		"@repo/observability#build": {
			"dependsOn": ["^build", "@repo/security#build"],
			"outputs": ["dist/**"]
		},
		"@repo/ui#build": {
			"dependsOn": ["^build", "//#generate:icons"]
		},
		"app#build": {
			"dependsOn": [
				"^build",
				"@repo/auth#build",
				"@repo/email#build",
				"@repo/observability#build",
				"@repo/integrations#build",
				"@repo/ui#build",
				"@repo/i18n#build",
				"@repo/payments#build",
				"@repo/storage#build",
				"@repo/security#build",
				"@repo/notifications#build",
				"@repo/ai#build"
			],
			"env": ["DEPLOY_TARGET"],
			"outputs": ["build/**", "public/build/**", ".wrangler/**"],
			"passThroughEnv": ["NODE_OPTIONS"]
		},
		"admin#build": {
			"dependsOn": [
				"^build",
				"@repo/auth#build",
				"@repo/email#build",
				"@repo/observability#build",
				"@repo/integrations#build",
				"@repo/ui#build",
				"@repo/i18n#build",
				"@repo/payments#build",
				"@repo/storage#build",
				"@repo/security#build",
				"@repo/notifications#build",
				"@repo/ai#build"
			],
			"env": ["DEPLOY_TARGET"],
			"outputs": ["build/**", "public/build/**", ".wrangler/**"],
			"passThroughEnv": ["NODE_OPTIONS"]
		},
		"lint": {
			"cache": true
		},
		"typecheck": {
			"cache": true
		},
		"db:seed": {
			"cache": false
		},
		"test": {
			"dependsOn": ["^build"],
			"cache": true
		},
		"test:e2e:run": {
			"dependsOn": ["^build"],
			"cache": false
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"app#dev": {
			"dependsOn": ["@repo/observability#build", "//#generate:icons"],
			"cache": false,
			"persistent": true
		},
		"admin#dev": {
			"dependsOn": ["@repo/observability#build", "//#generate:icons"],
			"cache": false,
			"persistent": true
		},
		"dev:ksa": {
			"cache": false,
			"persistent": true
		},
		"build:docs": {
			"outputs": [".mintlify/doc-build/**"],
			"cache": true
		},
		"test:e2e:install": {
			"cache": false
		}
	}
}
