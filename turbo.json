{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": ["**/.env.*local", "packages/**/.env.schema"],
	"tasks": {
		"//#env:codegen": {
			"cache": true,
			"inputs": [
				"packages/**/.env.schema",
				"apps/**/.env.schema",
				"scripts/codegen-package-env.mjs"
			],
			"outputs": [
				"packages/**/src/env.js",
				"packages/**/src/env.ts",
				"apps/**/env.d.ts"
			]
		},
		"build": {
			"dependsOn": ["//#env:codegen", "^build"],
			"outputs": ["build/**", "public/build/**", "dist/**", ".expo/**"],
			"cache": true
		},
		"@repo/auth#build": {
			"dependsOn": ["^build", "@repo/cache#build"]
		},
		"@repo/email#build": {
			"dependsOn": ["^build", "@repo/cache#build", "@repo/observability#build"]
		},
		"@repo/observability#build": {
			"dependsOn": ["^build", "@repo/security#build"]
		},
		"app#build": {
			"dependsOn": [
				"^build",
				"@repo/auth#build",
				"@repo/email#build",
				"@repo/observability#build",
				"@repo/integrations#build",
				"@repo/ui#build",
				"@repo/i18n#build",
				"@repo/payments#build",
				"@repo/storage#build",
				"@repo/security#build",
				"@repo/notifications#build",
				"@repo/ai#build"
			],
			"env": ["DEPLOY_TARGET"],
			"outputs": ["build/**", "public/build/**", ".wrangler/**"],
			"passThroughEnv": ["NODE_OPTIONS"]
		},
		"admin#build": {
			"dependsOn": [
				"^build",
				"@repo/auth#build",
				"@repo/email#build",
				"@repo/observability#build",
				"@repo/integrations#build",
				"@repo/ui#build",
				"@repo/i18n#build",
				"@repo/payments#build",
				"@repo/storage#build",
				"@repo/security#build",
				"@repo/notifications#build",
				"@repo/ai#build"
			],
			"env": ["DEPLOY_TARGET"],
			"outputs": ["build/**", "public/build/**", ".wrangler/**"],
			"passThroughEnv": ["NODE_OPTIONS"]
		},
		"lint": {
			"cache": true
		},
		"typecheck": {
			"dependsOn": ["//#env:codegen"],
			"cache": true
		},
		"db:seed": {
			"cache": false
		},
		"test": {
			"dependsOn": ["//#env:codegen", "^build"],
			"cache": true
		},
		"test:e2e:run": {
			"dependsOn": ["//#env:codegen", "^build"],
			"cache": true
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"app#dev": {
			"dependsOn": ["@repo/observability#build"],
			"cache": false,
			"persistent": true
		},
		"admin#dev": {
			"dependsOn": ["@repo/observability#build"],
			"cache": false,
			"persistent": true
		},
		"dev:ksa": {
			"cache": false,
			"persistent": true
		},
		"build:docs": {
			"outputs": [".mintlify/doc-build/**"],
			"cache": true
		},
		"test:e2e:install": {
			"cache": false
		}
	}
}
