{
	"$schema": "https://oxc.rs/schema/oxlintrc.json",
	"rules": {
		"no-unused-vars": [
			"warn",
			{
				"varsIgnorePattern": "^(_|ignored)",
				"argsIgnorePattern": "^(_|ignored)"
			}
		]
	},
	"env": {
		"browser": true,
		"node": true,
		"es2022": true
	},
	"globals": {
		"React": "readonly"
	},
	"ignorePatterns": [
		"**/*.test.ts",
		"**/*.test.tsx",
		"**/*.spec.ts",
		"**/*.spec.tsx",
		"**/next-env.d.ts",
		"**/emdash-env.d.ts"
	]
}
