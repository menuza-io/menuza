# Epic Stack - Main Application
# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# @currentEnv=$NODE_ENV
# @defaultRequired=infer @defaultSensitive=false
# @generateTypes(lang=ts, path=env.d.ts)
# @import(../../packages/database/.env.schema, pick=[DATABASE_URL,DATABASE_PATH])
# @import(../../packages/auth/.env.schema, pick=[SESSION_SECRET,IMPERSONATION_SESSION_SECRET,GITHUB_CLIENT_ID,GITHUB_CLIENT_SECRET,GITHUB_REDIRECT_URI,GITHUB_TOKEN,GOOGLE_CLIENT_ID,GOOGLE_CLIENT_SECRET,GOOGLE_REDIRECT_URI])
# @import(../../packages/security/.env.schema, pick=[HONEYPOT_SECRET,SSO_ENCRYPTION_KEY,INTEGRATION_ENCRYPTION_KEY,TRUST_PROXY,TRUSTED_PROXY_COUNT])
# @import(../../packages/audit/.env.schema, pick=[AUDIT_LOG_SECRET_KEY,AUDIT_LOG_OLD_SECRET_KEY,AUDIT_LOG_SECRET_KEYS])
# @import(../../packages/cache/.env.schema, pick=[CACHE_DATABASE_PATH,INTERNAL_COMMAND_TOKEN])
# @import(../../packages/email/.env.schema, pick=[EMAIL_PROVIDER,RESEND_API_KEY,MOCKS,OCI_TENANCY_OCID,OCI_USER_OCID,OCI_FINGERPRINT,OCI_PRIVATE_KEY,OCI_REGION,OCI_EMAIL_COMPARTMENT_ID,OCI_EMAIL_SENDER_EMAIL,OCI_EMAIL_SENDER_NAME,OCI_EMAIL_SENDER_OCID,OCI_EMAIL_LOG_OCID])
# @import(../../packages/integrations/.env.schema, pick=[INTEGRATIONS_OAUTH_STATE_SECRET,JIRA_CLIENT_ID,JIRA_CLIENT_SECRET,SLACK_CLIENT_ID,SLACK_CLIENT_SECRET,LINEAR_CLIENT_ID,LINEAR_CLIENT_SECRET,GITLAB_CLIENT_ID,GITLAB_CLIENT_SECRET,CLICKUP_CLIENT_ID,CLICKUP_CLIENT_SECRET,NOTION_CLIENT_ID,NOTION_CLIENT_SECRET,ASANA_CLIENT_ID,ASANA_CLIENT_SECRET,TRELLO_API_KEY,TRELLO_API_SECRET,GITHUB_INTEGRATION_CLIENT_ID,GITHUB_INTEGRATION_CLIENT_SECRET,GBP_CLIENT_ID,GBP_CLIENT_SECRET,YELP_CLIENT_ID,YELP_CLIENT_SECRET,YELP_API_KEY,TRIPADVISOR_API_KEY,TRIPADVISOR_CLIENT_ID,TRIPADVISOR_CLIENT_SECRET,DELIVEROO_CLIENT_ID,DELIVEROO_CLIENT_SECRET,DELIVEROO_API_KEY,JUST_EAT_CLIENT_ID,JUST_EAT_CLIENT_SECRET,JUST_EAT_API_KEY,OPENTABLE_CLIENT_ID,OPENTABLE_CLIENT_SECRET,OPENTABLE_API_KEY,RESY_CLIENT_ID,RESY_CLIENT_SECRET,RESY_API_KEY,CLOVER_APP_ID,CLOVER_APP_SECRET,CLOVER_BASE_URL,CLOVER_AUTHORIZE_URL,SQUARE_APP_ID,SQUARE_APP_SECRET,SQUARE_BASE_URL,SQUARE_AUTHORIZE_URL,TOAST_CLIENT_ID,TOAST_CLIENT_SECRET,TOAST_BASE_URL,TOAST_AUTHORIZE_URL,UBER_EATS_ENVIRONMENT,UBER_EATS_CLIENT_ID,UBER_EATS_CLIENT_SECRET,UBER_EATS_BASE_URL,UBER_EATS_AUTHORIZE_URL,DOORDASH_DEVELOPER_ID,DOORDASH_KEY_ID,DOORDASH_SIGNING_SECRET,DOORDASH_BASE_URL])
# @import(../../packages/observability/.env.schema, pick=[SERVICE_NAME,SERVICE_VERSION,BETTERSTACK_API_KEY,BETTERSTACK_URL])
# @import(../../packages/payments/.env.schema, pick=[TRIAL_DAYS,CREDIT_CARD_REQUIRED_FOR_TRIAL])
# @import(../../packages/tenant-db/.env.schema, pick=[TENANT_DB_DIR])
# ----------

# @type=enum(production, development, test) @sensitive=false
NODE_ENV=development

# Signing secret from Resend Dashboard → Webhooks (email.opened, email.clicked).
# Only used when EMAIL_PROVIDER=resend. Webhook URL: {BASE_URL}/api/resend/webhook
# @sensitive
RESEND_WEBHOOK_SECRET=whsec_***

# Public PostHog project token used by browser analytics and server-side events.
# Project tokens start with `phc_` and are safe to expose to the browser.
# @sensitive=false
POSTHOG_PROJECT_TOKEN=

# PostHog ingestion host for the project's data region.
# @type=url @sensitive=false
POSTHOG_HOST=https://us.i.posthog.com

# Public origin of this app (`https://app.{apex}`). Cookie Domain is inferred
# as `.{apex}` so app. and admin. share the session. Leave as localhost in dev.
# @required @type=url @sensitive=false @dynamic
BASE_URL="https://app.menuza.test:2999"

# Match BASE_URL when using the HTTPS dev proxy (`npm run dev` on :2999).
# @type=url @sensitive=false @dynamic
GITHUB_REDIRECT_URI="https://app.menuza.test:2999/auth/github/callback"

# @type=url @sensitive=false @dynamic
GOOGLE_REDIRECT_URI="https://app.menuza.test:2999/auth/google/callback"

# Extra apex domains the website editor may iframe (tenant Sites).
# Comma-separated. Also derived at runtime from the App Host header and BASE_URL.
# @sensitive=false
PUBLIC_SITE_HOST_SUFFIXES=

# CF_DATACENTER, REGION, and DEPLOYMENT_ID are runtime-injected by Cloudflare Workers
# (see packages/observability/src/runtime-env.ts) — not declared in this schema.

# @required @sensitive @type=string(startsWith="sk_")
STRIPE_SECRET_KEY=sk_test_***

# Publishable key for the same Stripe account (embedded tenant shop checkout).
# @required @sensitive=false @type=string(startsWith="pk_")
STRIPE_PUBLISHABLE_KEY=pk_test_***

# @required @sensitive @type=string(startsWith="whsec_")
STRIPE_WEBHOOK_SECRET=whsec_***

# Polar organization access token for tenant shop checkout (Merchant of Record).
# Optional. Polar shops stay disabled until this is set.
# @sensitive
POLAR_ACCESS_TOKEN=

# Polar organization ID. Required when POLAR_ACCESS_TOKEN is a personal token
# rather than an organization access token.
# @sensitive=false
POLAR_ORGANIZATION_ID=

# Polar API environment for shop checkout. Defaults to sandbox.
# @type=enum(sandbox, production) @sensitive=false
POLAR_SERVER=sandbox

# Polar webhook secret from the Polar dashboard (order.paid, checkout.updated).
# @sensitive
POLAR_WEBHOOK_SECRET=

# Checkout.com secret API key (sk_sbox_ / sk_).
# @sensitive
CHECKOUT_SECRET_KEY=

# Checkout.com public key (pk_sbox_ / pk_).
# @sensitive
CHECKOUT_PUBLIC_KEY=

# Account-specific API subdomain prefix from Dashboard → Developers.
# @sensitive=false
CHECKOUT_SUBDOMAIN=

# Processing channel ID for tenant shop payments.
# @sensitive=false
CHECKOUT_PROCESSING_CHANNEL_ID=

# @type=enum(sandbox, production) @sensitive=false
CHECKOUT_ENVIRONMENT=sandbox

# Checkout.com webhook signature key (payment_approved, payment_captured).
# @sensitive
CHECKOUT_WEBHOOK_SECRET=

# Second Stripe webhook signing secret, for Connect events (`account.updated`).
# Optional. When set, the Stripe webhook route accepts either secret and the
# payment mock signs Connect events with it. See docs/payments-mock.md.
# @sensitive
STRIPE_CONNECT_WEBHOOK_SECRET=

# Local Stripe and Checkout.com emulators (never in a Cloudflare production
# build). `true` turns them on without MOCKS, `false` forces them off even with
# MOCKS=true. A real test key for a provider keeps that provider real.
# See docs/payments-mock.md.
# @sensitive=false
PAYMENTS_MOCK=

# Origin of the mock hosted pages. Defaults to BASE_URL.
# @sensitive=false
PAYMENTS_MOCK_ORIGIN=

# How the mock delivers signed webhooks: inline (before the redirect),
# deferred (shortly after) or manual (only on POST /mock-payments/dev/events/flush).
# @sensitive=false
PAYMENTS_MOCK_WEBHOOKS=

# `1` POSTs mock webhooks over HTTP to PAYMENTS_MOCK_ORIGIN instead of calling
# the route in process.
# @sensitive=false
PAYMENTS_MOCK_WEBHOOKS_HTTP=

# `true` puts the hosted page id on Checkout.com webhooks as
# processing.payment_session_id (unverified against the real API; off by default).
# @sensitive=false
PAYMENTS_MOCK_CKO_SESSION_ID=

# @type=url @sensitive=false
STRIPE_PORTAL_URL=https://billing.stripe.com/p/login/test_***

# @type=enum(CLOSED_BETA, PUBLIC_BETA, LAUNCHED) @sensitive=false
# See docs/launch-checklist.md for phase behavior and rollout steps.
LAUNCH_STATUS=LAUNCHED

# Signs short-lived operator JWTs (audience: "tenant-api-operator") that the
# app UI uses to call the regional tenant-api directly from the browser.
# MUST differ from INTERNAL_COMMAND_TOKEN.
# @required @sensitive
TENANT_OPERATOR_TOKEN=dev-operator-token-do-not-use-in-prod-32b

# Signs operator analytics JWTs (phone calls, customers, orders, wages).
# MUST differ from INTERNAL_COMMAND_TOKEN. The default is refused in production.
# @required @sensitive
OPERATOR_ANALYTICS_TOKEN=dev-operator-analytics-token-do-not-use-in-prod

# Shared only with the voice-agent worker and every tenant-api (≥32 chars).
# Authenticates /resources/phone-agent-config. MUST differ from
# INTERNAL_COMMAND_TOKEN and TENANT_OPERATOR_TOKEN. The default below is
# refused when NODE_ENV=production.
# @required @sensitive @type=string(minLength=32)
VOICE_AGENT_TOKEN=dev-voice-agent-token-do-not-use-in-prod-32b

# Shared only with the Sites worker (≥32 chars). Authenticates the two
# /resources/sites/reservation/* routes (checkout, status) and nothing else.
# MUST differ from INTERNAL_COMMAND_TOKEN, TENANT_OPERATOR_TOKEN and
# VOICE_AGENT_TOKEN. The default below is refused when NODE_ENV=production.
# @required @sensitive @type=string(minLength=32)
SITES_RESERVATION_PAYMENT_TOKEN=dev-sites-reservation-payment-token-do-not-use-in-prod

# Cloudflare jobs-cron Worker URL (storage migration workflow + cron triggers)
# @type=url @sensitive=false
JOBS_CRON_WORKER_URL=http://localhost:8787

# @type=boolean @sensitive=false
ALLOW_INDEXING=true

# Tigris Object Storage (S3-compatible) Configuration
# Access key ID is an identifier (also appears in SigV4 presigned URLs); not secret.
# @required @sensitive=false
AWS_ACCESS_KEY_ID=mock-access-key

# @required @sensitive
AWS_SECRET_ACCESS_KEY=mock-secret-key

# @required @sensitive=false
AWS_REGION=auto

# @required @type=url @sensitive=false
AWS_ENDPOINT_URL_S3=https://example.r2.cloudflarestorage.com

# @required @sensitive=false
BUCKET_NAME=mock-bucket

# ---------- External Services ----------

# Google AI
# @sensitive
GOOGLE_GENERATIVE_AI_API_KEY=

# Chrome Extension
# @sensitive=false
EXTENSION_ID=

# ---------- Enterprise SSO Configuration ----------

# @type=boolean @sensitive=false
SSO_ENABLED=false

# ---------- Discord Integration ----------
# Waitlist Discord OAuth (+2 points). Full setup: docs/launch-checklist.md and
# apps/app/docs/DISCORD_INTEGRATION.md
# @docs(https://discord.com/developers/applications)
# @type=url @sensitive=false
DISCORD_INVITE_URL=https://discord.gg/your-server

# Optional WhatsApp community group invite shown on the waitlist.
# WhatsApp membership is not auto-verified; admins can award points manually.
# @type=url @sensitive=false
WHATSAPP_GROUP_INVITE_URL=

# @sensitive=false
DISCORD_CLIENT_ID=

# @sensitive
DISCORD_CLIENT_SECRET=

# @type=url @sensitive=false
DISCORD_REDIRECT_URI=

# @sensitive=false
DISCORD_GUILD_ID=

# JWT for API authentication
# @required @sensitive
JWT_SECRET=your-jwt-secret

# ---------- Build-time Variables ----------

# PostHog source map upload. The personal key needs Error Tracking write access.
# @sensitive
POSTHOG_PERSONAL_API_KEY=

# @sensitive=false
POSTHOG_PROJECT_ID=

# Release identifier used to correlate client logs and uploaded source maps.
# @sensitive=false
COMMIT_SHA=

# ---------- Cloudflare for SaaS (Sites custom domains) ----------
# Optional in local/dev. When unset, custom domains are stored locally only.
# @docs(https://developers.cloudflare.com/cloudflare-for-platforms/cloudflare-for-saas/)
# @sensitive
CLOUDFLARE_API_TOKEN=

# @sensitive=false
CLOUDFLARE_ZONE_ID=

# CNAME target customers point their domain at (e.g. sites.menuza.io)
# @sensitive=false
CLOUDFLARE_CUSTOM_HOSTNAME_CNAME_TARGET=sites.menuza.io

# ---------- Domains: apex and www, nameservers, buying, forwarding (#139, #313, #283, #183, #276) ----------
# Addresses for a customer's root domain when their DNS host has no ALIAS, ANAME
# or CNAME flattening (comma separated). Empty: only ALIAS is shown for the root.
# @sensitive=false
SITES_APEX_IPV4=

# @sensitive=false
SITES_APEX_IPV6=

# Local emulators for DNS zones, the registrar, email routing and Domain
# Connect. Ignored unless BASE_URL is local, so nothing real is ever faked.
# @sensitive=false
DOMAINS_MOCK=

# Cloudflare account that holds the DNS zones Menuza hosts, with a token scoped
# to Zone edit, DNS edit and Email Routing (separate from CLOUDFLARE_API_TOKEN).
# @sensitive=false
CLOUDFLARE_ACCOUNT_ID=

# @sensitive
CLOUDFLARE_DOMAINS_API_TOKEN=

# Nameservers shown when the DNS provider names none (comma separated).
# @sensitive=false
DOMAINS_NAMESERVERS=

# Name.com Core API credentials for buying domains (NAMECOM_API_URL points at
# the sandbox). Empty: Get a domain stays off even with the flag on.
# @sensitive=false
NAMECOM_USERNAME=

# @sensitive
NAMECOM_API_TOKEN=

# @sensitive=false
NAMECOM_API_URL=

# Extensions we sell (comma separated, default com) and our markup in percent.
# @sensitive=false
DOMAIN_SUPPORTED_TLDS=

# @sensitive=false
DOMAIN_PRICE_MARKUP_PERCENT=

# The Domain Connect provider id our templates are published under
# (docs/domain-connect). Empty: Connect automatically stays off.
# @sensitive=false
DOMAIN_CONNECT_PROVIDER_ID=

# Public origin of the Station web app (apps/station), e.g. https://pos.menuza.io.
# Used only to build the pairing link and QR code managers hand to a terminal.
# Leave empty to show the bare pairing code instead of a link. The same origin
# must be listed in POS_ORIGINS on every tenant-api node.
# @type=url @sensitive=false
POS_URL=

# ---------- Print shop (Marketing, Print shop) ----------
# Cloudflare Browser Rendering renders print PDFs (REST API /pdf). The token
# needs the "Browser Rendering - Edit" permission on this account. Leave both
# empty in dev: the download then opens a print-ready page and the browser's
# print dialog saves the PDF.
# @sensitive=false
PRINT_BROWSER_ACCOUNT_ID=

# @sensitive
PRINT_BROWSER_API_TOKEN=

# Shipped prints. PRINT_SHIPPING_ENABLED=false (also 0, off, no, disabled)
# pauses new paid orders on every organization (vendor outage); unset or true
# means on. Orders already paid keep moving.
# @sensitive=false
PRINT_SHIPPING_ENABLED=

# Kill switch for AI menu import (#73). Unset or true means on; false (also 0,
# off, no) disables new menu imports and hides the upload/URL action.
# @sensitive=false
MENU_IMPORT_ENABLED=

# Local vendor emulator: true routes every vendor call to a stateless mock
# (quotes, orders, tracking) so shipped prints work without vendor keys. Never
# set in production.
# @sensitive=false
PRINT_MOCK=

# Gelato API key (X-API-KEY). Empty: Gelato products cannot be ordered.
# @sensitive
GELATO_API_KEY=

# Prodigi API key (X-API-Key). PRODIGI_SANDBOX=true uses the sandbox API.
# @sensitive
PRODIGI_API_KEY=

# @sensitive=false
PRODIGI_SANDBOX=

# Shared secret in the vendor webhook URLs
# (/resources/print/webhook/<vendor>?token=...). At least 32 characters. The
# webhook only triggers a status fetch from the vendor's API; its body is
# never trusted.
# @sensitive
PRINT_WEBHOOK_TOKEN=

# Renders per organization per hour (cached files do not count). Default 30.
# @type=number @sensitive=false
PRINT_RENDER_LIMIT_PER_HOUR=

# Branded customer app registry (#156). The build pipeline: a GitHub Actions
# workflow dispatched per app and platform. Leave empty and a build is only
# recorded (status `queued`) for whatever runner reports back through
# /resources/customer-app/build-callback. Nothing here submits to a store.
# @sensitive=false
CUSTOMER_APP_BUILD_REPO=

# @sensitive=false
CUSTOMER_APP_BUILD_WORKFLOW=

# @sensitive=false
CUSTOMER_APP_BUILD_REF=

# @sensitive
CUSTOMER_APP_BUILD_TOKEN=

# Shared only with the customer-app build pipeline (≥32 chars). Authenticates
# GET /resources/customer-app/config and per-build POST build-callback. MUST
# differ from INTERNAL_COMMAND_TOKEN and CUSTOMER_APP_BUILD_TOKEN.
# @required @sensitive @type=string(minLength=32)
CUSTOMER_APP_PIPELINE_TOKEN=dev-customer-app-pipeline-token-do-not-use-in-prod-32b

# Local emulators for the build pipeline, the stores and the store account
# (also on with MOCKS=true). Ignored unless BASE_URL is local. Never set in
# production.
# @sensitive=false
CUSTOMER_APP_MOCK=

# Canva Connect integration (Print shop, Import from Canva and Send to Canva).
# Create it in the Canva developer portal with the redirect URL
# <BASE_URL>/resources/print/canva/callback and the scopes design:meta:read,
# design:content:read, design:content:write and profile:read. Empty: the Canva
# buttons stay hidden. Tokens are stored encrypted with
# INTEGRATION_ENCRYPTION_KEY. See docs/print-shop-canva.md.
# @sensitive=false
CANVA_CLIENT_ID=

# @sensitive
CANVA_CLIENT_SECRET=

# Local Canva emulator: true connects without Canva and offers three sample
# designs. Ignored unless BASE_URL is local. Never set in production.
# @sensitive=false
CANVA_MOCK=

# Meta app for Marketing, Social media (Facebook Pages and Instagram
# professional accounts). Facebook Login redirect URL:
# <BASE_URL>/resources/social/meta/callback. Empty: accounts cannot be
# connected. Page tokens are stored encrypted with INTEGRATION_ENCRYPTION_KEY.
# See docs/social-media.md.
# @sensitive=false
META_APP_ID=

# @sensitive
META_APP_SECRET=

# Local Meta emulator: true connects a sample Facebook Page or Instagram
# account and publishes nothing. Ignored unless BASE_URL is local. Never set
# in production.
# @sensitive=false
SOCIAL_MOCK=

# Local rank checks (Website, SEO, Keywords; flag seo.rank_tracking): the
# DataForSEO login and password for its Google Maps SERP API. Empty: checks are
# skipped as "not set up" (a local BASE_URL uses a built-in mock instead).
# @sensitive
SEO_RANK_API_LOGIN=
# @sensitive
SEO_RANK_API_PASSWORD=

# Base URL for Cloudflare Media Transformations (/cdn-cgi/media). Must be a
# Cloudflare-proxied hostname with Transformations enabled. Leave empty in dev
# to fall back to direct video source URLs.
# @type=url @sensitive=false
MEDIA_TRANSFORM_BASE_URL=

# Kill switch for the menu photo restyle (#146). Unset or true means on; false
# (also 0, off, no, disabled) stops new runs and draft generation on this node.
# Drafts already made stay reviewable.
# @sensitive=false
MEDIA_RESTYLE_ENABLED=

# Local emulators for the photo adapters (#145 quality scoring, #146 restyle,
# #316 bulk matching): true answers from fixtures without any model. The global
# MOCKS=true does the same. Ignored unless BASE_URL is local. Never set in
# production.
# @sensitive=false
PHOTO_QUALITY_MOCK=
# @sensitive=false
MEDIA_RESTYLE_MOCK=
# @sensitive=false
DISH_PHOTO_MATCH_MOCK=

# Hero video renderer (#301): the service that turns 3 to 6 of a restaurant's
# own photos into a silent, looping hero clip (pan and zoom compositing). The
# App sends it the plan and short-lived read links to the photos, and gets the
# MP4 and its poster back. See docs/hero-video.md for the contract. Empty:
# "Make a video from my photos" reports that it is not available. Never a
# generative model: only the restaurant's own photos go in.
# @type=url @sensitive=false
HERO_VIDEO_RENDERER_URL=
# @sensitive
HERO_VIDEO_RENDERER_TOKEN=

# Local hero video renderer emulator: true renders a tiny fixture clip and uses
# the first photo as the poster. Ignored unless BASE_URL is local. Never set in
# production.
# @sensitive=false
HERO_VIDEO_MOCK=

# Optional external documentation URL. When empty, the App sidebar omits the
# Get help link.
# @type=url @sensitive=false
DOCS_URL=

# Optional "What's new" page for the Help menu (#233). When empty, What's new
# opens DOCS_URL; with neither set the entry is omitted.
# @type=url @sensitive=false
WHATS_NEW_URL=

# Regional tenant-api (US data plane). Used for server-to-server provision,
# deprovision, and App loader fetchTenant. Local default matches
# `npm run dev:tenant-api`. Do not pass this URL to the browser when the App is
# served over HTTPS (mixed content).
# @type=url @sensitive=false
TENANT_API_URL=http://localhost:3007

# KSA tenant-api. Local default matches `npm run dev:tenant-api:ksa` (port 3009).
# @type=url @sensitive=false
TENANT_API_URL_KSA=http://localhost:3009

# Manager alerts and operator push (#106, #131, #241, #300, #190). Each kill
# switch is unset or true for on; false (also 0, off, no, disabled) DROPS what
# it stops, so switching it back on sends no backlog. The organization flags
# `orders.manager_alerts` and `notifications.operator_push` (default off) come
# first. See docs/manager-alerts.md.
# - ORDERS_ALERTS_ENABLED: every order and tablet alert (tenant-api honors it too).
# - ORDERS_EMAIL_ENABLED: the email of those alerts; the bell is unaffected.
# - ORDER_ALERT_SMS_ENABLED: texts to the people a location chose.
# - OPERATOR_PUSH_ENABLED: every push to the operator phone app.
# @sensitive=false
ORDERS_ALERTS_ENABLED=
# @sensitive=false
ORDERS_EMAIL_ENABLED=
# @sensitive=false
ORDER_ALERT_SMS_ENABLED=
# @sensitive=false
OPERATOR_PUSH_ENABLED=

# Keys the hash of a text recipient's number (so STOP can be matched without the
# number travelling) and the one-time-code hash (#241). Shared by the App and the
# US tenant-api only, 32+ chars. MUST differ from INTERNAL_COMMAND_TOKEN: that
# token is held by every node and the cron worker, and rotating it must not
# silently break STOP. The default is refused outside development and test.
# Rotate by adding a new hash version, not by changing this in place.
# @required @sensitive @type=string(minLength=32)
ORDER_ALERT_HASH_SECRET=dev-order-alert-hash-secret-do-not-use-in-prod-32b

# Operator push provider: Expo's push service by default. `mock` (also
# MOCKS=true) records pushes in memory and calls nothing. EXPO_ACCESS_TOKEN is
# optional (Expo's enhanced push security). `ALERT_TEXT_PROVIDER=mock` does the
# same for order alert texts, which otherwise go through the US tenant-api.
# @sensitive=false
OPERATOR_PUSH_PROVIDER=
# @sensitive=true
EXPO_ACCESS_TOKEN=
# @sensitive=false
ALERT_TEXT_PROVIDER=

# Kill switch for staffing manager-alert email (someone has not clocked in, a
# forgotten clock-out, overtime close). Unset or true means on. false (also 0,
# off, no, disabled) stops those emails; in-app notifications are unaffected.
# tenant-api honors the same variable for staff email on its own nodes.
# @type=boolean @sensitive=false
STAFFING_EMAIL_ENABLED=true

# Kill switch for reservations manager-alert email (large-party request, failed
# payment, bulk message failure). Unset or true means on. false (also 0, off,
# no, disabled) stops those emails; in-app notifications are unaffected.
# tenant-api honors the same variable for guest email on its own nodes.
# @type=boolean @sensitive=false
RESERVATIONS_EMAIL_ENABLED=true

# Verifies tenant-site customer access tokens on US shop checkout endpoints.
# MUST match the US tenant-api `JWT_SECRET` (not App operator `JWT_SECRET`).
# @required @sensitive
TENANT_CUSTOMER_JWT_SECRET=dev-jwt-secret-do-not-use-in-prod-32b

# Optional. Google Cloud Translation API key for the page-builder Translate buttons.
# @sensitive
GOOGLE_API_KEY=

# Optional. Google Maps Platform key (Places API (New) + Geocoding API) for
# operator store-address search and geocoding store addresses on location
# save. Empty uses bundled mock/dev fixtures outside production; empty in
# production disables address search and store geocoding.
# @sensitive
GOOGLE_MAPS_API_KEY=

# @sensitive=false
ROOT_APP=menuza.test

# LiveKit project for the AI phone agent (US only). App mints browser test-call
# tokens with these; the voice-agent worker uses the same project. Leave empty
# to hide test calls. Local: `livekit-server --dev` → ws://localhost:7880,
# key `devkey`, secret `secret`. Cloud: wss://<project>.livekit.cloud.
# @type=url @sensitive=false
LIVEKIT_URL=

# @sensitive=false
LIVEKIT_API_KEY=

# @sensitive
LIVEKIT_API_SECRET=

# Optional. Cartesia key for the phone agent's voice picker on Setup: searching
# the voice library and playing previews. The voice-agent worker has its own
# copy. Leave empty to hide the picker's search and previews.
# @sensitive
CARTESIA_API_KEY=

# Optional. Where the voice-agent stores call recordings: the same bucket,
# endpoint and region as RECORDING_S3_* on tenant-api and the worker (never the
# keys). App only allows the bucket as a media source so the call detail can
# play a recording from the short-lived link tenant-api signs. Leave empty to
# disable playback.
# @sensitive=false
RECORDING_S3_BUCKET=
# @type=url @required=false @sensitive=false
RECORDING_S3_ENDPOINT=
# @sensitive=false
RECORDING_S3_REGION=

# Optional. Cloudflare Turnstile on the operator login (password step), signup
# and forgot-password forms. Both keys must be set to turn it on; leave either
# empty to disable it (local dev, Vitest and Playwright E2E run without it).
# The mobile JSON API (/api/auth/*) has no widget and relies on rate limits.
# Site key: shown to the browser.
# @sensitive=false
TURNSTILE_SITE_KEY=
# Secret for siteverify. Set with `wrangler secret put TURNSTILE_SECRET_KEY`.
# @sensitive
TURNSTILE_SECRET_KEY=
# Optional comma-separated hostnames siteverify must report (for example
# `app.example.com`). Empty accepts any hostname the widget is allowed on.
# @sensitive=false
TURNSTILE_HOSTNAMES=
