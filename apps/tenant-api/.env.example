# Copy to .env on the OCI VM. Do not commit real values.
# US (Ashburn): DATA_REGION=us
# KSA (Riyadh): DATA_REGION=ksa

DATA_REGION=us
PORT=8080
TENANT_DB_DIR=/data/tenants
NODE_ENV=production

JWT_SECRET=
AUTH_HMAC_SECRET=
# ZATCA (KSA POS): 64 hex chars (`openssl rand -hex 32`), sealing EGS keys and CSID secrets.
ZATCA_SEAL_KEY=
INTERNAL_COMMAND_TOKEN=
# Shared only with apps/voice-agent and App (≥32 chars, distinct from the above).
VOICE_AGENT_TOKEN=

# Optional. Call recording bucket so retention/erasure can delete recordings.
# RECORDING_S3_BUCKET=
# RECORDING_S3_REGION=
# RECORDING_S3_ENDPOINT=
# RECORDING_S3_ACCESS_KEY=
# RECORDING_S3_SECRET=

# US App origin so this node can resolve org flags without the control-plane SQLite volume.
APP_URL=https://app.menuza.test:2999
ROOT_APP=menuza.test

# Required in production. Public origin of this node, used in consent email links.
TENANT_API_URL=https://tenant-us.example.com

# Required in production. Public origin of this node, used in consent email links.
TENANT_API_URL=https://tenant-us.example.com

# Optional. Only needed if this node reads the control-plane database locally (US). KSA should use APP_URL.
# DATABASE_URL=file:/data/tenants/unused.db

# US only. Do not set Twilio on the KSA VM.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# GLOBAL_SMS_CAP=500

# Staff time clock kill switch (default on). false answers 503 on every /kiosk
# route and refuses new pairing codes; revoking a device always still works.
# STAFFING_KIOSK_ENABLED=true

# Walk-in POS kill switch (default on). false answers 503 on every /pos route and
# refuses new pairing codes; revoking a terminal always still works.
# POS_ENABLED=true

# Origins hosting the POS web app, comma separated (CORS for /pos/* only).
# POS_ORIGINS=https://pos.example.com

# Staff email kill switch (default on). false drops staff reminders and notices
# from this node instead of holding them. Manager alerts honor it in the App.
# STAFFING_EMAIL_ENABLED=true

# Online-booking kill switch (default on). false answers 503 on every public
# /reservations/* route; operator routes are unaffected.
# RESERVATIONS_PUBLIC_ENABLED=true

# Guest reservation email and SMS kill switches (default on). false drops those
# messages instead of holding them, so re-enabling sends no backlog. SMS is US
# node only; the KSA node never sends reservation SMS.
# RESERVATIONS_EMAIL_ENABLED=true
# RESERVATIONS_SMS_ENABLED=true

# Node runtime only: seconds between in-process reservation ticks (default 120,
# min 60, 0 off). The hourly cron fan-out always runs.
# RESERVATIONS_TICK_INTERVAL_SECONDS=120

# Development only: capture emails this node would only log as JSON files in this
# folder (relative to apps/tenant-api). Ignored in production or with OCI email.
# DEV_EMAIL_CAPTURE_DIR=.dev-mail/us

# Node runtime only: seconds between in-process staff ticks (default 300, min 60,
# 0 off). The hourly cron fan-out always runs.
# STAFFING_TICK_INTERVAL_SECONDS=300

# Cloudflare Turnstile for public website form submissions.
# TURNSTILE_SECRET_KEY=
# TURNSTILE_HOSTNAMES=localhost,your-tenant-sites.example

# Google Maps Platform (Places API (New) + Geocoding API) for delivery
# address search and coverage quotes. Required in production for delivery
# quotes; both regions use their own server-side calls.
# GOOGLE_MAPS_API_KEY=

# Development only (ignored in production): write a JSON file per email the node
# would otherwise only log.
# DEV_EMAIL_CAPTURE_DIR=.dev-mail/us

# Image tag written by CI / docker compose pull.
# TENANT_API_IMAGE=ghcr.io/<owner>/menuza/tenant-api:<sha>
