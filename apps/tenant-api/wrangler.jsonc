{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "epic-startup-tenant-api-us",
	"main": "./workers/index.ts",
	"build": {
		"command": "npm run generate:do-migrations",
	},
	"compatibility_date": "2026-08-13",
	"compatibility_flags": [
		"nodejs_compat",
		"nodejs_compat_populate_process_env",
	],
	"workers_dev": true,
	"observability": {
		"enabled": true,
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "TENANT_ORG",
				"class_name": "TenantOrg",
			},
			{
				"name": "TENANT_REGISTRY",
				"class_name": "TenantRegistry",
			},
		],
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["TenantOrg", "TenantRegistry"],
		},
	],
	// Secrets — set via `wrangler secret put <NAME>` (never commit values):
	// JWT_SECRET, AUTH_HMAC_SECRET, INTERNAL_COMMAND_TOKEN, TENANT_OPERATOR_TOKEN,
	// TWILIO_AUTH_TOKEN, OCI_PRIVATE_KEY, OCI_EMAIL_COMPARTMENT_ID, etc.
	//
	// TENANT_API_URL (this Worker's public https origin, used in the signed
	// confirmation and unsubscribe links inside emails) is required in
	// production but deliberately NOT declared below: an empty "vars" entry
	// would overwrite a value set in the dashboard on every deploy. Set it per
	// environment ("vars" of that environment, or the dashboard) BEFORE you
	// deploy. Until it is set the Worker keeps serving; consent emails are
	// skipped (broadcasts end Failed) and each skip is logged with ids only.
	"vars": {
		"DATA_REGION": "us",
		"NODE_ENV": "production",
		"TENANT_API_RUNTIME": "workers",
		"GLOBAL_SMS_CAP": "500",
	},
	"env": {
		"staging": {
			"name": "epic-startup-tenant-api-us-staging",
			"vars": {
				"DATA_REGION": "us",
				"NODE_ENV": "production",
				"TENANT_API_RUNTIME": "workers",
				"GLOBAL_SMS_CAP": "500",
			},
		},
	},
}
