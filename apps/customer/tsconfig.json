{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"allowImportingTsExtensions": true,
		"ignoreDeprecations": "6.0",
		"types": ["jest", "node"],
		"paths": {
			"@/*": ["./*"]
		}
	},
	"include": ["**/*.ts", "**/*.tsx", "**/*.d.ts", "uniwind-env.d.ts"],
	"exclude": ["node_modules", "dist", "scripts"]
}
