{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "menuza-jobs-cron",
	"main": "src/index.ts",
	"compatibility_date": "2025-08-15",
	"workers_dev": true,
	"observability": {
		"enabled": true,
	},
	"triggers": {
		"crons": ["0 2 * * *", "0 3 * * *", "0 4 * * *", "0 * * * *"],
	},
	"workflows": [
		{
			"name": "storage-migration",
			"binding": "STORAGE_MIGRATION_WORKFLOW",
			"class_name": "StorageMigrationWorkflow",
		},
		{
			"name": "marketing-journey",
			"binding": "MARKETING_JOURNEY_WORKFLOW",
			"class_name": "MarketingJourneyWorkflow",
		},
	],
	// APP_BASE_URL / TENANT_API_URL* patched at deploy — set INTERNAL_COMMAND_TOKEN via wrangler secret put.
	"vars": {},
	"env": {
		"staging": {
			"name": "menuza-jobs-cron-staging",
			"vars": {},
		},
	},
}
