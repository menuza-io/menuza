{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "menuza-jobs-cron",
	"main": "src/index.ts",
	"compatibility_date": "2025-08-15",
	"workers_dev": true,
	"observability": {
		"enabled": true,
	},
	"triggers": {
		"crons": [
			"*/15 * * * *",
			"0 2 * * *",
			"0 3 * * *",
			"0 4 * * *",
			"0 * * * *",
		],
	},
	"workflows": [
		{
			"name": "storage-migration",
			"binding": "STORAGE_MIGRATION_WORKFLOW",
			"class_name": "StorageMigrationWorkflow",
		},
		{
			"name": "marketing-journey",
			"binding": "MARKETING_JOURNEY_WORKFLOW",
			"class_name": "MarketingJourneyWorkflow",
		},
		{
			"name": "social-post",
			"binding": "SOCIAL_POST_WORKFLOW",
			"class_name": "SocialPostWorkflow",
		},
		{
			"name": "website-publish",
			"binding": "WEBSITE_PUBLISH_WORKFLOW",
			"class_name": "WebsitePublishWorkflow",
		},
		{
			"name": "website-import",
			"binding": "WEBSITE_IMPORT_WORKFLOW",
			"class_name": "WebsiteImportWorkflow",
		},
		{
			"name": "menu-schedule",
			"binding": "MENU_SCHEDULE_WORKFLOW",
			"class_name": "MenuScheduleWorkflow",
		},
		{
			"name": "menu-import",
			"binding": "MENU_IMPORT_WORKFLOW",
			"class_name": "MenuImportWorkflow",
		},
		{
			"name": "calendar-sync",
			"binding": "CALENDAR_SYNC_WORKFLOW",
			"class_name": "CalendarSyncWorkflow",
		},
		{
			"name": "hero-video",
			"binding": "HERO_VIDEO_WORKFLOW",
			"class_name": "HeroVideoWorkflow",
		},
		{
			"name": "occasion-schedule",
			"binding": "OCCASION_SCHEDULE_WORKFLOW",
			"class_name": "OccasionScheduleWorkflow",
		},
		{
			"name": "photo-quality",
			"binding": "PHOTO_QUALITY_WORKFLOW",
			"class_name": "PhotoQualityWorkflow",
		},
		{
			"name": "media-restyle",
			"binding": "MEDIA_RESTYLE_WORKFLOW",
			"class_name": "MediaRestyleWorkflow",
		},
		{
			"name": "operator-alerts",
			"binding": "OPERATOR_ALERTS_WORKFLOW",
			"class_name": "OperatorAlertsWorkflow",
		},
	],
	// APP_BASE_URL / TENANT_API_URL* patched at deploy — set INTERNAL_COMMAND_TOKEN via wrangler secret put.
	"vars": {},
	"env": {
		"staging": {
			"name": "menuza-jobs-cron-staging",
			"vars": {},
		},
	},
}
