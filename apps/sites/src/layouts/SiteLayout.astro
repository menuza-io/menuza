---
import { buildCustomSiteFontFaceCss } from '@repo/common/site-fonts'
import { brand } from '@repo/config/brand'
import SiteAnalyticsIntegrations from '~/components/SiteAnalyticsIntegrations.astro'
import { resolveMediaUrl } from '~/lib/media'
import { SITES_BOOT_SCRIPT } from '~/lib/site-headers'
import { verificationMetaTags } from '~/lib/site-verification'
import { type PublicSiteTheme } from '~/lib/org'
import '../styles/tailwind.css'
import siteFontsStylesheet from '../styles/site-fonts.css?url'

interface Props {
	title?: string
	description?: string
	imageUrl?: string | null
	canonicalUrl?: string
	alternateLinks?: Array<{ hrefLang: string; href: string }>
	noIndex?: boolean
	theme?: PublicSiteTheme
	lang?: string
	dir?: 'ltr' | 'rtl'
	siteIcon?: {
		favicon32: string
		favicon16: string
		appleTouchIcon: string
	} | null
	tenantApiUrl?: string
	appUrl?: string
	orgSlug?: string | null
	customHost?: string | null
	defaultLocale?: string
	facebookPixelId?: string | null
	googleTagManagerId?: string | null
	googleAnalyticsId?: string | null
	tiktokPixelId?: string | null
	/** The cookie banner mode (#89): tags load only as consent allows. */
	consentMode?: 'required' | 'notice' | 'off'
	/** Search engine verification codes (#138); the home page passes them. */
	siteVerification?: { google: string[]; bing: string | null } | null
}

const {
	title = brand.name,
	description,
	imageUrl,
	canonicalUrl,
	noIndex = false,
	theme,
	lang = 'en',
	dir = 'ltr',
	siteIcon,
	tenantApiUrl,
	appUrl,
	orgSlug,
	customHost,
	defaultLocale = 'en',
	alternateLinks = [],
	facebookPixelId,
	googleTagManagerId,
	googleAnalyticsId,
	tiktokPixelId,
	consentMode = 'off',
	siteVerification,
} = Astro.props
const themeMode = theme?.mode ?? 'system'
const themeCss = theme?.css ?? ''
const headingCustomUrl = resolveMediaUrl(theme?.headingCustomFont?.url)
const bodyCustomUrl = resolveMediaUrl(theme?.bodyCustomFont?.url)
const customFontCss = buildCustomSiteFontFaceCss({
	headingUrl: headingCustomUrl,
	headingFormat: theme?.headingCustomFont?.format,
	bodyUrl: bodyCustomUrl,
	bodyFormat: theme?.bodyCustomFont?.format,
})
const headingFont =
	theme?.headingFont === 'custom' && headingCustomUrl
		? 'custom'
		: theme?.headingFont === 'custom'
			? 'inter'
			: (theme?.headingFont ?? 'inter')
const bodyFont =
	theme?.bodyFont === 'custom' && bodyCustomUrl
		? 'custom'
		: theme?.bodyFont === 'custom'
			? 'inter'
			: (theme?.bodyFont ?? 'inter')
const htmlClass =
	themeMode === 'dark' ? 'dark' : themeMode === 'light' ? '' : undefined
---

<!doctype html>
<html
	lang={lang}
	dir={dir}
	class={htmlClass}
	data-theme-mode={themeMode}
	data-site-theme={theme?.theme}
	data-site-base={theme?.baseColor}
	data-heading-font={headingFont}
	data-body-font={bodyFont}
	data-tenant-api-url={tenantApiUrl}
	data-app-url={appUrl}
	data-org-slug={orgSlug || undefined}
	data-custom-host={customHost || undefined}
	data-default-locale={defaultLocale}
>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link
			rel="stylesheet"
			href={siteFontsStylesheet}
			media="print"
			data-defer-stylesheet
		/>
		<noscript>
			<link rel="stylesheet" href={siteFontsStylesheet} />
		</noscript>
		<title>{title}</title>
		{description ? <meta name="description" content={description} /> : null}
		{noIndex ? <meta name="robots" content="noindex, nofollow" /> : null}
		{verificationMetaTags(siteVerification).map((tag) => (
			<meta name={tag.name} content={tag.content} />
		))}
		{canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : null}
		{alternateLinks.map((link) => (
			<link rel="alternate" hreflang={link.hrefLang} href={link.href} />
		))}
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		{description ? <meta property="og:description" content={description} /> : null}
		{imageUrl ? <meta property="og:image" content={imageUrl} /> : null}
		{canonicalUrl ? <meta property="og:url" content={canonicalUrl} /> : null}
		<meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={title} />
		{description ? <meta name="twitter:description" content={description} /> : null}
		{imageUrl ? <meta name="twitter:image" content={imageUrl} /> : null}
		<link rel="icon" href="/favicon.ico" sizes="any" />
		{
			siteIcon ? (
				<>
					<link rel="icon" type="image/png" sizes="32x32" href={siteIcon.favicon32} />
					<link rel="icon" type="image/png" sizes="16x16" href={siteIcon.favicon16} />
					<link rel="apple-touch-icon" sizes="180x180" href={siteIcon.appleTouchIcon} />
				</>
			) : null
		}
		<script is:inline set:html={SITES_BOOT_SCRIPT} />
		<style is:inline>
			html[data-customer-session] [data-auth='signed-out'] {
				display: none !important;
			}
			html:not([data-customer-session]) [data-auth='signed-in'] {
				display: none !important;
			}
		</style>
		<slot name="head" />
		{/*
			A scanned table code (`#table=…`) is a capability: move it out of the
			address bar before any analytics tag can read the page URL. The menu
			script picks it up from this tab's session storage.
		*/}
		<script is:inline>
			;(function () {
				try {
					var hash = window.location.hash
					if (hash.indexOf('table=') === -1) return
					var params = new URLSearchParams(hash.slice(1))
					var code = params.get('table')
					if (!code) return
					params.delete('table')
					var rest = params.toString()
					sessionStorage.setItem(
						'menuza_qr_scan',
						JSON.stringify({ code: code, at: Date.now() }),
					)
					history.replaceState(
						history.state,
						'',
						window.location.pathname +
							window.location.search +
							(rest ? '#' + rest : ''),
					)
				} catch (error) {}
			})()
		</script>
		{/*
			A cart reminder link (`#cart=…`, #150) is a capability too: move it out of
			the address bar before any analytics tag can read the page URL. The menu
			script reads it from this tab's session storage (never a query string).
		*/}
		<script is:inline>
			;(function () {
				try {
					var hash = window.location.hash
					if (hash.indexOf('cart=') === -1) return
					var params = new URLSearchParams(hash.slice(1))
					var token = params.get('cart')
					if (!token) return
					params.delete('cart')
					var rest = params.toString()
					sessionStorage.setItem('menuza_cart_token', token)
					history.replaceState(
						history.state,
						'',
						window.location.pathname +
							window.location.search +
							(rest ? '#' + rest : ''),
					)
				} catch (error) {}
			})()
		</script>
		{/*
			A test-order code (`#test=…`, #119) and a group order's join link
			(`#join=…`, #170) are capabilities as well: move them out of the address
			bar before any analytics tag can read the page URL. The menu and group
			scripts pick them up from this tab's session storage. The address is
			cleaned even when storage is blocked (the capability is then lost, which
			is better than leaking it).
		*/}
		<script is:inline>
			;(function () {
				try {
					var hash = window.location.hash
					if (hash.indexOf('test=') === -1 && hash.indexOf('join=') === -1) return
					var params = new URLSearchParams(hash.slice(1))
					var keys = { test: 'menuza_pending_test', join: 'menuza_pending_join' }
					var changed = false
					for (var name in keys) {
						var value = params.get(name)
						if (value === null) continue
						params.delete(name)
						changed = true
						try {
							if (value) sessionStorage.setItem(keys[name], value)
						} catch (error) {}
					}
					if (!changed) return
					var rest = params.toString()
					history.replaceState(
						history.state,
						'',
						window.location.pathname +
							window.location.search +
							(rest ? '#' + rest : ''),
					)
				} catch (error) {}
			})()
		</script>
		<SiteAnalyticsIntegrations
			facebookPixelId={facebookPixelId}
			googleTagManagerId={googleTagManagerId}
			googleAnalyticsId={googleAnalyticsId}
			tiktokPixelId={tiktokPixelId}
			consentMode={consentMode}
		/>
		{/* Inject after bundled CSS so org theme tokens win over any leftover defaults. */}
		{themeCss ? (
			<style is:inline set:html={themeCss} id="org-site-theme" />
		) : null}
		{customFontCss ? (
			<style is:inline set:html={customFontCss} id="org-site-fonts" />
		) : null}
	</head>
	<body class="min-h-dvh antialiased">
		<slot />
	</body>
</html>

<script>
	import { captureReferralFromPage } from '~/lib/loyalty/referral-storage'
	import { captureAttributionFromPage } from '~/lib/ordering/attribution'
	import { mountSiteInteractions } from '~/lib/site-interactions'

	captureReferralFromPage()
	// Where the guest came from (#115), kept in this browser for 7 days.
	captureAttributionFromPage()
	mountSiteInteractions()
</script>
