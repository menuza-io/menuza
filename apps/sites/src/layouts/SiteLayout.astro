---
import { buildCustomSiteFontFaceCss } from '@repo/common/site-fonts'
import { brand } from '@repo/config/brand'
import SiteAnalyticsIntegrations from '~/components/SiteAnalyticsIntegrations.astro'
import { resolveMediaUrl } from '~/lib/media'
import { type PublicSiteTheme } from '~/lib/org'
import '../styles/tailwind.css'
import siteFontsStylesheet from '../styles/site-fonts.css?url'

interface Props {
	title?: string
	description?: string
	imageUrl?: string | null
	canonicalUrl?: string
	alternateLinks?: Array<{ hrefLang: string; href: string }>
	noIndex?: boolean
	theme?: PublicSiteTheme
	lang?: string
	dir?: 'ltr' | 'rtl'
	siteIcon?: {
		favicon32: string
		favicon16: string
		appleTouchIcon: string
	} | null
	tenantApiUrl?: string
	appUrl?: string
	orgSlug?: string | null
	customHost?: string | null
	defaultLocale?: string
	facebookPixelId?: string | null
	googleTagManagerId?: string | null
	googleAnalyticsId?: string | null
	tiktokPixelId?: string | null
}

const {
	title = brand.name,
	description,
	imageUrl,
	canonicalUrl,
	noIndex = false,
	theme,
	lang = 'en',
	dir = 'ltr',
	siteIcon,
	tenantApiUrl,
	appUrl,
	orgSlug,
	customHost,
	defaultLocale = 'en',
	alternateLinks = [],
	facebookPixelId,
	googleTagManagerId,
	googleAnalyticsId,
	tiktokPixelId,
} = Astro.props
const themeMode = theme?.mode ?? 'system'
const themeCss = theme?.css ?? ''
const headingCustomUrl = resolveMediaUrl(theme?.headingCustomFont?.url)
const bodyCustomUrl = resolveMediaUrl(theme?.bodyCustomFont?.url)
const customFontCss = buildCustomSiteFontFaceCss({
	headingUrl: headingCustomUrl,
	headingFormat: theme?.headingCustomFont?.format,
	bodyUrl: bodyCustomUrl,
	bodyFormat: theme?.bodyCustomFont?.format,
})
const headingFont =
	theme?.headingFont === 'custom' && headingCustomUrl
		? 'custom'
		: theme?.headingFont === 'custom'
			? 'inter'
			: (theme?.headingFont ?? 'inter')
const bodyFont =
	theme?.bodyFont === 'custom' && bodyCustomUrl
		? 'custom'
		: theme?.bodyFont === 'custom'
			? 'inter'
			: (theme?.bodyFont ?? 'inter')
const htmlClass =
	themeMode === 'dark' ? 'dark' : themeMode === 'light' ? '' : undefined
---

<!doctype html>
<html
	lang={lang}
	dir={dir}
	class={htmlClass}
	data-site-theme={theme?.theme}
	data-site-base={theme?.baseColor}
	data-heading-font={headingFont}
	data-body-font={bodyFont}
	data-tenant-api-url={tenantApiUrl}
	data-app-url={appUrl}
	data-org-slug={orgSlug || undefined}
	data-custom-host={customHost || undefined}
	data-default-locale={defaultLocale}
>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link
			rel="stylesheet"
			href={siteFontsStylesheet}
			media="print"
			onload="this.setAttribute('media','all')"
		/>
		<noscript>
			<link rel="stylesheet" href={siteFontsStylesheet} />
		</noscript>
		<title>{title}</title>
		{description ? <meta name="description" content={description} /> : null}
		{noIndex ? <meta name="robots" content="noindex, nofollow" /> : null}
		{canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : null}
		{alternateLinks.map((link) => (
			<link rel="alternate" hreflang={link.hrefLang} href={link.href} />
		))}
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		{description ? <meta property="og:description" content={description} /> : null}
		{imageUrl ? <meta property="og:image" content={imageUrl} /> : null}
		{canonicalUrl ? <meta property="og:url" content={canonicalUrl} /> : null}
		<meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={title} />
		{description ? <meta name="twitter:description" content={description} /> : null}
		{imageUrl ? <meta name="twitter:image" content={imageUrl} /> : null}
		<link rel="icon" href="/favicon.ico" sizes="any" />
		{
			siteIcon ? (
				<>
					<link rel="icon" type="image/png" sizes="32x32" href={siteIcon.favicon32} />
					<link rel="icon" type="image/png" sizes="16x16" href={siteIcon.favicon16} />
					<link rel="apple-touch-icon" sizes="180x180" href={siteIcon.appleTouchIcon} />
				</>
			) : null
		}
		{
			themeMode === 'system' ? (
				<script is:inline>
					;(function () {
						try {
							const prefersDark = window.matchMedia(
								'(prefers-color-scheme: dark)',
							).matches
							document.documentElement.classList.toggle('dark', prefersDark)
						} catch {
							/* ignore */
						}
					})()
				</script>
			) : null
		}
		<script is:inline>
			;(function () {
				try {
					if (localStorage.getItem('tenant_access_token')) {
						document.documentElement.dataset.customerSession = '1'
					}
				} catch {
					/* ignore */
				}
			})()
		</script>
		<style is:inline>
			html[data-customer-session] [data-auth='signed-out'] {
				display: none !important;
			}
			html:not([data-customer-session]) [data-auth='signed-in'] {
				display: none !important;
			}
		</style>
		<slot name="head" />
		<SiteAnalyticsIntegrations
			facebookPixelId={facebookPixelId}
			googleTagManagerId={googleTagManagerId}
			googleAnalyticsId={googleAnalyticsId}
			tiktokPixelId={tiktokPixelId}
		/>
		{/* Inject after bundled CSS so org theme tokens win over any leftover defaults. */}
		{themeCss ? (
			<style is:inline set:html={themeCss} id="org-site-theme" />
		) : null}
		{customFontCss ? (
			<style is:inline set:html={customFontCss} id="org-site-fonts" />
		) : null}
	</head>
	<body class="min-h-dvh antialiased">
		<slot />
	</body>
</html>
