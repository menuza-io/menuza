---
import { msg } from '@lingui/core/macro'
import ReservationLabels from '~/components/reservations/ReservationLabels.astro'
import SitePage from '~/components/SitePage.astro'
import { siteContainer } from '~/lib/media'

interface Props {
	done?: boolean
}

const { done = false } = Astro.props
const organization = Astro.locals.organization
const i18n = Astro.locals.i18n

if (!organization) {
	return new Response('Not Found', { status: 404, statusText: 'Not Found' })
}

// Payment links keep working while online booking is paused: the page holds no
// guest data, and the App refuses anything the restaurant has switched off.
const heading = i18n._(msg`Complete your payment`)
const loading = i18n._(msg`Loading…`)
---

<SitePage
	organization={organization}
	page={{ id: 'reserve-pay', title: heading, slug: 'reserve/pay', isHomePage: false, sections: [] }}
	title={`${heading} - ${organization.name}`}
	noIndex
>
	<ReservationLabels />
	<div class:list={[siteContainer, 'pb-16 sm:pb-20']}>
		<header class="pt-6 pb-6 sm:pt-10 sm:pb-8">
			<h1 class="text-3xl font-bold leading-tight tracking-tight text-balance text-foreground sm:text-4xl">
				{heading}
			</h1>
		</header>
		<div id="pay-root" class="flex max-w-3xl flex-col gap-6" data-done={done ? 'true' : 'false'}>
			<p class="text-sm text-muted-foreground">{loading}</p>
		</div>
	</div>
	<script>
		import '~/scripts/pay-page.ts'
	</script>
</SitePage>
