---
import { resolveSiteLink, type SiteLinkInput } from '@repo/common/site-link'
import { getLocaleHref } from '@repo/common/site-locales'

interface Props {
	link: SiteLinkInput
	class?: string
	'aria-current'?: 'page'
	title?: string
}

const {
	link,
	class: className,
	'aria-current': ariaCurrent,
	title,
} = Astro.props
const resolved = resolveSiteLink(link)
resolved.href = getLocaleHref(
	resolved.href,
	Astro.locals.requestedLocale,
	Astro.locals.requestedLocale,
	Astro.locals.defaultLocale,
)
---

<a
	href={resolved.href}
	class={className}
	target={resolved.target}
	rel={resolved.rel}
	aria-current={ariaCurrent}
	title={title}
>
	<slot />
</a>
