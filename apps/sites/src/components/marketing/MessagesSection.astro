---
import { msg } from '@lingui/core/macro'
import { marketingConsentTextVersion } from '@repo/common/marketing-consent'
import { translate } from '~/lib/ordering-labels'

/**
 * "Messages from <Restaurant>": one switch per channel for each kind of
 * message. Rendered without any guest data; the browser loads the
 * subscriptions from tenant-api after sign-in and each switch writes straight
 * back (optimistic, rolled back on an error).
 *
 * EDITORS: the offers row carries the consent wording (switch labels, the
 * frequency line and, outside KSA, the rates/STOP line). When that wording
 * changes, bump `MARKETING_CONSENT_TEXT_VERSIONS.profile` and
 * `.profileDisclosure` in `@repo/common/marketing-consent`. Only the offers
 * topic sends a version (`data-text-version-marketing`); the reservation news
 * row sits outside that wording, so it sends none.
 *
 * KSA sends no marketing texts: the offers Text switch is rendered hidden and
 * the browser shows it only for a guest who already has an active text
 * subscription, so they can turn it off.
 */
interface Props {
	/** Show the reservation news row (only while online booking is on). */
	reservations?: boolean
	class?: string
}

const { reservations = false, class: className } = Astro.props
const i18n = Astro.locals.i18n
const org = Astro.locals.organization?.name ?? ''
const ksa = Astro.locals.organization?.dataRegion === 'ksa'
const textVersion = marketingConsentTextVersion('profile', !ksa)

const topicLabels = {
	marketing: i18n._(msg`Offers and news`),
	reservations: i18n._(msg`Reservation news`),
}
const channelLabels = { email: i18n._(msg`Email`), sms: i18n._(msg`Text`) }
const topics = [
	'marketing',
	...(reservations ? (['reservations'] as const) : []),
] as const
const channels = ['email', 'sms'] as const

const labels = {
	title: translate(i18n, msg`Messages from {org}`, { org }),
	hint: i18n._(msg`Choose what you hear from us, and how.`),
	note: i18n._(msg`Turning a switch off never affects receipts or booking confirmations.`),
	pending: i18n._(msg`Check your inbox to confirm`),
	needsEmail: i18n._(msg`Add an email address first`),
	needsPhone: i18n._(msg`Verify your phone first`),
	error: i18n._(msg`We couldn't save that. Try again.`),
	frequency: i18n._(msg`A few messages a month. You can opt out anytime.`),
	rates: i18n._(msg`Msg and data rates may apply. Reply STOP to opt out.`),
}
const ariaLabel = (topic: keyof typeof topicLabels, channel: (typeof channels)[number]) =>
	translate(i18n, msg`{topic}: {channel}`, {
		topic: topicLabels[topic],
		channel: channelLabels[channel],
	})
---

<section
	data-auth="signed-in"
	data-messages
	data-label-pending={labels.pending}
	data-label-needs-email={labels.needsEmail}
	data-label-needs-phone={labels.needsPhone}
	data-label-error={labels.error}
	data-text-version-marketing={textVersion}
	data-ksa={ksa ? 'true' : undefined}
	aria-labelledby="messages-title"
	hidden
	class:list={['surface w-full p-6 sm:p-8', className]}
>
	<div class="mb-4 space-y-1">
		<h2 id="messages-title" class="font-heading text-lg text-foreground">{labels.title}</h2>
		<p class="text-sm text-muted-foreground">{labels.hint}</p>
	</div>
	<ul class="divide-y divide-border">
		{topics.map((topic) => (
			<li class="py-3 first:pt-0" data-topic={topic}>
				<p class="text-sm font-semibold text-foreground">{topicLabels[topic]}</p>
				<div class="mt-2 flex flex-wrap gap-x-6 gap-y-2">
					{channels.map((channel) => (
						<div
							class="flex items-center gap-3"
							data-switch-row
							hidden={ksa && topic === 'marketing' && channel === 'sms'}
						>
							<button
								type="button"
								role="switch"
								aria-checked="false"
								aria-label={ariaLabel(topic, channel)}
								data-topic={topic}
								data-channel={channel}
								disabled
								class="group focus-ring relative inline-flex h-6 w-11 shrink-0 items-center rounded-full bg-muted transition-colors duration-150 ease-out aria-checked:bg-primary disabled:opacity-50 aria-disabled:opacity-50 motion-reduce:transition-none"
							>
								<span class="ms-0.5 size-5 rounded-full bg-background shadow-elev-1 transition-transform duration-150 ease-out group-aria-checked:translate-x-5 rtl:group-aria-checked:-translate-x-5 motion-reduce:transition-none" />
							</button>
							<span class="text-sm text-foreground" aria-hidden="true">{channelLabels[channel]}</span>
						</div>
					))}
				</div>
				{topic === 'marketing' ? (
					<p class="mt-2 text-xs text-pretty text-muted-foreground">
						{labels.frequency}
						{ksa ? '' : ` ${labels.rates}`}
					</p>
				) : null}
				<p data-status role="status" class="mt-2 text-xs text-muted-foreground empty:hidden"></p>
			</li>
		))}
	</ul>
	<p class="mt-4 text-xs text-pretty text-muted-foreground">{labels.note}</p>
</section>

<script>
	import { mountMessagesSection } from '~/lib/messages-section-client'

	for (const root of document.querySelectorAll<HTMLElement>('[data-messages]')) {
		void mountMessagesSection(root)
	}
</script>
