---
interface Props {
	facebookPixelId?: string | null
	googleTagManagerId?: string | null
	googleAnalyticsId?: string | null
	tiktokPixelId?: string | null
}

const {
	facebookPixelId,
	googleTagManagerId,
	googleAnalyticsId,
	tiktokPixelId,
} = Astro.props
const facebookEnabled = Boolean(
	facebookPixelId && /^\d{5,20}$/.test(facebookPixelId),
)
const tagManagerEnabled = Boolean(
	googleTagManagerId && /^GTM-[A-Z0-9]+$/.test(googleTagManagerId),
)
const googleAnalyticsEnabled = Boolean(
	googleAnalyticsId && /^G-[A-Z0-9]+$/.test(googleAnalyticsId),
)
const tiktokEnabled = Boolean(
	tiktokPixelId && /^[A-Z0-9]{10,30}$/.test(tiktokPixelId),
)
const safeJson = (value: string | null | undefined) =>
	JSON.stringify(value ?? '').replace(/</g, '\\u003c')
const googleAnalyticsScriptUrl = `https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`
---

<div
	hidden
	data-site-pixels
	data-facebook-pixel={facebookEnabled ? facebookPixelId : undefined}
	data-tiktok-pixel={tiktokEnabled ? tiktokPixelId : undefined}
	data-google-tag-manager={tagManagerEnabled ? googleTagManagerId : undefined}
/>
<script>
	import { bootSitePixels } from '~/lib/site-pixels'

	const node = document.querySelector('[data-site-pixels]')
	if (node instanceof HTMLElement) bootSitePixels(node)
</script>
{
	googleAnalyticsEnabled && (
		<>
			<script is:inline type="text/partytown" src={googleAnalyticsScriptUrl} />
			<script
				is:inline
				type="text/partytown"
				set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config',${safeJson(googleAnalyticsId)});`}
			/>
		</>
	)
}
