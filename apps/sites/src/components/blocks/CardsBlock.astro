---
import { resolveSiteLink, siteLinkHasDestination } from '@repo/common/site-link'
import { getLocaleHref } from '@repo/common/site-locales'
import {
	resolveMediaUrl,
	siteContainer,
	siteSection,
	siteSectionBackground,
	siteSectionBodyClass,
	siteSectionHeadingClass,
} from '~/lib/media'

interface CardItem {
	title?: string
	description?: string
	imageUrl?: string
	linkUrl?: unknown
	ctaLabel?: string
}

interface Props {
	config: {
		title?: string
		background?: 'none' | 'muted' | 'inverted'
		items?: CardItem[]
	}
}

const { config } = Astro.props
const items = Array.isArray(config.items) ? config.items : []
const background = siteSectionBackground(config.background)
const headingClass = siteSectionHeadingClass(config.background)
const bodyClass = siteSectionBodyClass(config.background)
---

<section class:list={[siteSection, background]}>
	<div class={siteContainer}>
		{config.title ? (
			<h2 class:list={['mb-10 text-3xl font-bold tracking-tight sm:text-4xl', headingClass]}>
				{config.title}
			</h2>
		) : null}

		<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{items.map((item) => {
				const src = resolveMediaUrl(item.imageUrl)
				const linked = siteLinkHasDestination(item.linkUrl)
				const resolved = resolveSiteLink(item.linkUrl)
				resolved.href = getLocaleHref(
					resolved.href,
					Astro.locals.requestedLocale,
					Astro.locals.requestedLocale,
					Astro.locals.defaultLocale,
				)
				const inner = (
					<>
						{src ? (
							<div class="aspect-[4/3] overflow-hidden rounded-[calc(var(--radius)+8px)] bg-muted">
								<img
									src={src}
									alt={item.title || ''}
									class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
									loading="lazy"
								/>
							</div>
						) : null}
						<div class="pt-4">
							{item.title ? (
								<h3 class:list={['text-lg tracking-tight', headingClass]}>
									{item.title}
								</h3>
							) : null}
							{item.description ? (
								<p class:list={['mt-2 text-sm leading-relaxed', bodyClass]}>
									{item.description}
								</p>
							) : null}
							{item.ctaLabel ? (
								<p class:list={['mt-3 text-sm', config.background === 'inverted' ? headingClass : 'text-primary']}>{item.ctaLabel}</p>
							) : null}
						</div>
					</>
				)

				return linked ? (
					<a
						href={resolved.href}
						class="group block overflow-hidden no-underline"
						target={resolved.target}
						rel={resolved.rel}
					>
						{inner}
					</a>
				) : (
					<div class="group overflow-hidden">{inner}</div>
				)
			})}
		</div>
	</div>
</section>
