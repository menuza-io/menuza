---
import { locationOffersOrdering } from '@repo/common/restaurant-sections'
import SectionBlock from './SectionBlock.astro'
import {
	fetchPublishedReservations,
	fetchPublishedSiteMenu,
	type PublicWebsitePageSection,
} from '~/lib/org'

interface Props {
	sections: PublicWebsitePageSection[]
	/** The running A/B test of this page, if any (#338). */
	experiment?: { id: string; sectionId: string; variantConfig: unknown } | null
}

const { sections, experiment = null } = Astro.props
const bodySections = sections.filter(
	(section) => section.type !== 'header' && section.type !== 'footer',
)
const needsLive = bodySections.some((section) => {
	if (section.type === 'menuHighlights' || section.type === 'locationsHours' || section.type === 'contact') {
		return true
	}
	if (section.type !== 'hero') return false
	const links = (section.config as { links?: Array<{ when?: string }> } | undefined)?.links
	return Array.isArray(links) && links.some((link) => link?.when)
})
const menu = needsLive
	? await fetchPublishedSiteMenu({
			slug: Astro.locals.orgSlug,
			host: Astro.locals.customHost,
			lng: Astro.locals.requestedLocale,
		})
	: null
const reservations = needsLive
	? await fetchPublishedReservations({
			slug: Astro.locals.orgSlug,
			host: Astro.locals.customHost,
		})
	: null
const features = {
	ordering: (menu?.locations ?? []).some(
		(location) =>
			locationOffersOrdering(location.fulfillmentOptions) &&
			(menu?.menus?.length ?? 0) > 0,
	),
	reservations: reservations?.online === true,
}
---

<div class="flex flex-col">
	{bodySections.map((section) =>
		experiment && experiment.sectionId === section.id ? (
			// A/B test (#338): the original renders as usual and is what crawlers
			// and scriptless visitors get. Variant B waits in an inert template; the
			// browser picks the visitor's arm and swaps it in before first paint
			// (`data-exp` hides the wrapper until then, with a CSS timeout so a
			// blocked script can never leave the section hidden).
			<div data-exp={experiment.id} data-exp-pending class="exp-wrap">
				<div data-exp-arm="a">
					<SectionBlock type={section.type} id={section.id} config={section.config} menu={menu} features={features} />
				</div>
				<template data-exp-arm="b">
					<SectionBlock type={section.type} id={section.id} config={experiment.variantConfig} menu={menu} features={features} />
				</template>
			</div>
		) : (
			<SectionBlock type={section.type} id={section.id} config={section.config} menu={menu} features={features} />
		),
	)}
</div>

<style is:global>
	.exp-wrap[data-exp-pending] {
		visibility: hidden;
		animation: exp-reveal 0s 1.5s forwards;
	}
	@keyframes exp-reveal {
		to {
			visibility: visible;
		}
	}
</style>

{
	experiment ? (
		<script>
			import { applyExperiments } from '~/lib/site-experiments-client'

			applyExperiments()
		</script>
	) : null
}
