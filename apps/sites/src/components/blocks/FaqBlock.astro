---
import {
	siteContainer,
	siteSection,
	siteSectionBackground,
	siteSectionBodyClass,
	siteSectionBorderClass,
	siteSectionDividerClass,
	siteSectionHeadingClass,
} from '~/lib/media'

interface FaqItem {
	question?: string
	answer?: string
}

interface Props {
	config: {
		title?: string
		subtitle?: string
		background?: 'none' | 'muted' | 'inverted'
		items?: FaqItem[]
	}
}

const { config } = Astro.props
const items = Array.isArray(config.items) ? config.items : []
const background = siteSectionBackground(config.background)
const headingClass = siteSectionHeadingClass(config.background)
const bodyClass = siteSectionBodyClass(config.background)
const borderClass = siteSectionBorderClass(config.background)
const dividerClass = siteSectionDividerClass(config.background)
---

<section class:list={[siteSection, background]}>
	<div class:list={[siteContainer, 'max-w-3xl']}>
		{(config.title || config.subtitle) ? (
			<div class="mb-10 text-center">
				{config.title ? (
					<h2 class:list={['text-3xl font-bold tracking-tight sm:text-4xl', headingClass]}>
						{config.title}
					</h2>
				) : null}
				{config.subtitle ? (
					<p class:list={['mt-3 text-base', bodyClass]}>{config.subtitle}</p>
				) : null}
			</div>
		) : null}

		<div class:list={['divide-y border-y', dividerClass, borderClass]}>
			{items.map((item) => (
				<details data-site-disclosure class="t-acc group py-1">
					<summary class:list={['focus-ring flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 rounded-[var(--radius)] py-4 text-start text-base font-medium marker:content-none [&::-webkit-details-marker]:hidden', headingClass]}>
						<span>{item.question}</span>
						<svg
							class:list={['t-acc-chevron size-4 shrink-0', bodyClass]}
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="m6 9 6 6 6-6"></path>
						</svg>
					</summary>
					<div class="t-acc-panel">
						<div class="t-acc-panel-inner">
							<p class:list={['max-w-prose pb-5 pe-8 text-sm leading-relaxed', bodyClass]}>{item.answer}</p>
						</div>
					</div>
				</details>
			))}
		</div>
	</div>
</section>
