---
import { pickLocalized } from '@repo/common/site-locales'
import {
	dishPriceAtLocation,
	highlightShowsFromPrice,
	resolveMenuHighlights,
	type CatalogDish,
} from '@repo/common/restaurant-sections'
import { msg } from '@lingui/core/macro'
import { formatMoney } from '~/lib/ordering/money'
import { resolveMediaUrl, siteContainer, siteSection } from '~/lib/media'
import type { PublicSiteMenuPayload } from '~/lib/org'

interface Props {
	config: Record<string, unknown>
	menu: PublicSiteMenuPayload | null
}

const { config, menu } = Astro.props
const locale = Astro.locals.requestedLocale || menu?.organization.defaultLocale || 'en'
const defaultLocale = menu?.organization.defaultLocale || Astro.locals.defaultLocale || 'en'
const i18n = Astro.locals.i18n
const orderLabel = i18n?._(msg`Order`) ?? 'Order'
const fromLabel = i18n?._(msg`from`) ?? 'from'

const defaultLocation =
	menu?.locations.find((location) => location.isDefault) ?? menu?.locations[0]
const currency = defaultLocation?.currency || menu?.organization.currency || 'USD'
const overrides = defaultLocation
	? (menu?.locationOverrides?.[defaultLocation.id] ?? [])
	: []

function nameOf(value: string | null | undefined) {
	return pickLocalized(value ?? '', locale, defaultLocale)
}

const dishes: CatalogDish[] = []
for (const group of menu?.menus ?? []) {
	for (const category of group.categories ?? []) {
		for (const item of category.items ?? []) {
			const override = overrides.find(
				(row) => row.entityType === 'item' && row.entityId === item.id,
			)
			const unavailable =
				item.availabilityStatus === 'hidden' ||
				item.availabilityStatus === 'unavailable' ||
				override?.isEnabled === false ||
				override?.availabilityStatus === 'hidden' ||
				override?.availabilityStatus === 'unavailable'
			dishes.push({
				id: item.id,
				name: nameOf(item.displayName),
				description: nameOf(item.description),
				price: dishPriceAtLocation(item.price, override?.price),
				currency,
				imageUrl: resolveMediaUrl(item.imageUrl),
				categoryIds: [category.id],
				isPopular: item.isPopular,
				availability: unavailable ? 'unavailable' : 'available',
				hasOptions:
					(item.modifierGroups?.length ?? 0) > 0 ||
					(item.variations?.variants?.length ?? 0) > 0,
			})
		}
	}
}

const cards = resolveMenuHighlights(config, dishes)
const layout = config.layout === 'grid' ? 'grid' : 'row'
const heading = typeof config.heading === 'string' ? config.heading : ''
const subtitle = typeof config.subtitle === 'string' ? config.subtitle : ''
---

{cards.length > 0 ? (
	<section class={siteSection} data-menu-highlights>
		<div class={siteContainer}>
			{heading ? <h2 class="text-3xl font-bold tracking-tight text-foreground">{heading}</h2> : null}
			{subtitle ? <p class="mt-2 text-muted-foreground">{subtitle}</p> : null}
			<div class:list={['mt-8', layout === 'grid' ? 'grid gap-4 sm:grid-cols-2 lg:grid-cols-3' : 'flex gap-4 overflow-x-auto']}>
				{cards.map((card) => (
					<article class:list={['surface flex flex-col overflow-hidden', layout === 'row' && 'w-64 shrink-0']}>
						{card.imageUrl ? (
							<img src={card.imageUrl} alt="" width="640" height="480" class="aspect-[4/3] w-full object-cover" loading="lazy" />
						) : null}
						<div class="flex flex-1 flex-col p-4">
							<h3 class="text-lg font-semibold text-foreground">{card.name}</h3>
							{card.description ? <p class="mt-1 text-sm text-muted-foreground">{card.description}</p> : null}
							<p class="mt-3 text-sm font-medium text-foreground">
								{highlightShowsFromPrice(card) ? <span>{fromLabel} </span> : null}
								{formatMoney(card.price, card.currency, locale)}
							</p>
							<a class="btn-cta mt-4" href={`/menu?item=${encodeURIComponent(card.id)}`}>{orderLabel}</a>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>
) : null}
