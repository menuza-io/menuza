---
import {
	siteContainer,
	siteSection,
	siteSectionBackground,
	siteSectionBodyClass,
	siteSectionHeadingClass,
} from '~/lib/media'

interface FeatureItem {
	title?: string
	description?: string
}

interface Props {
	config: {
		title?: string
		subtitle?: string
		background?: 'none' | 'muted' | 'inverted'
		items?: FeatureItem[]
	}
}

const { config } = Astro.props
const items = Array.isArray(config.items) ? config.items : []
const background = siteSectionBackground(config.background)
const headingClass = siteSectionHeadingClass(config.background)
const bodyClass = siteSectionBodyClass(config.background)
---

<section class:list={[siteSection, background]}>
	<div class={siteContainer}>
		{(config.title || config.subtitle) ? (
			<div class="mx-auto mb-12 max-w-2xl text-center">
				{config.title ? (
					<h2 class:list={['text-3xl font-bold tracking-tight sm:text-4xl', headingClass]}>
						{config.title}
					</h2>
				) : null}
				{config.subtitle ? (
					<p class:list={['mt-3 text-base', bodyClass]}>{config.subtitle}</p>
				) : null}
			</div>
		) : null}

		<div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
			{items.map((item) => (
				<div>
					<h3 class:list={['text-xl tracking-tight', headingClass]}>{item.title}</h3>
					{item.description ? (
						<p class:list={['mt-3 text-sm leading-relaxed', bodyClass]}>
							{item.description}
						</p>
					) : null}
				</div>
			))}
		</div>
	</div>
</section>
