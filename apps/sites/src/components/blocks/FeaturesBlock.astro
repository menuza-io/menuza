---
import {
	siteContainer,
	siteSection,
	siteSectionBackground,
	siteSectionBodyClass,
	siteSectionHeadingClass,
} from '~/lib/media'

interface FeatureItem {
	title?: string
	description?: string
	icon?: string
}

const ICONS: Record<string, string> = {
	utensils: '<path d="M4 3v8a2 2 0 0 0 2 2h0"/><path d="M6 3v18"/><path d="M10 3v6"/><path d="M14 3c0 6 4 6 4 10v8"/><path d="M14 13h4"/>',
	clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v6l4 2"/>',
	pin: '<path d="M12 21s7-6 7-11a7 7 0 1 0-14 0c0 5 7 11 7 11z"/><circle cx="12" cy="10" r="2"/>',
	star: '<path d="m12 3 2.5 5.5L20 9.5l-4 4 1 6L12 16.5 7 19.5l1-6-4-4 5.5-1z"/>',
	truck: '<path d="M3 7h11v8H3z"/><path d="M14 10h4l3 3v2h-7z"/><circle cx="7" cy="17" r="1.5"/><circle cx="17" cy="17" r="1.5"/>',
	leaf: '<path d="M5 19c8 0 14-8 14-14-6 0-14 6-14 14z"/><path d="M8 16c2-3 5-6 9-8"/>',
	heart: '<path d="M12 19s-7-4.4-7-9a4 4 0 0 1 7-2 4 4 0 0 1 7 2c0 4.6-7 9-7 9z"/>',
	phone: '<path d="M8 3h3l1 4-2 1a12 12 0 0 0 6 6l1-2 4 1v3a2 2 0 0 1-2 2A15 15 0 0 1 6 5a2 2 0 0 1 2-2z"/>',
}

interface Props {
	config: {
		title?: string
		subtitle?: string
		background?: 'none' | 'muted' | 'inverted'
		items?: FeatureItem[]
	}
}

const { config } = Astro.props
const items = Array.isArray(config.items) ? config.items : []
const background = siteSectionBackground(config.background)
const headingClass = siteSectionHeadingClass(config.background)
const bodyClass = siteSectionBodyClass(config.background)
---

<section class:list={[siteSection, background]}>
	<div class={siteContainer}>
		{(config.title || config.subtitle) ? (
			<div class="mx-auto mb-12 max-w-2xl text-center">
				{config.title ? (
					<h2 class:list={['text-3xl font-bold tracking-tight sm:text-4xl', headingClass]}>
						{config.title}
					</h2>
				) : null}
				{config.subtitle ? (
					<p class:list={['mt-3 text-base', bodyClass]}>{config.subtitle}</p>
				) : null}
			</div>
		) : null}

		<div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
			{items.map((item) => (
				<div>
					{item.icon && ICONS[item.icon] ? (
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="mb-3 size-6 text-primary" aria-hidden="true" set:html={ICONS[item.icon]} />
					) : null}
					<h3 class:list={['text-xl tracking-tight', headingClass]}>{item.title}</h3>
					{item.description ? (
						<p class:list={['mt-3 text-sm leading-relaxed', bodyClass]}>
							{item.description}
						</p>
					) : null}
				</div>
			))}
		</div>
	</div>
</section>
