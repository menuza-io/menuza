---
import { msg } from '@lingui/core/macro'
import { visibleHeroLinks } from '@repo/common/restaurant-sections'
import { heroSlideshow, heroSlides, HERO_SLIDE_SECONDS } from '@repo/common/site-motion'
import SiteAnchor from '~/components/SiteAnchor.astro'
import {
	resolveImageSrcSet,
	resolveMediaUrl,
	siteButtonClass,
} from '~/lib/media'

interface Link {
	url?: unknown
	link?: { label?: string }
	variant?: 'primary' | 'secondary'
}

interface Props {
	config: {
		heading?: string
		subheading?: string
		links?: Link[]
		assetType?: 'none' | 'image' | 'video'
		assetPosition?: string
		textPosition?: 'left' | 'center'
		overlay?: 'none' | 'dark' | 'gradient'
		minHeight?: number
		imageUrl?: string
		media?: { url?: string; alt?: string }
		videoSrc?: string
		videoAutoPlay?: boolean
		videoLoop?: boolean
		videoMuted?: boolean
		videoControls?: boolean
		slides?: Array<{ url?: string; alt?: string }>
	}
	features?: { ordering: boolean; reservations: boolean }
}

const { config, features = { ordering: false, reservations: false } } = Astro.props
const {
	heading,
	subheading,
	links = [],
	assetType = 'image',
	textPosition = 'left',
	overlay = 'dark',
	minHeight = 560,
	imageUrl,
	media,
	videoSrc,
	videoAutoPlay = true,
	videoLoop = true,
	videoMuted = true,
	videoControls = false,
} = config

const slides = heroSlides({ slides: config.slides, imageUrl, media })
	.map((slide) => ({
		...slide,
		src: resolveMediaUrl(slide.url),
		srcSet: resolveImageSrcSet(slide.url),
	}))
	.filter((slide) => slide.src)
const slideshow = heroSlideshow(slides)
const imageSrc = slides[0]?.src ?? null
const imageSrcSet = slides[0]?.srcSet
const videoUrl = resolveMediaUrl(videoSrc)
const hasMedia =
	(assetType === 'image' && slides.length > 0) ||
	(assetType === 'video' && Boolean(videoUrl))
const isCentered = textPosition === 'center'
const visibleLinks = visibleHeroLinks(links, features)
const primary = visibleLinks[0]
const secondary = visibleLinks[1]
const pauseLabel = Astro.locals.i18n?._(msg`Pause slideshow`) ?? 'Pause slideshow'
const slideSeconds = slides.length * HERO_SLIDE_SECONDS
---

<section
	class="relative isolate flex w-full overflow-hidden"
	style={`min-height: ${Math.max(minHeight, 320)}px;`}
	data-hero-slideshow={slideshow ? '' : undefined}
>
	{hasMedia && assetType === 'image' && slides.length > 0 ? (
		slides.map((slide, index) => (
			<img
				src={slide.src!}
				srcset={slide.srcSet || undefined}
				alt={slide.alt || (index === 0 ? heading || '' : '')}
				width="1920"
				height="1080"
				sizes="100vw"
				class:list={['hero-slide absolute inset-0 size-full object-cover', slideshow && 'hero-slide-animate']}
				style={slideshow ? `animation-duration: ${slideSeconds}s; animation-delay: ${index * HERO_SLIDE_SECONDS}s;` : undefined}
				loading={index === 0 ? 'eager' : 'lazy'}
				decoding="async"
				fetchpriority={index === 0 ? 'high' : 'low'}
			/>
		))
	) : null}
	{slideshow ? (
		<button type="button" class="hero-pause" data-hero-pause aria-pressed="false">
			{pauseLabel}
		</button>
	) : null}

	{hasMedia && assetType === 'video' && videoUrl ? (
		<video
			class="absolute inset-0 size-full object-cover"
			src={videoUrl}
			autoplay={videoAutoPlay}
			loop={videoLoop}
			muted={videoMuted}
			controls={videoControls}
			playsinline
		/>
	) : null}

	{!hasMedia ? (
		<div class="absolute inset-0 bg-primary" aria-hidden="true"></div>
	) : null}

	{hasMedia && overlay === 'dark' ? (
		<div class="absolute inset-0 bg-black/65" aria-hidden="true"></div>
	) : hasMedia && overlay === 'gradient' ? (
		<div
			class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/50 to-black/25"
			aria-hidden="true"
		></div>
	) : null}

	<div
		class:list={[
			'relative z-10 mx-auto flex w-full max-w-6xl flex-1 flex-col px-5 py-16 sm:px-8 sm:py-24',
			isCentered ? 'items-center justify-center text-center' : 'items-start justify-end',
		]}
	>
		{subheading ? (
			<p
				class:list={[
					'mb-3 max-w-xl text-sm font-medium tracking-wide sm:text-base',
					hasMedia ? 'text-white' : 'text-primary-foreground',
				]}
			>
				{subheading}
			</p>
		) : null}
		{heading ? (
			<h1
				class:list={[
					'max-w-3xl text-4xl font-bold tracking-tight text-balance sm:text-6xl',
					hasMedia ? 'text-white' : 'text-primary-foreground',
				]}
			>
				{heading}
			</h1>
		) : null}
		{(primary?.link?.label || secondary?.link?.label) ? (
			<div
				class:list={[
					'mt-8 flex flex-wrap gap-3',
					isCentered && 'justify-center',
				]}
			>
				{primary?.link?.label ? (
					<SiteAnchor
						link={primary.url}
						class={siteButtonClass(primary.variant, 'primary')}
					>
						{primary.link.label}
					</SiteAnchor>
				) : null}
				{secondary?.link?.label ? (
					<SiteAnchor
						link={secondary.url}
						class={siteButtonClass(secondary.variant, 'secondary')}
					>
						{secondary.link.label}
					</SiteAnchor>
				) : null}
			</div>
		) : null}
	</div>
</section>

<style>
	.hero-slide-animate {
		opacity: 0;
		animation-name: hero-fade;
		animation-timing-function: ease-in-out;
		animation-iteration-count: infinite;
	}
	@keyframes hero-fade {
		0% { opacity: 0; }
		6% { opacity: 1; }
		28% { opacity: 1; }
		34% { opacity: 0; }
		100% { opacity: 0; }
	}
	.hero-pause {
		position: absolute;
		inset-inline-end: 1rem;
		bottom: 1rem;
		z-index: 20;
		min-height: 2.75rem;
		border-radius: var(--radius);
		background: rgb(0 0 0 / 0.55);
		color: white;
		padding-inline: 0.75rem;
	}
	[data-hero-slideshow]:hover .hero-slide-animate,
	[data-hero-slideshow]:focus-within .hero-slide-animate,
	[data-hero-slideshow][data-paused] .hero-slide-animate {
		animation-play-state: paused;
	}
	@media (prefers-reduced-motion: reduce) {
		.hero-slide-animate {
			animation: none;
			opacity: 0;
		}
		.hero-slide-animate:first-child {
			opacity: 1;
		}
	}
</style>

<script>
	for (const root of document.querySelectorAll<HTMLElement>('[data-hero-slideshow]')) {
		const button = root.querySelector<HTMLButtonElement>('[data-hero-pause]')
		button?.addEventListener('click', () => {
			const paused = root.toggleAttribute('data-paused')
			button.setAttribute('aria-pressed', paused ? 'true' : 'false')
		})
	}
</script>
