---
import { msg } from '@lingui/core/macro'

/**
 * Location → date → time slot chooser for a live drop. This is the labeled
 * shell; the chips are rendered client-side by the drop page script because
 * slot availability depends on the live clock and on the stored selection.
 *
 * Steps with a single option are collapsed (auto-selected) by the client
 * script, mirroring the "hidden when 1" rule.
 */
const i18n = Astro.locals.i18n
const heading = i18n._(msg`Choose your pickup`)
const chooseLocation = i18n._(msg`Choose a location`)
const chooseDay = i18n._(msg`Choose a day`)
const chooseTime = i18n._(msg`Choose a time`)
---

<section id="pickup-picker" class="scroll-mt-28 border-t border-border pt-4 sm:pt-5" aria-labelledby="pickup-picker-heading">
	<h2 id="pickup-picker-heading" class="text-lg font-semibold text-foreground">{heading}</h2>
	<div class="mt-3 space-y-4 sm:mt-4 sm:space-y-5">
		<fieldset id="pickup-location-step" class="min-w-0">
			<legend id="pickup-location-label" class="mb-2 text-sm font-semibold text-foreground">
				{chooseLocation}
			</legend>
			<div
				id="pickup-location-chips"
				class="flex flex-wrap gap-2"
				role="radiogroup"
				aria-labelledby="pickup-location-label"
			></div>
		</fieldset>

		<fieldset id="pickup-date-step" class="hidden min-w-0">
			<legend id="pickup-date-label" class="mb-2 text-sm font-semibold text-foreground">
				{chooseDay}
			</legend>
			<div
				id="pickup-date-chips"
				class="flex flex-wrap gap-2"
				role="radiogroup"
				aria-labelledby="pickup-date-label"
			></div>
		</fieldset>

		<fieldset id="pickup-slot-step" class="hidden min-w-0">
			<legend id="pickup-slot-label" class="mb-2 text-sm font-semibold text-foreground">
				{chooseTime}
			</legend>
			<div
				id="pickup-slot-chips"
				class="flex flex-wrap gap-2"
				role="radiogroup"
				aria-labelledby="pickup-slot-label"
			></div>
		</fieldset>
	</div>

	<p
		id="pickup-selected-summary"
		class="tone-success mt-5 hidden items-start gap-3 rounded-lg border p-3 text-sm [&:not(.hidden)]:flex"
		role="status"
		aria-live="polite"
	></p>
</section>
