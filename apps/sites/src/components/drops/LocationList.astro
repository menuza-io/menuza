---
import { msg } from '@lingui/core/macro'

/**
 * Pickup locations of a drop with their address, map link, phone and pickup
 * window times. Shown as a disclosure under the "Where" fact in the drop
 * summary; the toggle behaviour lives in `DropSummaryCard.astro`.
 */
interface Props {
	locations: Array<{
		id: string
		name: string
		addressLine: string
		mapHref: string
		phone: string | null
		phoneHref: string | null
		windows: string[]
	}>
}

const { locations } = Astro.props
const i18n = Astro.locals.i18n
const directionsLabel = i18n._(msg`Directions`)
const callLabel = i18n._(msg`Call`)
---

<ul class="space-y-2.5">
	{locations.map((location) => (
		<li class="rounded-[calc(var(--radius)*0.7)] border border-border bg-background p-3">
			<p class="text-sm font-medium text-foreground">{location.name}</p>
			{location.addressLine ? (
				<p class="mt-0.5 text-xs leading-relaxed text-muted-foreground">{location.addressLine}</p>
			) : null}
			<p class="mt-1 text-xs text-muted-foreground">
				{location.windows.join(' · ')}
			</p>
			<div class="mt-1.5 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs">
				<a
					href={location.mapHref}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-1 font-medium text-foreground/80 underline-offset-4 hover:text-foreground hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring rounded-sm"
				>
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="size-3.5" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
					{directionsLabel}
				</a>
				{location.phone && location.phoneHref ? (
					<a
						href={location.phoneHref}
						class="inline-flex items-center gap-1 font-medium text-foreground/80 underline-offset-4 hover:text-foreground hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring rounded-sm"
					>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="size-3.5" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
						{callLabel} {location.phone}
					</a>
				) : null}
			</div>
		</li>
	))}
</ul>
