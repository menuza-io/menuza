---
import { msg } from '@lingui/core/macro'

/**
 * Pickup locations of a drop with their address, map link, phone and pickup
 * window times. Shown as a disclosure under the "Where" fact in the drop
 * summary; the toggle behaviour lives in `DropSummaryCard.astro`.
 */
interface Props {
	locations: Array<{
		id: string
		name: string
		addressLine: string
		mapHref: string
		phone: string | null
		phoneHref: string | null
		windows: string[]
	}>
}

const { locations } = Astro.props
const i18n = Astro.locals.i18n
const directionsLabel = i18n._(msg`Directions`)
const callLabel = i18n._(msg`Call`)
const linkClass =
	'focus-ring inline-flex items-center gap-1 rounded-sm text-sm font-semibold text-foreground underline-offset-4 hover:underline'
---

<ul class="divide-y divide-border">
	{locations.map((location) => (
		<li class="py-3 first:pt-0 last:pb-0">
			<p class="text-sm font-semibold text-foreground">{location.name}</p>
			{location.addressLine ? (
				<p class="mt-0.5 text-sm leading-relaxed text-muted-foreground">{location.addressLine}</p>
			) : null}
			{location.windows.length > 0 ? (
				<ul class="mt-1 space-y-0.5 text-xs text-muted-foreground">
					{location.windows.map((window) => (
						<li class="bidi-isolate">{window}</li>
					))}
				</ul>
			) : null}
			<div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1">
				<a href={location.mapHref} target="_blank" rel="noopener noreferrer" class={linkClass}>
					{directionsLabel}
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5 rtl:-scale-x-100" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
				</a>
				{location.phone && location.phoneHref ? (
					<a href={location.phoneHref} class={linkClass}>
						{callLabel}
						<span class="bidi-isolate font-normal text-muted-foreground" dir="ltr">{location.phone}</span>
					</a>
				) : null}
			</div>
		</li>
	))}
</ul>
