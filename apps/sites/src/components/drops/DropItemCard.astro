---
import DietaryBadges from '~/components/ordering/DietaryBadges.astro'

/**
 * Image-top item card for the drop menu grid. In the live phase the whole
 * card opens the shared item modal (`data-item-id`, `data-sold-out`); preview
 * cards are read-only. `note` carries the limit/inventory wording
 * ("Only 3 left", "Limit 2 per order", "Sold out").
 */
interface Props {
	id: string
	name: string
	description?: string | null
	priceLabel: string
	soldOut: boolean
	imageUrl?: string | null
	note?: string | null
	calories?: string | null
	isVegetarian?: boolean
	isGlutenFree?: boolean
	isAlcohol?: boolean
	readonly?: boolean
	labels: {
		vegetarian: string
		glutenFree: string
		alcohol: string
	}
}

const {
	id,
	name,
	description,
	priceLabel,
	soldOut,
	imageUrl,
	note,
	calories,
	isVegetarian,
	isGlutenFree,
	isAlcohol,
	readonly = false,
	labels,
} = Astro.props
---

<li
	class:list={[
		'group relative flex flex-col overflow-hidden rounded-[var(--radius)] border border-border bg-card text-card-foreground shadow-xs transition-colors',
		!readonly && 'js-item-card',
		!readonly && (soldOut ? 'opacity-70' : 'cursor-pointer hover:border-foreground/25'),
	]}
	data-item-id={id}
	data-sold-out={soldOut ? 'true' : 'false'}
	data-remaining={note ?? undefined}
>
	<div class="relative aspect-[4/3] w-full overflow-hidden bg-muted">
		{imageUrl ? (
			<img
				src={imageUrl}
				alt=""
				loading="lazy"
				decoding="async"
				class="size-full object-cover transition-transform duration-300 motion-safe:group-hover:scale-[1.02]"
			/>
		) : (
			<div class="flex size-full items-center justify-center text-muted-foreground" aria-hidden="true">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" class="size-10">
					<path d="M3 11h18"/><path d="M5 11V7a7 7 0 0 1 14 0v4"/><path d="M4 11v2a8 8 0 0 0 16 0v-2"/>
				</svg>
			</div>
		)}
	</div>

	<div class="flex flex-1 flex-col gap-1 p-3">
		<h4 class="font-heading text-sm font-semibold leading-snug text-foreground">
			{!readonly ? (
				<button
					type="button"
					class="js-item-open text-start after:absolute after:inset-0 after:content-[''] focus-visible:outline-none after:focus-visible:ring-2 after:focus-visible:ring-ring after:focus-visible:ring-inset disabled:cursor-default"
					aria-haspopup="dialog"
					disabled={soldOut}
				>
					{name}
				</button>
			) : (
				<span>{name}</span>
			)}
		</h4>
		{description ? (
			<p class="line-clamp-2 text-xs leading-snug text-muted-foreground">{description}</p>
		) : null}
		<div class="mt-auto flex flex-wrap items-center gap-x-2 gap-y-1 pt-1">
			<span class:list={['text-sm font-medium tabular-nums', soldOut ? 'text-muted-foreground' : 'text-foreground']}>
				{priceLabel}
			</span>
			{calories ? <span class="text-xs text-muted-foreground">{calories}</span> : null}
		</div>
		{note ? (
			<p class:list={['text-xs font-medium', soldOut ? 'text-foreground' : 'text-muted-foreground']}>
				{note}
			</p>
		) : null}
		<DietaryBadges
			isVegetarian={isVegetarian}
			isGlutenFree={isGlutenFree}
			isAlcohol={isAlcohol}
			labels={labels}
			class="mt-0.5"
		/>
	</div>
</li>
