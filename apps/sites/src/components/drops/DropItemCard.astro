---
import DietaryBadges from '~/components/ordering/DietaryBadges.astro'

/**
 * Item card for the drop menu, laid out like the menu page's `MenuItemRow`
 * (text at the start, square photo at the inline end). In the live phase the
 * whole card opens the shared item modal (`data-item-id`, `data-sold-out`);
 * preview cards are read-only. `note` carries the limit/inventory wording
 * ("Only 3 left", "Limit 2 per order", "Sold out").
 */
interface Props {
	id: string
	name: string
	description?: string | null
	priceLabel: string
	soldOut: boolean
	imageUrl?: string | null
	note?: string | null
	/** `warning` for low stock ("Only 3 left"), `neutral` for order limits. */
	noteTone?: 'warning' | 'neutral'
	/** Translated "Sold out" badge text. */
	soldOutLabel: string
	calories?: string | null
	isVegetarian?: boolean
	isGlutenFree?: boolean
	isAlcohol?: boolean
	readonly?: boolean
	labels: {
		vegetarian: string
		glutenFree: string
		alcohol: string
	}
}

const {
	id,
	name,
	description,
	priceLabel,
	soldOut,
	imageUrl,
	note,
	noteTone = 'warning',
	soldOutLabel,
	calories,
	isVegetarian,
	isGlutenFree,
	isAlcohol,
	readonly = false,
	labels,
} = Astro.props
const interactive = !readonly && !soldOut
const plusIcon = '<path d="M5 12h14"/><path d="M12 5v14"/>'
const hasMeta = Boolean(calories || isVegetarian || isGlutenFree || isAlcohol || (note && !soldOut))
---

<li
	class:list={[
		'group relative flex min-h-36 gap-4 rounded-xl border p-4',
		!readonly && 'js-item-card',
		soldOut ? 'border-dashed border-border bg-muted/40' : 'surface',
		interactive && 'surface-interactive cursor-pointer',
		'has-[.js-item-open:focus-visible]:outline-2 has-[.js-item-open:focus-visible]:outline-offset-2 has-[.js-item-open:focus-visible]:outline-ring',
	]}
	data-item-id={id}
	data-sold-out={soldOut ? 'true' : 'false'}
	data-remaining={note ?? undefined}
	aria-disabled={soldOut ? 'true' : undefined}
>
	<div class="flex min-w-0 flex-1 flex-col">
		<h3
			class:list={[
				'text-base leading-snug font-semibold text-pretty sm:text-lg sm:leading-snug',
				soldOut ? 'text-muted-foreground' : 'text-foreground',
			]}
		>
			{!readonly ? (
				<button
					type="button"
					class="js-item-open block w-full text-start after:absolute after:inset-0 after:rounded-xl after:content-[''] focus-visible:outline-none disabled:cursor-default"
					aria-haspopup="dialog"
					disabled={soldOut}
				>
					<span class="line-clamp-2">{name}</span>
				</button>
			) : (
				<span class="line-clamp-2">{name}</span>
			)}
		</h3>
		{description ? (
			<p class="mt-1 line-clamp-2 text-sm leading-relaxed text-muted-foreground">{description}</p>
		) : null}
		{hasMeta ? (
			<div class="mt-2.5 flex flex-wrap items-center gap-x-2 gap-y-1.5">
				{note && !soldOut ? (
					<span class:list={['badge', noteTone === 'warning' ? 'tone-warning' : 'tone-neutral']}>{note}</span>
				) : null}
				<DietaryBadges
					isVegetarian={isVegetarian}
					isGlutenFree={isGlutenFree}
					isAlcohol={isAlcohol}
					labels={labels}
				/>
				{calories ? <span class="bidi-isolate text-xs text-muted-foreground">{calories}</span> : null}
			</div>
		) : null}
		<div class="mt-auto flex items-end justify-between gap-3 pt-3">
			{soldOut ? (
				<span class="badge tone-solid">{soldOutLabel}</span>
			) : (
				<span class="price font-heading text-lg leading-none text-foreground">{priceLabel}</span>
			)}
			{!imageUrl && interactive ? (
				<span class="add-btn" aria-hidden="true">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" class="size-5" set:html={plusIcon} />
				</span>
			) : null}
		</div>
	</div>
	{imageUrl ? (
		<div class="relative size-28 shrink-0 self-start overflow-hidden rounded-lg bg-placeholder sm:size-32">
			<img
				src={imageUrl}
				alt=""
				loading="lazy"
				decoding="async"
				width="128"
				height="128"
				class:list={[
					'size-full object-cover transition-transform duration-300 ease-out motion-reduce:transition-none',
					soldOut ? 'opacity-50 grayscale' : 'group-hover:scale-103',
				]}
			/>
			{interactive ? (
				<span class="add-btn absolute end-2 bottom-2 shadow-elev-2" aria-hidden="true">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" class="size-5" set:html={plusIcon} />
				</span>
			) : null}
		</div>
	) : null}
</li>
