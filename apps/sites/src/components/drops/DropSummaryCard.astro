---
import { msg } from '@lingui/core/macro'
import LocationList from '~/components/drops/LocationList.astro'

/**
 * Drop facts panel (sticky on wide screens): order window, pickup, where,
 * the order-window countdown and (via the default slot) the `PickupPicker`
 * on live drops. The cover, title and description live in `DropHero`.
 */
interface Props {
	/** Fact rows: order window, pickup. */
	facts: Array<{
		id: string
		label: string
		text: string
		/**
		 * Live countdown for this fact's boundary ("open" / "close"). The initial
		 * text is rendered server-side and the drop page script keeps it ticking
		 * (`data-drop-countdown-always`).
		 */
		countdown?: { kind: 'open' | 'close'; initial: string; label: string } | null
		/** `.ics` download for the orders-open reminder (upcoming drops). */
		calendar?: { href: string; fileName: string } | null
	}>
	where: {
		label: string
		summary: string
		locations: Array<{
			id: string
			name: string
			addressLine: string
			mapHref: string
			phone: string | null
			phoneHref: string | null
			windows: string[]
		}>
	} | null
}

const { facts, where } = Astro.props

const i18n = Astro.locals.i18n
const addToCalendarLabel = i18n._(msg`Add to calendar`)
const whereToggleLabel = i18n._(msg`Show pickup locations`)
const countdown = facts.find((fact) => fact.countdown)?.countdown ?? null

// The icon tile sits in the row's start gutter so `dt`/`dd` stay direct children of the row.
const iconTile =
	'absolute start-0 top-0 hidden size-9 sm:flex items-center justify-center rounded-lg bg-muted text-muted-foreground'
const svg = {
	xmlns: 'http://www.w3.org/2000/svg',
	viewBox: '0 0 24 24',
	fill: 'none',
	stroke: 'currentColor',
	'stroke-linecap': 'round',
	'stroke-linejoin': 'round',
	'aria-hidden': 'true',
} as const
---

<div id="drop-summary-card" class="surface space-y-4 p-4 sm:space-y-5 sm:p-6">
	{facts.length > 0 || where ? (
		<dl class="grid grid-cols-2 gap-x-4 gap-y-3 sm:gap-4 lg:grid-cols-1">
			{facts.map((fact) => (
				<div class="relative min-w-0 sm:min-h-9 sm:ps-12" id={fact.id}>
					<dt class="eyebrow">
						<span class={iconTile}>
						{fact.id === 'drop-fact-pickup' ? (
							<svg {...svg} stroke-width="1.75" class="size-[18px]"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
						) : (
							<svg {...svg} stroke-width="1.75" class="size-[18px]"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
						)}
						</span>
						{fact.label}
					</dt>
					<dd class="bidi-isolate mt-0.5 text-sm font-medium text-foreground">
						{fact.text}
						{fact.countdown ? (
							<span data-drop-countdown={fact.countdown.kind} class="hidden font-normal text-muted-foreground"></span>
						) : null}
					</dd>
					{fact.calendar ? (
						<dd class="mt-1">
							<a
								href={fact.calendar.href}
								download={fact.calendar.fileName}
								class="focus-ring inline-flex items-center gap-1.5 rounded-sm text-sm font-semibold text-foreground underline-offset-4 hover:underline"
							>
								<svg {...svg} stroke-width="1.75" class="size-4"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18M12 14v6M9 17h6" /></svg>
								{addToCalendarLabel}
							</a>
						</dd>
					) : null}
				</div>
			))}

			{where && where.locations.length > 0 ? (
				<div class="relative col-span-2 min-w-0 sm:min-h-9 sm:ps-12 lg:col-span-1">
					<dt class="eyebrow">
						<span class={iconTile}>
							<svg {...svg} stroke-width="1.75" class="size-[18px]"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="3" /></svg>
						</span>
						{where.label}
					</dt>
					<dd class="mt-0.5">
							<button
								type="button"
								id="where-toggle"
								class="group/where focus-ring inline-flex max-w-full items-center gap-1 rounded-sm text-start text-sm font-medium text-foreground underline-offset-4 hover:underline"
								aria-expanded="false"
								aria-controls="where-locations"
							>
								<span class="truncate">{where.summary}</span>
								<svg
									{...svg}
									stroke-width="2"
									class="size-4 shrink-0 text-muted-foreground transition-transform duration-200 ease-out group-aria-expanded/where:rotate-180 motion-reduce:transition-none"
								>
									<path d="m6 9 6 6 6-6" />
								</svg>
								<span class="sr-only">{whereToggleLabel}</span>
							</button>
						</dd>
						<dd id="where-locations" class="mt-2 hidden">
							<LocationList locations={where.locations} />
						</dd>
				</div>
			) : null}
		</dl>
	) : null}

	{countdown ? (
		<div class="flex items-center justify-between gap-3 rounded-lg bg-muted px-4 py-2.5 sm:py-3">
			<span class="text-sm text-muted-foreground">{countdown.label}</span>
			<span
				data-drop-countdown-always={countdown.kind}
				class="price font-heading text-lg text-foreground sm:text-xl"
			>
				{countdown.initial}
			</span>
		</div>
	) : null}

	<slot />
</div>

<script>
	// "Where" disclosure.
	const whereToggle = document.getElementById('where-toggle')
	const whereLocations = document.getElementById('where-locations')
	if (whereToggle && whereLocations) {
		whereToggle.addEventListener('click', () => {
			const hidden = whereLocations.classList.toggle('hidden')
			whereToggle.setAttribute('aria-expanded', String(!hidden))
		})
	}
</script>
