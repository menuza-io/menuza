---
import { msg } from '@lingui/core/macro'
import { formatDropDateTime, type DropPhase } from '~/lib/drops/format'
import { translate } from '~/lib/ordering-labels'

interface Props {
	phase: DropPhase
	ordersOpenAt: string | null
	ordersCloseAt: string | null
	locale: string
	timeZone: string | null
	now?: Date
	class?: string
	/** Sits on top of a photo: adds a backdrop so the tone reads on any image. */
	overlay?: boolean
}

const {
	phase,
	ordersOpenAt,
	ordersCloseAt,
	locale,
	timeZone,
	now = new Date(),
	class: className,
	overlay = false,
} = Astro.props

const i18n = Astro.locals.i18n
const tz = timeZone || 'UTC'
const WEEK_MS = 7 * 24 * 60 * 60 * 1000

let text: string
if (phase === 'live') {
	text = i18n._(msg`Ordering now`)
} else if (phase === 'upcoming') {
	if (ordersOpenAt) {
		const openAt = new Date(ordersOpenAt)
		const soon = openAt.getTime() - now.getTime() < WEEK_MS
		const when = formatDropDateTime(openAt, locale, tz, { month: !soon })
		text = translate(i18n, msg`Opens {when}`, { when })
	} else {
		text = i18n._(msg`Coming soon`)
	}
} else if (ordersCloseAt) {
	const closedAt = new Date(ordersCloseAt)
	const sameYear = closedAt.getUTCFullYear() === now.getUTCFullYear()
	const when = new Intl.DateTimeFormat(locale, {
		timeZone: tz,
		month: 'short',
		day: 'numeric',
		year: sameYear ? undefined : 'numeric',
	}).format(closedAt)
	text = translate(i18n, msg`Ended {when}`, { when })
} else {
	text = i18n._(msg`Ended`)
}

const tone =
	phase === 'live' ? 'tone-success' : phase === 'upcoming' ? 'tone-warning' : 'tone-neutral'
---

{/* On a photo the tinted badge sits on an opaque plate so the tone reads anywhere. */}
<span
	class:list={[
		'inline-flex',
		overlay && 'rounded-[max(4px,calc(var(--radius)-4px))] bg-background/90 shadow-elev-1 backdrop-blur-sm',
		className,
	]}
	data-drop-phase={phase}
>
	<span class:list={['badge', tone]}>
		{phase === 'live' ? (
			<span class="relative flex size-1.5 shrink-0" aria-hidden="true">
				<span class="absolute inset-0 rounded-full bg-current opacity-60 motion-safe:animate-ping"></span>
				<span class="relative size-1.5 rounded-full bg-current"></span>
			</span>
		) : phase === 'upcoming' ? (
			<svg
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2.25"
				stroke-linecap="round"
				stroke-linejoin="round"
				class="size-3 shrink-0"
				aria-hidden="true"
			>
				<circle cx="12" cy="12" r="9" />
				<path d="M12 7v5l3 2" />
			</svg>
		) : (
			<span class="size-1.5 shrink-0 rounded-full bg-current opacity-70" aria-hidden="true"></span>
		)}
		<span class="bidi-isolate">{text}</span>
	</span>
</span>
