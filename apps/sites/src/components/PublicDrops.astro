---
import { msg } from '@lingui/core/macro'
import { getLocaleHref } from '@repo/common/site-locales'
import DropCard from '~/components/drops/DropCard.astro'
import { getDropPhase } from '~/lib/drops/format'
import { siteContainer } from '~/lib/media'
import { fetchPublishedDrops, type PublicDropListing } from '~/lib/org'

interface Props {
	variant?: 'home' | 'menu'
	limit?: number
}

const { variant = 'home', limit = 3 } = Astro.props

const drops = await fetchPublishedDrops({
	slug: Astro.locals.orgSlug,
	host: Astro.locals.customHost,
})
const i18n = Astro.locals.i18n
const defaultLocale = Astro.locals.defaultLocale || 'en'
const locale = Astro.locals.requestedLocale || defaultLocale
const now = new Date()

const heading = i18n._(msg`Drops`)
const explainer = i18n._(msg`Limited menus you pre-order for a pickup window.`)
const allDrops = i18n._(msg`All drops`)

const toTime = (value: string | null) => (value ? new Date(value).getTime() : Infinity)

const withPhase = drops.map((drop) => ({ drop, phase: getDropPhase(drop, now) }))
const active: PublicDropListing[] = withPhase
	.filter(({ phase }) => phase !== 'ended')
	.sort((a, b) => {
		if (a.phase !== b.phase) return a.phase === 'live' ? -1 : 1
		return a.phase === 'live'
			? toTime(a.drop.ordersCloseAt) - toTime(b.drop.ordersCloseAt)
			: toTime(a.drop.ordersOpenAt) - toTime(b.drop.ordersOpenAt)
	})
	.map(({ drop }) => drop)
const endedCount = withPhase.length - active.length
const visible = active.slice(0, Math.max(0, limit))
const showAllLink = active.length > visible.length || endedCount > 0
const allDropsHref = getLocaleHref('/drops', locale, locale, defaultLocale)
const headingId = `drops-${variant}-heading`
---

{visible.length > 0 ? (
	<section
		class:list={[
			'border-t border-border',
			variant === 'menu' ? 'py-10 sm:py-12' : 'py-12 sm:py-16',
		]}
		aria-labelledby={headingId}
		data-drops-teaser={variant}
	>
		<div class={siteContainer}>
			<div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
				<div class="min-w-0">
					<h2 id={headingId} class="font-heading text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
						{heading}
					</h2>
					<p class="mt-1 text-sm text-muted-foreground sm:text-base">{explainer}</p>
				</div>
				{showAllLink ? (
					<a
						href={allDropsHref}
						class="inline-flex items-center gap-1 text-sm font-medium text-foreground underline-offset-4 hover:underline"
					>
						{allDrops}
						<span aria-hidden="true" class="rtl:rotate-180">→</span>
					</a>
				) : null}
			</div>
			<div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
				{visible.map((drop) => (
					<DropCard
						drop={drop}
						locale={locale}
						defaultLocale={defaultLocale}
						variant="full"
						now={now}
					/>
				))}
			</div>
		</div>
	</section>
) : null}
