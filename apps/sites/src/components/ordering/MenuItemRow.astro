---
import DietaryBadges from '~/components/ordering/DietaryBadges.astro'

/**
 * One menu card. Without a photo it is a typographic card (name, two-line
 * description, badges, price and a brand-tinted quick add); with a photo the
 * image sits at the inline end in a fixed square, so loading never shifts
 * the layout. The name is the real button (and the first button in the card,
 * which the menu script relies on); its `::after` stretches over the card so
 * the whole card opens the item modal and the focus ring wraps the card.
 */
interface Props {
	id: string
	name: string
	description?: string | null
	/** Formatted price, or the sold-out label when `soldOut`. */
	priceLabel: string
	/** Shown muted before the price when the item has a price range ("From"). */
	fromLabel?: string | null
	soldOut: boolean
	imageUrl?: string | null
	calories?: string | null
	popularLabel?: string | null
	isVegetarian?: boolean
	isGlutenFree?: boolean
	isAlcohol?: boolean
	labels: {
		vegetarian: string
		glutenFree: string
		alcohol: string
	}
}

const {
	id,
	name,
	description,
	priceLabel,
	fromLabel,
	soldOut,
	imageUrl,
	calories,
	popularLabel,
	isVegetarian,
	isGlutenFree,
	isAlcohol,
	labels,
} = Astro.props

const searchText = `${name} ${description ?? ''}`.toLocaleLowerCase()
const plusIcon = '<path d="M5 12h14"/><path d="M12 5v14"/>'
const flameIcon =
	'<path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>'
const hasMeta = Boolean(
	(popularLabel && !soldOut) || calories || isVegetarian || isGlutenFree || isAlcohol,
)
---

<li
	class:list={[
		'js-item-card group relative flex min-h-36 gap-4 rounded-xl border p-4 [&.hidden]:hidden',
		soldOut
			? 'border-dashed border-border bg-muted/40'
			: 'surface surface-interactive cursor-pointer',
	]}
	data-item-id={id}
	data-sold-out={soldOut ? 'true' : 'false'}
	data-search={searchText}
	aria-disabled={soldOut ? 'true' : undefined}
>
	<div class="flex min-w-0 flex-1 flex-col">
		<h3
			class:list={[
				'text-base leading-snug font-semibold text-pretty sm:text-lg sm:leading-snug',
				soldOut ? 'text-muted-foreground' : 'text-foreground',
			]}
		>
			<button
				type="button"
				class="js-item-open block w-full text-start after:absolute after:inset-0 after:rounded-xl after:content-[''] focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:outline-offset-2 focus-visible:after:outline-ring disabled:cursor-default"
				aria-haspopup="dialog"
				disabled={soldOut}
			>
				<span class="line-clamp-2">{name}</span>
			</button>
		</h3>
		{description ? (
			<p class="mt-1 line-clamp-2 text-sm leading-relaxed text-muted-foreground">{description}</p>
		) : null}
		{hasMeta ? (
			<div class="mt-2.5 flex flex-wrap items-center gap-x-2 gap-y-1.5">
				{popularLabel && !soldOut ? (
					<span class="badge tone-brand">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3" aria-hidden="true" set:html={flameIcon} />
						{popularLabel}
					</span>
				) : null}
				<DietaryBadges
					isVegetarian={isVegetarian}
					isGlutenFree={isGlutenFree}
					isAlcohol={isAlcohol}
					labels={labels}
				/>
				{calories ? (
					<span class="bidi-isolate text-xs text-muted-foreground">{calories}</span>
				) : null}
			</div>
		) : null}
		<div class="mt-auto flex items-end justify-between gap-3 pt-3">
			{soldOut ? (
				<span class="badge tone-solid">{priceLabel}</span>
			) : (
				<span class="inline-flex items-baseline gap-1.5">
					{fromLabel ? <span class="text-sm text-muted-foreground">{fromLabel}</span> : null}
					<span class="price font-heading text-lg leading-none text-foreground">{priceLabel}</span>
				</span>
			)}
			{!imageUrl && !soldOut ? (
				<span class="add-btn" aria-hidden="true">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" class="size-5" set:html={plusIcon} />
				</span>
			) : null}
		</div>
	</div>
	{imageUrl ? (
		<div class="relative size-28 shrink-0 self-start overflow-hidden rounded-lg bg-placeholder sm:size-32">
			<img
				src={imageUrl}
				alt=""
				loading="lazy"
				decoding="async"
				width="128"
				height="128"
				class:list={[
					'size-full object-cover transition-transform duration-300 ease-out motion-reduce:transition-none',
					soldOut ? 'opacity-50 grayscale' : 'group-hover:scale-103',
				]}
			/>
			{!soldOut ? (
				<span class="add-btn absolute end-2 bottom-2 shadow-elev-2" aria-hidden="true">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" class="size-5" set:html={plusIcon} />
				</span>
			) : null}
		</div>
	) : null}
</li>
