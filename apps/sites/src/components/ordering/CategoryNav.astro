---
/**
 * Category navigation driven by `mountScrollSpy`. Horizontal tabs by default
 * (the active one carries a bar in the org primary); `rail` renders a
 * vertical list for wide layouts. The scroll-spy toggles
 * `aria-current` and the `is-active` marker; both styles key off those, so the
 * swapped class sets stay minimal.
 */
interface Props {
	items: Array<{ id: string; label: string }>
	label: string
	rail?: boolean
	class?: string
}

const { items, label, rail = false, class: className } = Astro.props

// Tabs set their own display, so `.hidden` (search filtering) needs the
// higher-specificity guard to win.
const chipBase =
	"relative inline-flex min-h-11 shrink-0 items-center px-3 text-sm font-semibold whitespace-nowrap text-muted-foreground transition-colors duration-150 ease-out after:absolute after:inset-x-3 after:bottom-0 after:h-0.5 after:rounded-full after:bg-primary after:opacity-0 after:transition-opacity after:content-[''] hover:text-foreground focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ring motion-reduce:transition-none motion-reduce:after:transition-none aria-[current=true]:text-foreground aria-[current=true]:after:opacity-100 [&.hidden]:hidden"
const railBase =
	'block truncate rounded-md px-3 py-2 text-sm text-muted-foreground transition-colors duration-150 ease-out hover:bg-muted hover:text-foreground focus-ring motion-reduce:transition-none aria-[current=true]:bg-muted aria-[current=true]:font-semibold aria-[current=true]:text-foreground'
const activeClass = 'is-active'
---

{items.length > 0 ? (
	<nav
		aria-label={label}
		data-category-nav={rail ? 'rail' : 'chips'}
		data-scroll-spy-scroller
		data-active-class={activeClass}
		data-inactive-class=""
		class:list={[
			rail
				? 'flex max-h-[calc(100dvh-9rem)] flex-col gap-0.5 overflow-y-auto no-scrollbar'
				: 'flex items-stretch overflow-x-auto no-scrollbar',
			className,
		]}
	>
		{items.map((item, index) => (
			<a
				href={`#category-${item.id}`}
				data-category-id={item.id}
				aria-current={index === 0 ? 'true' : undefined}
				class:list={[rail ? railBase : chipBase, index === 0 && activeClass]}
			>
				{item.label}
			</a>
		))}
	</nav>
) : null}
