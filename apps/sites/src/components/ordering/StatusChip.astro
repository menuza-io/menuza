---
/** Text-first status with a small dot; the words carry the meaning. */
interface Props {
	open: boolean
	text: string
	class?: string
}

const { open, text, class: className } = Astro.props
---

<span class:list={['inline-flex items-center gap-2 text-sm text-foreground', className]}>
	<span
		class:list={['size-1.5 shrink-0 rounded-full', open ? 'bg-primary' : 'bg-muted-foreground']}
		aria-hidden="true"></span>
	<span>{text}</span>
</span>
