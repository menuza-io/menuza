---
import { getLocalizedMenuValue } from '@repo/common/menu-types'
import { type PublicLocationData } from '~/lib/org'

/**
 * Location switcher. With several locations it renders the real
 * `<select id="location-select">` (styled, with a chevron) and navigates with
 * `?location=` on change; with one it shows the name and street.
 */
interface Props {
	locations: PublicLocationData[]
	activeId?: string | null
	locale: string
	defaultLocale: string
	labels: { selectLocation: string }
	class?: string
}

const { locations, activeId, locale, defaultLocale, labels, class: className } = Astro.props
const active = locations.find((location) => location.id === activeId) ?? locations[0]
const streetLine = [active?.address?.streetNumber, active?.address?.streetName]
	.filter(Boolean)
	.join(' ')
const pinIcon =
	'<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>'
---

{active ? (
	<div class:list={['flex min-w-0 items-center gap-2 text-sm text-foreground', className]}>
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0 text-muted-foreground" aria-hidden="true" set:html={pinIcon} />
		{locations.length > 1 ? (
			<div class="relative min-w-0">
				<label for="location-select" class="sr-only">{labels.selectLocation}</label>
				<select
					id="location-select"
					class="max-w-[16rem] cursor-pointer appearance-none truncate rounded-[var(--radius)] border border-border bg-background py-1.5 ps-3 pe-8 text-sm text-foreground hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
				>
					{locations.map((location) => (
						<option value={location.id} selected={location.id === active.id}>
							{getLocalizedMenuValue(location.name, locale, defaultLocale)}
						</option>
					))}
				</select>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="pointer-events-none absolute end-2.5 top-1/2 size-4 -translate-y-1/2 text-muted-foreground" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
			</div>
		) : (
			<span class="min-w-0 truncate">
				<span>{getLocalizedMenuValue(active.name, locale, defaultLocale)}</span>
				{streetLine ? (
					<span class="hidden text-muted-foreground md:inline"> · {streetLine}</span>
				) : null}
			</span>
		)}
	</div>
) : null}

<script>
	document
		.getElementById('location-select')
		?.addEventListener('change', (event) => {
			const url = new URL(window.location.href)
			url.searchParams.set('location', (event.target as HTMLSelectElement).value)
			url.searchParams.delete('item')
			window.location.href = url.toString()
		})
</script>
