---
interface Props {
	isVegetarian?: boolean
	isGlutenFree?: boolean
	isAlcohol?: boolean
	labels: {
		vegetarian: string
		glutenFree: string
		alcohol: string
	}
	class?: string
}

const { isVegetarian, isGlutenFree, isAlcohol, labels, class: className } = Astro.props
const show = Boolean(isVegetarian || isGlutenFree || isAlcohol)
const badgeClass = 'badge tone-neutral min-h-5 gap-1 px-1.5 font-medium'
---

{show ? (
	<span class:list={['inline-flex flex-wrap items-center gap-1', className]}>
		{isVegetarian ? (
			<span class={badgeClass}>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3" aria-hidden="true"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
				{/* The hidden glyph keeps the legacy "🌱 Vegetarian" text match used by the storefront audit. */}
				<span class="sr-only" aria-hidden="true">🌱</span>{' '}
				<span>{labels.vegetarian}</span>
			</span>
		) : null}
		{isGlutenFree ? (
			<span class={badgeClass}>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3" aria-hidden="true"><path d="M2 22 16 8"/><path d="M3.47 12.53 5 11l1.53 1.53a3.5 3.5 0 0 1 0 4.94L5 19l-1.53-1.53a3.5 3.5 0 0 1 0-4.94Z"/><path d="M7.47 8.53 9 7l1.53 1.53a3.5 3.5 0 0 1 0 4.94L9 15l-1.53-1.53a3.5 3.5 0 0 1 0-4.94Z"/><path d="M11.47 4.53 13 3l1.53 1.53a3.5 3.5 0 0 1 0 4.94L13 11l-1.53-1.53a3.5 3.5 0 0 1 0-4.94Z"/><path d="M20 2h2v2a4 4 0 0 1-4 4h-2V6a4 4 0 0 1 4-4Z"/></svg>
				<span>{labels.glutenFree}</span>
			</span>
		) : null}
		{isAlcohol ? (
			<span class={badgeClass}>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3" aria-hidden="true"><path d="M8 22h8"/><path d="M7 10h10"/><path d="M12 15v7"/><path d="M12 15a5 5 0 0 0 5-5c0-2-.5-4-2-8H9c-1.5 4-2 6-2 8a5 5 0 0 0 5 5Z"/></svg>
				<span>{labels.alcohol}</span>
			</span>
		) : null}
	</span>
) : null}
