---
/**
 * Item customization dialog shell: bottom sheet below `sm`, centered dialog
 * above. Content is rendered by `createItemModal`; this file only provides
 * the stable ids it binds to. Hidden via the `hidden` class on the backdrop.
 */
interface Props {
	labels: {
		customizeItem: string
		specialInstructions: string
		specialInstructionsPlaceholder: string
		quantity: string
		addToOrder: string
		close: string
	}
}

const { labels } = Astro.props
const stepButton = 'icon-btn size-9 border-0'
---

<div
	id="item-modal-backdrop"
	class="fixed inset-0 z-50 flex hidden items-end justify-center bg-foreground/40 backdrop-blur-xs dark:bg-background/80 sm:items-center sm:p-6"
>
	<div
		id="item-modal-dialog"
		class="surface-overlay relative flex max-h-[92dvh] w-full flex-col overflow-hidden rounded-t-2xl animate-in fade-in slide-in-from-bottom-4 duration-200 ease-out motion-reduce:animate-none sm:max-w-xl sm:rounded-2xl sm:zoom-in-95 sm:slide-in-from-bottom-2"
		role="dialog"
		aria-modal="true"
		aria-labelledby="modal-item-name"
		tabindex="-1"
	>
		{/* In flow (not overlaid) so scrolled content never slides under the handle. */}
		<div class="mx-auto mt-2 mb-1 h-1 w-9 shrink-0 rounded-full bg-muted-foreground/30 sm:hidden" aria-hidden="true"></div>

		<button
			type="button"
			id="close-item-modal"
			class="icon-btn absolute end-3 top-3 z-10 size-9 bg-background/90 shadow-elev-1 backdrop-blur-sm"
			aria-label={labels.close}
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
		</button>

		<div class="min-h-0 flex-1 overflow-y-auto overscroll-contain" data-modal-body>
			<div
				id="modal-item-media"
				class="hidden aspect-[16/9] w-full overflow-hidden bg-placeholder sm:aspect-[2/1]"
			></div>

			<div class="space-y-2 p-5 sm:p-6 [#modal-item-media.hidden+&]:pe-14">
				<h2 id="modal-item-name" class="text-2xl leading-tight font-bold tracking-tight text-balance text-foreground">
					{labels.customizeItem}
				</h2>
				<p id="modal-item-desc" class="text-sm leading-relaxed text-muted-foreground"></p>
				<p id="modal-item-price" class="price font-heading text-lg text-foreground"></p>
			</div>

			<div
				id="modal-variation-groups"
				class="space-y-5 border-t border-border px-5 py-4 empty:hidden sm:px-6"
			></div>
			<p
				id="modal-variation-unavailable"
				class="tone-warning mx-5 mb-4 hidden rounded-lg border p-3 text-sm font-medium sm:mx-6 sm:p-4"
				role="status"
			></p>
			<div id="modal-modifier-groups"></div>

			<div
				id="modal-special-instructions-field"
				class="space-y-2 border-t border-border px-5 py-4 sm:px-6"
			>
				<label for="modal-special-instructions" class="block text-sm font-semibold text-foreground">
					{labels.specialInstructions}
				</label>
				<textarea
					id="modal-special-instructions"
					rows="3"
					maxlength="300"
					placeholder={labels.specialInstructionsPlaceholder}
					class="field min-h-24 resize-none py-3"
				></textarea>
			</div>
		</div>

		<div class="border-t border-border bg-card px-5 pt-3 pb-safe sm:px-6">
			<p id="modal-qty-note" class="mb-2 hidden text-xs text-muted-foreground" role="status"></p>
			<div class="flex items-center gap-3">
				<span class="sr-only" id="modal-qty-label">{labels.quantity}</span>
				<div
					class="inline-flex h-12 shrink-0 items-center gap-1 rounded-lg border border-border bg-background p-1"
					role="group"
					aria-labelledby="modal-qty-label"
				>
					<button type="button" id="modal-qty-minus" class={stepButton}>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true"><path d="M5 12h14"/></svg>
					</button>
					<span id="modal-qty-value" class="price min-w-8 text-center text-sm text-foreground" aria-live="polite">1</span>
					<button type="button" id="modal-qty-plus" class={stepButton}>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
					</button>
				</div>
				<button
					type="button"
					id="modal-add-btn"
					class="btn-cta min-w-0 flex-1 px-4 py-2 text-center leading-tight tabular-nums"
				>
					{labels.addToOrder}
				</button>
			</div>
		</div>
	</div>
</div>
