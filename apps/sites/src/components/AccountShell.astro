---
import { msg } from '@lingui/core/macro'
import { getLocaleHref } from '@repo/common/site-locales'

interface Props {
	current: 'account' | 'orders' | 'rewards'
	title: string
	description?: string
}

const { current, title, description } = Astro.props
const i18n = Astro.locals.i18n
const requestedLocale = Astro.locals.requestedLocale
const defaultLocale = Astro.locals.defaultLocale

const accountNav = i18n._(msg`Account`)
const ordersNav = i18n._(msg`Orders`)
const rewardsNav = i18n._(msg`Rewards`)
const accountSettings = i18n._(msg`Account settings`)

const accountHref = getLocaleHref(
	'/profile',
	requestedLocale,
	requestedLocale,
	defaultLocale,
)
const ordersHref = getLocaleHref(
	'/profile/orders',
	requestedLocale,
	requestedLocale,
	defaultLocale,
)

const rewardsHref = getLocaleHref(
	'/profile/rewards',
	requestedLocale,
	requestedLocale,
	defaultLocale,
)

const navItems = [
	{ id: 'account' as const, label: accountNav, href: accountHref },
	{ id: 'orders' as const, label: ordersNav, href: ordersHref },
	{ id: 'rewards' as const, label: rewardsNav, href: rewardsHref },
]

function navClass(active: boolean) {
	return [
		'focus-ring flex min-h-11 items-center gap-2.5 rounded-[var(--radius)] px-3 py-2 text-sm font-medium transition-colors',
		active
			? 'bg-background text-foreground shadow-sm ring-1 ring-border lg:bg-muted'
			: 'text-muted-foreground hover:text-foreground',
	].join(' ')
}
---

<div class="mx-auto flex min-h-[60vh] w-full max-w-3xl flex-col gap-8 px-4 py-10 sm:py-12">
	<header class="space-y-1.5">
		<h1 class="font-heading text-2xl tracking-tight text-foreground">
			{title}
		</h1>
		{description ? (
			<p class="max-w-prose text-sm leading-relaxed text-muted-foreground">{description}</p>
		) : null}
	</header>

	<div class="flex flex-col gap-8 lg:flex-row lg:items-start lg:gap-10">
		<nav
			class="lg:w-48 lg:shrink-0"
			aria-label={accountSettings}
		>
			<ul
				data-fluid-nav="xy"
				class="flex gap-1 overflow-x-auto border-b border-border pb-px lg:flex-col lg:gap-0.5 lg:overflow-visible lg:rounded-xl lg:border lg:border-border lg:bg-muted/20 lg:p-1.5 lg:pb-1.5"
				role="list"
			>
				{navItems.map((item) => (
					<li
						class="shrink-0 lg:shrink"
						data-loyalty-link={item.id === 'rewards' ? '' : undefined}
						hidden={item.id === 'rewards' && current !== 'rewards'}
					>
						<a
							href={item.href}
							class={navClass(current === item.id)}
							aria-current={current === item.id ? 'page' : undefined}
						>
							{item.id === 'account' ? (
								<svg
									xmlns="http://www.w3.org/2000/svg"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.75"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="size-4 shrink-0 opacity-70"
									aria-hidden="true"
								>
									<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
									<circle cx="12" cy="7" r="4" />
								</svg>
							) : item.id === 'rewards' ? (
								<svg
									xmlns="http://www.w3.org/2000/svg"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.75"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="size-4 shrink-0 opacity-70"
									aria-hidden="true"
								>
									<rect x="3" y="8" width="18" height="4" rx="1" />
									<path d="M12 8v13" />
									<path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7" />
									<path d="M7.5 8a2.5 2.5 0 0 1 0-5C10 3 12 8 12 8s2-5 4.5-5a2.5 2.5 0 0 1 0 5" />
								</svg>
							) : (
								<svg
									xmlns="http://www.w3.org/2000/svg"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.75"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="size-4 shrink-0 opacity-70"
									aria-hidden="true"
								>
									<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" />
									<path d="M3 6h18" />
									<path d="M16 10a4 4 0 0 1-8 0" />
								</svg>
							)}
							{item.label}
						</a>
					</li>
				))}
			</ul>
		</nav>

		<div class="min-w-0 flex-1 space-y-6">
			<slot />
		</div>
	</div>
</div>

<script>
	import { revealLoyaltyLinks } from '~/lib/loyalty/availability'

	// The Rewards link shows only when the region says this site runs a program.
	void revealLoyaltyLinks()
</script>
