---
import { msg } from '@lingui/core/macro'
import { getLocaleHref, getSiteLocaleLabel } from '@repo/common/site-locales'
import SiteAnchor from '~/components/SiteAnchor.astro'
import {
	resolveMediaUrl,
	siteBtnPrimary,
	type SiteLocaleLink,
	type SiteOrgChrome,
} from '~/lib/media'

interface NavLink {
	label?: string
	url?: unknown
}

interface Props {
	config?: {
		navLinks?: NavLink[]
		ctaLabel?: string
		ctaUrl?: unknown
		showCta?: boolean
		showName?: boolean
		sticky?: boolean
	}
	organization: SiteOrgChrome
	locales?: SiteLocaleLink[]
}

const { config = {}, organization, locales = [] } = Astro.props
const navLinks = Array.isArray(config.navLinks) ? config.navLinks.filter((link) => link.label) : []
const showCta = config.showCta !== false && Boolean(config.ctaLabel)
const showName = config.showName !== false
const sticky = config.sticky !== false
const logoSrc = resolveMediaUrl(organization.siteIcon?.original)
const showLocales = locales.length > 1
const requestedLocale = Astro.locals.requestedLocale
const defaultLocale = Astro.locals.defaultLocale
const i18n = Astro.locals.i18n
const homeHref = getLocaleHref('/', requestedLocale, requestedLocale, defaultLocale)
const loginHref = getLocaleHref('/login', requestedLocale, requestedLocale, defaultLocale)
const profileHref = getLocaleHref('/profile', requestedLocale, requestedLocale, defaultLocale)
const signIn = i18n._(msg`Sign in`)
const profile = i18n._(msg`Profile`)
const logout = i18n._(msg`Logout`)
const openMenu = i18n._(msg`Open menu`)
const language = i18n._(msg`Language`)
const primaryNav = i18n._(msg`Primary`)
const mobileNav = i18n._(msg`Mobile`)
---

<header
	class:list={[
		'z-30 border-b border-border/70 bg-background/95 backdrop-blur-md',
		sticky && 'sticky top-0',
	]}
>
	<div class="mx-auto flex h-[4.25rem] w-full max-w-6xl items-center gap-4 px-5 sm:px-8">
		<a href={homeHref} class="flex min-w-0 items-center gap-2.5 no-underline">
			{logoSrc ? (
				<img
					src={logoSrc}
					alt=""
					class="size-9 rounded-[calc(var(--radius)*0.7)] object-contain"
				/>
			) : null}
			{showName || !logoSrc ? (
				<span class="truncate font-heading text-[15px] tracking-tight text-foreground">
					{organization.name}
				</span>
			) : (
				<span class="sr-only">{organization.name}</span>
			)}
		</a>

		<nav class="hidden min-w-0 flex-1 items-center justify-center gap-1 lg:flex" aria-label={primaryNav}>
			{navLinks.map((link) => (
				<SiteAnchor
					link={link.url}
					class="rounded-[var(--radius)] px-3 py-1.5 text-sm font-medium text-foreground/70 transition-colors hover:bg-muted hover:text-foreground"
				>
					{link.label}
				</SiteAnchor>
			))}
		</nav>

		<div class="ml-auto flex items-center gap-2 lg:ml-0">
			{showLocales ? (
				<nav class="hidden items-center gap-1 sm:flex" aria-label={language}>
					{locales.map((locale) => (
						<a
							href={locale.href}
							hreflang={locale.code}
							aria-current={locale.active ? 'true' : undefined}
							class:list={[
								'rounded-md px-2 py-1 text-[11px] tracking-wide uppercase transition-colors',
								locale.active
									? 'bg-primary text-primary-foreground'
									: 'text-muted-foreground hover:bg-muted hover:text-foreground',
							]}
						>
							{getSiteLocaleLabel(locale.code)}
						</a>
					))}
				</nav>
			) : null}

			<div data-auth="signed-in">
				<details class="group relative hidden sm:block">
					<summary class:list={[siteBtnPrimary, "cursor-pointer list-none appearance-none marker:content-none [&::-webkit-details-marker]:hidden"]}>
						<span class="js-auth-name">{profile}</span>
						<svg class="ml-2 size-4 opacity-70" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
					</summary>
					<div class="absolute right-0 top-[calc(100%+0.5rem)] z-50 w-48 rounded-[var(--radius)] border border-border bg-background p-2 shadow-lg">
						<a href={profileHref} class="block rounded-[calc(var(--radius)*0.7)] px-3 py-2 text-sm font-medium hover:bg-muted text-foreground">{profile}</a>
						<button type="button" class="logout-button block w-full rounded-[calc(var(--radius)*0.7)] px-3 py-2 text-left text-sm font-medium hover:bg-muted text-foreground">{logout}</button>
					</div>
				</details>
			</div>
			<div data-auth="signed-out">
				<div class="hidden items-center gap-2 sm:flex">
					{showCta ? (
						<>
							<a
								href={loginHref}
								class="rounded-[var(--radius)] px-3 py-1.5 text-sm font-medium text-foreground/80 transition-colors hover:bg-muted hover:text-foreground"
							>
								{signIn}
							</a>
							<SiteAnchor link={config.ctaUrl} class={siteBtnPrimary}>
								{config.ctaLabel}
							</SiteAnchor>
						</>
					) : (
						<a href={loginHref} class:list={[siteBtnPrimary]}>
							{signIn}
						</a>
					)}
				</div>
			</div>

			<details class="relative lg:hidden">
				<summary
					class="flex size-10 cursor-pointer list-none items-center justify-center rounded-[var(--radius)] text-foreground marker:content-none [&::-webkit-details-marker]:hidden"
					aria-label={openMenu}
				>
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<line x1="4" x2="20" y1="6" y2="6"></line>
						<line x1="4" x2="20" y1="12" y2="12"></line>
						<line x1="4" x2="20" y1="18" y2="18"></line>
					</svg>
				</summary>
				<div class="absolute right-0 top-[calc(100%+0.5rem)] z-50 w-64 rounded-[var(--radius)] border border-border bg-background p-3 shadow-lg">
					<nav class="flex flex-col gap-1" aria-label={mobileNav}>
						{navLinks.map((link) => (
							<SiteAnchor
								link={link.url}
								class="rounded-[var(--radius)] px-3 py-2 text-sm font-medium text-foreground hover:bg-muted"
							>
								{link.label}
							</SiteAnchor>
						))}
					</nav>
					{showLocales ? (
						<div class="mt-3 flex flex-wrap gap-1 border-t border-border pt-3">
							{locales.map((locale) => (
								<a
									href={locale.href}
									hreflang={locale.code}
									class:list={[
										'rounded-md px-2 py-1 text-[11px] tracking-wide uppercase',
										locale.active
											? 'bg-primary text-primary-foreground'
											: 'bg-muted text-muted-foreground',
									]}
								>
									{getSiteLocaleLabel(locale.code)}
								</a>
							))}
						</div>
					) : null}
					<div data-auth="signed-in" class="mt-3 flex flex-col gap-1 border-t border-border pt-3">
						<a href={profileHref} class="rounded-[var(--radius)] px-3 py-2 text-sm font-medium text-foreground hover:bg-muted">{profile}</a>
						<button type="button" class="logout-button rounded-[var(--radius)] px-3 py-2 text-left text-sm font-medium text-foreground hover:bg-muted">{logout}</button>
					</div>
					<div data-auth="signed-out" class="mt-3 flex flex-col gap-2 border-t border-border pt-3">
							{showCta ? (
								<>
									<a
										href={loginHref}
										class="rounded-[var(--radius)] px-3 py-2 text-sm font-medium text-foreground hover:bg-muted"
									>
										{signIn}
									</a>
									<SiteAnchor
										link={config.ctaUrl}
										class:list={[siteBtnPrimary, 'w-full']}
									>
										{config.ctaLabel}
									</SiteAnchor>
								</>
							) : (
								<a href={loginHref} class:list={[siteBtnPrimary, 'w-full']}>
									{signIn}
								</a>
							)}
					</div>
				</div>
			</details>
		</div>
	</div>
</header>

<script>
	import {
		getAccessToken,
		getAccessTokenClaims,
		logoutTenantSession,
	} from '~/lib/client-auth'
	import { browserLocaleHref } from '~/lib/locale'

	if (getAccessToken()) {
		document.documentElement.dataset.customerSession = '1'
	}

	const claims = getAccessTokenClaims()
	const firstName = claims?.name?.split(' ')[0]
	if (firstName) {
		document.querySelectorAll('.js-auth-name').forEach((el) => {
			el.textContent = firstName
		})
	}

	document.addEventListener('click', (event) => {
		const target = event.target as HTMLElement | null
		const openDetails = document.querySelectorAll('header details[open]')
		openDetails.forEach((details) => {
			if (!details.contains(target)) {
				details.removeAttribute('open')
			}
		})

		if (target?.closest('.logout-button')) {
			void logoutTenantSession().finally(() => {
				window.location.href = browserLocaleHref('/')
			})
		}
	})
</script>
