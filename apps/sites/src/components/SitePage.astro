---
import {
	getLocaleHref,
	getSiteLocaleDirection,
	getSiteLocaleLabel,
} from '@repo/common/site-locales'
import AnnouncementBanners from '~/components/AnnouncementBanners.astro'
import SiteFooter from '~/components/SiteFooter.astro'
import SiteHeader from '~/components/SiteHeader.astro'
import RenderBlocks from '~/components/blocks/RenderBlocks.astro'
import SiteLayout from '~/layouts/SiteLayout.astro'
import type { PublicOrganization, PublicWebsitePage } from '~/lib/org'
import type { SiteLocaleLink } from '~/lib/media'
import { getTenantApiUrl } from '~/lib/tenant-api'
import { ENV } from 'varlock/env'

const appUrl = (
	process.env.PUBLIC_APP_URL ||
	ENV.PUBLIC_APP_URL ||
	'http://localhost:3001'
).replace(/\/$/, '')

interface Props {
	organization: PublicOrganization
	page?: PublicWebsitePage | null
	title: string
	description?: string
	imageUrl?: string | null
	canonicalUrl?: string
	noIndex?: boolean
}

const {
	organization,
	page,
	title,
	description,
	imageUrl,
	canonicalUrl,
	noIndex = false,
} = Astro.props

const announcements = organization.announcements ?? []
const locales = organization.locales ?? ['en']
const activeLocale =
	Astro.locals.requestedLocale ||
	organization.locale ||
	organization.defaultLocale ||
	'en'
const localeDirection = getSiteLocaleDirection(activeLocale)
const sections = page?.sections ?? []
const header = sections.find((section) => section.type === 'header')
const footer = sections.find((section) => section.type === 'footer')
const isPreview = Astro.url.searchParams.get('preview') === 'true'
const defaultLocale =
	organization.defaultLocale ?? Astro.locals.defaultLocale ?? 'en'
const localeLinks: SiteLocaleLink[] = locales.map((locale) => ({
	code: locale,
	label: getSiteLocaleLabel(locale),
	href: getLocaleHref(
		Astro.url.pathname,
		locale,
		Astro.locals.requestedLocale,
		defaultLocale,
	),
	active: locale === activeLocale,
}))
const canonicalPath = getLocaleHref(
	Astro.url.pathname,
	activeLocale,
	Astro.locals.requestedLocale,
	defaultLocale,
)
const resolvedCanonical = canonicalUrl || `${Astro.url.origin}${canonicalPath}`
const alternateLinks = [
	...locales.map((locale) => ({
		hrefLang: locale,
		href: `${Astro.url.origin}${getLocaleHref(Astro.url.pathname, locale, Astro.locals.requestedLocale, defaultLocale)}`,
	})),
	{
		hrefLang: 'x-default',
		href: `${Astro.url.origin}${getLocaleHref(Astro.url.pathname, defaultLocale, Astro.locals.requestedLocale, defaultLocale)}`,
	},
]
---

<SiteLayout
	title={title}
	description={description}
	imageUrl={imageUrl}
	canonicalUrl={resolvedCanonical}
	alternateLinks={isPreview ? [] : alternateLinks}
	noIndex={noIndex}
	theme={organization.theme}
	lang={activeLocale}
	dir={localeDirection}
	siteIcon={organization.siteIcon ?? null}
	tenantApiUrl={getTenantApiUrl(organization.dataRegion)}
	appUrl={appUrl}
	orgSlug={Astro.locals.orgSlug || organization.slug}
	customHost={Astro.locals.customHost}
	defaultLocale={defaultLocale}
	facebookPixelId={organization.facebookPixelId ?? null}
	googleTagManagerId={organization.googleTagManagerId ?? null}
	googleAnalyticsId={organization.googleAnalyticsId ?? null}
	tiktokPixelId={organization.tiktokPixelId ?? null}
>
	<div class="bg-background text-foreground flex min-h-dvh flex-col">
		<AnnouncementBanners announcements={announcements} />
		<SiteHeader
			config={header?.config}
			organization={organization}
			locales={localeLinks}
		/>
		<main class="flex-1">
			<slot>
				{page ? <RenderBlocks sections={sections} /> : null}
			</slot>
		</main>
		<SiteFooter config={footer?.config} organization={organization} />
		
		{isPreview ? (
			<script is:inline>
				(function() {
					window.addEventListener('message', async (event) => {
						if (event.data?.type === 'epic-preview-update') {
							try {
								const res = await fetch(window.location.href, {
									method: 'POST',
									headers: { 'Content-Type': 'application/json' },
									body: JSON.stringify({ sections: event.data.sections, theme: event.data.theme })
								});
								const html = await res.text();
								const parser = new DOMParser();
								const doc = parser.parseFromString(html, 'text/html');
								
								const newHtml = doc.documentElement;
								document.documentElement.className = newHtml.className;
								['siteTheme', 'siteBase', 'headingFont', 'bodyFont'].forEach(key => {
									if (newHtml.dataset[key]) {
										document.documentElement.dataset[key] = newHtml.dataset[key];
									} else {
										delete document.documentElement.dataset[key];
									}
								});
								
								const updateStyle = (id) => {
									const current = document.getElementById(id);
									const next = doc.getElementById(id);
									if (current && next) {
										// Use textContent for style elements — CSS is not HTML, avoids XSS flag
										current.textContent = next.textContent;
									} else if (!current && next) {
										document.head.appendChild(next.cloneNode(true));
									} else if (current && !next) {
										current.remove();
									}
								};
								updateStyle('org-site-theme');
								updateStyle('org-site-fonts');

								const currentContainer = document.querySelector('div.bg-background');
								const newContainer = doc.querySelector('div.bg-background');
								
								if (currentContainer && newContainer) {
									// Use replaceChildren with cloned nodes instead of innerHTML
									currentContainer.replaceChildren(...Array.from(newContainer.cloneNode(true).childNodes));
								}
							} catch (err) {
								console.error('Failed to update preview', err);
							}
						}
					});
				})()
			</script>
		) : null}

	</div>
</SiteLayout>
