---
import {
	getLocaleHref,
	getSiteLocaleDirection,
	getSiteLocaleNativeLabel,
} from '@repo/common/site-locales'
import { activeAnnouncements } from '@repo/common/announcement-window'
import AnnouncementBanners from '~/components/AnnouncementBanners.astro'
import ConsentBanner from '~/components/ConsentBanner.astro'
import SiteFooter from '~/components/SiteFooter.astro'
import SiteHeader from '~/components/SiteHeader.astro'
import RenderBlocks from '~/components/blocks/RenderBlocks.astro'
import SiteLayout from '~/layouts/SiteLayout.astro'
import {
	fetchPublishedSitePage,
	type PublicOrganization,
	type PublicWebsitePage,
	type PublicWebsitePageSection,
} from '~/lib/org'
import type { SiteLocaleLink } from '~/lib/media'
import { bannerApplies } from '~/lib/legal-links'
import { getTenantApiUrl } from '~/lib/tenant-api'
import { ENV } from 'varlock/env'

const appUrl = (
	process.env.PUBLIC_APP_URL ||
	ENV.PUBLIC_APP_URL ||
	'http://localhost:3001'
).replace(/\/$/, '')

interface Props {
	organization: PublicOrganization
	page?: PublicWebsitePage | null
	title: string
	description?: string
	imageUrl?: string | null
	canonicalUrl?: string
	noIndex?: boolean
	/** Home page only: search engine verification meta tags (#138). */
	siteVerification?: { google: string[]; bing: string | null } | null
}

const {
	organization,
	page,
	title,
	description,
	imageUrl,
	canonicalUrl,
	noIndex = false,
	siteVerification = null,
} = Astro.props

// The bars whose window includes this request's time (#238): decided per
// request, so a window opening or closing needs no republish.
const announcements = activeAnnouncements(
	organization.announcements ?? [],
	Date.now(),
)
const locales = organization.locales ?? ['en']
const activeLocale =
	Astro.locals.requestedLocale ||
	organization.locale ||
	organization.defaultLocale ||
	'en'
const localeDirection = getSiteLocaleDirection(activeLocale)
const sections = page?.sections ?? []
// The cookie banner (#89): tags load only as the guest's consent allows.
const showConsentBanner = bannerApplies(organization)
const consentMode = organization.consent?.mode ?? 'off'
const isPreview = Astro.url.searchParams.get('preview') === 'true'
const findChrome = (list: PublicWebsitePageSection[]) => ({
	header: list.find((section) => section.type === 'header'),
	footer: list.find((section) => section.type === 'footer'),
})
let { header, footer } = findChrome(sections)
// App routes (menu, drops, checkout, profile…) have no CMS sections of their
// own; they wear the site chrome the org designed on its home page.
if (!header || !footer) {
	const home = page?.isHomePage
		? null
		: await fetchPublishedSitePage({
				slug: Astro.locals.orgSlug,
				host: Astro.locals.customHost,
				home: true,
				preview: isPreview,
				lng: Astro.locals.requestedLocale,
			})
	const homeChrome = findChrome(home?.sections ?? [])
	header ??= homeChrome.header
	footer ??= homeChrome.footer
}
const defaultLocale =
	organization.defaultLocale ?? Astro.locals.defaultLocale ?? 'en'
const localeLinks: SiteLocaleLink[] = locales.map((locale) => ({
	code: locale,
	label: getSiteLocaleNativeLabel(locale),
	href: getLocaleHref(
		Astro.url.pathname,
		locale,
		Astro.locals.requestedLocale,
		defaultLocale,
	),
	active: locale === activeLocale,
}))
const canonicalPath = getLocaleHref(
	Astro.url.pathname,
	activeLocale,
	Astro.locals.requestedLocale,
	defaultLocale,
)
const resolvedCanonical = canonicalUrl || `${Astro.url.origin}${canonicalPath}`
const alternateLinks = [
	...locales.map((locale) => ({
		hrefLang: locale,
		href: `${Astro.url.origin}${getLocaleHref(Astro.url.pathname, locale, Astro.locals.requestedLocale, defaultLocale)}`,
	})),
	{
		hrefLang: 'x-default',
		href: `${Astro.url.origin}${getLocaleHref(Astro.url.pathname, defaultLocale, Astro.locals.requestedLocale, defaultLocale)}`,
	},
]
---

<SiteLayout
	title={title}
	description={description}
	imageUrl={imageUrl}
	canonicalUrl={resolvedCanonical}
	alternateLinks={isPreview ? [] : alternateLinks}
	noIndex={Boolean(noIndex) || isPreview}
	theme={organization.theme}
	lang={activeLocale}
	dir={localeDirection}
	siteIcon={organization.siteIcon ?? null}
	tenantApiUrl={getTenantApiUrl(organization.dataRegion) ?? undefined}
	appUrl={appUrl}
	orgSlug={Astro.locals.orgSlug || organization.slug}
	customHost={Astro.locals.customHost}
	defaultLocale={defaultLocale}
	facebookPixelId={organization.facebookPixelId ?? null}
	googleTagManagerId={organization.googleTagManagerId ?? null}
	googleAnalyticsId={organization.googleAnalyticsId ?? null}
	tiktokPixelId={organization.tiktokPixelId ?? null}
	consentMode={consentMode}
	siteVerification={siteVerification}
>
	<slot name="head" slot="head" />
	<div class="bg-background text-foreground flex min-h-dvh flex-col">
		{showConsentBanner ? <ConsentBanner /> : null}
		<AnnouncementBanners announcements={announcements} />
		<SiteHeader
			config={header?.config}
			organization={organization}
			locales={localeLinks}
		/>
		<main class="flex-1">
			<slot>
				{page ? <RenderBlocks sections={sections} /> : null}
			</slot>
		</main>
		<SiteFooter
			config={footer?.config}
			organization={organization}
			showCookieSettings={showConsentBanner}
		/>
		
		{isPreview ? (
			<>
				<div hidden data-preview-parent-origin={appUrl} />
				<script>
					import { initSitePreview } from '~/lib/site-preview'

					const node = document.querySelector('[data-preview-parent-origin]')
					if (node instanceof HTMLElement) initSitePreview(node)
				</script>
			</>
		) : null}

	</div>
</SiteLayout>
