---
import { msg } from '@lingui/core/macro'
import SitePage from '~/components/SitePage.astro'

const organization = Astro.locals.organization
const i18n = Astro.locals.i18n
const checkYourPhone = i18n._(msg`Check your phone`)
const codeSentPrefix = i18n._(msg`We've sent a 6-digit code to`)
const verificationCode = i18n._(msg`Verification Code`)
const verify = i18n._(msg`Verify`)
const verifying = i18n._(msg`Verifying...`)
const invalidCode = i18n._(msg`Invalid verification code.`)
const networkError = i18n._(msg`Network error. Please try again.`)

if (!organization) {
	return new Response('Not Found', { status: 404, statusText: 'Not Found' })
}
---

<SitePage
	organization={organization}
	page={{ id: 'verify', title: checkYourPhone, slug: 'verify', isHomePage: false, sections: [] }}
	title={`${checkYourPhone} - ${organization.name}`}
>
	<div id="verify-container" class="mx-auto flex min-h-[60vh] w-full max-w-md flex-col items-center justify-center px-5 py-10 sm:px-8">
		<div class="surface w-full p-6 sm:p-8">
			<div class="mb-6 flex flex-col space-y-2 text-center">
				<h1 class="font-heading text-2xl tracking-tight text-foreground">
					{checkYourPhone}
				</h1>
				<p class="text-sm text-muted-foreground">
					{codeSentPrefix} <strong id="display-phone" class="text-foreground" dir="ltr"></strong>
				</p>
			</div>

			<form
				id="verify-form"
				class="space-y-4"
				data-verify={verify}
				data-verifying={verifying}
				data-invalid={invalidCode}
				data-network={networkError}
			>
				<input type="hidden" name="phone" id="phone-input" />
				<div class="space-y-2">
					<label for="code" class="text-sm font-medium leading-none text-foreground">
						{verificationCode}
					</label>
					<input
						type="text"
						id="code"
						name="code"
						placeholder="123456"
						required
						maxlength="6"
						minlength="6"
						inputmode="numeric"
						autocomplete="one-time-code"
						dir="ltr"
						class="field text-center text-lg tracking-widest"
					/>
				</div>

				<div id="error-message" role="alert" class="hidden text-sm font-medium text-destructive"></div>

				<button
					type="submit"
					class="btn-cta w-full"
				>
					{verify}
				</button>
			</form>
		</div>
	</div>
</SitePage>

<script>
	import {
		getOrgBinding,
		redirectHomeIfSignedIn,
		setSessionTokens,
		tenantErrorMessage,
		tenantJson,
	} from '~/lib/client-auth'
	import { browserLocaleHref } from '~/lib/locale'

	redirectHomeIfSignedIn()

	const form = document.getElementById('verify-form') as HTMLFormElement
	const errorMessage = document.getElementById('error-message')!
	const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement
	const displayPhone = document.getElementById('display-phone')!
	const phoneInput = document.getElementById('phone-input') as HTMLInputElement
	const codeField = document.getElementById('code') as HTMLInputElement
	const verifyLabel = form.dataset.verify || 'Verify'
	const verifyingLabel = form.dataset.verifying || 'Verifying...'
	const invalidLabel = form.dataset.invalid || 'Invalid verification code.'
	const networkLabel = form.dataset.network || 'Network error. Please try again.'

	const phone = sessionStorage.getItem('pending_phone')

	if (!phone) {
		window.location.href = browserLocaleHref('/login')
	} else {
		displayPhone.textContent = phone
		phoneInput.value = phone
	}

	function showError(message: string) {
		errorMessage.textContent = message
		errorMessage.classList.remove('hidden')
		codeField.setAttribute('aria-invalid', 'true')
		codeField.setAttribute('aria-describedby', 'error-message')
		// Disabling the button while verifying dropped focus.
		codeField.focus()
		codeField.select()
	}

	form.addEventListener('submit', async (e) => {
		e.preventDefault()
		errorMessage.classList.add('hidden')
		codeField.removeAttribute('aria-invalid')
		codeField.removeAttribute('aria-describedby')
		submitButton.disabled = true
		submitButton.textContent = verifyingLabel

		const formData = new FormData(form)
		const payload = {
			...Object.fromEntries(formData.entries()),
			...getOrgBinding(),
		}

		try {
			const { ok, data } = await tenantJson('/auth/verify', payload)

			if (ok && data.success && typeof data.accessToken === 'string') {
				setSessionTokens({
					accessToken: data.accessToken,
					refreshToken:
						typeof data.refreshToken === 'string'
							? data.refreshToken
							: undefined,
				})
				sessionStorage.removeItem('pending_phone')
				window.location.href =
					data.needsName === true
						? browserLocaleHref('/complete-name')
						: browserLocaleHref('/')
			} else {
				showError(tenantErrorMessage(data, invalidLabel))
			}
		} catch {
			showError(networkLabel)
		} finally {
			submitButton.disabled = false
			submitButton.textContent = verifyLabel
		}
	})
</script>
