---
import { msg } from '@lingui/core/macro'
import {
	getLocationCurrency,
	isLocationOpenForOrdering,
	type LocationOrderingAvailability,
} from '@repo/common/location-types'
import { menuItemSalePrice } from '@repo/discounts'
import { getLocalizedMenuValue } from '@repo/common/menu-types'
import { getLocaleHref } from '@repo/common/site-locales'
import SitePage from '~/components/SitePage.astro'
import DropNudge from '~/components/drops/DropNudge.astro'
import CartDrawer from '~/components/ordering/CartDrawer.astro'
import CartTray from '~/components/ordering/CartTray.astro'
import CategoryNav from '~/components/ordering/CategoryNav.astro'
import ItemModal from '~/components/ordering/ItemModal.astro'
import MenuMeta from '~/components/ordering/MenuMeta.astro'
import MenuItemRow from '~/components/ordering/MenuItemRow.astro'
import OrderBar from '~/components/ordering/OrderBar.astro'
import OrderDetailsSheet from '~/components/ordering/OrderDetailsSheet.astro'
import OrderingLabels from '~/components/ordering/OrderingLabels.astro'
import PopularRow from '~/components/ordering/PopularRow.astro'
import StickyCategoryNav from '~/components/ordering/StickyCategoryNav.astro'
import TableTab from '~/components/ordering/TableTab.astro'
import { resolveMediaUrl, siteContainer } from '~/lib/media'
import { summarizeHours } from '~/lib/menu-hours'
import {
	buildOrderDetailsLabels,
	buildOrderingLabels,
	translate,
} from '~/lib/ordering-labels'
import {
	flattenItems,
	isItemSoldOut,
	itemHasPriceRange,
	lowestAvailablePrice,
} from '~/lib/ordering/catalog'
import { formatMoney } from '~/lib/ordering/money'
import {
	MAX_BANNER_OFFERS,
	MAX_ITEM_BADGES,
	localizePromotion,
	offersForItem,
	promotionsForLocation,
	worksForMode,
} from '~/lib/ordering/offers'
import { schedulingSettings } from '~/lib/ordering/schedule'
import {
	type FulfillmentMode,
	type ModifierGroup,
	type ModifierOption,
	type OrderingCategory,
	type OrderingItem,
} from '~/lib/ordering/types'
import {
	fetchPublishedSiteMenu,
	type PublicLocationData,
	type PublicMenuCategoryData,
	type PublicMenuData,
	type PublicMenuItemData,
	type PublicMenuOptionData,
	type PublicModifierGroupData,
} from '~/lib/org'

const organization = Astro.locals.organization
const i18n = Astro.locals.i18n
const orgSlug = Astro.locals.orgSlug
const customHost = Astro.locals.customHost
const requestedLocale =
	Astro.locals.requestedLocale ||
	organization?.locale ||
	organization?.defaultLocale ||
	'en'
const defaultLocale = organization?.defaultLocale || 'en'

if (!organization) {
	return new Response('Not Found', { status: 404, statusText: 'Not Found' })
}

const urlLocation = Astro.url.searchParams.get('location')
const isPreview = Astro.url.searchParams.get('preview') === 'true'

const menuPayload = await fetchPublishedSiteMenu({
	slug: orgSlug,
	host: customHost,
	lng: requestedLocale,
	locationId: urlLocation,
	preview: isPreview,
})

const locations = menuPayload?.locations ?? []
const menus = menuPayload?.menus ?? []

const activeLocation: PublicLocationData | undefined =
	(urlLocation ? locations.find((l) => l.id === urlLocation) : undefined) ||
	locations.find((l) => l.isDefault) ||
	locations[0]

const currency =
	activeLocation?.currency ||
	getLocationCurrency(activeLocation?.address) ||
	menuPayload?.organization?.currency ||
	'USD'

const availability: LocationOrderingAvailability = activeLocation
	? isLocationOpenForOrdering(activeLocation, new Date())
	: {
			isOpen: true,
			status: 'open',
			estimatedPrepTime: 15,
			estimatedDeliveryTime: { min: 25, max: 45 },
			currentLocalTime: '12:00',
			currentLocalDate: new Date().toISOString().slice(0, 10),
			dayOfWeek: 'monday',
		}

const hours = activeLocation
	? summarizeHours(activeLocation, availability, requestedLocale)
	: {}

const price = (amount: number) => formatMoney(amount, currency, requestedLocale)
const t = (val: string | null | undefined) =>
	getLocalizedMenuValue(val, requestedLocale, defaultLocale)

// ---------- strings ----------

const labels = buildOrderingLabels(i18n)
const menuTitle = i18n._(msg`Menu & ordering`)
const openForOrders = i18n._(msg`Open for orders`)
const openUntil = translate(i18n, msg`Open until {time}`, { time: hours.closesAt ?? '' })
const closedLabel = i18n._(msg`Closed`)
const closedOpens = translate(i18n, msg`Closed · opens {time}`, { time: hours.opensAt ?? '' })
const closedReason = hours.opensAt
	? translate(i18n, msg`We're closed right now. Orders reopen {time}`, { time: hours.opensAt })
	: i18n._(msg`We're closed right now.`)
const statusText = availability.isOpen
	? hours.closesAt
		? openUntil
		: openForOrders
	: hours.opensAt
		? closedOpens
		: closedLabel
const pickupLabel = i18n._(msg`Pickup`)
const deliveryLabel = i18n._(msg`Delivery`)
const fulfillmentLabel = i18n._(msg`Fulfillment`)
const pickupEstimate = translate(i18n, msg`~{minutes} min`, {
	minutes: availability.estimatedPrepTime,
})
const deliveryEstimate = translate(i18n, msg`{min}–{max} min`, {
	min: availability.estimatedDeliveryTime?.min ?? 25,
	max: availability.estimatedDeliveryTime?.max ?? 45,
})
const searchLabel = i18n._(msg`Search the menu`)
const clearSearchLabel = i18n._(msg`Clear search`)
const noMatchLabel = i18n._(msg`No dishes match`)
const categoriesNavLabel = i18n._(msg`Menu categories`)
const popularLabel = i18n._(msg`Popular`)
const mostOrderedLabel = i18n._(msg`Most ordered`)
const carouselLabels = {
	previous: i18n._(msg`Previous`),
	next: i18n._(msg`Next`),
}
const viewOrderLabel = i18n._(msg`View order`)
const yourOrderLabel = i18n._(msg`Your order`)
const subtotalLabel = i18n._(msg`Subtotal`)
const taxLabel = i18n._(msg`Estimated tax`)
const includesTaxLabel = i18n._(msg`Includes VAT`)
const deliveryFeeLabel = i18n._(msg`Delivery fee`)
const totalLabel = i18n._(msg`Total`)
const checkoutLabel = i18n._(msg`Proceed to checkout`)
const specialInstructionsLabel = i18n._(msg`Special instructions`)
const specialInstructionsPlaceholder = i18n._(
	msg`Any dietary preferences, sauce on the side, etc.`,
)
const vegetarianLabel = i18n._(msg`Vegetarian`)
const glutenFreeLabel = i18n._(msg`Gluten-free`)
const alcoholLabel = i18n._(msg`Alcohol`)
const comingSoonTitle = i18n._(msg`Menu coming soon`)
const comingSoonDesc = i18n._(
	msg`Our kitchen is preparing delicious dishes. Check back soon for our full online menu.`,
)
const voiceOrderLabels = {
	loaded: i18n._(msg`We loaded your order from your call. Review it and check out.`),
	expired: i18n._(msg`This order link has expired. You can still order from the menu.`),
	error: i18n._(msg`We couldn't load your phone order.`),
	unavailable: i18n._(
		msg`The items from your call are no longer available. You can still order from the menu.`,
	),
	removed: i18n._(
		msg`Some items from your call are no longer available, so we removed them:`,
	),
	repriced: i18n._(
		msg`Some prices changed since your call. Your cart shows the current prices.`,
	),
}
const dietaryLabels = {
	vegetarian: vegetarianLabel,
	glutenFree: glutenFreeLabel,
	alcohol: alcoholLabel,
}

// ---------- catalog ----------

function localizeOption(option: PublicMenuOptionData): ModifierOption {
	return {
		id: option.id,
		displayName: t(option.displayName),
		description: option.description ? t(option.description) : '',
		imageUrl: resolveMediaUrl(option.imageUrl),
		price: option.price ?? 0,
		priceWhole: option.priceWhole,
		priceLeft: option.priceLeft,
		priceRight: option.priceRight,
		calories: option.calories,
		minSelections: option.minSelections,
		maxSelections: option.maxSelections,
		isDefault: Boolean((option as { isDefault?: boolean }).isDefault),
		availabilityStatus: option.availabilityStatus,
		nestedModifierGroups: (option.nestedModifierGroups ?? []).map(localizeGroup),
	}
}

function localizeGroup(group: PublicModifierGroupData): ModifierGroup {
	return {
		id: group.id,
		name: t(group.name),
		selectionType: group.selectionType,
		minSelections: group.minSelections ?? 0,
		maxSelections: group.maxSelections ?? null,
		availabilityStatus: group.availabilityStatus,
		options: (group.options ?? []).map(localizeOption),
	}
}

function localizeItem(item: PublicMenuItemData, menu: PublicMenuData): OrderingItem {
	return {
		id: item.id,
		displayName: t(item.displayName),
		description: item.description ? t(item.description) : '',
		price: item.price,
		imageUrl: resolveMediaUrl(item.imageUrl),
		variations: {
			groups: (item.variations?.groups ?? []).map((group) => ({
				id: group.id,
				name: t(group.name),
				values: group.values.map((value) => ({ id: value.id, name: t(value.name) })),
			})),
			variants: (item.variations?.variants ?? []).map((variant) => ({
				...variant,
				imageUrl: resolveMediaUrl(variant.imageUrl),
			})),
		},
		modifierGroups: (item.modifierGroups ?? []).map(localizeGroup),
		isVegetarian: item.isVegetarian,
		isGlutenFree: item.isGlutenFree,
		isAlcohol: item.isAlcohol,
		allergens: item.allergens ?? [],
		calorieMin: item.calorieMin,
		calorieMax: item.calorieMax,
		isPopular: item.isPopular,
		excludeFromDiscounts: item.excludeFromDiscounts === true,
		availabilityStatus: item.availabilityStatus,
		specialInstructions: menu.specialInstructions !== false,
	}
}

function localizeCategory(
	category: PublicMenuCategoryData,
	menu: PublicMenuData,
): OrderingCategory {
	return {
		id: category.id,
		displayName: t(category.displayName),
		description: category.description ? t(category.description) : '',
		items: (category.items ?? []).map((item) => localizeItem(item, menu)),
		subcategories: (category.subcategories ?? [])
			.filter((sub) => sub.availabilityStatus !== 'unavailable')
			.map((sub) => localizeCategory(sub, menu)),
	}
}

function categoryItemCount(category: OrderingCategory): number {
	return (
		category.items.length +
		(category.subcategories ?? []).reduce((acc, sub) => acc + categoryItemCount(sub), 0)
	)
}

function pruneEmpty(category: OrderingCategory): OrderingCategory | null {
	const subcategories = (category.subcategories ?? [])
		.map(pruneEmpty)
		.filter((sub): sub is OrderingCategory => sub !== null)
	const pruned = { ...category, subcategories }
	return categoryItemCount(pruned) > 0 ? pruned : null
}

const categories: OrderingCategory[] = []
for (const menu of menus) {
	if (menu.availabilityStatus === 'unavailable') continue
	for (const category of menu.categories) {
		if (category.availabilityStatus === 'unavailable' || category.parentId) continue
		const localized = pruneEmpty(localizeCategory(category, menu))
		if (localized) categories.push(localized)
	}
}

const allItems = flattenItems(categories)

/**
 * Price split for display: the amount (or the sold-out label) plus a muted
 * "From" prefix when the item has a price range.
 */
function priceParts(item: OrderingItem): { priceLabel: string; fromLabel: string | null } {
	if (isItemSoldOut(item)) return { priceLabel: labels.soldOut, fromLabel: null }
	return {
		priceLabel: price(lowestAvailablePrice(item)),
		fromLabel: itemHasPriceRange(item) ? labels.from : null,
	}
}

function caloriesFor(item: OrderingItem): string | null {
	if (!item.calorieMin) return null
	if (item.calorieMax && item.calorieMax !== item.calorieMin) {
		return translate(i18n, msg`{min}–{max} Cal`, { min: item.calorieMin, max: item.calorieMax })
	}
	return translate(i18n, msg`{count} Cal`, { count: item.calorieMin })
}

// Offer names and descriptions in the page language, like the menu itself.
const promotions = (menuPayload?.promotions ?? []).map((promotion) =>
	localizePromotion(promotion, requestedLocale, defaultLocale),
)
const offersLabel = translate(i18n, msg`Offers`, {})

function offerText(promotion: (typeof promotions)[number]): string {
	// A set price, a deal, a ladder or a size-limited offer has no one value.
	if (promotion.showName) return promotion.name
	if (promotion.valueType === 'percent' && promotion.percentBp) {
		return translate(i18n, msg`{percentText} off`, {
			percentText: new Intl.NumberFormat(requestedLocale, {
				style: 'percent',
				maximumFractionDigits: 2,
			}).format(promotion.percentBp / 10_000),
		})
	}
	if (promotion.valueType === 'fixed' && promotion.amountMinor) {
		return translate(i18n, msg`{amount} off`, {
			amount: formatMoney(promotion.amountMinor / 100, currency, requestedLocale),
		})
	}
	if (promotion.valueType === 'free_delivery') {
		return translate(i18n, msg`Free delivery`, {})
	}
	return promotion.name
}

/**
 * Badges for an item. `categoryIds` is the item's own (direct) category only:
 * the region matches category offers by it, not by an ancestor.
 */
function offersFor(item: OrderingItem, categoryIds: string[]): string[] {
	return offersForItem(livePromotions, item.id, categoryIds, MAX_ITEM_BADGES, {
		excludeFromDiscounts: item.excludeFromDiscounts,
	}).map(offerText)
}

/**
 * The was/now price of an item, only when one plain offer (a percentage or an
 * amount off each item) is the single offer covering it. Display only: the
 * quote at checkout decides what an order costs.
 */
function saleInputFor(item: OrderingItem, categoryId: string) {
	const available = (item.variations?.variants ?? []).filter(
		(variant) => variant.availabilityStatus !== 'unavailable',
	)
	return {
		id: item.id,
		directCategoryIds: [categoryId],
		priceMinor: Math.round(lowestAvailablePrice(item) * 100),
		currency,
		excludeFromDiscounts:
			item.excludeFromDiscounts === true ||
			available.some((variant) => variant.excludeFromDiscounts === true),
	}
}

function salePriceFor(
	item: OrderingItem,
	categoryIds: string[],
): { originalLabel: string; saleLabel: string } | null {
	if (isItemSoldOut(item)) return null
	const sale = menuItemSalePrice(
		livePromotions,
		saleInputFor(item, categoryIds[categoryIds.length - 1] ?? ''),
	)
	if (!sale) return null
	return {
		originalLabel: price(sale.originalMinor / 100),
		saleLabel: price(sale.saleMinor / 100),
	}
}

/**
 * Every orderable item with what the browser needs to redo the was/now price
 * when the visitor picks a time or order type (the offers are judged at the
 * time the food is wanted, like the region does).
 */
type SaleItemInput = ReturnType<typeof saleInputFor>
function collectSaleItems(
	list: OrderingCategory[],
	out: SaleItemInput[] = [],
): SaleItemInput[] {
	for (const category of list) {
		for (const item of category.items ?? []) {
			if (!isItemSoldOut(item)) out.push(saleInputFor(item, category.id))
		}
		collectSaleItems(category.subcategories ?? [], out)
	}
	return out
}

function rowProps(item: OrderingItem, categoryIds: string[]) {
	const sale = salePriceFor(item, categoryIds)
	return {
		id: item.id,
		name: item.displayName,
		description: item.description,
		...priceParts(item),
		originalPriceSrLabel: labels.originalPrice,
		salePriceSrLabel: labels.salePrice,
		...(sale
			? { priceLabel: sale.saleLabel, originalPriceLabel: sale.originalLabel }
			: {}),
		soldOut: isItemSoldOut(item),
		popularLabel: item.isPopular ? popularLabel : null,
		offerLabels: isItemSoldOut(item) ? [] : offersFor(item, categoryIds),
		imageUrl: item.imageUrl,
		calories: caloriesFor(item),
		isVegetarian: item.isVegetarian,
		isGlutenFree: item.isGlutenFree,
		isAlcohol: item.isAlcohol,
		labels: dietaryLabels,
	}
}

const saleInputById = new Map(
	collectSaleItems(categories).map((input) => [input.id, input]),
)

/** The was/now price parts of a card that does not know its category (popular). */
function salePartsFor(item: OrderingItem): {
	priceLabel?: string
	originalPriceLabel?: string
	originalPriceSrLabel: string
	salePriceSrLabel: string
} {
	const input = saleInputById.get(item.id)
	const sale = input ? menuItemSalePrice(livePromotions, input) : null
	return {
		originalPriceSrLabel: labels.originalPrice,
		salePriceSrLabel: labels.salePrice,
		...(sale
			? {
					priceLabel: price(sale.saleMinor / 100),
					originalPriceLabel: price(sale.originalMinor / 100),
				}
			: {}),
	}
}

const popularCards = allItems
	.filter((item) => item.isPopular)
	.map((item) => ({
		id: item.id,
		name: item.displayName,
		description: item.description,
		...priceParts(item),
		...salePartsFor(item),
		imageUrl: item.imageUrl,
		soldOut: isItemSoldOut(item),
	}))

const navItems = categories.map((category) => ({
	id: category.id,
	label: category.displayName,
}))

// ---------- fulfilment ----------

const fulfillment = (activeLocation?.fulfillmentOptions ?? {}) as {
	pickup?: boolean
	delivery?: boolean
}
const allowedModes: FulfillmentMode[] = []
if (fulfillment.pickup !== false) allowedModes.push('pickup')
if (fulfillment.delivery !== false) allowedModes.push('delivery')
if (!allowedModes.length) allowedModes.push('pickup')

// Offers that work at this location, now (in its time zone) and for an order
// type this page can place. A table order is `dine_in`, so those offers stay
// in the list and the browser shows them only while a table is active.
const livePromotions = promotionsForLocation(promotions, {
	locationId: activeLocation?.id,
	timeZone: activeLocation?.timezone || 'UTC',
	modes: [...allowedModes, 'dine_in'],
})
const initialOfferMode = allowedModes[0] ?? 'pickup'
// The banner lists up to 20; the browser narrows them to the current order
// type and shows the first three of those.
const bannerPool = livePromotions.slice(0, 20)
const initialMatching = bannerPool.filter((promotion) =>
	worksForMode(promotion, initialOfferMode),
)
const initialOffers = initialMatching.slice(0, MAX_BANNER_OFFERS)
// "and N more offers" for every count the banner can reach, translated here so
// plural rules stay the catalog's; the browser picks the one that fits.
const moreOffersText: Record<number, string> = {}
for (let count = 1; count <= bannerPool.length; count += 1) {
	moreOffersText[count] = translate(
		i18n,
		msg`{count, plural, one {and # more offer} other {and # more offers}}`,
		{ count },
	)
}
const initialMore = Math.max(0, initialMatching.length - MAX_BANNER_OFFERS)
const offerCodeText = (code: string) => translate(i18n, msg`Use code {code}`, { code })

// Fallback fee before the customer has a verified address. Once the order
// details hold a delivery quote, the cart uses the quote's zone fee instead
// (and the server re-prices from the signed quote either way).
function resolveDeliveryFee(location: PublicLocationData | undefined): number {
	const raw: unknown = location?.deliveryZones
	const zones: Array<Record<string, unknown>> = Array.isArray(raw) ? raw : []
	const usable = (zone: Record<string, unknown>) =>
		zone.enabled !== false && zone.restriction !== 'disallowed'
	const applicable =
		zones.find((zone) => zone.provider === 'in_house' && usable(zone)) ??
		zones.find(usable)
	return typeof applicable?.deliveryFee === 'number' ? applicable.deliveryFee : 0
}

const taxRate = activeLocation?.taxRate ?? 0
// Prices that already include tax (VAT): the cart shows the tax, not adds it.
const taxInclusive = activeLocation?.taxInclusive === true
const taxRateLabel = new Intl.NumberFormat(requestedLocale, {
	style: 'percent',
	maximumFractionDigits: 2,
}).format(taxRate / 100)

const checkoutHref =
	getLocaleHref('/menu/checkout', requestedLocale, requestedLocale, defaultLocale) +
	(activeLocation ? `?location=${encodeURIComponent(activeLocation.id)}` : '')

// ---------- header + order bar ----------

const orderDetailsLabels = buildOrderDetailsLabels(i18n)
const scheduling = activeLocation
	? schedulingSettings(activeLocation)
	: { enabled: false, advanceOrderDays: 0 }
const orgName = menuPayload?.organization?.name || organization.name
const locationName = activeLocation?.name ? t(activeLocation.name) : orgName
const addressLine = [
	[activeLocation?.address?.streetNumber, activeLocation?.address?.streetName]
		.filter(Boolean)
		.join(' '),
	activeLocation?.address?.city,
]
	.filter(Boolean)
	.join(', ')
const estimates = [
	allowedModes.includes('pickup') ? { label: pickupLabel, value: pickupEstimate } : null,
	allowedModes.includes('delivery') ? { label: deliveryLabel, value: deliveryEstimate } : null,
].filter((entry): entry is { label: string; value: string } => entry !== null)

const orderBarLabels = {
	fulfillment: fulfillmentLabel,
	pickup: pickupLabel,
	delivery: deliveryLabel,
	pickupFrom: orderDetailsLabels.pickupFrom,
	deliverTo: i18n._(msg`Deliver to`),
	addAddress: orderDetailsLabels.addAddress,
	pickupTime: i18n._(msg`Pickup time`),
	deliveryTime: i18n._(msg`Delivery time`),
	asap: orderDetailsLabels.asap,
}

const clientMenuData = {
	organizationId: organization.id,
	currency,
	locale: requestedLocale,
	activeLocationId: activeLocation?.id ?? '',
	locationIds: locations.map((location) => location.id),
	timezone: activeLocation?.timezone || 'UTC',
	saleItems: [...saleInputById.values()],
	offers: promotions
		.filter(
			(promotion) =>
				!promotion.locationIds ||
				(activeLocation && promotion.locationIds.includes(activeLocation.id)),
		)
		.map((promotion) => ({
			id: promotion.id,
			valueType: promotion.valueType,
			percentBp: promotion.percentBp ?? null,
			amountMinor: promotion.amountMinor ?? null,
			currency: promotion.currency ?? null,
			scope: promotion.scope,
			itemIds: promotion.itemIds,
			categoryIds: promotion.categoryIds,
			excludeItemIds: promotion.excludeItemIds ?? [],
			excludeCategoryIds: promotion.excludeCategoryIds ?? [],
			itemPrice: promotion.itemPrice === true,
			fulfillments: promotion.fulfillments,
			startsAt: promotion.startsAt ?? null,
			endsAt: promotion.endsAt ?? null,
			schedule: promotion.schedule,
		})),
	taxRate,
	taxInclusive,
	deliveryFee: resolveDeliveryFee(activeLocation),
	isOpen: availability.isOpen,
	closedReason,
	allowedModes,
	categories,
	voiceOrderLabels,
	timeLabels: {
		today: orderDetailsLabels.today,
		tomorrow: orderDetailsLabels.tomorrow,
		minutesRange: orderDetailsLabels.minutesRange,
	},
}

const icons = {
	clock: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>',
	search: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>',
	close: '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>',
	bag: '<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>',
}
const sectionScroll = 'scroll-mt-32 focus:outline-none lg:scroll-mt-28'
---

<SitePage
	organization={organization}
	page={{ id: 'menu', title: menuTitle, slug: 'menu', isHomePage: false, sections: [] }}
	title={`${menuTitle} - ${organization.name}`}
>
	<div class="bg-background pb-32 lg:pb-28">
		<div class:list={[siteContainer, 'relative z-10 pt-6 sm:pt-8']}>
			<h1 class="sr-only">{orgName} · {menuTitle}</h1>

			<OrderBar
				allowedModes={allowedModes}
				initialMode={allowedModes[0] ?? 'pickup'}
				locationName={locationName}
				pickupEstimate={pickupEstimate}
				deliveryEstimate={deliveryEstimate}
				scheduling={scheduling.enabled}
				labels={orderBarLabels}
			/>

			{/* QR table ordering: shown only when a table code is active. */}
			<TableTab />

			{!availability.isOpen ? (
				<div class="tone-warning mt-4 flex items-start gap-2.5 rounded-xl border px-3.5 py-2.5 text-sm leading-6" role="status">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-1 size-4 shrink-0" aria-hidden="true" set:html={icons.clock} />
					<p class="min-w-0">
						<span class="font-semibold text-foreground">{closedReason}</span>
						{scheduling.enabled ? (
							<span class="block text-muted-foreground sm:inline">
								<span class="hidden sm:inline" aria-hidden="true"> · </span>
								{orderDetailsLabels.asapClosed}
							</span>
						) : null}
					</p>
				</div>
			) : null}

			<MenuMeta
				open={availability.isOpen}
				statusText={statusText}
				estimates={estimates}
				locationName={locations.length > 1 ? locationName : null}
				addressLine={addressLine}
				class="mt-3 px-0.5"
			/>

			{/* Active drops live on /drops; the menu only nudges toward them. */}
			<DropNudge class="mt-5" />

			{livePromotions.length > 0 ? (
				<>
					<ul
						id="menu-offers"
						class="mt-3 flex flex-col gap-2 [&[hidden]]:hidden"
						aria-label={offersLabel}
						data-max={MAX_BANNER_OFFERS}
						hidden={initialOffers.length === 0}
						data-more={JSON.stringify(moreOffersText)}
					>
						{bannerPool.map((promotion) => (
							<li
								class="surface flex items-start gap-3 rounded-xl px-3.5 py-2.5 [&[hidden]]:hidden"
								data-offer
								data-fulfillments={promotion.fulfillments?.join(' ') ?? ''}
								hidden={!initialOffers.includes(promotion)}
							>
								{/* An offer shown by name has no value badge: the title says it. */}
								{promotion.showName ? null : (
									<span class="badge tone-brand shrink-0">{offerText(promotion)}</span>
								)}
								<div class="min-w-0">
									<p class="font-semibold text-foreground">{promotion.name}</p>
									{promotion.description ? (
										<p class="text-sm leading-relaxed text-muted-foreground">{promotion.description}</p>
									) : null}
									{promotion.code ? (
										<p class="mt-0.5 text-sm font-medium text-foreground">{offerCodeText(promotion.code)}</p>
									) : null}
								</div>
							</li>
						))}
					</ul>
					<p
						id="menu-offers-more"
						class="mt-1.5 px-1 text-sm text-muted-foreground [&[hidden]]:hidden"
						hidden={initialMore === 0}
					>
						{moreOffersText[initialMore] ?? ''}
					</p>
				</>
			) : null}

			{/* Live region stays mounted so screen readers announce the inserted notice. */}
			<div id="voice-order-notice" role="status" aria-live="polite"></div>

			{/* A printed coupon's QR opened the menu: say the code is kept. The
			    region still decides at checkout whether it applies. */}
			<div id="menu-coupon-saved" role="status" aria-live="polite">
				<p
					class="surface mt-3 flex items-start gap-3 rounded-xl px-3.5 py-2.5 text-sm font-medium text-foreground [&[hidden]]:hidden"
					hidden
				></p>
			</div>

			{/* Search sits here below lg; on lg+ it lives at the top of the
			    category rail (moved by the inline script after the rail). */}
			{categories.length > 0 ? (
				<div id="menu-search-slot-top" class="mt-6 w-full sm:ms-auto sm:w-80 lg:hidden"></div>
			) : null}
		</div>

		{/* Sticky category tabs (wide screens use the rail instead) */}
		<StickyCategoryNav
			id="menu-sticky-nav"
			items={navItems}
			label={categoriesNavLabel}
			layout="page"
			class="mt-6 lg:hidden"
		/>

		<PopularRow heading={mostOrderedLabel} labels={carouselLabels} cards={popularCards} />

		<div class:list={[siteContainer, 'pt-8 sm:pt-10']}>
			{categories.length === 0 ? (
				<div class="surface flex flex-col items-center gap-3 px-6 py-12 text-center">
					<span class="flex size-12 items-center justify-center rounded-xl bg-muted text-muted-foreground">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-6" aria-hidden="true" set:html={icons.bag} />
					</span>
					<h2 class="text-base font-semibold text-foreground">{comingSoonTitle}</h2>
					<p class="max-w-sm text-sm text-muted-foreground">{comingSoonDesc}</p>
				</div>
			) : (
				<div class="lg:grid lg:grid-cols-[12rem_minmax(0,1fr)] lg:gap-12">
					<div class="hidden lg:block">
						<div class="sticky top-[calc(4.25rem+1.5rem)]">
							<div id="menu-search-slot-rail" class="mb-5">
								<div id="menu-search-box" class="relative w-full">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="pointer-events-none absolute start-3 top-1/2 size-4 -translate-y-1/2 text-muted-foreground" aria-hidden="true" set:html={icons.search} />
									<input
										type="search"
										id="menu-search"
										placeholder={searchLabel}
										aria-label={searchLabel}
										autocomplete="off"
										enterkeyhint="search"
										class="field ps-9 pe-10 sm:min-h-11 sm:text-sm [&::-webkit-search-cancel-button]:hidden"
									/>
									<button
										type="button"
										id="menu-search-clear"
										class="icon-btn absolute end-1.5 top-1/2 hidden size-8 -translate-y-1/2 border-0 text-muted-foreground [&.hidden]:hidden"
										aria-label={clearSearchLabel}
									>
										<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true" set:html={icons.close} />
									</button>
								</div>
							</div>
							<div class="[&:not(:has(a:not(.hidden)))]:hidden">
								<CategoryNav items={navItems} label={categoriesNavLabel} rail />
							</div>
						</div>
					</div>
					{/* Before first paint, put search in the top slot below lg so phones
					    and tablets keep it under the order bar. */}
					<script is:inline>
						;(() => {
							const box = document.getElementById('menu-search-box')
							const top = document.getElementById('menu-search-slot-top')
							if (box && top && !window.matchMedia('(min-width: 64rem)').matches) top.appendChild(box)
						})()
					</script>

					<div class="min-w-0">
						<div id="menu-search-empty" class="surface mb-6 flex hidden flex-col items-center gap-3 px-6 py-12 text-center" role="status">
							<span class="flex size-12 items-center justify-center rounded-xl bg-muted text-muted-foreground">
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-6" aria-hidden="true" set:html={icons.search} />
							</span>
							<p class="text-base font-semibold text-foreground">{noMatchLabel}</p>
							<button type="button" id="menu-search-reset" class="btn-secondary focus-ring mt-1">
								{clearSearchLabel}
							</button>
						</div>

						{categories.map((category) => (
							<section
								id={`category-${category.id}`}
								data-category-section
								class:list={['mt-12 first-of-type:mt-0 sm:mt-14', sectionScroll]}
								aria-labelledby={`category-${category.id}-title`}
							>
								<header class="mb-4 sm:mb-5">
									<h2 id={`category-${category.id}-title`} class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
										{category.displayName}
									</h2>
									{category.description ? (
										<p class="mt-1.5 line-clamp-2 max-w-2xl text-sm leading-relaxed text-muted-foreground">{category.description}</p>
									) : null}
								</header>

								{category.items.length > 0 ? (
									<ul class="grid grid-cols-1 gap-3 md:grid-cols-2 md:gap-4">
										{category.items.map((item) => (
											<MenuItemRow {...rowProps(item, [category.id])} />
										))}
									</ul>
								) : null}

								{(category.subcategories ?? []).map((sub) => (
									<div id={`category-${sub.id}`} data-category-group class:list={['mt-8', sectionScroll]}>
										<h3 class="mb-3 text-base font-semibold text-foreground">{sub.displayName}</h3>
										{sub.description ? (
											<p class="-mt-2 mb-3 line-clamp-2 text-sm leading-relaxed text-muted-foreground">{sub.description}</p>
										) : null}
										{sub.items.length > 0 ? (
											<ul class="grid grid-cols-1 gap-3 md:grid-cols-2 md:gap-4">
												{sub.items.map((item) => (
													<MenuItemRow {...rowProps(item, [sub.id])} />
												))}
											</ul>
										) : null}
										{(sub.subcategories ?? []).map((subSub) => (
											<div id={`category-${subSub.id}`} data-category-group class:list={['mt-6', sectionScroll]}>
												<h4 class="mb-2 text-sm font-semibold text-foreground">{subSub.displayName}</h4>
												{subSub.description ? (
													<p class="mb-3 line-clamp-2 text-sm leading-relaxed text-muted-foreground">{subSub.description}</p>
												) : null}
												{subSub.items.length > 0 ? (
													<ul class="grid grid-cols-1 gap-3 md:grid-cols-2 md:gap-4">
														{subSub.items.map((item) => (
															<MenuItemRow {...rowProps(item, [subSub.id])} />
														))}
													</ul>
												) : null}
											</div>
										))}
									</div>
								))}
							</section>
						))}
					</div>
				</div>
			)}
		</div>

		<CartTray labels={{ viewOrder: viewOrderLabel }} initialTotal={price(0)} />

		<ItemModal
			labels={{
				customizeItem: labels.customizeItem,
				specialInstructions: specialInstructionsLabel,
				specialInstructionsPlaceholder,
				quantity: labels.quantity,
				addToOrder: labels.addToOrder,
				close: labels.closeDialog,
			}}
		/>

		<CartDrawer
			labels={{
				yourOrder: yourOrderLabel,
				subtotal: subtotalLabel,
				tax: taxLabel,
				includesTax: includesTaxLabel,
				deliveryFee: deliveryFeeLabel,
				total: totalLabel,
				discounts: labels.discounts,
				checkout: checkoutLabel,
				close: labels.closeDialog,
			}}
			taxRateLabel={taxRateLabel}
			taxInclusive={taxInclusive}
			checkoutHref={checkoutHref}
			initialTotal={price(0)}
		/>
	</div>

	{activeLocation ? (
		<OrderDetailsSheet
			locations={locations}
			activeLocationId={activeLocation.id}
			allowedModes={allowedModes}
			orgId={organization.id}
			currency={currency}
			locale={requestedLocale}
			defaultLocale={defaultLocale}
			labels={orderDetailsLabels}
			navigateOnLocationChange
		/>
	) : null}

	<OrderingLabels labels={labels} />
	<script
		id="menu-data"
		type="application/json"
		is:inline
		set:html={JSON.stringify(clientMenuData).replace(/</g, '\\u003c')}
	/>

	<script>
		import { getBrowserTenantApiUrl, getOrgBinding } from '~/lib/client-auth'
		import { indexCatalog } from '~/lib/ordering/catalog'
		import {
			cartDiscountView,
			createQuoteBudget,
			menuPricingPayload,
		} from '~/lib/ordering/cart-discounts'
		import { createCartStore } from '~/lib/ordering/cart-store'
		import { mountCartUi } from '~/lib/ordering/cart-ui'
		import {
			createDiscountQuotes,
			isTerminalRefusal,
			adoptCouponFromUrl,
			loadStoredCode,
			rememberDroppedCode,
			saveStoredCode,
			stripCouponFromAddress,
			type DiscountQuotes,
		} from '~/lib/ordering/discount-quote'
		import {
			attemptKey,
			couponContextKey,
			shouldRetryHeldCoupon,
			type HeldCoupon,
		} from '~/lib/ordering/coupon-retry'
		import { createItemModal } from '~/lib/ordering/item-modal'
		import { el } from '~/lib/ordering/dom'
		import { createMoneyFormatter } from '~/lib/ordering/money'
		import { orderLines, postDiscountQuote } from '~/lib/ordering/order-client'
		import {
			hasValidDeliveryQuote,
			loadOrderDetails,
			openOrderDetails,
			subscribeOrderDetails,
			updateOrderDetails,
			type OrderDetails,
		} from '~/lib/ordering/order-details'
		import { menuItemSalePrice, type MenuPricePromotion } from '@repo/discounts'
		import {
			isPromotionLive,
			localStamp,
			type OfferMode,
			worksForMode,
		} from '~/lib/ordering/offers'
		import { formatScheduledFor } from '~/lib/ordering/schedule'
		import { mountScrollSpy } from '~/lib/ordering/scroll-spy'
		import { posterSource } from '~/lib/ordering/table-session'
		import {
			type FulfillmentMode,
			type OrderingCategory,
			type OrderingLabels,
		} from '~/lib/ordering/types'
		import {
			fetchVoiceOrderHandoff,
			getHandoffToken,
			handoffGuardKey,
			hasHandoffParam,
			repriceHandoffCart,
			stripHandoffParam,
			type HandoffCartItem,
		} from '../scripts/voice-order-handoff'
		import { mountTableOrdering } from '../scripts/table-ordering'

		type MenuData = {
			organizationId: string
			currency: string
			locale: string
			activeLocationId: string
			locationIds: string[]
			timezone: string
			saleItems: {
				id: string
				directCategoryIds: string[]
				priceMinor: number
				currency: string
				excludeFromDiscounts: boolean
			}[]
			offers: (MenuPricePromotion & {
				fulfillments?: OfferMode[]
				startsAt?: string | null
				endsAt?: string | null
				schedule?: { day: number; start: string; end: string }[]
			})[]
			taxRate: number
			taxInclusive?: boolean
			deliveryFee: number
			isOpen: boolean
			closedReason: string
			allowedModes: FulfillmentMode[]
			categories: OrderingCategory[]
			voiceOrderLabels: Record<
				'loaded' | 'expired' | 'error' | 'unavailable' | 'removed' | 'repriced',
				string
			>
			timeLabels: { today: string; tomorrow: string; minutesRange: string }
		}

		function readJson<T>(id: string): T {
			return JSON.parse(document.getElementById(id)?.textContent || '{}') as T
		}

		const data = readJson<MenuData>('menu-data')
		const labels = readJson<OrderingLabels>('ordering-labels')
		const orgId = data.organizationId || 'default'
		// A printed coupon's QR: keep its code like a typed one, and say so. A code
		// this tab already let go of (removed, or refused for good) stays gone, and
		// the link leaves the address bar so a reload does not send it again.
		const adoptedCoupon = adoptCouponFromUrl(sessionStorage, orgId, window.location.search)
		stripCouponFromAddress(window)
		const couponSaved = document.querySelector<HTMLElement>('#menu-coupon-saved p')
		if (adoptedCoupon && couponSaved && labels.couponSaved) {
			couponSaved.textContent = fillTemplate(labels.couponSaved, { code: adoptedCoupon })
			couponSaved.hidden = false
		}
		const money = createMoneyFormatter(data.currency, data.locale)
		const catalog = indexCatalog(data.categories ?? [])

		const store = createCartStore({ key: `menuza_cart_${orgId}` })
		// Pickup/delivery, address and time live in the order details (browser
		// only); the legacy mode key is kept in sync by `saveOrderDetails`.
		let details: OrderDetails = loadOrderDetails(orgId, {
			locationId: data.activeLocationId,
			allowedModes: data.allowedModes,
		})

		const modalRoot = document.getElementById('item-modal-backdrop')
		const modal = modalRoot
			? createItemModal({
					root: modalRoot,
					getItem: (id) => catalog.items.get(id),
					labels,
					formatMoney: money,
					cartLines: () => store.lines(),
					onAdd: (line) => store.add(line),
					// The headline price of the open item (or chosen variant) as was/now.
					salePrice: (item, variant) => {
						const input = saleInputs.get(item.id)
						if (!input) return null
						const sale = menuItemSalePrice(liveOffers(), {
							...input,
							priceMinor: Math.round((variant?.price ?? item.price) * 100),
							excludeFromDiscounts:
								item.excludeFromDiscounts === true ||
								variant?.excludeFromDiscounts === true,
						})
						return sale
							? { original: sale.originalMinor / 100, sale: sale.saleMinor / 100 }
							: null
					},
				})
			: null

		const atTable = () => document.documentElement.dataset.tableMode === 'true'

		// Discounts in the cart: the region prices them (`/orders/quote`), the same
		// call checkout makes, with the cart as ids and quantities and the coupon
		// code checkout stored. The drawer and tray show the region's total only
		// while that quote matches the cart; otherwise the estimate stays, marked
		// as before discounts. At most about 20 requests a minute leave this page
		// (the region allows 60 per address, shared with checkout).
		let quotes: DiscountQuotes | null = null
		// A code the region refused for good is not sent again (the region allows
		// 20 refused answers per address per 10 minutes, and checkout shares them).
		// It is held here, told to the guest once in the cart note, and sent once
		// more only when what a hidden refusal depends on changes (see
		// `coupon-retry.ts`, the same logic as checkout).
		let heldCoupon: HeldCoupon | null = null
		const triedCoupons = new Set<string>()
		const quoteBudget = createQuoteBudget({ max: 20, windowMs: 60_000 })

		function pricingPayload() {
			const lines = store.lines()
			return menuPricingPayload({
				lines,
				orderLines: orderLines(lines),
				locale: data.locale,
				locationId: data.activeLocationId,
				mode: details.mode,
				verifiedDelivery: hasValidDeliveryQuote(details) ? (details.delivery ?? null) : null,
				scheduledFor: details.scheduledFor,
				open: data.isOpen,
				atTable: atTable(),
				posterSource: posterSource(orgId),
			})
		}

		function settleCoupon() {
			if (!quotes) return
			const stored = loadStoredCode(sessionStorage, orgId)
			const state = quotes.state()
			if (stored && state.status === 'ready') {
				const outcome = state.quote.coupon
				if (outcome?.status === 'refused' && isTerminalRefusal(outcome.reason)) {
					const contextKey = couponContextKey(pricingPayload())
					heldCoupon = { code: stored, reason: outcome.reason, contextKey }
					if (outcome.reason === 'not_found' && contextKey) {
						triedCoupons.add(attemptKey(stored, contextKey))
					}
					rememberDroppedCode(sessionStorage, orgId, stored)
					saveStoredCode(sessionStorage, orgId, null)
					return
				}
			}
			if (!stored && heldCoupon) {
				const key = couponContextKey(pricingPayload())
				if (key && shouldRetryHeldCoupon(heldCoupon, key, triedCoupons)) {
					triedCoupons.add(attemptKey(heldCoupon.code, key))
					saveStoredCode(sessionStorage, orgId, heldCoupon.code)
					heldCoupon = null
				}
			}
		}

		const cartUi = mountCartUi({
			store,
			labels,
			formatMoney: money,
			locale: data.locale,
			defaultLocale: document.documentElement.dataset.defaultLocale || 'en',
			discounts: {
				sync: () => quotes?.sync(),
				refusal: () => (heldCoupon ? { code: heldCoupon.code } : null),
				dismissRefusal: () => {
					heldCoupon = null
				},
				view: () =>
					cartDiscountView({
						state: quotes?.state() ?? { status: 'idle' },
						fresh: quotes?.freshQuote() ?? null,
						mode: atTable() ? 'pickup' : details.mode,
						hasItems: store.lines().length > 0,
						deliveryVerified: hasValidDeliveryQuote(details),
						atTable: atTable(),
						discountOffersAvailable: (data.offers ?? []).some((offer) =>
							isPromotionLive(offer, localStamp(data.timezone, new Date())),
						),
					}),
			},
			totals: {
				taxRate: data.taxRate || 0,
				taxInclusive: data.taxInclusive === true,
				deliveryFee: () => details.delivery?.deliveryFee ?? (data.deliveryFee || 0),
				// At a table nothing is delivered: no delivery fee in the cart.
				mode: () =>
					document.documentElement.dataset.tableMode === 'true' ? 'pickup' : details.mode,
			},
			// A scheduled order can be placed while the store is closed; the
			// server re-validates the slot.
			gate: () =>
				data.isOpen || details.scheduledFor
					? { allowed: true }
					: { allowed: false, reason: data.closedReason },
		})

		quotes = createDiscountQuotes({
			post: async (body, signal) => {
				const wait = quoteBudget.take()
				// Over budget: answer as a busy region would, so the quote client waits
				// and retries instead of sending.
				if (wait > 0) {
					return {
						status: 429,
						body: { error: 'rate_limited', retryAfterSeconds: Math.ceil(wait / 1000) },
					}
				}
				return postDiscountQuote(body, signal)
			},
			pricingPayload,
			code: () => loadStoredCode(sessionStorage, orgId),
			onChange: () => {
				settleCoupon()
				cartUi.refresh()
			},
			debounceMs: 1000,
		})

		// Order bar: Pickup | Delivery, where, and when. The chips open the order
		// details sheet; everything repaints from the stored details.
		const orderBar = document.getElementById('order-bar')
		const barLabels = orderBar?.dataset ?? {}
		const modeButtons = Array.from(
			document.querySelectorAll<HTMLButtonElement>('.js-mode-btn'),
		)
		const placeChip = document.getElementById('order-place-chip')
		const placeLabel = orderBar?.querySelector<HTMLElement>('[data-order-place-label]')
		const placeValue = orderBar?.querySelector<HTMLElement>('[data-order-place-value]')
		const timeLabel = orderBar?.querySelector<HTMLElement>('[data-order-time-label]')
		const timeValue = orderBar?.querySelector<HTMLElement>('[data-order-time-value]')

		function fillTemplate(template: string, values: Record<string, string | number>) {
			return template.replace(/\{(\w+)\}/g, (match, key: string) =>
				key in values ? String(values[key]) : match,
			)
		}

		function scheduledText(iso: string): string | null {
			const parts = formatScheduledFor(iso, data.locale, data.timezone)
			if (!parts) return null
			const day =
				parts.offset === 0
					? data.timeLabels.today
					: parts.offset === 1
						? data.timeLabels.tomorrow
						: parts.weekday
			return `${day} ${parts.time}`
		}

		/** Sets text and replays the reveal only when the value really changed. */
		function setValue(node: HTMLElement | null | undefined, build: () => Node[], key: string, animate: boolean) {
			if (!node || node.dataset.key === key) return
			node.dataset.key = key
			node.replaceChildren(...build())
			if (!animate) return
			node.classList.remove('order-value-in')
			void node.offsetWidth
			node.classList.add('order-value-in')
		}

		function paintOrderBar(animate: boolean) {
			const delivery = details.mode === 'delivery'
			for (const button of modeButtons) {
				button.setAttribute('aria-checked', button.dataset.mode === details.mode ? 'true' : 'false')
			}

			const quoted = delivery && hasValidDeliveryQuote(details)
			if (placeChip) {
				placeChip.dataset.orderDetailsTab = delivery ? 'delivery' : 'pickup'
				placeChip.toggleAttribute('data-needs-attention', delivery && !quoted)
			}
			if (placeLabel) {
				placeLabel.textContent = delivery
					? (barLabels.labelDeliverTo ?? '')
					: (barLabels.labelPickupFrom ?? '')
			}
			const place = delivery
				? quoted && details.delivery
					? [details.delivery.line1, details.delivery.unit].filter(Boolean).join(', ')
					: (barLabels.labelAddAddress ?? '')
				: (barLabels.locationName ?? '')
			setValue(placeValue, () => [document.createTextNode(place)], `${details.mode}|${place}`, animate)

			if (timeLabel) {
				timeLabel.textContent = delivery
					? (barLabels.labelDeliveryTime ?? '')
					: (barLabels.labelPickupTime ?? '')
			}
			const scheduled = details.scheduledFor ? scheduledText(details.scheduledFor) : null
			const eta =
				delivery && quoted && details.delivery
					? fillTemplate(data.timeLabels.minutesRange, details.delivery.eta)
					: delivery
						? (barLabels.deliveryEstimate ?? '')
						: (barLabels.pickupEstimate ?? '')
			setValue(
				timeValue,
				() => {
					if (scheduled) return [document.createTextNode(scheduled)]
					const muted = el('span', 'font-normal text-muted-foreground', ' · ')
					const bdi = document.createElement('bdi')
					bdi.className = 'tabular-nums'
					bdi.textContent = eta
					muted.appendChild(bdi)
					return [document.createTextNode(barLabels.labelAsap ?? ''), muted]
				},
				scheduled ? `s|${scheduled}` : `a|${eta}`,
				animate,
			)
		}

		function setMode(mode: FulfillmentMode, options: { prompt?: boolean } = {}) {
			if (!data.allowedModes.includes(mode)) return
			details = updateOrderDetails(orgId, details, { mode })
			// Delivery needs a verified address first (owner.com behavior).
			if (options.prompt !== false && mode === 'delivery' && !hasValidDeliveryQuote(details)) {
				openOrderDetails('delivery')
			}
		}

		for (const button of modeButtons) {
			button.addEventListener('click', () => {
				setMode(button.dataset.mode as FulfillmentMode)
			})
		}

		// Banner offers: the ones that work for the current order type, the first
		// three of them, and how many more there are. A table order is `dine_in`.
		const offersList = document.getElementById('menu-offers')
		const offersMore = document.getElementById('menu-offers-more')
		function paintOffers() {
			if (!offersList) return
			const mode = atTable() ? 'dine_in' : details.mode
			const max = Number(offersList.dataset.max) || 3
			const items = Array.from(offersList.querySelectorAll<HTMLElement>('[data-offer]'))
			const matching = items.filter((item) => {
				const modes = item.dataset.fulfillments
				return !modes || modes.split(' ').includes(mode)
			})
			for (const item of items) item.hidden = true
			for (const item of matching.slice(0, max)) item.hidden = false
			offersList.hidden = matching.length === 0
			const more = Math.max(0, matching.length - max)
			if (offersMore) {
				let texts: Record<string, string> = {}
				try {
					texts = JSON.parse(offersList.dataset.more || '{}')
				} catch {}
				offersMore.textContent = more > 0 ? (texts[String(more)] ?? '') : ''
				offersMore.hidden = more === 0
			}
		}
		// Was/now prices: the offers are judged at the time the food is wanted in
		// the location's zone (a scheduled time, else now), for the current order
		// type, like the region does. Display only: checkout quotes the order.
		// The offers live at the time the food is wanted, for the order type.
		function liveOffers() {
			const at = details.scheduledFor ? new Date(details.scheduledFor) : new Date()
			const stamp = localStamp(data.timezone, Number.isNaN(at.getTime()) ? new Date() : at)
			const mode = atTable() ? 'dine_in' : details.mode
			return (data.offers ?? []).filter(
				(offer) => isPromotionLive(offer, stamp) && worksForMode(offer, mode),
			)
		}
		const saleInputs = new Map((data.saleItems ?? []).map((input) => [input.id, input]))
		function paintPrices() {
			const live = liveOffers()
			for (const input of data.saleItems ?? []) {
				const cards = document.querySelectorAll<HTMLElement>(
					`[data-item-id="${CSS.escape(input.id)}"].js-item-card, [data-item-id="${CSS.escape(input.id)}"].js-popular-card`,
				)
				const sale = menuItemSalePrice(live, input)
				const regular = money(input.priceMinor / 100)
				for (const card of cards) {
					const was = card.querySelector<HTMLElement>('.js-price-was')
					const now = card.querySelector<HTMLElement>('.js-price-now')
					const nowSr = card.querySelector<HTMLElement>('.js-price-now-sr')
					if (!was || !now) continue
					was.hidden = !sale
					if (nowSr) nowSr.hidden = !sale
					const wasText = was.querySelector<HTMLElement>('.js-price-was-text')
					if (wasText) wasText.textContent = sale ? regular : ''
					now.textContent = sale ? money(sale.saleMinor / 100) : regular
				}
			}
		}
		new MutationObserver(() => {
			paintOffers()
			paintPrices()
		}).observe(document.documentElement, {
			attributes: true,
			attributeFilter: ['data-table-mode'],
		})

		subscribeOrderDetails(orgId, (next) => {
			// Another store was picked: the sheet navigates to it (its menu, tax and
			// fees are resolved server-side), so this page keeps its own location.
			if (!next || next.locationId !== data.activeLocationId) return
			details = next
			paintOrderBar(true)
			paintOffers()
			paintPrices()
			cartUi.refresh()
		})
		paintOrderBar(false)
		paintOffers()
		paintPrices()
		cartUi.refresh()

		mountTableOrdering({
			orgId,
			locationId: data.activeLocationId,
			locale: data.locale,
			formatMoney: money,
			store,
			cart: cartUi,
		})

		// Item rows and popular cards open the modal
		document.addEventListener('click', (event) => {
			const target = event.target as HTMLElement | null
			const card = target?.closest<HTMLElement>('.js-item-card, .js-popular-card')
			if (!card || !modal) return
			if (card.dataset.soldOut === 'true') return
			if (card instanceof HTMLButtonElement && card.disabled) return
			const itemId = card.dataset.itemId
			if (!itemId) return
			const opener = card.querySelector<HTMLElement>('button') ?? card
			modal.open(itemId, opener)
		})
		modal?.openFromUrl()

		// Category navigation
		const navs = Array.from(document.querySelectorAll<HTMLElement>('[data-category-nav]'))
		const sections = Array.from(
			document.querySelectorAll<HTMLElement>('[data-category-section]'),
		)
		const siteHeader = document.querySelector<HTMLElement>('header')
		const stickyNav = document.getElementById('menu-sticky-nav')
		if (navs.length && sections.length) {
			mountScrollSpy({
				nav: navs,
				sections,
				offset: () =>
					(siteHeader?.offsetHeight ?? 0) +
					(stickyNav && stickyNav.offsetParent !== null ? stickyNav.offsetHeight : 16),
			})
		}

		// Search lives under the order bar below lg and atop the rail on lg+.
		const searchBox = document.getElementById('menu-search-box')
		const searchSlots = {
			top: document.getElementById('menu-search-slot-top'),
			rail: document.getElementById('menu-search-slot-rail'),
		}
		const wide = window.matchMedia('(min-width: 64rem)')
		function placeSearch() {
			const slot = wide.matches ? searchSlots.rail : searchSlots.top
			if (searchBox && slot && searchBox.parentElement !== slot) slot.appendChild(searchBox)
		}
		wide.addEventListener('change', placeSearch)
		placeSearch()

		// In-menu search
		const search = document.getElementById('menu-search') as HTMLInputElement | null
		const clearBtn = document.getElementById('menu-search-clear')
		const emptyState = document.getElementById('menu-search-empty')
		function applySearch(raw: string) {
			const query = raw.trim().toLocaleLowerCase()
			let anyVisible = false
			document.querySelectorAll<HTMLElement>('.js-item-card').forEach((row) => {
				const hit = !query || (row.dataset.search ?? '').includes(query)
				row.classList.toggle('hidden', !hit)
				if (hit) anyVisible = true
			})
			document.querySelectorAll<HTMLElement>('[data-category-group]').forEach((group) => {
				group.classList.toggle('hidden', !group.querySelector('.js-item-card:not(.hidden)'))
			})
			for (const section of sections) {
				const visible = Boolean(section.querySelector('.js-item-card:not(.hidden)'))
				section.classList.toggle('hidden', !visible)
				for (const nav of navs) {
					nav
						.querySelector<HTMLElement>(`a[href="#${section.id}"]`)
						?.classList.toggle('hidden', !visible)
				}
			}
			document
				.querySelectorAll<HTMLElement>('[data-search-hide]')
				.forEach((node) => node.classList.toggle('hidden', Boolean(query)))
			emptyState?.classList.toggle('hidden', anyVisible || !query)
			clearBtn?.classList.toggle('hidden', !query)
		}
		search?.addEventListener('input', () => applySearch(search.value))
		document
			.getElementById('menu-search-reset')
			?.addEventListener('click', () => clearBtn?.click())
		clearBtn?.addEventListener('click', () => {
			if (!search) return
			search.value = ''
			applySearch('')
			search.focus()
		})
		if (search?.value) applySearch(search.value)

		// Phone-order handoff (#handoff=TOKEN from the voice agent's SMS link). The
		// token stays in the fragment so only the browser and tenant-api see it.
		const VOICE_NOTICE_KEY = 'menuza_voice_order_notice'
		// Static lucide paths: a phone for call handoffs, an alert for errors, so
		// the notice state is not carried by colour alone.
		const VOICE_ICON_PATHS = {
			phone: [
				'M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384',
			],
			alert: ['M12 8v4', 'M12 16h.01', 'M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0'],
		}
		function voiceIcon(name: keyof typeof VOICE_ICON_PATHS): SVGSVGElement {
			const ns = 'http://www.w3.org/2000/svg'
			const svg = document.createElementNS(ns, 'svg')
			for (const [key, value] of Object.entries({
				viewBox: '0 0 24 24',
				fill: 'none',
				stroke: 'currentColor',
				'stroke-width': '2',
				'stroke-linecap': 'round',
				'stroke-linejoin': 'round',
				'aria-hidden': 'true',
				class: 'mt-0.5 size-5 shrink-0',
			})) {
				svg.setAttribute(key, value)
			}
			for (const d of VOICE_ICON_PATHS[name]) {
				const path = document.createElementNS(ns, 'path')
				path.setAttribute('d', d)
				svg.appendChild(path)
			}
			return svg
		}
		type VoiceNotice = 'loaded' | 'expired' | 'error' | 'unavailable'
		type VoiceChanges = { removed: string[]; pricesChanged: boolean }

		function showVoiceOrderNotice(kind: VoiceNotice, changes?: VoiceChanges) {
			const region = document.getElementById('voice-order-notice')
			if (!region) return
			const voiceLabels = data.voiceOrderLabels
			const notice = el(
				'div',
				`mt-4 flex items-start gap-3 rounded-lg border p-3 text-sm sm:p-4 ${kind === 'error' ? 'tone-danger' : 'tone-neutral'}`,
			)
			const icon = voiceIcon(kind === 'error' ? 'alert' : 'phone')
			const body = el('div', 'min-w-0 space-y-1')
			body.appendChild(el('p', 'font-semibold text-foreground', voiceLabels[kind]))
			if (changes?.removed.length) {
				body.appendChild(
					el('p', 'text-muted-foreground', `${voiceLabels.removed} ${changes.removed.join(', ')}`),
				)
			}
			if (changes?.pricesChanged) {
				body.appendChild(el('p', 'text-muted-foreground', voiceLabels.repriced))
			}
			notice.append(icon, body)
			region.replaceChildren(notice)
		}

		function readSession(key: string) {
			try {
				return sessionStorage.getItem(key)
			} catch {
				return null
			}
		}

		function writeSession(key: string, value: string | null) {
			try {
				if (value === null) sessionStorage.removeItem(key)
				else sessionStorage.setItem(key, value)
			} catch {}
		}

		/**
		 * The phone order is what the caller just agreed to, so it replaces any
		 * existing cart, unless nothing from it can still be ordered. Prices are
		 * never trusted from the handoff: the cart is rebuilt from this page's menu.
		 */
		function applyVoiceCart(lines: HandoffCartItem[], keepCartWhenEmpty: boolean) {
			const repriced = repriceHandoffCart(lines, [{ categories: data.categories ?? [] }])
			if (!repriced.cart.length) {
				if (!keepCartWhenEmpty) store.clear()
				showVoiceOrderNotice('unavailable')
				return
			}
			store.save(repriced.cart)
			showVoiceOrderNotice('loaded', repriced)
			cartUi.open()
		}

		async function importVoiceOrder(token: string) {
			// Drop the token from the address bar before anything else.
			history.replaceState(history.state, '', stripHandoffParam(window.location.href))

			const guardKey = await handoffGuardKey(token)
			if (readSession(guardKey)) return
			writeSession(guardKey, '1')

			let tenantApiUrl: string
			try {
				tenantApiUrl = getBrowserTenantApiUrl()
			} catch {
				showVoiceOrderNotice('error')
				return
			}
			const result = await fetchVoiceOrderHandoff({
				tenantApiUrl,
				token,
				binding: getOrgBinding(),
			})
			if (result.status !== 'loaded') {
				showVoiceOrderNotice(result.status)
				return
			}

			if (result.fulfillmentMode) setMode(result.fulfillmentMode, { prompt: false })

			const canSwitchLocation =
				!!result.locationId &&
				result.locationId !== data.activeLocationId &&
				data.locationIds.includes(result.locationId)
			if (canSwitchLocation && result.locationId) {
				// Tax, delivery fee, and the menu itself are resolved server-side per
				// location, so reload with it and reprice against that location's menu.
				store.save(result.cart)
				writeSession(VOICE_NOTICE_KEY, 'reprice')
				const url = new URL(window.location.href)
				url.searchParams.set('location', result.locationId)
				window.location.href = url.toString()
				return
			}

			applyVoiceCart(result.cart, true)
		}

		const voiceOrderToken = getHandoffToken(window.location.href)
		if (voiceOrderToken) {
			void importVoiceOrder(voiceOrderToken)
		} else if (hasHandoffParam(window.location.href)) {
			history.replaceState(history.state, '', stripHandoffParam(window.location.href))
			showVoiceOrderNotice('error')
		} else if (readSession(VOICE_NOTICE_KEY) === 'reprice') {
			writeSession(VOICE_NOTICE_KEY, null)
			applyVoiceCart(store.lines(), false)
		}
	</script>
</SitePage>
