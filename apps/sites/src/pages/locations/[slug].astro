---
import { msg } from '@lingui/core/macro'
import { formatPriceRange, cuisineLabel } from '@repo/common/cuisines'
import { getLocaleHref, pickLocalized } from '@repo/common/site-locales'
import GonePage from '~/components/GonePage.astro'
import SiteNotFound from '~/components/SiteNotFound.astro'
import SitePage from '~/components/SitePage.astro'
import {
	directionsUrl,
	locationTitleParts,
	resolveLocationPage,
	weeklyHoursRows,
} from '~/lib/landing-pages'
import { resolveMediaUrl, siteContainer } from '~/lib/media'
import {
	fetchPublishedLanding,
	fetchPublishedReservations,
	fetchPublishedSiteMenu,
} from '~/lib/org'
import { locationRestaurantStructuredData } from '~/lib/restaurant-jsonld'
import { formatAddress } from '~/lib/seo-files'
import { translate } from '~/lib/translate'

/**
 * A location's own page (#137): hours, map and directions, phone, order and
 * reserve buttons, popular dishes and the operator's introduction, with its
 * own Restaurant structured data. Deactivated (or switched off): 410.
 */
const organization = Astro.locals.organization
const i18n = Astro.locals.i18n
const orgSlug = Astro.locals.orgSlug
const customHost = Astro.locals.customHost
if (!organization) {
	return new Response('Not Found', { status: 404, statusText: 'Not Found' })
}
const slug = (Astro.params.slug ?? '').toLowerCase()
const defaultLocale = organization.defaultLocale || 'en'
const locale = Astro.locals.requestedLocale || defaultLocale
const href = (path: string) => getLocaleHref(path, locale, locale, defaultLocale)

const [landing, menu, reservations] = await Promise.all([
	fetchPublishedLanding({ slug: orgSlug, host: customHost }),
	fetchPublishedSiteMenu({ slug: orgSlug, host: customHost, lng: locale }),
	fetchPublishedReservations({ slug: orgSlug, host: customHost }),
])
const outcome = resolveLocationPage(landing, slug)
if (outcome.kind === 'gone') {
	Astro.response.status = 410
	Astro.response.statusText = 'Gone'
} else if (outcome.kind === 'not_found') {
	Astro.response.status = 404
	Astro.response.statusText = 'Not Found'
}
const location = outcome.kind === 'page' ? outcome.value : null
const multiLocation = (landing?.locations.length ?? 0) > 1
const menuLocation = location
	? menu?.locations.find((entry) => entry.id === location.id) ?? null
	: null
const currency = menu?.organization?.currency ?? 'USD'

const name = location ? pickLocalized(location.name, locale, defaultLocale) || location.name : ''
const parts = location
	? locationTitleParts({ brand: organization.name, location, locale, defaultLocale })
	: null
const generatedTitle = parts
	? parts.cuisine && parts.city
		? translate(i18n, msg`{name} – {cuisine} restaurant in {city}`, parts)
		: parts.cuisine
			? translate(i18n, msg`{name} – {cuisine} restaurant`, parts)
			: parts.city
				? translate(i18n, msg`{name} – restaurant in {city}`, parts)
				: parts.name
	: ''
const title = location?.seoTitle?.trim() || generatedTitle
const intro = location?.intro ? pickLocalized(location.intro, locale, defaultLocale) : ''
const address = location ? formatAddress(location.address) : ''
const description =
	location?.seoDescription?.trim() ||
	(intro ? intro.slice(0, 160) : [name, address].filter(Boolean).join(' · '))
const closed = i18n._(msg`Closed`)
const hours = location ? weeklyHoursRows(location, locale, closed) : []
const directions = location ? directionsUrl(location.address) : null
const cuisines = location ? location.cuisines.map((key) => cuisineLabel(key, locale)) : []
const priceRange = location ? formatPriceRange(location.priceRange, currency) : ''
const canOrder = Boolean(menuLocation && (menu?.menus?.length ?? 0) > 0)
const canReserve = reservations?.online === true

const popular = (() => {
	if (!menuLocation || !menu) return []
	const items = (menu.menus ?? []).flatMap((m) =>
		(m.categories ?? []).flatMap((category) => category.items ?? []),
	)
	return items
		.filter((item) => item.isPopular && item.availabilityStatus !== 'hidden')
		.slice(0, 6)
		.map((item) => ({
			id: item.id,
			name: pickLocalized(item.displayName, locale, defaultLocale) || item.displayName,
			imageUrl: resolveMediaUrl(item.imageUrl),
		}))
})()

const pageUrl = `${Astro.url.origin}${href(`/locations/${slug}`)}`
const structuredData =
	location
		? locationRestaurantStructuredData({
				origin: Astro.url.origin,
				name: menu?.organization?.name || organization.name,
				locale,
				locales: { locales: organization.locales?.length ? organization.locales : [defaultLocale], defaultLocale },
				logoUrl: resolveMediaUrl(organization.siteIcon?.original),
				location: {
					id: location.id,
					name: location.name,
					phone: location.phone,
					address: location.address,
					storeHours: location.storeHours,
					fulfillmentOptions: location.fulfillmentOptions,
					cuisines: location.cuisines,
					priceRange: priceRange || null,
				},
				pageUrl,
				multiLocation,
				hasMenu: canOrder,
				reservationsOnline: canReserve,
			})
		: null

const labels = {
	hours: i18n._(msg`Hours`),
	today: i18n._(msg`Today`),
	directions: i18n._(msg`Get directions`),
	order: i18n._(msg`Order online`),
	reserve: i18n._(msg`Book a table`),
	call: i18n._(msg`Call`),
	popular: i18n._(msg`Popular dishes`),
	allLocations: i18n._(msg`All locations`),
}
---

{outcome.kind === 'gone' ? (
	<GonePage
		organization={organization}
		title={i18n._(msg`Locations`)}
		backHref={href(multiLocation ? '/locations' : '/')}
		backLabel={multiLocation ? labels.allLocations : i18n._(msg`Go to the home page`)}
	/>
) : !location ? (
	<SiteNotFound organization={organization} />
) : (
	<SitePage
		organization={organization}
		page={{ id: `location-${location.id}`, title: name, slug: `locations/${slug}`, isHomePage: false, sections: [] }}
		title={`${title}`}
		description={description || undefined}
	>
		{structuredData ? (
			<script slot="head" type="application/ld+json" is:inline set:html={structuredData} />
		) : null}
		<div class:list={[siteContainer, 'py-12 sm:py-16']} data-location-page={location.id}>
			{multiLocation ? (
				<a href={href('/locations')} class="focus-ring text-sm text-muted-foreground hover:text-foreground">
					{labels.allLocations}
				</a>
			) : null}
			<header class="mt-3">
				<h1 class="text-3xl font-bold tracking-tight text-balance text-foreground sm:text-4xl" dir="auto">{name}</h1>
				{cuisines.length || priceRange ? (
					<p class="mt-2 text-base text-muted-foreground">
						{[cuisines.join(' · '), priceRange].filter(Boolean).join(' · ')}
					</p>
				) : null}
				{address ? <p class="mt-2 text-base text-foreground" dir="auto">{address}</p> : null}
			</header>
			<div class="mt-6 flex flex-wrap gap-3">
				{canOrder ? (
					<a class="btn-cta" href={`${href('/menu')}?location=${encodeURIComponent(location.id)}`} data-action="order">{labels.order}</a>
				) : null}
				{canReserve ? (
					<a class="btn-secondary" href={href('/reserve')} data-action="reserve">{labels.reserve}</a>
				) : null}
				{directions ? (
					<a class="btn-secondary" href={directions} rel="noopener" target="_blank" data-action="directions">{labels.directions}</a>
				) : null}
				{location.phone ? (
					<a class="btn-secondary" href={`tel:${location.phone.replace(/[^+\d]/g, '')}`} dir="ltr">{labels.call} {location.phone}</a>
				) : null}
			</div>
			{intro ? (
				<p class="mt-8 max-w-prose text-base leading-relaxed whitespace-pre-line text-foreground" dir="auto">{intro}</p>
			) : null}
			{hours.length ? (
				<section class="surface mt-10 max-w-md px-6 py-5">
					<h2 class="text-lg font-semibold text-foreground">{labels.hours}</h2>
					<dl class="mt-3 space-y-1 text-sm" data-hours>
						{hours.map((row) => (
							<div class:list={['flex justify-between gap-6', row.today && 'font-semibold text-foreground']}>
								<dt>{row.day}{row.today ? ` (${labels.today})` : ''}</dt>
								<dd class="tabular-nums">{row.text}</dd>
							</div>
						))}
					</dl>
				</section>
			) : null}
			{popular.length ? (
				<section class="mt-12">
					<h2 class="text-xl font-semibold text-foreground">{labels.popular}</h2>
					<ul class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3">
						{popular.map((dish) => (
							<li class="surface overflow-hidden">
								{dish.imageUrl ? (
									<img src={dish.imageUrl} alt="" loading="lazy" class="aspect-[4/3] w-full object-cover" />
								) : null}
								<p class="px-4 py-3 text-sm font-medium text-foreground" dir="auto">{dish.name}</p>
							</li>
						))}
					</ul>
				</section>
			) : null}
		</div>
	</SitePage>
)}
