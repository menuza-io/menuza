---
import { msg } from '@lingui/core/macro'
import { getLocalizedMenuValue } from '@repo/common/menu-types'
import { getLocaleHref } from '@repo/common/site-locales'
import SitePage from '~/components/SitePage.astro'
import DropAlertsSignup from '~/components/drops/DropAlertsSignup.astro'
import DropCard from '~/components/drops/DropCard.astro'
import DropHero from '~/components/drops/DropHero.astro'
import DropItemCard from '~/components/drops/DropItemCard.astro'
import DropSummaryCard from '~/components/drops/DropSummaryCard.astro'
import PickupPicker from '~/components/drops/PickupPicker.astro'
import CartDrawer from '~/components/ordering/CartDrawer.astro'
import CartTray from '~/components/ordering/CartTray.astro'
import ItemModal from '~/components/ordering/ItemModal.astro'
import OrderingLabels from '~/components/ordering/OrderingLabels.astro'
import StickyCategoryNav from '~/components/ordering/StickyCategoryNav.astro'
import {
	formatDropDate,
	formatDropDateTime,
	formatRemaining,
	getDropPhase,
} from '~/lib/drops/format'
import { resolveMediaUrl, siteContainer } from '~/lib/media'
import { buildOrderingLabels, translate } from '~/lib/ordering-labels'
import { buildIcsDataUrl } from '~/lib/ordering/calendar'
import { indexCatalog, isItemSoldOut, itemPriceLabel } from '~/lib/ordering/catalog'
import { remainingFor } from '~/lib/ordering/constraints'
import { fillTemplate, formatMoney } from '~/lib/ordering/money'
import {
	formatPickupAddress,
	formatWindow,
	pickupMapHref,
	pickupPhoneHref,
} from '~/lib/ordering/pickup'
import {
	type Constraints,
	type ModifierGroup,
	type ModifierOption,
	type OrderingCategory,
	type OrderingItem,
} from '~/lib/ordering/types'
import {
	fetchPublishedDrop,
	fetchPublishedDrops,
	fetchPublishedSiteMenu,
	type PublicMenuItemData,
	type PublicMenuOptionData,
	type PublicModifierGroupData,
} from '~/lib/org'

const organization = Astro.locals.organization
const i18n = Astro.locals.i18n
const orgSlug = Astro.locals.orgSlug
const customHost = Astro.locals.customHost
const dropSlug = Astro.params.slug
const url = new URL(Astro.request.url)
const isPreview = url.searchParams.get('preview') === 'true'

if (!dropSlug) {
	return new Response('Not Found', { status: 404 })
}

const dropData = await fetchPublishedDrop({
	slug: orgSlug,
	host: customHost,
	dropSlug,
	lng: Astro.locals.requestedLocale,
	preview: isPreview,
})

if (!dropData || !organization) {
	return new Response('Drop Not Found', { status: 404 })
}

const drop = dropData.drop
const defaultLocale = Astro.locals.defaultLocale || organization.defaultLocale || 'en'
const requestedLocale = Astro.locals.requestedLocale || organization.locale || defaultLocale
const localize = (value: string | null | undefined) =>
	getLocalizedMenuValue(value, requestedLocale, defaultLocale)
const now = new Date()
const currency = dropData.organization.currency || 'USD'
const phase = getDropPhase(drop, now)

// ---------- strings ----------

const labels = buildOrderingLabels(i18n)
const allDropsLabel = i18n._(msg`All drops`)
const dropAlertsUpcomingTitle = i18n._(msg`Get a text when orders open`)
const dropAlertsUpcomingBody = i18n._(msg`We'll text you when this drop and future ones open.`)
const dropAlertsEndedTitle = i18n._(msg`Missed this one?`)
const dropAlertsEndedBody = i18n._(msg`Get a text when the next drop opens, before it sells out.`)
const orderWindowLabel = i18n._(msg`Order window`)
const pickupLabel = i18n._(msg`Pickup`)
const whereLabel = i18n._(msg`Where`)
const addToCalendarLabel = i18n._(msg`Add to calendar`)
const ordersOpenBlockLabel = i18n._(msg`Orders open`)
const endedTitle = i18n._(msg`This drop has ended`)
const endedBody = i18n._(
	msg`Orders have closed for this drop and every pickup has gone out. Thanks for the support — see what's next below.`,
)
const moreDropsLabel = i18n._(msg`More drops`)
const viewMenuLabel = i18n._(msg`View menu`)
const viewOrderLabel = i18n._(msg`View order`)
const yourOrderLabel = i18n._(msg`Your Order`)
const subtotalLabel = i18n._(msg`Subtotal`)
const taxLabel = i18n._(msg`Estimated Tax`)
const deliveryFeeLabel = i18n._(msg`Delivery Fee`)
const totalLabel = i18n._(msg`Total`)
const checkoutLabel = i18n._(msg`Proceed to Checkout`)
const specialInstructionsLabel = i18n._(msg`Special Instructions`)
const specialInstructionsPlaceholder = i18n._(
	msg`Any dietary preferences, sauce on the side, etc.`,
)
const categoriesNavLabel = i18n._(msg`Menu categories`)
const choosePickupTimeLabel = i18n._(msg`Choose a pickup time to continue`)
const noPickupTimesLabel = i18n._(
	msg`No pickup times are available right now.`,
)
const noLongerAvailableLabel = i18n._(msg`No longer available`)
const changeLabel = i18n._(msg`Change`)
const timeRemainingLabel = i18n._(msg`Time remaining`)
const vegetarianLabel = i18n._(msg`Vegetarian`)
const glutenFreeLabel = i18n._(msg`Gluten-Free`)
const alcoholLabel = i18n._(msg`Alcohol`)
const dietaryLabels = {
	vegetarian: vegetarianLabel,
	glutenFree: glutenFreeLabel,
	alcohol: alcoholLabel,
}
/** Live countdown templates; filled client-side from the same JSON. */
const remainingLabels = {
	in: translate(i18n, msg`in {t}`, { t: '{t}' }),
	days: translate(i18n, msg`{n} days`, { n: '{n}' }),
	oneDay: i18n._(msg`1 day`),
	hoursMinutes: translate(i18n, msg`{h}h {m}m`, { h: '{h}', m: '{m}' }),
	minutes: translate(i18n, msg`{n} min`, { n: '{n}' }),
	lessThanMinute: i18n._(msg`less than a minute`),
}

const price = (amount: number) => formatMoney(amount, currency, requestedLocale)

// ---------- catalog ----------

function localizeOption(option: PublicMenuOptionData): ModifierOption {
	return {
		id: option.id,
		displayName: localize(option.displayName),
		description: option.description ? localize(option.description) : '',
		imageUrl: option.imageUrl ? resolveMediaUrl(option.imageUrl) : null,
		price: option.price ?? 0,
		priceWhole: option.priceWhole,
		priceLeft: option.priceLeft,
		priceRight: option.priceRight,
		calories: option.calories,
		minSelections: option.minSelections,
		maxSelections: option.maxSelections,
		isDefault: option.isDefault,
		availabilityStatus: option.availabilityStatus,
		nestedModifierGroups: (option.nestedModifierGroups ?? []).map(localizeGroup),
	}
}

function localizeGroup(group: PublicModifierGroupData): ModifierGroup {
	return {
		id: group.id,
		name: localize(group.name),
		selectionType: group.selectionType,
		minSelections: group.minSelections ?? 0,
		maxSelections: group.maxSelections ?? null,
		availabilityStatus: group.availabilityStatus,
		options: (group.options ?? []).map(localizeOption),
	}
}

function localizeItem(item: PublicMenuItemData): OrderingItem {
	return {
		id: item.id,
		displayName: localize(item.displayName),
		description: item.description ? localize(item.description) : '',
		price: item.price,
		imageUrl: item.imageUrl ? resolveMediaUrl(item.imageUrl) : null,
		variations: {
			groups: (item.variations?.groups ?? []).map((group) => ({
				id: group.id,
				name: localize(group.name),
				values: group.values.map((value) => ({
					id: value.id,
					name: localize(value.name),
				})),
			})),
			variants: (item.variations?.variants ?? []).map((variant) => ({
				...variant,
				imageUrl: variant.imageUrl ? resolveMediaUrl(variant.imageUrl) : null,
			})),
		},
		modifierGroups: (item.modifierGroups ?? []).map(localizeGroup),
		isVegetarian: item.isVegetarian,
		isGlutenFree: item.isGlutenFree,
		isAlcohol: item.isAlcohol,
		allergens: item.allergens ?? [],
		calorieMin: item.calorieMin,
		calorieMax: item.calorieMax,
		isPopular: item.isPopular,
		availabilityStatus: item.availabilityStatus,
		specialInstructions: drop.menu.specialInstructions !== false,
	}
}

const categories: OrderingCategory[] = dropData.categories
	.filter((category) => category.items.length > 0)
	.map((category) => ({
		id: category.id,
		displayName: localize(category.displayName),
		description: category.description ? localize(category.description) : '',
		items: category.items.map(localizeItem),
		subcategories: [],
	}))

const catalog = indexCatalog(categories)

// ---------- constraints (drop inventory) ----------

const categoryNames = new Map(
	dropData.categories.map((category) => [category.id, localize(category.displayName)]),
)
const itemRules: NonNullable<Constraints['items']> = {}
const categoryRules: NonNullable<Constraints['categories']> = {}
for (const override of dropData.inventoryOverrides) {
	if (override.entityType === 'item') {
		itemRules[override.entityId] = {
			inventory: override.inventory,
			maxPerOrder: override.maxPerOrder,
		}
	} else {
		categoryRules[override.entityId] = {
			inventory: override.inventory,
			maxPerOrder: override.maxPerOrder,
			name: categoryNames.get(override.entityId) ?? '',
		}
	}
}
const constraints: Constraints = {
	items: itemRules,
	categories: categoryRules,
	itemCategoryIds: Object.fromEntries(catalog.itemCategoryIds),
	showInventory: drop.showInventoryRemaining !== false,
}

/** Card tag wording: "Only 3 left", "Limit 2 per order" — the tightest rule wins. */
const LOW_STOCK_THRESHOLD = 5
function cardProps(item: OrderingItem) {
	const cap = remainingFor(item.id, [], constraints)
	const max = cap.max ?? 0
	// `max` is null when no inventory/limit rule applies (unlimited), so only an
	// explicit 0 means the drop inventory is exhausted.
	const soldOut = isItemSoldOut(item) || cap.max === 0
	const priceLabel = itemPriceLabel(item, {
		formatMoney: price,
		fromLabel: labels.from,
		soldOutLabel: labels.soldOut,
	})
	let note: string | null = null
	let noteTone: 'warning' | 'neutral' = 'warning'
	if (!soldOut && cap.reason) {
		if (cap.reason === 'limit') {
			note = fillTemplate(labels.limitNPerOrder, { count: cap.limit ?? max })
			noteTone = 'neutral'
		} else if (constraints.showInventory !== false) {
			if (
				cap.reason === 'inventory' &&
				(cap.remaining ?? 0) > 0 &&
				(cap.remaining ?? 0) <= LOW_STOCK_THRESHOLD
			) {
				note = fillTemplate(labels.onlyNLeft, { count: cap.remaining ?? 0 })
			} else if (
				cap.reason === 'category-inventory' &&
				max > 0 &&
				max <= LOW_STOCK_THRESHOLD
			) {
				note = fillTemplate(labels.onlyNLeftIn, {
					count: max,
					category: cap.categoryName ?? '',
				})
			}
		}
	}
	return {
		id: item.id,
		name: item.displayName,
		description: item.description,
		priceLabel: soldOut ? labels.soldOut : priceLabel,
		soldOut,
		imageUrl: item.imageUrl,
		note,
		noteTone,
		soldOutLabel: labels.soldOut,
		calories: caloriesFor(item),
		isVegetarian: item.isVegetarian,
		isGlutenFree: item.isGlutenFree,
		isAlcohol: item.isAlcohol,
		labels: dietaryLabels,
	}
}

function caloriesFor(item: OrderingItem): string | null {
	if (!item.calorieMin) return null
	if (item.calorieMax && item.calorieMax !== item.calorieMin) {
		return translate(i18n, msg`{min}–{max} Cal`, {
			min: item.calorieMin,
			max: item.calorieMax,
		})
	}
	return translate(i18n, msg`{count} Cal`, { count: item.calorieMin })
}

const navItems = categories.map((category) => ({
	id: category.id,
	label: category.displayName,
}))

// ---------- pickup windows ----------

const pickupWindows = dropData.pickupWindows.map((window) => ({
	...window,
	location: window.location
		? {
				...window.location,
				name: localize(window.location.name),
			}
		: null,
}))
const windowsWithLocation = pickupWindows.filter((window) => window.location)
const primaryTimeZone = windowsWithLocation.find(
	(window) => window.location?.timezone,
)?.location?.timezone ?? null
const factsTimeZone = primaryTimeZone ?? 'UTC'
const hasPickupWindows = windowsWithLocation.length > 0

// Locations for the "Where" disclosure, each with its window times.
const whereLocations: Array<{
	id: string
	name: string
	addressLine: string
	mapHref: string
	phone: string | null
	phoneHref: string | null
	windows: string[]
}> = []
for (const window of windowsWithLocation) {
	const location = window.location!
	const existing = whereLocations.find((entry) => entry.id === window.locationId)
	if (existing) {
		existing.windows.push(formatWindow(window, requestedLocale))
		continue
	}
	const name = location.name
	whereLocations.push({
		id: window.locationId,
		name,
		addressLine: formatPickupAddress(location.address),
		mapHref: pickupMapHref({ name, address: location.address }),
		phone: location.phone,
		phoneHref: pickupPhoneHref(location.phone),
		windows: [formatWindow(window, requestedLocale)],
	})
}
const whereSummary =
	whereLocations.length === 0
		? null
		: whereLocations.length === 1
			? whereLocations[0]!.name
			: `${whereLocations[0]!.name} ${translate(i18n, msg`+{n} more`, {
					n: whereLocations.length - 1,
				})}`

const uniqueDates = Array.from(new Set(pickupWindows.map((w) => w.date))).sort()
const pickupFactText =
	uniqueDates.length === 0
		? null
		: uniqueDates.length === 1 && windowsWithLocation[0]
			? formatWindow(windowsWithLocation[0], requestedLocale)
			: `${formatDropDate(uniqueDates[0]!, requestedLocale, factsTimeZone)} ${translate(
					i18n,
					msg`+{n} more`,
					{ n: uniqueDates.length - 1 },
				)}`

// Tax rates per pickup location (the menu payload is the only public source).
const menuPayload = await fetchPublishedSiteMenu({
	slug: orgSlug,
	host: customHost,
	lng: requestedLocale,
})
const locationTaxRates: Record<string, number> = {}
for (const location of menuPayload?.locations ?? []) {
	locationTaxRates[location.id] = location.taxRate ?? 0
}

// ---------- order window facts ----------

const openAt = drop.ordersOpenAt ? new Date(drop.ordersOpenAt) : null
const closeAt = drop.ordersCloseAt ? new Date(drop.ordersCloseAt) : null
const sameYear = (instant: Date | null) =>
	Boolean(instant && instant.getUTCFullYear() === now.getUTCFullYear())
const formatWhen = (instant: Date | null) =>
	instant
		? formatDropDateTime(instant, requestedLocale, factsTimeZone, {
				year: !sameYear(instant),
			})
		: ''
const openWhen = formatWhen(openAt)
const closeWhen = formatWhen(closeAt)
const openMsLeft = openAt ? openAt.getTime() - now.getTime() : 0
const closeMsLeft = closeAt ? closeAt.getTime() - now.getTime() : 0
const remainingText = (ms: number) =>
	ms > 0 ? formatRemaining(ms, remainingLabels, requestedLocale) : ''

const dropHref = getLocaleHref(
	`/drop/${encodeURIComponent(drop.slug)}`,
	requestedLocale,
	requestedLocale,
	defaultLocale,
)
const dropsHref = getLocaleHref('/drops', requestedLocale, requestedLocale, defaultLocale)
const menuHref = getLocaleHref('/menu', requestedLocale, requestedLocale, defaultLocale)
const checkoutHref =
	getLocaleHref('/menu/checkout', requestedLocale, requestedLocale, defaultLocale) +
	`?drop=${encodeURIComponent(drop.slug)}`

const openCalendarHref =
	phase === 'upcoming' && openAt
		? buildIcsDataUrl({
				title: translate(i18n, msg`Orders open: {title}`, {
					title: localize(drop.title),
				}),
				start: openAt,
				end: new Date(openAt.getTime() + 30 * 60_000),
				description: drop.description ? localize(drop.description) : null,
				url: new URL(dropHref, Astro.url.origin).toString(),
				now,
			})
		: null

const facts: Array<{
	id: string
	label: string
	text: string
	countdown?: { kind: 'open' | 'close'; initial: string; label: string } | null
	calendar?: { href: string; fileName: string } | null
}> = []
// Without a menu preview the main column shows its own "Orders open" card with
// the calendar button, so the fact skips it.
const showUpcomingCard =
	phase === 'upcoming' && !(drop.showMenuPreview && categories.length > 0)
if (phase === 'live' && closeWhen) {
	facts.push({
		id: 'drop-fact-order-window',
		label: orderWindowLabel,
		text: translate(i18n, msg`Orders close {when}`, { when: closeWhen }),
		countdown:
			closeMsLeft > 0
				? { kind: 'close', initial: remainingText(closeMsLeft), label: timeRemainingLabel }
				: null,
	})
}
if (phase === 'upcoming' && openWhen) {
	facts.push({
		id: 'drop-fact-order-window',
		label: orderWindowLabel,
		text: translate(i18n, msg`Orders open {when}`, { when: openWhen }),
		countdown:
			openMsLeft > 0
				? { kind: 'open', initial: remainingText(openMsLeft), label: ordersOpenBlockLabel }
				: null,
		calendar: openCalendarHref && !showUpcomingCard
			? { href: openCalendarHref, fileName: `${drop.slug}-orders-open.ics` }
			: null,
	})
}
if (pickupFactText) {
	facts.push({ id: 'drop-fact-pickup', label: pickupLabel, text: pickupFactText })
}

// Ended drops point at the other live/upcoming drops instead.
const otherDrops =
	phase === 'ended'
		? (await fetchPublishedDrops({ slug: orgSlug, host: customHost }))
				.filter((listing) => listing.slug !== drop.slug)
				.filter((listing) => getDropPhase(listing, now) !== 'ended')
				.slice(0, 3)
		: []

const previewHeader = translate(i18n, msg`Preview · ordering opens {when}`, {
	when: openWhen,
})

const clientData = {
	organizationId: organization.id,
	dropId: drop.id,
	dropSlug: drop.slug,
	currency,
	locale: requestedLocale,
	phase,
	ordersOpenAt: drop.ordersOpenAt,
	ordersCloseAt: drop.ordersCloseAt,
	checkoutHref,
	categories,
	constraints,
	pickupWindows,
	locationTaxRates,
	labels: {
		remaining: remainingLabels,
		choosePickupTime: choosePickupTimeLabel,
		noPickupTimes: noPickupTimesLabel,
		noLongerAvailable: noLongerAvailableLabel,
		change: changeLabel,
		pickup: pickupLabel,
	},
}
---

<SitePage
	organization={organization}
	page={{
		id: `drop-${drop.id}`,
		title: localize(drop.title),
		slug: `drop/${drop.slug}`,
		isHomePage: false,
		sections: [],
	}}
	title={`${localize(drop.title)} - ${organization.name}`}
	description={drop.description ? localize(drop.description) : undefined}
	noIndex={drop.visibility === 'unlisted'}
>
	<div class="bg-background pb-32 lg:pb-28">
		<div class:list={[siteContainer, 'pt-4 sm:pt-6']}>
			<a
				href={dropsHref}
				class="focus-ring -ms-1 mb-4 inline-flex min-h-9 items-center gap-1 rounded-md px-1 text-sm font-semibold text-muted-foreground transition-colors duration-150 ease-out hover:text-foreground"
			>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 rtl:-scale-x-100" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
				{allDropsLabel}
			</a>

			<div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-x-10 lg:gap-y-8">
				<div class="min-w-0 lg:col-start-1 lg:row-start-1">
					<DropHero
						coverUrl={drop.coverImageUrl ? resolveMediaUrl(drop.coverImageUrl) : null}
						title={localize(drop.title)}
						description={drop.description ? localize(drop.description) : null}
						phase={phase}
						ordersOpenAt={drop.ordersOpenAt}
						ordersCloseAt={drop.ordersCloseAt}
						locale={requestedLocale}
						timeZone={primaryTimeZone}
					/>
				</div>

				<aside class="min-w-0 lg:sticky lg:top-[5.75rem] lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:self-start">
					<DropSummaryCard
						facts={facts}
						where={
							whereSummary && whereLocations.length > 0
								? { label: whereLabel, summary: whereSummary, locations: whereLocations }
								: null
						}
					>
						{phase === 'live' && hasPickupWindows ? <PickupPicker /> : null}
					</DropSummaryCard>
				</aside>

				<div class="min-w-0 lg:col-start-1 lg:row-start-2">
					{phase === 'live' ? (
						<StickyCategoryNav
							id="drop-sticky-nav"
							items={navItems}
							label={categoriesNavLabel}
							layout="column"
						/>
					) : null}

					{phase === 'live' ? (
						<div class:list={[navItems.length > 0 && 'pt-6', 'space-y-10 sm:space-y-12']}>
							{categories.map((category) => (
								<section
									id={`category-${category.id}`}
									data-category-section
									class="scroll-mt-32"
									aria-labelledby={`category-${category.id}-title`}
								>
									<header class="mb-4">
										<h2
											id={`category-${category.id}-title`}
											class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl"
										>
											{category.displayName}
										</h2>
										{category.description ? (
											<p class="mt-1 line-clamp-2 text-sm text-muted-foreground">{category.description}</p>
										) : null}
									</header>
									<ul class="grid grid-cols-1 gap-3 md:grid-cols-2 md:gap-4">
										{category.items.map((item) => (
											<DropItemCard {...cardProps(item)} />
										))}
									</ul>
								</section>
							))}
						</div>
					) : null}

					{phase === 'upcoming' ? (
						drop.showMenuPreview && categories.length > 0 ? (
							<div class="space-y-10 sm:space-y-12">
								<div class="tone-warning flex items-start gap-3 rounded-lg border p-3 text-sm sm:p-4">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 size-5 shrink-0" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
									<p class="bidi-isolate font-semibold text-foreground">{previewHeader}</p>
								</div>
								{categories.map((category) => (
									<section aria-labelledby={`preview-${category.id}-title`}>
										<header class="mb-4">
											<h2
												id={`preview-${category.id}-title`}
												class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl"
											>
												{category.displayName}
											</h2>
											{category.description ? (
												<p class="mt-1 line-clamp-2 text-sm text-muted-foreground">{category.description}</p>
											) : null}
										</header>
										<ul class="grid grid-cols-1 gap-3 md:grid-cols-2 md:gap-4">
											{category.items.map((item) => (
												<DropItemCard {...cardProps(item)} readonly />
											))}
										</ul>
									</section>
								))}
							</div>
						) : (
							<div class="surface flex flex-col items-center gap-3 px-6 py-10 text-center sm:p-10">
								<span class="flex size-12 items-center justify-center rounded-xl bg-muted text-muted-foreground">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="size-6" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
								</span>
								<p class="eyebrow">{ordersOpenBlockLabel}</p>
								<p class="bidi-isolate font-heading text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
									{openWhen}
								</p>
								{openCalendarHref ? (
									<a
										href={openCalendarHref}
										download={`${drop.slug}-orders-open.ics`}
										class="btn-cta mt-3"
									>
										<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M12 14v6M9 17h6"/></svg>
										{addToCalendarLabel}
									</a>
								) : null}
							</div>
						)
					) : null}

					{phase === 'upcoming' ? (
						<DropAlertsSignup
							source="drop_page"
							title={dropAlertsUpcomingTitle}
							body={dropAlertsUpcomingBody}
							class="mt-6"
						/>
					) : null}

					{phase === 'ended' ? (
						<div class="space-y-10 sm:space-y-12">
							<div class="surface flex flex-col items-center gap-3 px-6 py-12 text-center">
								<span class="flex size-12 items-center justify-center rounded-xl bg-muted text-muted-foreground">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="size-6" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18M9.5 14.5l5 5M14.5 14.5l-5 5" /></svg>
								</span>
								<h2 class="text-base font-semibold text-foreground">{endedTitle}</h2>
								<p class="max-w-sm text-sm text-muted-foreground">{endedBody}</p>
								<a href={menuHref} class="btn-secondary mt-2">{viewMenuLabel}</a>
							</div>

							<DropAlertsSignup
								source="drop_page"
								title={dropAlertsEndedTitle}
								body={dropAlertsEndedBody}
							/>

							{otherDrops.length > 0 ? (
								<section aria-labelledby="other-drops-heading">
									<h2 id="other-drops-heading" class="mb-4 text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
										{moreDropsLabel}
									</h2>
									<div class="grid gap-4 sm:grid-cols-2">
										{otherDrops.map((listing) => (
											<DropCard
												drop={listing}
												locale={requestedLocale}
												defaultLocale={defaultLocale}
												variant="full"
												now={now}
											/>
										))}
									</div>
								</section>
							) : null}
						</div>
					) : null}
				</div>
			</div>
		</div>

		{phase === 'live' ? (
			<>
				<CartTray labels={{ viewOrder: viewOrderLabel }} initialTotal={price(0)} />

				<ItemModal
					labels={{
						customizeItem: labels.customizeItem,
						specialInstructions: specialInstructionsLabel,
						specialInstructionsPlaceholder,
						quantity: labels.quantity,
						addToOrder: labels.addToOrder,
						close: labels.closeDialog,
					}}
				/>

				<CartDrawer
					labels={{
						yourOrder: yourOrderLabel,
						subtotal: subtotalLabel,
						tax: taxLabel,
						deliveryFee: deliveryFeeLabel,
						total: totalLabel,
						checkout: checkoutLabel,
						close: labels.closeDialog,
					}}
					checkoutHref={checkoutHref}
					initialTotal={price(0)}
				/>

				<OrderingLabels labels={labels} />
			</>
		) : null}
	</div>

	<script
		id="drop-data"
		type="application/json"
		is:inline
		set:html={JSON.stringify(clientData).replace(/</g, '\\u003c')}
	/>

	<script>
		import {
			formatDropDate,
			formatDropTime,
			formatRemaining as formatRemainingWith,
			type DropPhase,
		} from '~/lib/drops/format'
		import { indexCatalog } from '~/lib/ordering/catalog'
		import { createCartStore } from '~/lib/ordering/cart-store'
		import { mountCartUi } from '~/lib/ordering/cart-ui'
		import { startCountdown } from '~/lib/ordering/countdown'
		import { el, prefersReducedMotion } from '~/lib/ordering/dom'
		import { createItemModal } from '~/lib/ordering/item-modal'
		import { createMoneyFormatter } from '~/lib/ordering/money'
		import {
			buildPickupOptions,
			formatSlot,
			loadPickupSelection,
			resolvePickup,
			savePickupSelection,
			type PickupWindowData,
			type ResolvedPickup,
		} from '~/lib/ordering/pickup'
		import { mountScrollSpy } from '~/lib/ordering/scroll-spy'
		import {
			type Constraints,
			type OrderingCategory,
			type OrderingLabels,
		} from '~/lib/ordering/types'

		type DropData = {
			organizationId: string
			dropId: string
			dropSlug: string
			currency: string
			locale: string
			phase: DropPhase
			ordersOpenAt: string | null
			ordersCloseAt: string | null
			checkoutHref: string
			categories: OrderingCategory[]
			constraints: Constraints | null
			pickupWindows: PickupWindowData[]
			locationTaxRates: Record<string, number>
			labels: {
				remaining: {
					in: string
					days: string
					oneDay: string
					hoursMinutes: string
					minutes: string
					lessThanMinute: string
				}
				choosePickupTime: string
				noPickupTimes: string
				noLongerAvailable: string
				change: string
				pickup: string
			}
		}

		function readJson<T>(id: string): T {
			return JSON.parse(document.getElementById(id)?.textContent || '{}') as T
		}

		const data = readJson<DropData>('drop-data')
		const labels = readJson<OrderingLabels>('ordering-labels')
		const DAY_MS = 24 * 60 * 60 * 1000

		// ---------- order-window countdowns ----------

		function paintCountdown(kind: 'open' | 'close', ms: number) {
			const text = formatRemainingWith(ms, data.labels.remaining, data.locale)
			document
				.querySelectorAll<HTMLElement>(`[data-drop-countdown="${kind}"]`)
				.forEach((node) => {
					// The fact countdown appears only inside the last day.
					const withinDay = ms > 0 && ms < DAY_MS
					node.classList.toggle('hidden', !withinDay)
					if (withinDay) node.textContent = ` (${text})`
				})
			document
				.querySelectorAll<HTMLElement>(`[data-drop-countdown-always="${kind}"]`)
				.forEach((node) => {
					node.textContent = text
				})
		}

		if (data.phase === 'live' && data.ordersCloseAt) {
			startCountdown(
				new Date(data.ordersCloseAt),
				(ms) => paintCountdown('close', ms),
				() => window.location.reload(),
			)
		} else if (data.phase === 'upcoming' && data.ordersOpenAt) {
			startCountdown(
				new Date(data.ordersOpenAt),
				(ms) => paintCountdown('open', ms),
				() => window.location.reload(),
			)
		}

		// ---------- ordering engine (live drops) ----------

		if (data.phase === 'live') mountOrdering()

		function mountOrdering() {
			const catalog = indexCatalog(data.categories ?? [])
			const store = createCartStore({
				key: `menuza_drop_cart_${data.organizationId}_${data.dropId}`,
			})
			const money = createMoneyFormatter(data.currency, data.locale)

			const modalRoot = document.getElementById('item-modal-backdrop')
			const modal = modalRoot
				? createItemModal({
						root: modalRoot,
						getItem: (id) => catalog.items.get(id),
						labels,
						formatMoney: money,
						constraints: data.constraints,
						cartLines: () => store.lines(),
						onAdd: (line) => store.add(line),
					})
				: null

			// ---------- pickup picker ----------

			const options = buildPickupOptions(data.pickupWindows ?? [])
			const picker = {
				locationStep: document.getElementById('pickup-location-step'),
				locationChips: document.getElementById('pickup-location-chips'),
				dateStep: document.getElementById('pickup-date-step'),
				dateChips: document.getElementById('pickup-date-chips'),
				slotStep: document.getElementById('pickup-slot-step'),
				slotChips: document.getElementById('pickup-slot-chips'),
				summary: document.getElementById('pickup-selected-summary'),
			}

			const restored = resolvePickup(options, loadPickupSelection(data.dropId))
			let selectedLocationId: string | null =
				restored?.location.locationId ??
				(options.length === 1 ? options[0]!.locationId : null)
			let selectedDate: string | null = restored?.date.date ?? null
			if (!selectedDate) {
				const single = options.find((o) => o.locationId === selectedLocationId)
				if (single && single.dates.length === 1) selectedDate = single.dates[0]!.date
			}
			let selectedSlotStart: string | null = restored?.slot.start ?? null
			let resolved: ResolvedPickup | null = null
			let anySlotAvailable = options.some((location) =>
				location.dates.some((date) => date.slots.some((slot) => slot.available)),
			)

			// Cart totals read this object on every refresh, so moving the pickup
			// moves the tax with it.
			const totals = {
				taxRate: 0,
				deliveryFee: 0,
				mode: () => 'pickup' as const,
			}

			// `chip` styles its own active (aria-checked) and :disabled states, so
			// the swapped sets stay minimal.
			const CHIP_BASE = 'chip min-h-11 max-w-full focus-ring'
			const CHIP_ON = 'is-active'
			const CHIP_OFF = ''
			const CHIP_DISABLED = ''

			function chip(
				label: string,
				on: boolean,
				disabled: boolean,
				onSelect: () => void,
				note?: string,
			) {
				const button = el(
					'button',
					`${CHIP_BASE} ${disabled ? CHIP_DISABLED : on ? CHIP_ON : CHIP_OFF}`,
				)
				button.type = 'button'
				button.setAttribute('role', 'radio')
				button.setAttribute('aria-checked', on ? 'true' : 'false')
				if (note) {
					button.classList.add('flex-col', 'gap-0.5', 'py-1')
					button.appendChild(el('span', 'price', label))
					button.appendChild(el('span', 'text-xs font-normal leading-tight opacity-80', note))
				} else {
					button.appendChild(el('span', 'bidi-isolate truncate', label))
				}
				button.disabled = disabled
				button.addEventListener('click', () => {
					if (disabled) return
					onSelect()
				})
				return button
			}

			function checkIcon() {
				const ns = 'http://www.w3.org/2000/svg'
				const svg = document.createElementNS(ns, 'svg')
				svg.setAttribute('viewBox', '0 0 24 24')
				svg.setAttribute('fill', 'none')
				svg.setAttribute('stroke', 'currentColor')
				svg.setAttribute('stroke-width', '2.25')
				svg.setAttribute('stroke-linecap', 'round')
				svg.setAttribute('stroke-linejoin', 'round')
				svg.setAttribute('aria-hidden', 'true')
				svg.setAttribute('class', 'mt-0.5 size-4 shrink-0')
				const path = document.createElementNS(ns, 'path')
				path.setAttribute('d', 'M20 6 9 17l-5-5')
				svg.appendChild(path)
				return svg
			}

			function renderPicker() {
				const location =
					options.find((o) => o.locationId === selectedLocationId) ?? null
				const dates = location?.dates ?? []
				const date = dates.find((d) => d.date === selectedDate) ?? null

				if (picker.locationStep && picker.locationChips) {
					// A single location needs no choice; it is pre-selected.
					picker.locationStep.classList.toggle('hidden', options.length <= 1)
					picker.locationChips.replaceChildren(
						...options.map((option) =>
							chip(option.name, option.locationId === selectedLocationId, false, () => {
								selectedLocationId = option.locationId
								selectedDate =
									option.dates.length === 1 ? option.dates[0]!.date : null
								selectedSlotStart = null
								refreshPickup()
							}),
						),
					)
				}

				if (picker.dateStep && picker.dateChips) {
					picker.dateStep.classList.toggle('hidden', !location || dates.length <= 1)
					if (location && dates.length > 1) {
						picker.dateChips.replaceChildren(
							...dates.map((option) =>
								chip(
									formatDropDate(option.date, data.locale, location.timezone),
									option.date === selectedDate,
									false,
									() => {
										selectedDate = option.date
										selectedSlotStart = null
										refreshPickup()
									},
								),
							),
						)
					}
				}

				if (picker.slotStep && picker.slotChips) {
					picker.slotStep.classList.toggle('hidden', !date)
					if (date && location) {
						picker.slotChips.replaceChildren(
							...date.slots.map((slot) =>
								chip(
									slot.startInstant
										? formatDropTime(slot.startInstant, data.locale, location.timezone)
										: slot.start,
									slot.start === selectedSlotStart,
									!slot.available,
									() => {
										selectedSlotStart = slot.start
										refreshPickup()
									},
									!slot.available ? data.labels.noLongerAvailable : undefined,
								),
							),
						)
					}
				}

				if (picker.summary) {
					if (resolved) {
						const text = el('span', 'min-w-0 font-semibold text-foreground')
						text.append(
							`${data.labels.pickup}: ${resolved.location.name} · `,
							el(
								'bdi',
								undefined,
								formatSlot(
									resolved.date.date,
									resolved.slot.start,
									data.locale,
									resolved.location.timezone,
								),
							),
						)
						picker.summary.replaceChildren(checkIcon(), text)
						picker.summary.classList.remove('hidden')
					} else {
						picker.summary.textContent = ''
						picker.summary.classList.add('hidden')
					}
				}
			}

			function refreshPickup() {
				const location =
					options.find((o) => o.locationId === selectedLocationId) ?? null
				const date = location?.dates.find((d) => d.date === selectedDate) ?? null
				const slot =
					date?.slots.find((s) => s.start === selectedSlotStart && s.available) ?? null
				resolved =
					location && date && slot
						? resolvePickup(options, {
								locationId: location.locationId,
								date: date.date,
								slotStart: slot.start,
								slotEnd: slot.end,
							})
						: null
				if (resolved) savePickupSelection(data.dropId, resolved.selection)
				else if (selectedSlotStart && !slot) selectedSlotStart = null
				// Lead time can pass while the page sits open; re-check so the
				// gate's reason stays honest.
				anySlotAvailable = options.some((candidate) =>
					candidate.dates.some((d) => d.slots.some((s) => s.available)),
				)
				totals.taxRate = resolved
					? (data.locationTaxRates[resolved.location.locationId] ?? 0)
					: 0
				renderPicker()
				cartUi.refresh()
			}

			function renderDrawerPickup(slot: HTMLElement) {
				slot.replaceChildren()
				if (!resolved) return
				const card = el('div', 'mt-2 rounded-md bg-muted px-3 py-2.5 text-sm')
				card.appendChild(
					el(
						'p',
						'font-semibold text-foreground',
						`${data.labels.pickup}: ${resolved!.location.name}`,
					),
				)
				card.appendChild(
					el(
						'p',
						'bidi-isolate text-muted-foreground',
						formatSlot(
							resolved!.date.date,
							resolved!.slot.start,
							data.locale,
							resolved!.location.timezone,
						),
					),
				)
				const change = el(
					'button',
					'focus-ring mt-1 rounded-sm font-semibold text-foreground underline underline-offset-4',
					data.labels.change,
				)
				change.type = 'button'
				change.addEventListener('click', () => {
					cartUi.close()
					document.getElementById('pickup-picker')?.scrollIntoView({
						behavior: prefersReducedMotion() ? 'auto' : 'smooth',
						block: 'center',
					})
				})
				card.appendChild(change)
				slot.appendChild(card)
			}

			const cartUi = mountCartUi({
				store,
				labels,
				formatMoney: money,
				totals,
				gate: () =>
					resolved
						? { allowed: true }
						: {
								allowed: false,
								reason: anySlotAvailable
									? data.labels.choosePickupTime
									: data.labels.noPickupTimes,
							},
				constraints: data.constraints,
				renderHeaderExtra: (slot) => renderDrawerPickup(slot),
			})

			refreshPickup()

			// Item cards open the shared item modal.
			document.addEventListener('click', (event) => {
				const target = event.target as HTMLElement | null
				const card = target?.closest<HTMLElement>('.js-item-card')
				if (!card || !modal) return
				if (card.dataset.soldOut === 'true') return
				if (card instanceof HTMLButtonElement && card.disabled) return
				const itemId = card.dataset.itemId
				if (!itemId) return
				const opener = card.querySelector<HTMLElement>('button') ?? card
				modal.open(itemId, opener)
			})
			modal?.openFromUrl()

			// Category navigation with scroll-spy.
			const navs = Array.from(
				document.querySelectorAll<HTMLElement>('[data-category-nav]'),
			)
			const sections = Array.from(
				document.querySelectorAll<HTMLElement>('[data-category-section]'),
			)
			const siteHeader = document.querySelector<HTMLElement>('header')
			const stickyNav = document.getElementById('drop-sticky-nav')
			if (navs.length && sections.length) {
				mountScrollSpy({
					nav: navs,
					sections,
					offset: () =>
						(siteHeader?.offsetHeight ?? 0) +
						(stickyNav && stickyNav.offsetParent !== null
							? stickyNav.offsetHeight
							: 16),
				})
			}
		}
	</script>
</SitePage>
