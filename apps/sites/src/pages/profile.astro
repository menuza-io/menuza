---
import { msg } from '@lingui/core/macro'
import SitePage from '~/components/SitePage.astro'

const organization = Astro.locals.organization
const i18n = Astro.locals.i18n
const yourProfile = i18n._(msg`Your Profile`)
const updateDetails = i18n._(msg`Update your basic details below.`)
const nameLabel = i18n._(msg`Name`)
const emailLabel = i18n._(msg`Email`)
const phoneNumber = i18n._(msg`Phone Number`)
const phoneCannotChange = i18n._(msg`Phone number cannot be changed at this time.`)
const saveChanges = i18n._(msg`Save Changes`)
const saving = i18n._(msg`Saving...`)
const profileUpdated = i18n._(msg`Profile updated successfully!`)
const somethingWentWrong = i18n._(msg`Something went wrong.`)
const networkError = i18n._(msg`Network error. Please try again.`)
const orderHistory = i18n._(msg`Order history`)
const orderHistoryHint = i18n._(msg`Purchases from the shop while signed in.`)
const noOrders = i18n._(msg`No orders yet.`)
const browseShop = i18n._(msg`Browse the shop`)
const paymentMethods = i18n._(msg`Payment methods`)
const paymentMethodsHint = i18n._(
	msg`Cards used on past shop purchases on this account.`,
)
const noPaymentMethods = i18n._(msg`No saved payment methods yet.`)
const expires = i18n._(msg`Expires`)

if (!organization) {
	return new Response('Not Found', { status: 404, statusText: 'Not Found' })
}
---

<SitePage
	organization={organization}
	page={{ id: 'profile', title: yourProfile, slug: 'profile', isHomePage: false, sections: [] }}
	title={`${yourProfile} - ${organization.name}`}
>
	<div
		id="profile-page-root"
		class="mx-auto flex min-h-[60vh] w-full max-w-lg flex-col gap-6 px-4 py-12"
		data-no-orders={noOrders}
		data-no-payment-methods={noPaymentMethods}
		data-expires={expires}
	>
		<div class="w-full rounded-xl border border-border bg-card p-6 shadow-sm sm:p-8">
			<div class="mb-6 flex flex-col space-y-2 text-center">
				<h1 class="font-heading text-2xl tracking-tight text-foreground">
					{yourProfile}
				</h1>
				<p class="text-sm text-muted-foreground">
					{updateDetails}
				</p>
			</div>

			<form
				id="profile-form"
				class="space-y-4"
				data-save={saveChanges}
				data-saving={saving}
				data-error={somethingWentWrong}
				data-network={networkError}
			>
				<div class="space-y-2">
					<label for="name" class="text-sm font-medium leading-none text-foreground">
						{nameLabel}
					</label>
					<input
						type="text"
						id="name"
						name="name"
						required
						placeholder="Jane Doe"
						class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm text-foreground ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
					/>
				</div>

				<div class="space-y-2">
					<label for="email" class="text-sm font-medium leading-none text-foreground">
						{emailLabel}
					</label>
					<input
						type="email"
						id="email"
						name="email"
						placeholder="jane@example.com"
						class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm text-foreground ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
					/>
				</div>

				<div class="space-y-2">
					<label for="phone" class="text-sm font-medium leading-none text-foreground">
						{phoneNumber}
					</label>
					<input
						type="tel"
						id="phone"
						name="phone"
						required
						readonly
						disabled
						placeholder="+1234567890"
						class="flex h-10 w-full rounded-md border border-input bg-muted/50 px-3 py-2 text-sm text-muted-foreground ring-offset-background cursor-not-allowed opacity-75"
					/>
					<p class="text-xs text-muted-foreground">
						{phoneCannotChange}
					</p>
				</div>

				<div id="error-message" class="hidden text-sm font-medium text-destructive"></div>
				<div id="success-message" class="hidden text-sm font-medium text-green-500">{profileUpdated}</div>

				<button
					type="submit"
					id="submit-button"
					class="inline-flex h-10 w-full items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground ring-offset-background transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50"
				>
					{saveChanges}
				</button>
			</form>
		</div>

		<div class="w-full rounded-xl border border-border bg-card p-6 shadow-sm sm:p-8">
			<div class="mb-4 space-y-1">
				<h2 class="font-heading text-lg text-foreground">{orderHistory}</h2>
				<p class="text-sm text-muted-foreground">{orderHistoryHint}</p>
			</div>
			<ul id="order-history" class="divide-y rounded-lg border">
				<li class="px-4 py-6 text-center text-sm text-muted-foreground">{noOrders}</li>
			</ul>
			<a
				href="/shop"
				class="mt-4 inline-flex text-sm font-medium text-primary hover:underline"
			>
				{browseShop}
			</a>
		</div>

		<div class="w-full rounded-xl border border-border bg-card p-6 shadow-sm sm:p-8">
			<div class="mb-4 space-y-1">
				<h2 class="font-heading text-lg text-foreground">{paymentMethods}</h2>
				<p class="text-sm text-muted-foreground">{paymentMethodsHint}</p>
			</div>
			<ul id="payment-methods" class="divide-y rounded-lg border">
				<li class="px-4 py-6 text-center text-sm text-muted-foreground">{noPaymentMethods}</li>
			</ul>
		</div>
	</div>

	<script>
		import '../scripts/profile-page.ts'
	</script>
</SitePage>
