---
import { msg } from '@lingui/core/macro'
import SitePage from '~/components/SitePage.astro'

const organization = Astro.locals.organization
const i18n = Astro.locals.i18n
const whatsYourName = i18n._(msg`What's your name?`)
const nameHint = i18n._(msg`We'll use this on your profile. You can change it later.`)
const fullName = i18n._(msg`Full name`)
const continueLabel = i18n._(msg`Continue`)
const saving = i18n._(msg`Saving...`)
const somethingWentWrong = i18n._(msg`Something went wrong.`)
const networkError = i18n._(msg`Network error. Please try again.`)

if (!organization) {
	return new Response('Not Found', { status: 404, statusText: 'Not Found' })
}
---

<SitePage
	organization={organization}
	page={{ id: 'complete-name', title: whatsYourName, slug: 'complete-name', isHomePage: false, sections: [] }}
	title={`${whatsYourName} - ${organization.name}`}
>
	<div id="complete-name-container" class="mx-auto flex min-h-[60vh] w-full max-w-md flex-col items-center justify-center px-5 py-10 sm:px-8">
		<div class="surface w-full p-6 sm:p-8">
			<div class="mb-6 flex flex-col space-y-2 text-center">
				<h1 class="font-heading text-2xl tracking-tight text-foreground">
					{whatsYourName}
				</h1>
				<p class="text-sm text-muted-foreground">
					{nameHint}
				</p>
			</div>

			<form
				id="complete-name-form"
				class="space-y-4"
				data-continue={continueLabel}
				data-saving={saving}
				data-error={somethingWentWrong}
				data-network={networkError}
			>
				<div class="space-y-2">
					<label for="name" class="text-sm font-medium leading-none text-foreground">
						{fullName}
					</label>
					<input
						type="text"
						id="name"
						name="name"
						placeholder="Jane Doe"
						required
						minlength="2"
						autocomplete="name"
						class="field"
					/>
				</div>

				<div id="error-message" class="hidden text-sm font-medium text-destructive"></div>

				<button
					type="submit"
					class="btn-cta w-full"
				>
					{continueLabel}
				</button>
			</form>
		</div>
	</div>
</SitePage>

<script>
	import '../scripts/complete-name.ts'
</script>
