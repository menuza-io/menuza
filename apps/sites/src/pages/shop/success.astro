---
import { msg } from '@lingui/core/macro'
import SitePage from '~/components/SitePage.astro'
import { fetchShopOrderStatus } from '~/lib/org'

const organization = Astro.locals.organization
const i18n = Astro.locals.i18n
const orgSlug = Astro.locals.orgSlug
const customHost = Astro.locals.customHost
const sessionId = Astro.url.searchParams.get('session_id')
const paymentIntentId = Astro.url.searchParams.get('payment_intent')
const checkoutPaymentId =
	Astro.url.searchParams.get('cko-payment-id') ||
	Astro.url.searchParams.get('cko_payment_id')
const checkoutId = Astro.url.searchParams.get('checkout_id')

const orderConfirmed = i18n._(msg`Order confirmed`)
const thankYou = i18n._(msg`Thank you for your purchase!`)
const orderFailed = i18n._(msg`We could not confirm this order.`)
const backToShop = i18n._(msg`Back to shop`)

if (!organization) {
	return new Response('Not Found', { status: 404, statusText: 'Not Found' })
}

const order =
	sessionId || paymentIntentId || checkoutId || checkoutPaymentId ?
		await fetchShopOrderStatus({
			sessionId,
			paymentIntentId,
			checkoutId,
			checkoutPaymentId,
			slug: orgSlug,
			host: customHost,
		})
	:	null

function formatMoney(cents: number | null, currency = 'usd') {
	if (cents == null) return ''
	return new Intl.NumberFormat(Astro.locals.requestedLocale || 'en', {
		style: 'currency',
		currency,
	}).format(cents / 100)
}
---

<SitePage
	organization={organization}
	page={{
		id: 'shop-success',
		title: orderConfirmed,
		slug: 'shop/success',
		isHomePage: false,
		sections: [],
	}}
	title={`${orderConfirmed} - ${organization.name}`}
>
	<div class="mx-auto flex min-h-[60vh] w-full max-w-lg flex-col justify-center px-4 py-12">
		<div class="w-full rounded-xl border border-border bg-card p-6 text-center shadow-sm sm:p-8">
			{order ? (
				<div class="space-y-4">
					<h1 class="font-heading text-2xl text-foreground">
						{orderConfirmed}
					</h1>
					<p class="text-sm text-muted-foreground">{thankYou}</p>
					<div class="rounded-lg border border-border bg-muted/30 p-4 text-left text-sm">
						<p class="font-medium text-foreground">{order.productName}</p>
						<p class="text-muted-foreground">
							{formatMoney(order.amountCents, order.currency)} · {order.status}
						</p>
					</div>
					<a href="/shop" class="inline-flex text-sm font-medium text-primary hover:underline">
						{backToShop}
					</a>
				</div>
			) : (
				<p class="text-sm text-destructive">{orderFailed}</p>
			)}
		</div>
	</div>
</SitePage>
