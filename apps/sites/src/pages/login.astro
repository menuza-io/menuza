---
import { msg } from '@lingui/core/macro'
import SitePage from '~/components/SitePage.astro'

const organization = Astro.locals.organization
const i18n = Astro.locals.i18n
const signIn = i18n._(msg`Sign in`)
const signInDescription = i18n._(
	msg`Enter your phone number. We'll send a verification code.`,
)
const phoneNumber = i18n._(msg`Phone Number`)
const sendCode = i18n._(msg`Send Code`)
const sending = i18n._(msg`Sending...`)
const networkError = i18n._(msg`Network error. Please try again.`)
const somethingWentWrong = i18n._(msg`Something went wrong.`)
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || ''

if (!organization) {
	return new Response('Not Found', { status: 404, statusText: 'Not Found' })
}
---

<SitePage
	organization={organization}
	page={{ id: 'login', title: signIn, slug: 'login', isHomePage: false, sections: [] }}
	title={`${signIn} - ${organization.name}`}
>
	<div id="login-container" class="mx-auto flex min-h-[60vh] w-full max-w-md flex-col items-center justify-center px-5 py-10 sm:px-8">
		<div class="surface w-full p-6 sm:p-8">
			<div class="mb-6 flex flex-col space-y-2 text-center">
				<h1 class="font-heading text-2xl tracking-tight text-foreground">
					{signIn}
				</h1>
				<p class="text-sm text-muted-foreground">
					{signInDescription}
				</p>
			</div>

			<form
				id="login-form"
				class="space-y-4"
				data-send-code={sendCode}
				data-sending={sending}
				data-network={networkError}
				data-error={somethingWentWrong}
			>
				<div class="space-y-2">
					<label for="phone" class="text-sm font-medium leading-none text-foreground">
						{phoneNumber}
					</label>
					<input
						type="tel"
						id="phone"
						name="phone"
						placeholder="+1 (555) 000-0000"
						required
						autocomplete="tel"
						class="field"
					/>
				</div>

				{turnstileSiteKey ? (
					<div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-action="customer-login" />
				) : null}

				<div id="error-message" class="hidden text-sm font-medium text-destructive"></div>

				<button
					type="submit"
					class="btn-cta w-full"
				>
					{sendCode}
				</button>
			</form>
		</div>
	</div>
</SitePage>

{turnstileSiteKey ? (
	<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
) : null}

<script>
	import {
		getBrowserTenantApiUrl,
		getOrgBinding,
		redirectHomeIfSignedIn,
		tenantErrorMessage,
		tenantJson,
	} from '~/lib/client-auth'
	import { browserLocaleHref } from '~/lib/locale'

	redirectHomeIfSignedIn()

	const form = document.getElementById('login-form') as HTMLFormElement
	const errorMessage = document.getElementById('error-message')!
	const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement
	const sendLabel = form.dataset.sendCode || 'Send Code'
	const sendingLabel = form.dataset.sending || 'Sending...'
	const networkLabel = form.dataset.network || 'Network error. Please try again.'
	const errorLabel = form.dataset.error || 'Something went wrong.'

	// No tenant-api serves this organization's region: sign-in is unavailable
	// (a phone number is never sent to another region's node).
	if (!getBrowserTenantApiUrl()) {
		errorMessage.textContent = errorLabel
		errorMessage.classList.remove('hidden')
		submitButton.disabled = true
	}

	form.addEventListener('submit', async (e) => {
		e.preventDefault()
		errorMessage.classList.add('hidden')
		submitButton.disabled = true
		submitButton.textContent = sendingLabel

		const formData = new FormData(form)
		const turnstileToken = String(formData.get('cf-turnstile-response') || '')
		const payload = {
			phone: formData.get('phone'),
			...getOrgBinding(),
			...(turnstileToken ? { turnstileToken } : {}),
		}

		try {
			const { ok, data } = await tenantJson('/auth/send-code', payload)

			if (ok) {
				const phone = formData.get('phone') as string
				sessionStorage.setItem('pending_phone', phone)
				window.location.href = browserLocaleHref('/verify')
			} else {
				errorMessage.textContent = tenantErrorMessage(data, errorLabel)
				errorMessage.classList.remove('hidden')
				const turnstileWidget = form.querySelector('.cf-turnstile')
				const turnstileApi = (
					window as typeof window & {
						turnstile?: { reset: (element: Element) => void }
					}
				).turnstile
				if (turnstileWidget && turnstileApi) {
					turnstileApi.reset(turnstileWidget)
				}
			}
		} catch {
			errorMessage.textContent = networkLabel
			errorMessage.classList.remove('hidden')
		} finally {
			submitButton.disabled = false
			submitButton.textContent = sendLabel
		}
	})
</script>
