---
import { msg } from '@lingui/core/macro'
import { getLocalizedMenuValue } from '@repo/common/menu-types'
import { getLocaleHref } from '@repo/common/site-locales'
import OrderDetailsSheet from '~/components/ordering/OrderDetailsSheet.astro'
import SitePage from '~/components/SitePage.astro'
import { siteContainer } from '~/lib/media'
import { buildOrderDetailsLabels, translate } from '~/lib/ordering-labels'
import { formatMoney } from '~/lib/ordering/money'
import { type FulfillmentMode } from '~/lib/ordering/types'
import {
	fetchPublishedDrop,
	fetchPublishedSiteMenu,
	type PublicLocationData,
	type PublicMenuCategoryData,
} from '~/lib/org'

const organization = Astro.locals.organization
const i18n = Astro.locals.i18n
const orgSlug = Astro.locals.orgSlug
const customHost = Astro.locals.customHost
const requestedLocale =
	Astro.locals.requestedLocale ||
	organization?.locale ||
	organization?.defaultLocale ||
	'en'
const defaultLocale = organization?.defaultLocale || 'en'

if (!organization) {
	return new Response('Not Found', { status: 404, statusText: 'Not Found' })
}

const urlLocation = Astro.url.searchParams.get('location')
const menuPayload = await fetchPublishedSiteMenu({
	slug: orgSlug,
	host: customHost,
	lng: requestedLocale,
	locationId: urlLocation,
})

const unavailableVariantIds = new Set<string>()
function indexUnavailableVariants(category: PublicMenuCategoryData) {
	for (const item of category.items) {
		for (const variant of item.variations.variants) {
			if (variant.availabilityStatus === 'unavailable') unavailableVariantIds.add(variant.id)
		}
	}
	for (const child of category.subcategories ?? []) indexUnavailableVariants(child)
}
for (const menu of menuPayload?.menus ?? []) {
	for (const category of menu.categories) indexUnavailableVariants(category)
}

// Drop checkout (`?drop=<slug>`): loads the drop cart instead of the menu
// cart and shows the pickup chosen on the drop page. Drops are pickup only,
// so the fulfillment choice stays hidden and tax follows the pickup location.
const dropSlugParam = Astro.url.searchParams.get('drop')
const dropData = dropSlugParam
	? await fetchPublishedDrop({
			slug: orgSlug,
			host: customHost,
			dropSlug: dropSlugParam,
			lng: requestedLocale,
		})
	: null
const dropMode = Boolean(dropSlugParam && dropData)
if (dropData) {
	for (const category of dropData.categories) {
		for (const item of category.items) {
			for (const variant of item.variations?.variants ?? []) {
				if (variant.availabilityStatus === 'unavailable') {
					unavailableVariantIds.add(variant.id)
				}
			}
		}
	}
}

const locations = menuPayload?.locations ?? []
const currency = menuPayload?.organization?.currency || 'USD'

// Resolve the active location exactly like the menu page (URL param → default →
// first) so checkout and the menu agree on the same cart's tax rate and fee.
const activeLocation: PublicLocationData | undefined =
	(urlLocation ? locations.find((l) => l.id === urlLocation) : undefined) ||
	locations.find((l) => l.isDefault) ||
	locations[0]

// Sales tax is stored as a percent (e.g. 8.25), never a fraction.
// The delivery fee and minimum come from the verified address quote (the
// regional tenant-api resolves the zone), never from a guessed zone here.
const taxRate = activeLocation?.taxRate ?? 0

// Same fulfillment rule as the menu page.
const fulfillmentOptions = (activeLocation?.fulfillmentOptions ?? {}) as {
	pickup?: boolean
	delivery?: boolean
}
const allowedModes: FulfillmentMode[] = []
if (fulfillmentOptions.pickup !== false) allowedModes.push('pickup')
if (fulfillmentOptions.delivery !== false) allowedModes.push('delivery')
if (!allowedModes.length) allowedModes.push('pickup')
const odLabels = buildOrderDetailsLabels(i18n)

const menuHref = getLocaleHref('/menu', requestedLocale, defaultLocale)
const successHref = getLocaleHref('/menu/success', requestedLocale, defaultLocale)

const price = (amount: number) => formatMoney(amount, currency, requestedLocale)

const checkoutTitle = i18n._(msg`Checkout`)
const backToMenuLabel = i18n._(msg`Back to menu`)
const checkoutSubtitle = i18n._(msg`Review your order details and enter your contact information to complete your order.`)
const emptyCartTitle = i18n._(msg`Your order is empty`)
const emptyCartDesc = i18n._(msg`Looks like you haven't added any dishes to your order yet.`)
const exploreMenuLabel = i18n._(msg`Explore menu`)
const fulfillmentTitle = i18n._(msg`Fulfillment`)
const pickupLabel = i18n._(msg`Pickup`)
const deliveryLabel = i18n._(msg`Delivery`)
const freeLabel = i18n._(msg`Free`)
const toYourDoorLabel = i18n._(msg`To your door`)
const contactTitle = i18n._(msg`Contact details`)
const fullNameLabel = i18n._(msg`Full name`)
const phoneLabel = i18n._(msg`Phone number`)
const phonePlaceholder = i18n._(msg`+1 555 000 0000`)
const emailLabel = i18n._(msg`Email address`)
const emailPlaceholder = i18n._(msg`name@example.com`)
const deliveryTitle = i18n._(msg`Delivery address`)
const deliveryNotesLabel = i18n._(msg`Delivery instructions`)
const deliveryNotesPlaceholder = i18n._(msg`Gate code, buzzer, or where to leave it`)
const tipTitle = i18n._(msg`Tip`)
const noTipLabel = i18n._(msg`No tip`)
const paymentTitle = i18n._(msg`Payment`)
const payOnlineLabel = i18n._(msg`Pay online`)
const payOnlineHint = i18n._(msg`Pay securely now`)
const payAtPickupLabel = i18n._(msg`Pay at pickup`)
const payOnDeliveryLabel = i18n._(msg`Pay on delivery`)
const payHandoffHint = i18n._(msg`Pay when you receive your order`)
const summaryTitle = i18n._(msg`Order summary`)
const subtotalText = i18n._(msg`Subtotal`)
const taxText = i18n._(msg`Tax`)
const deliveryFeeText = i18n._(msg`Delivery fee`)
const tipText = tipTitle
const totalText = i18n._(msg`Total`)
const placeOrderLabel = i18n._(msg`Place order`)
const termsNotice = i18n._(msg`Secure checkout. By placing your order you agree to the restaurant's terms.`)
const cartAvailabilityNotice = i18n._(msg`Some items are no longer available and were removed from your order.`)

// ---------- drop checkout strings ----------

const dropHref = dropData
	? getLocaleHref(
			`/drop/${encodeURIComponent(dropData.drop.slug)}`,
			requestedLocale,
			requestedLocale,
			defaultLocale,
		)
	: menuHref
const backLabel = dropMode ? i18n._(msg`Back to drop`) : backToMenuLabel
const emptyHref = dropMode ? dropHref : menuHref
const emptyActionLabel = dropMode ? i18n._(msg`Back to drop`) : exploreMenuLabel
const changePickupLabel = i18n._(msg`Change`)
const timeRemainingLabel = i18n._(msg`Time remaining`)
const choosePickupNotice = i18n._(msg`Choose a pickup time to continue`)

// The hold starts only once `POST /orders` succeeds for an online payment;
// tell drop customers up front how long they will have to pay. `Intl` spells
// the duration so plurals are correct in every locale.
const checkoutHoldMinutes = dropData?.drop.checkoutHoldMinutes ?? 0
let holdDurationText = `${checkoutHoldMinutes} min`
try {
	holdDurationText = new Intl.NumberFormat(requestedLocale, {
		style: 'unit',
		unit: 'minute',
		unitDisplay: 'long',
	}).format(checkoutHoldMinutes)
} catch {}
const holdNoteText =
	dropMode && checkoutHoldMinutes > 0
		? translate(
				i18n,
				msg`After you place your order, we'll hold your items for {duration} while you pay.`,
				{ duration: holdDurationText },
			)
		: ''

// ---------- client-side label bag (regional ordering flow) ----------

const checkoutLabels = {
	payOnline: payOnlineLabel,
	payAtPickup: payAtPickupLabel,
	payOnDelivery: payOnDeliveryLabel,
	placingOrder: i18n._(msg`Placing your order…`),
	placeOrder: placeOrderLabel,
	closed: i18n._(msg`We're closed right now.`),
	closedReopen: translate(i18n, msg`We're closed right now. Orders reopen {time}`, {
		time: '{time}',
	}),
	ordersClose: translate(i18n, msg`Orders close {when}`, { when: '{when}' }),
	orderPlacedPaymentFailed: i18n._(
		msg`Your order was placed, but we couldn't start online payment. You can pay from your receipt page.`,
	),
	viewReceipt: i18n._(msg`View your receipt`),
	validation: {
		name: i18n._(msg`Please enter your full name.`),
		phone: i18n._(msg`Please enter your phone number.`),
		email: i18n._(msg`Please enter your email address.`),
		address: i18n._(msg`Please enter your delivery street address.`),
	},
	errors: {
		orderingClosed: i18n._(msg`Ordering is currently closed.`),
		dropClosed: i18n._(msg`This drop is no longer accepting orders.`),
		dropNotFound: i18n._(msg`This drop could not be found. It may have ended.`),
		pickupSlotUnavailable: i18n._(
			msg`That pickup time is no longer available. Please choose a different time.`,
		),
		pickupRequired: choosePickupNotice,
		pickupUnavailable: i18n._(msg`Pickup is not available for this order.`),
		deliveryUnavailable: i18n._(msg`Delivery is not available for this order.`),
		deliveryAddressRequired: i18n._(msg`Please enter your delivery address.`),
		tipsDisabled: i18n._(msg`Tips are not available for this order.`),
		itemsChanged: i18n._(
			msg`Some items in your order changed or sold out. Please review your cart and try again.`,
		),
		orderNeedsReview: i18n._(msg`Please review your order details and try again.`),
		slotFull: i18n._(
			msg`That pickup slot just filled up. Please choose a different time.`,
		),
		soldOut: i18n._(msg`Some items just sold out. Please review your order.`),
		quantityLimit: i18n._(
			msg`Your order exceeds the allowed quantity. Please review your cart.`,
		),
		minimumOrder: i18n._(msg`This order is below the minimum for delivery.`),
		locationUnavailable: i18n._(msg`This location is not available for ordering.`),
		idempotencyConflict: i18n._(
			msg`Your order changed while it was being placed. Please review it and try again.`,
		),
		rateLimited: i18n._(msg`Too many attempts. Please try again later.`),
		generic: i18n._(msg`We could not place your order. Please try again.`),
	},
}

const dropPickupLocations = dropData
	? dropData.pickupWindows
			.filter((window) => window.location)
			.map((window) => ({
				id: window.location!.id,
				name: getLocalizedMenuValue(
					window.location!.name,
					requestedLocale,
					defaultLocale,
				),
				address: window.location!.address,
				timezone: window.location!.timezone ?? 'UTC',
				phone: window.location!.phone,
			}))
	: []

const dropWindows = dropData
	? dropData.pickupWindows.map((window) => ({
			id: window.id,
			locationId: window.locationId,
			date: window.date,
			startTime: window.startTime,
			endTime: window.endTime,
			slotIntervalMinutes: window.slotIntervalMinutes,
			orderLeadTimeMinutes: window.orderLeadTimeMinutes,
			maxOrdersPerSlot: window.maxOrdersPerSlot,
			slots: window.slots,
		}))
	: []

const pickupHint = activeLocation
	? getLocalizedMenuValue(activeLocation.name, requestedLocale, defaultLocale)
	: ''

// Shared class recipes (spec §3). Rows that scripts toggle use plain `flex`
// so `.hidden` always wins over a custom utility's `display`.
const sectionClass = 'surface p-4 sm:p-6 [counter-increment:step]'
const sectionHeadClass = 'mb-4 flex items-center gap-3'
const stepMarkerClass =
	'price flex size-7 shrink-0 items-center justify-center rounded-full bg-muted text-sm text-foreground before:content-[counter(step)]'
const sectionTitleClass = 'text-lg font-semibold text-foreground'
const labelClass = 'mb-1.5 block text-sm font-semibold text-foreground'
const noticeClass = 'flex items-start gap-3 rounded-lg border p-3 text-sm sm:p-4'
const iconTileClass =
	'flex size-10 shrink-0 items-center justify-center rounded-lg bg-muted text-foreground'
const rowClass =
	'flex items-baseline justify-between gap-4 text-sm text-muted-foreground'
const valueClass = 'price font-medium text-foreground'
const tipBtnClass =
	'tip-btn focus-ring flex min-h-12 flex-col items-center justify-center rounded-lg border px-2 text-sm font-semibold transition-colors duration-150 hover:border-foreground/40 motion-reduce:transition-none'
const tipOn = 'border-foreground bg-foreground text-background'
const tipOff = 'border-border bg-background text-foreground'
---

<SitePage
	organization={organization}
	page={{ id: 'checkout', title: checkoutTitle, slug: 'menu/checkout', isHomePage: false, sections: [] }}
	title={`${checkoutTitle} - ${organization.name}`}
>
	<div class="min-h-screen bg-background pt-6 pb-32 sm:pt-10 lg:pb-16">
		<div class={siteContainer}>
			<header class="mb-6 sm:mb-8">
				<a
					href={dropMode ? dropHref : menuHref}
					class="focus-ring -ms-1 inline-flex items-center gap-1 rounded-md px-1 py-1 text-sm font-semibold text-muted-foreground transition-colors hover:text-foreground"
				>
					<svg xmlns="http://www.w3.org/2000/svg" class="size-4 rtl:-scale-x-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
					{backLabel}
				</a>
				<h1 class="mt-2 text-3xl font-bold leading-tight tracking-tight text-foreground sm:text-4xl">{checkoutTitle}</h1>
				<p class="mt-2 max-w-2xl text-sm text-muted-foreground sm:text-base">{checkoutSubtitle}</p>
			</header>

			<div id="cart-availability-notice" class:list={[noticeClass, 'tone-warning hidden mb-6']} role="status">
				<svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
				<p class="font-semibold">{cartAvailabilityNotice}</p>
			</div>
			<div id="ordering-closed-notice" class:list={[noticeClass, 'tone-warning hidden mb-6']} role="alert">
				<svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
				<p id="ordering-closed-text" class="min-w-0 flex-1 font-semibold"></p>
			</div>

			{/* Empty cart state */}
			<div id="empty-cart-state" class="surface hidden flex-col items-center gap-3 px-6 py-12 text-center [&:not(.hidden)]:flex">
				<span class="flex size-12 items-center justify-center rounded-xl bg-muted text-muted-foreground">
					<svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
				</span>
				<h2 class="text-base font-semibold text-foreground">{emptyCartTitle}</h2>
				<p class="max-w-sm text-sm text-muted-foreground">{emptyCartDesc}</p>
				<a href={emptyHref} class="btn-cta mt-2">{emptyActionLabel}</a>
			</div>

			<div id="checkout-root" class="grid grid-cols-1 items-start gap-6 lg:grid-cols-[minmax(0,1fr)_24rem] lg:gap-8">
				{/* Form column: sections are numbered by CSS counters, so a hidden
				    section (delivery address, tip) never leaves a gap. */}
				<div class="min-w-0 space-y-4 [counter-reset:step] sm:space-y-5">
					{/* Drop order window countdown (real closing time, not a hold) */}
					<div id="drop-close-banner" class:list={[noticeClass, 'tone-warning hidden']} role="status">
						<svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
						<div class="flex min-w-0 flex-1 flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
							<span id="drop-close-text" class="bidi-isolate font-semibold text-foreground"></span>
							<span class="flex items-baseline gap-2">
								<span class="text-xs text-muted-foreground">{timeRemainingLabel}</span>
								<span id="drop-close-countdown" class="price text-base text-foreground" role="timer">--:--</span>
							</span>
						</div>
					</div>

					{dropMode ? (
						/* Drop pickup summary (drops are pickup only) */
						<section class={sectionClass} aria-labelledby="co-step-pickup">
							<div class={sectionHeadClass}>
								<span class={stepMarkerClass} aria-hidden="true"></span>
								<h2 id="co-step-pickup" class={sectionTitleClass}>{pickupLabel}</h2>
							</div>
							<div id="drop-pickup-summary" class:list={[noticeClass, 'tone-success hidden']}>
								<svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
								<div class="min-w-0 flex-1 space-y-0.5">
									<p id="drop-pickup-time" class="bidi-isolate font-semibold text-foreground"></p>
									<p id="drop-pickup-location" class="text-foreground"></p>
									<p id="drop-pickup-address" class="text-muted-foreground"></p>
								</div>
							</div>
							<div id="drop-pickup-missing" class:list={[noticeClass, 'tone-warning hidden outline-none']} role="status" tabindex="-1">
								<svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
								<p class="min-w-0 flex-1 font-semibold">{choosePickupNotice}</p>
							</div>
							<a id="drop-pickup-change" href={dropHref} class="focus-ring mt-3 inline-flex rounded-sm text-sm font-semibold text-foreground underline-offset-4 hover:underline">
								{changePickupLabel}
							</a>
						</section>
					) : (
						/* Fulfillment */
						<section class={sectionClass} aria-labelledby="co-step-fulfillment">
							<div class={sectionHeadClass}>
								<span class={stepMarkerClass} aria-hidden="true"></span>
								<h2 id="co-step-fulfillment" class={sectionTitleClass}>{fulfillmentTitle}</h2>
							</div>
						<div class:list={['grid grid-cols-1 gap-3', allowedModes.length > 1 && 'sm:grid-cols-2']}>
							<label class:list={['choice-card', !allowedModes.includes('pickup') && 'hidden']}>
								<input type="radio" name="fulfillment_mode" value="pickup" id="radio-pickup" checked />
									<span class={iconTileClass} aria-hidden="true">
										<svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
									</span>
									<span class="min-w-0 flex-1">
										<span class="flex items-center justify-between gap-2">
											<span class="text-sm font-semibold text-foreground">{pickupLabel}</span>
											<span class="badge tone-neutral">{freeLabel}</span>
										</span>
										{pickupHint ? <span class="mt-0.5 block truncate text-xs text-muted-foreground">{pickupHint}</span> : null}
									</span>
								</label>
							<label class:list={['choice-card', !allowedModes.includes('delivery') && 'hidden']}>
								<input type="radio" name="fulfillment_mode" value="delivery" id="radio-delivery" disabled={!allowedModes.includes('delivery')} />
									<span class={iconTileClass} aria-hidden="true">
										<svg xmlns="http://www.w3.org/2000/svg" class="size-5 rtl:-scale-x-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>
									</span>
									<span class="min-w-0 flex-1">
										<span class="flex items-center justify-between gap-2">
											<span class="text-sm font-semibold text-foreground">{deliveryLabel}</span>
										<span id="delivery-fee-badge" class="badge tone-neutral price hidden" dir="ltr"></span>
									</span>
									<span id="delivery-hint" class="mt-0.5 block truncate text-xs text-muted-foreground">{toYourDoorLabel}</span>
								</span>
							</label>
						</div>
						<div id="co-when-row" class="mt-4 hidden items-center gap-3 border-t border-border pt-4 [&:not(.hidden)]:flex">
							<span class={iconTileClass} aria-hidden="true">
								<svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
							</span>
							<span class="min-w-0 flex-1">
								<span class="block text-xs text-muted-foreground">{odLabels.when}</span>
								<span id="co-when-value" class="bidi-isolate block truncate text-sm font-semibold text-foreground"></span>
							</span>
							<button type="button" class="btn-secondary min-h-10 shrink-0 px-4" data-open-order-details data-order-details-tab="time">{odLabels.change}</button>
						</div>
					</section>
					)}

					{/* Contact details */}
					<section class={sectionClass} aria-labelledby="co-step-contact">
						<div class={sectionHeadClass}>
							<span class={stepMarkerClass} aria-hidden="true"></span>
							<h2 id="co-step-contact" class={sectionTitleClass}>{contactTitle}</h2>
						</div>
						<div class="grid gap-4 sm:grid-cols-2">
							<div class="sm:col-span-2">
								<label for="cust-name" class={labelClass}>{fullNameLabel}<span class="ms-0.5 text-destructive" aria-hidden="true">*</span></label>
								<input type="text" id="cust-name" autocomplete="name" required class="field" />
							</div>
							<div>
								<label for="cust-phone" class={labelClass}>{phoneLabel}<span class="ms-0.5 text-destructive" aria-hidden="true">*</span></label>
								<input type="tel" id="cust-phone" autocomplete="tel" inputmode="tel" dir="ltr" placeholder={phonePlaceholder} required class="field text-start rtl:text-end" />
							</div>
							<div>
								<label for="cust-email" class={labelClass}>{emailLabel}<span class="ms-0.5 text-destructive" aria-hidden="true">*</span></label>
								<input type="email" id="cust-email" autocomplete="email" inputmode="email" dir="ltr" placeholder={emailPlaceholder} required class="field text-start rtl:text-end" />
							</div>
						</div>
					</section>

					{/* Delivery address (shown when delivery is selected) */}
					<section id="delivery-address-card" class:list={[sectionClass, 'hidden']} aria-labelledby="co-step-address">
						<div class={sectionHeadClass}>
							<span class={stepMarkerClass} aria-hidden="true"></span>
							<h2 id="co-step-address" class={sectionTitleClass}>{deliveryTitle}</h2>
						</div>
						{/* Verified address from the order-details sheet (quote from the
						    regional tenant-api). Read-only here; "Change" reopens the sheet. */}
						<div id="delivery-verified" class="hidden">
							<div class="flex items-start gap-3 rounded-lg border border-border bg-background p-3 sm:p-4">
								<span class:list={[iconTileClass, 'tone-success border']} aria-hidden="true">
									<svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
								</span>
								<div class="min-w-0 flex-1">
									<p id="delivery-verified-address" dir="auto" class="[text-align:match-parent] text-sm font-semibold leading-snug text-foreground"></p>
									<p id="delivery-verified-meta" class="bidi-isolate mt-1 text-xs text-muted-foreground"></p>
								</div>
								<button type="button" class="btn-secondary min-h-10 shrink-0 px-4" data-open-order-details data-order-details-tab="delivery">{odLabels.change}</button>
							</div>
							<div class="mt-4">
								<label for="cust-delivery-notes" class={labelClass}>{deliveryNotesLabel}</label>
								<input type="text" id="cust-delivery-notes" maxlength="200" placeholder={deliveryNotesPlaceholder} class="field" />
							</div>
						</div>
						<div id="delivery-missing" class="hidden flex-col items-start gap-3 rounded-lg border border-dashed border-border p-4 [&:not(.hidden)]:flex sm:flex-row sm:items-center">
							<div class="min-w-0 flex-1">
								<p class="text-sm font-semibold text-foreground">{odLabels.addressMissingTitle}</p>
								<p class="mt-0.5 text-sm text-muted-foreground">{odLabels.addressMissingBody}</p>
							</div>
							<button type="button" id="delivery-add-address" class="btn-secondary shrink-0" data-open-order-details data-order-details-tab="delivery">{odLabels.addAddress}</button>
						</div>
					</section>

					{/* Tip */}
					<section class={sectionClass} id="tip-card" aria-labelledby="co-step-tip">
						<div class={sectionHeadClass}>
							<span class={stepMarkerClass} aria-hidden="true"></span>
							<h2 id="co-step-tip" class={sectionTitleClass}>{tipTitle}</h2>
						</div>
						<div class="grid grid-cols-4 gap-2 sm:grid-cols-5" id="tip-buttons">
							<button type="button" class:list={[tipBtnClass, tipOff]} aria-pressed="false" data-tip="10"><span class="price">10%</span></button>
							<button type="button" class:list={[tipBtnClass, tipOn]} aria-pressed="true" data-tip="15"><span class="price">15%</span></button>
							<button type="button" class:list={[tipBtnClass, tipOff]} aria-pressed="false" data-tip="18"><span class="price">18%</span></button>
							<button type="button" class:list={[tipBtnClass, tipOff]} aria-pressed="false" data-tip="20"><span class="price">20%</span></button>
							<button type="button" class:list={[tipBtnClass, tipOff, 'col-span-4 sm:col-span-1']} aria-pressed="false" data-tip="0">{noTipLabel}</button>
						</div>
					</section>

					{/* Payment */}
					<section class={sectionClass} id="payment-method-card" aria-labelledby="co-step-payment">
						<div class={sectionHeadClass}>
							<span class={stepMarkerClass} aria-hidden="true"></span>
							<h2 id="co-step-payment" class={sectionTitleClass}>{paymentTitle}</h2>
						</div>
						<div class="grid grid-cols-1 gap-3">
							<div id="pay-online-row" class="hidden">
								<label class="choice-card">
									<input type="radio" name="payment_method" value="online" id="pay-online" />
									<span class={iconTileClass} aria-hidden="true">
										<svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><path d="M2 10h20"/></svg>
									</span>
									<span class="min-w-0 flex-1">
										<span class="block text-sm font-semibold text-foreground">{payOnlineLabel}</span>
										<span class="block text-xs text-muted-foreground">{payOnlineHint}</span>
									</span>
								</label>
							</div>
							<label class="choice-card">
								<input type="radio" name="payment_method" value="handoff" id="pay-handoff" checked />
								<span class={iconTileClass} aria-hidden="true">
									<svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 15h2a2 2 0 1 0 0-4h-3c-.6 0-1.1.2-1.4.6L3 17"/><path d="m7 21 1.6-1.4c.3-.4.8-.6 1.4-.6h4c1.1 0 2.1-.4 2.8-1.2l4.6-4.4a2 2 0 0 0-2.75-2.91l-4.2 3.9"/><path d="m2 16 6 6"/><circle cx="16" cy="9" r="2.9"/><circle cx="6" cy="5" r="3"/></svg>
								</span>
								<span class="min-w-0 flex-1">
									<span id="pay-handoff-label" class="block text-sm font-semibold text-foreground">{payAtPickupLabel}</span>
									<span class="block text-xs text-muted-foreground">{payHandoffHint}</span>
								</span>
							</label>
						</div>
					</section>
				</div>

				{/* Summary column */}
				<aside class="surface p-5 sm:p-6 lg:sticky lg:top-24" aria-labelledby="co-summary-title">
					<h2 id="co-summary-title" class="text-lg font-bold tracking-tight text-foreground">{summaryTitle}</h2>

					{/* Items list */}
					<ul id="checkout-items-list" class="mt-2 divide-y divide-border lg:max-h-80 lg:overflow-y-auto lg:overscroll-contain">
						{/* Injected dynamically from cart */}
					</ul>

					{/* Breakdown (estimate — the receipt is authoritative) */}
					<dl class="mt-2 space-y-2 border-t border-border pt-4">
						<div class={rowClass}>
							<dt>{subtotalText}</dt>
							<dd id="co-subtotal" class={valueClass}>{price(0)}</dd>
						</div>
						<div class={rowClass}>
							<dt>{taxText}</dt>
							<dd id="co-tax" class={valueClass}>{price(0)}</dd>
						</div>
						<div id="co-delivery-row" class:list={[rowClass, 'hidden']}>
							<dt>{deliveryFeeText}</dt>
							<dd id="co-delivery-fee" class={valueClass}>{price(0)}</dd>
						</div>
						<div class={rowClass}>
							<dt>{tipText}</dt>
							<dd id="co-tip" class={valueClass}>{price(0)}</dd>
						</div>
						<div class="mt-3 flex items-baseline justify-between gap-4 border-t border-border pt-3 text-base font-semibold text-foreground">
							<dt>{totalText}</dt>
							<dd id="co-total" class="price font-heading text-xl">{price(0)}</dd>
						</div>
					</dl>

					<div id="place-order-block" class:list={[noticeClass, 'tone-warning hidden mt-5']} role="status">
						<svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
						<p id="place-order-block-text" class="min-w-0 flex-1 font-medium"></p>
					</div>

					{holdNoteText ? (
						/* Shown only for drop orders paying online (see updateHoldNote). */
						<p id="checkout-hold-note" class="mt-5 flex hidden items-start gap-2 text-sm text-muted-foreground [&.hidden]:hidden">
							<svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 22h14"/><path d="M5 2h14"/><path d="M17 22v-4.172a2 2 0 0 0-.586-1.414L12 12l-4.414 4.414A2 2 0 0 0 7 17.828V22"/><path d="M7 2v4.172a2 2 0 0 0 .586 1.414L12 12l4.414-4.414A2 2 0 0 0 17 6.172V2"/></svg>
							<span class="min-w-0 flex-1 text-pretty">{holdNoteText}</span>
						</p>
					) : null}

					<div id="checkout-error" class:list={[noticeClass, 'tone-danger hidden mt-5']} role="alert">
						<svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
						<p class="min-w-0 flex-1">
							<span id="checkout-error-text"></span>
							{' '}<a id="checkout-error-link" href="#" class="hidden font-semibold underline underline-offset-4">{checkoutLabels.viewReceipt}</a>
						</p>
					</div>

					{/* Submit: a fixed bottom bar on phones, inline in the card from lg. */}
					<div class="mt-5 max-lg:fixed max-lg:inset-x-0 max-lg:bottom-0 max-lg:z-40 max-lg:mt-0 max-lg:flex max-lg:items-center max-lg:gap-4 max-lg:px-4 max-lg:pt-3 max-lg:glass-bar max-lg:shadow-bar-up max-lg:pb-safe max-lg:flex-wrap">
						<p id="place-order-block-bar" class="hidden w-full text-xs font-medium text-muted-foreground lg:hidden" aria-hidden="true"></p>
						<div class="min-w-0 lg:hidden">
							<p class="text-xs text-muted-foreground">{totalText}</p>
							<p id="co-bar-total" class="price font-heading text-lg text-foreground" aria-hidden="true">{price(0)}</p>
						</div>
						<button type="button" id="place-order-btn" class="btn-cta min-w-0 flex-1 lg:w-full">
							<svg id="place-order-spinner" xmlns="http://www.w3.org/2000/svg" class="hidden size-4 animate-spin motion-reduce:animate-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-6.22-8.56"/></svg>
							<span id="place-order-label" class="truncate">{placeOrderLabel}</span>
						</button>
					</div>

					<p class="mt-4 flex items-start justify-center gap-1.5 text-center text-xs text-muted-foreground">
						<svg xmlns="http://www.w3.org/2000/svg" class="mt-px size-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
						<span>{termsNotice}</span>
					</p>
				</aside>
			</div>
		</div>
	</div>

	{!dropMode && locations.length ? (
		<OrderDetailsSheet
			locations={locations}
			activeLocationId={activeLocation?.id}
			allowedModes={allowedModes}
			orgId={organization.id}
			currency={currency}
			locale={requestedLocale}
			defaultLocale={defaultLocale}
			labels={odLabels}
		/>
	) : null}

	<script
		id="checkout-meta"
		type="application/json"
		is:inline
		set:html={JSON.stringify({
			organizationId: organization.id,
			currency,
			locale: requestedLocale,
			successUrl: successHref,
			locationId: activeLocation?.id ?? null,
			locations,
			taxRate,
			allowedModes,
			orderDetailsLabels: odLabels,
			unavailableVariantIds: [...unavailableVariantIds],
			labels: checkoutLabels,
			drop: dropData && {
				id: dropData.drop.id,
				slug: dropData.drop.slug,
				title: getLocalizedMenuValue(dropData.drop.title, requestedLocale, defaultLocale),
				ordersCloseAt: dropData.drop.ordersCloseAt,
				dropHref,
				pickupLocations: dropPickupLocations,
				windows: dropWindows,
			},
		}).replace(/</g, '\\u003c')}
	/>

	<script>
		import {
			formatDropDate,
			formatDropDateTime,
			formatDropTime,
			zonedTimeToUtc,
		} from '~/lib/drops/format'
		import { formatRemaining, startCountdown } from '~/lib/ordering/countdown'
		import { orderErrorMessage } from '~/lib/ordering/order-errors'
		import {
			OrderRequestError,
			checkoutAttemptKey,
			clearCheckoutAttempt,
			fetchOrderingOptions,
			orderLines,
			saveOrderCapability,
			startOrderPayment,
			submitRegionalOrder,
		} from '~/lib/ordering/order-client'
		import {
			buildPickupOptions,
			clearPickupSelection,
			formatPickupAddress,
			loadPickupSelection,
			resolvePickup,
		} from '~/lib/ordering/pickup'
		import { createMoneyFormatter, fillTemplate } from '~/lib/ordering/money'
		import {
			hasValidDeliveryQuote,
			isQuoteValid,
			loadOrderDetails,
			openOrderDetails,
			subscribeOrderDetails,
			updateOrderDetails,
			type OrderDetails,
		} from '~/lib/ordering/order-details'
		import {
			buildScheduleDays,
			findSlot,
			formatScheduledFor,
			schedulingSettings,
		} from '~/lib/ordering/schedule'
		import { type OrderDetailsLabels } from '~/lib/ordering-labels'
		import { type FulfillmentMode } from '~/lib/ordering/types'
		import { type CartItem } from '~/lib/ordering/types'
		import { type PublicOrderingOptions } from '@repo/common/restaurant-orders'
		import { type OrderErrorLabels } from '~/lib/ordering/order-errors'

		type PickupLocationMeta = {
			id: string
			name: string
			address: unknown
			timezone: string
			phone: string | null
		}

		type DropWindowMeta = {
			id: string
			locationId: string
			date: string
			startTime: string
			endTime: string
			slotIntervalMinutes: number
			orderLeadTimeMinutes: number
			maxOrdersPerSlot: number | null
			slots: Array<{ time: string; displayTime?: string }>
		}

		type DropMeta = {
			id: string
			slug: string
			title: string
			ordersCloseAt: string | null
			dropHref: string
			pickupLocations: PickupLocationMeta[]
			windows: DropWindowMeta[]
		}

		type CheckoutLabels = {
			payOnline: string
			payAtPickup: string
			payOnDelivery: string
			placingOrder: string
			placeOrder: string
			closed: string
			closedReopen: string
			ordersClose: string
			orderPlacedPaymentFailed: string
			viewReceipt: string
			validation: { name: string; phone: string; email: string; address: string }
			errors: OrderErrorLabels
		}

		const metaEl = document.getElementById('checkout-meta')
		const meta = metaEl ? JSON.parse(metaEl.textContent || '{}') : {}
		const labels = (meta.labels ?? {}) as CheckoutLabels
		const orgId = meta.organizationId || 'default'
		const drop = (meta.drop ?? null) as DropMeta | null
		const isDrop = Boolean(drop)
		const storageKey = isDrop
			? `menuza_drop_cart_${orgId}_${drop!.id}`
			: `menuza_cart_${orgId}`
		const odLabels = (meta.orderDetailsLabels ?? {}) as OrderDetailsLabels
		const allowedModes = (meta.allowedModes ?? ['pickup', 'delivery']) as FulfillmentMode[]
		const activeLocation = (meta.locations ?? []).find((l: any) => l.id === meta.locationId) ?? null

		let cart: CartItem[] = []
		try {
			const saved = localStorage.getItem(storageKey)
			if (saved) cart = JSON.parse(saved)
		} catch {}
		if (meta.unavailableVariantIds?.length) {
			const unavailableVariants = new Set(meta.unavailableVariantIds)
			const originalCount = cart.length
			cart = cart.filter((item) => !item.variantId || !unavailableVariants.has(item.variantId))
			if (cart.length !== originalCount) {
				localStorage.setItem(storageKey, JSON.stringify(cart))
				document.getElementById('cart-availability-notice')?.classList.remove('hidden')
			}
		}

		if (cart.length === 0) {
			const root = document.getElementById('checkout-root')
			const emptyState = document.getElementById('empty-cart-state')
			if (root && emptyState) {
				root.classList.add('hidden')
				emptyState.classList.remove('hidden')
			}
		}

		// Order details (mode, verified delivery quote, schedule) live in the
		// browser only; the address goes from here to the regional tenant-api.
		let details: OrderDetails = loadOrderDetails(orgId, {
			locationId: meta.locationId ?? '',
			allowedModes,
		})
		let mode: 'pickup' | 'delivery' = !isDrop && details.mode === 'delivery' ? 'delivery' : 'pickup'
		let deliveryAvailable = allowedModes.includes('delivery')
		let tipPercent = 15
		let paymentMethod: 'handoff' | 'online' = 'handoff'
		let orderingOpen = true

		// Location-derived values resolved server-side (same source as the menu page).
		// Drop orders tax at the pickup location chosen on the drop page.
		const menuTaxRate = typeof meta.taxRate === 'number' ? meta.taxRate : 0
		const validDelivery = () => (isQuoteValid(details.delivery) ? details.delivery : null)

		const pickupSelection = isDrop ? loadPickupSelection(drop!.id) : null
		const pickupLocation = isDrop
			? (drop!.pickupLocations.find((l) => l.id === pickupSelection?.locationId) ??
				null)
			: null
		const pickupTaxRate = isDrop
			? (meta.locations?.find((l: any) => l.id === pickupSelection?.locationId)?.taxRate ?? 0)
			: 0
		function taxRate(): number {
			return isDrop ? (pickupLocation ? pickupTaxRate : 0) : menuTaxRate
		}

		// Display only: the org currency and locale, same formatter as the menu.
		const formatCurrency = createMoneyFormatter(meta.currency || 'USD', meta.locale || 'en')

		// Build nodes with textContent so operator/guest text is never parsed as HTML.
		function createEl(tag: string, className?: string, text?: string) {
			const node = document.createElement(tag)
			if (className) node.className = className
			if (text !== undefined) node.textContent = text
			return node
		}

		// The on-page summary is an estimate; the server re-prices everything and
		// the authoritative totals render on the success page from the receipt.
		function computeTotals() {
			const subtotal = cart.reduce((acc, it) => acc + it.unitPrice * it.quantity, 0)
			const tax = subtotal * (taxRate() / 100)
			const fee = mode === 'delivery' ? (validDelivery()?.deliveryFee ?? 0) : 0
			const tip = (subtotal * tipPercent) / 100
			const total = subtotal + tax + fee + tip
			return { subtotal, tax, deliveryFee: fee, tip, total }
		}

		function renderCheckout() {
			const { subtotal, tax, deliveryFee, tip, total } = computeTotals()

			// Render items
			const list = document.getElementById('checkout-items-list')
			if (list) {
				const rows = cart.map((it) => {
					const row = createEl('li', 'flex gap-3 py-3')
					row.appendChild(
						createEl(
							'span',
							'price flex h-6 min-w-6 shrink-0 items-center justify-center rounded-md bg-muted px-1.5 text-xs text-foreground',
							String(it.quantity),
						),
					)
					const body = createEl('div', 'min-w-0 flex-1')
					body.appendChild(createEl('p', 'text-sm font-semibold leading-snug text-foreground', it.name))
					const optionNames = (it.options ?? [])
						.map((o: any) => o.optionName)
						.filter(Boolean)
					if (optionNames.length > 0) {
						body.appendChild(
							createEl('p', 'mt-0.5 text-xs leading-relaxed text-muted-foreground', optionNames.join(', ')),
						)
					}
					if (it.instructions) {
						body.appendChild(
							createEl('p', 'mt-0.5 text-xs italic leading-relaxed text-muted-foreground', `“${it.instructions}”`),
						)
					}
					row.appendChild(body)
					row.appendChild(
						createEl('span', 'price shrink-0 text-sm text-foreground', formatCurrency(it.unitPrice * it.quantity)),
					)
					return row
				})
				list.replaceChildren(...rows)
			}

			// Render amounts
			const coSubtotal = document.getElementById('co-subtotal')
			const coTax = document.getElementById('co-tax')
			const coDeliveryRow = document.getElementById('co-delivery-row')
			const coDeliveryFee = document.getElementById('co-delivery-fee')
			const coTip = document.getElementById('co-tip')
			const coTotal = document.getElementById('co-total')

			if (coSubtotal) coSubtotal.textContent = formatCurrency(subtotal)
			if (coTax) coTax.textContent = formatCurrency(tax)
			if (coDeliveryRow && coDeliveryFee) {
				if (mode === 'delivery') {
					coDeliveryRow.classList.remove('hidden')
					coDeliveryFee.textContent = validDelivery()
						? deliveryFee > 0
							? formatCurrency(deliveryFee)
							: odLabels.free
						: odLabels.feeAfterAddress
				} else {
					coDeliveryRow.classList.add('hidden')
				}
			}
			if (coTip) coTip.textContent = formatCurrency(tip)
			if (coTotal) coTotal.textContent = formatCurrency(total)
			const barTotal = document.getElementById('co-bar-total')
			if (barTotal) barTotal.textContent = formatCurrency(total)

			// Delivery address section visibility
			const addrCard = document.getElementById('delivery-address-card')
			if (addrCard) {
				if (mode === 'delivery') {
					addrCard.classList.remove('hidden')
				} else {
					addrCard.classList.add('hidden')
				}
			}
			renderDeliveryDetails()
			renderWhen()
			renderBlockReason()
		}

		const minutesRange = (eta: { min: number; max: number }) =>
			eta.min === eta.max
				? fillTemplate(odLabels.minutes, { count: eta.min })
				: fillTemplate(odLabels.minutesRange, { min: `\u2066${eta.min}`, max: `${eta.max}\u2069` })

		function renderDeliveryDetails() {
			const delivery = validDelivery()
			document.getElementById('delivery-verified')?.classList.toggle('hidden', !delivery)
			document.getElementById('delivery-missing')?.classList.toggle('hidden', Boolean(delivery))
			const badge = document.getElementById('delivery-fee-badge')
			if (badge) {
				badge.classList.toggle('hidden', !delivery)
				if (delivery) {
					badge.textContent =
						delivery.deliveryFee > 0 ? `+${formatCurrency(delivery.deliveryFee)}` : odLabels.free
				}
			}
			if (!delivery) return
			const address = document.getElementById('delivery-verified-address')
			if (address) {
				address.textContent = [delivery.formatted, delivery.unit].filter(Boolean).join(' · ')
			}
			const metaLine = document.getElementById('delivery-verified-meta')
			if (metaLine) {
				metaLine.textContent = [
					delivery.zoneName,
					minutesRange(delivery.eta),
					delivery.minimumOrder > 0
						? `${odLabels.minimumOrder} ${formatCurrency(delivery.minimumOrder)}`
						: odLabels.noMinimum,
				]
					.filter(Boolean)
					.join(' · ')
			}
		}

		function schedulingEnabled() {
			return Boolean(!isDrop && activeLocation && schedulingSettings(activeLocation).enabled)
		}

		/** The chosen time if it is still offered, `null` for ASAP, `false` if stale. */
		function currentSchedule(): string | null | false {
			if (!details.scheduledFor) return null
			if (!schedulingEnabled()) return false
			const days = buildScheduleDays(activeLocation, {
				locale: meta.locale,
				mode,
				deliveryEtaMin: validDelivery()?.eta.min ?? 0,
			})
			return findSlot(days, details.scheduledFor) ? details.scheduledFor : false
		}

		function renderWhen() {
			const row = document.getElementById('co-when-row')
			const value = document.getElementById('co-when-value')
			const enabled = schedulingEnabled()
			row?.classList.toggle('hidden', !enabled)
			if (!enabled || !value) return
			const scheduled = currentSchedule()
			if (scheduled) {
				const parts = formatScheduledFor(scheduled, meta.locale, activeLocation?.timezone || 'UTC')
				const day = !parts
					? ''
					: parts.offset === 0
						? odLabels.today
						: parts.offset === 1
							? odLabels.tomorrow
							: parts.weekday
				value.textContent = parts ? `${day} · ${parts.time}` : scheduled
				return
			}
			if (scheduled === false) {
				value.textContent = odLabels.scheduleExpired
				return
			}
			const delivery = validDelivery()
			value.textContent =
				mode === 'delivery'
					? `${odLabels.asap} · ${minutesRange(delivery?.eta ?? { min: activeLocation?.deliveryConfig?.estimatedDeliveryTimeMin || 25, max: activeLocation?.deliveryConfig?.estimatedDeliveryTimeMax || 45 })}`
					: `${odLabels.asap} · ${fillTemplate(odLabels.minutes, { count: activeLocation?.prepTime || 15 })}`
		}

		/** Why the order cannot be placed yet (delivery address / minimum / time). */
		function blockReason(): string | null {
			if (isDrop || cart.length === 0) return null
			if (mode === 'delivery') {
				const delivery = validDelivery()
				if (!delivery) return odLabels.blockNoQuote
				const subtotal = cart.reduce((acc, it) => acc + it.unitPrice * it.quantity, 0)
				if (delivery.minimumOrder > 0 && subtotal + 1e-9 < delivery.minimumOrder) {
					return fillTemplate(odLabels.blockMinimum, {
						amount: formatCurrency(delivery.minimumOrder - subtotal),
						minimum: formatCurrency(delivery.minimumOrder),
					})
				}
			}
			if (currentSchedule() === false) return odLabels.scheduleExpired
			return null
		}

		function renderBlockReason() {
			const reason = blockReason()
			const box = document.getElementById('place-order-block')
			const text = document.getElementById('place-order-block-text')
			if (text) text.textContent = reason ?? ''
			const bar = document.getElementById('place-order-block-bar')
			if (bar) {
				bar.textContent = reason ?? ''
				bar.classList.toggle('hidden', !reason)
			}
			box?.classList.toggle('hidden', !reason)
			const button = document.getElementById('place-order-btn')
			if (reason) button?.setAttribute('aria-disabled', 'true')
			else button?.removeAttribute('aria-disabled')
		}

		function renderDropPickup() {
			if (!drop) return
			const summary = document.getElementById('drop-pickup-summary')
			const locationEl = document.getElementById('drop-pickup-location')
			const addressEl = document.getElementById('drop-pickup-address')
			const timeEl = document.getElementById('drop-pickup-time')
			const missing = document.getElementById('drop-pickup-missing')
			if (!pickupSelection || !pickupLocation) {
				summary?.classList.add('hidden')
				missing?.classList.remove('hidden')
				return
			}
			missing?.classList.add('hidden')
			if (summary) summary.classList.remove('hidden')
			const start = zonedTimeToUtc(
				pickupSelection.date,
				pickupSelection.slotStart,
				pickupLocation.timezone,
			)
			const dateText = formatDropDate(
				pickupSelection.date,
				meta.locale,
				pickupLocation.timezone,
			)
			const timeText = start
				? formatDropTime(start, meta.locale, pickupLocation.timezone)
				: pickupSelection.slotStart
			if (locationEl) locationEl.textContent = pickupLocation.name
			if (addressEl) addressEl.textContent = formatPickupAddress(pickupLocation.address)
			if (timeEl) timeEl.textContent = `${dateText} · ${timeText}`
		}

		function showPickupMissing() {
			const missing = document.getElementById('drop-pickup-missing')
			missing?.classList.remove('hidden')
			missing?.focus()
			missing?.scrollIntoView({ block: 'center' })
		}

		function showCheckoutError(message: string, receiptUrl?: string) {
			const box = document.getElementById('checkout-error')
			const text = document.getElementById('checkout-error-text')
			const link = document.getElementById('checkout-error-link') as HTMLAnchorElement | null
			if (text) text.textContent = message
			if (link) {
				if (receiptUrl) {
					link.href = receiptUrl
					link.classList.remove('hidden')
				} else {
					link.classList.add('hidden')
				}
			}
			box?.classList.remove('hidden')
			box?.scrollIntoView({ block: 'center' })
		}

		function hideCheckoutError() {
			document.getElementById('checkout-error')?.classList.add('hidden')
		}

		// Display only: flag the field and say why right under it, so the
		// message is visible on phones where the summary card sits far below.
		function markInvalid(input: HTMLInputElement | null, message: string) {
			if (!input) return
			const errorId = `${input.id}-error`
			let hint = document.getElementById(errorId)
			if (!hint) {
				hint = createEl('p', 'mt-1.5 flex items-center gap-1.5 text-sm font-medium text-destructive')
				hint.id = errorId
				input.insertAdjacentElement('afterend', hint)
			}
			hint.textContent = message
			input.setAttribute('aria-invalid', 'true')
			input.setAttribute('aria-describedby', errorId)
			input.addEventListener(
				'input',
				() => {
					input.removeAttribute('aria-invalid')
					input.removeAttribute('aria-describedby')
					hint?.remove()
				},
				{ once: true },
			)
		}

		function showOrderingClosedNotice(text: string) {
			orderingOpen = false
			const notice = document.getElementById('ordering-closed-notice')
			if (notice) {
				const target = document.getElementById('ordering-closed-text') ?? notice
				target.textContent = text
				notice.classList.remove('hidden')
			}
			const placeBtn = document.getElementById('place-order-btn') as HTMLButtonElement | null
			if (placeBtn) placeBtn.disabled = true
		}

		function showOrderingClosed(reason: string | null, nextOpen: string | null) {
			const reopenAt = nextOpen ? new Date(nextOpen) : null
			const reopenText =
				reopenAt && !Number.isNaN(reopenAt.getTime())
					? fillTemplate(labels.closedReopen, {
							time: formatDropDateTime(reopenAt, meta.locale, pickupLocation?.timezone ?? 'UTC'),
						})
					: labels.closed
			showOrderingClosedNotice(reason ? `${reopenText} ${reason}` : reopenText)
		}

		function updateHandoffLabel() {
			const el = document.getElementById('pay-handoff-label')
			if (el) {
				el.textContent = mode === 'delivery' ? labels.payOnDelivery : labels.payAtPickup
			}
		}

		function updateTipAvailability(options: PublicOrderingOptions | null) {
			const tips = options?.tips
			const enabled = !tips || (mode === 'delivery' ? tips.delivery : tips.pickup)
			document.getElementById('tip-card')?.classList.toggle('hidden', !enabled)
			if (!enabled) {
				tipPercent = 0
				renderCheckout()
			}
		}

		// Wire fulfillment mode radios
		const radioPickup = document.getElementById('radio-pickup') as HTMLInputElement
		const radioDelivery = document.getElementById('radio-delivery') as HTMLInputElement

		if (mode === 'delivery' && radioDelivery) {
			radioDelivery.checked = true
		} else if (radioPickup) {
			radioPickup.checked = true
		}

		function setMode(next: 'pickup' | 'delivery') {
			mode = next
			if (radioPickup) radioPickup.checked = next === 'pickup'
			if (radioDelivery) radioDelivery.checked = next === 'delivery'
			updateHandoffLabel()
			updateTipAvailability(orderingOptions)
			renderCheckout()
		}

		radioPickup?.addEventListener('change', () => {
			if (!isDrop) details = updateOrderDetails(orgId, details, { mode: 'pickup' })
			setMode('pickup')
		})
		radioDelivery?.addEventListener('change', () => {
			if (!isDrop) details = updateOrderDetails(orgId, details, { mode: 'delivery' })
			setMode('delivery')
			// No verified address yet: open the sheet on the delivery tab.
			if (!hasValidDeliveryQuote(details)) openOrderDetails('delivery')
		})

		// The sheet saved new details (or another tab did): re-read and re-render.
		if (!isDrop) {
			subscribeOrderDetails(orgId, () => {
				details = loadOrderDetails(orgId, { locationId: meta.locationId ?? '', allowedModes })
				const next = details.mode === 'delivery' && deliveryAvailable ? 'delivery' : 'pickup'
				hideCheckoutError()
				setMode(next)
			})
		}

		// Drop orders paying online: say how long the hold lasts before the
		// customer commits. The note also describes the Place order button.
		function updateHoldNote() {
			const note = document.getElementById('checkout-hold-note')
			if (!note) return
			const visible = isDrop && paymentMethod === 'online'
			note.classList.toggle('hidden', !visible)
			const placeBtn = document.getElementById('place-order-btn')
			if (visible) placeBtn?.setAttribute('aria-describedby', 'checkout-hold-note')
			else placeBtn?.removeAttribute('aria-describedby')
		}

		// Wire payment method radios
		document
			.querySelectorAll<HTMLInputElement>('input[name="payment_method"]')
			.forEach((radio) => {
				radio.addEventListener('change', () => {
					if (radio.checked) {
						paymentMethod = radio.value === 'online' ? 'online' : 'handoff'
					}
					updateHoldNote()
				})
			})

		// Wire tip buttons
		document.querySelectorAll('.tip-btn').forEach((btn) => {
			btn.addEventListener('click', () => {
				document.querySelectorAll('.tip-btn').forEach((b) => {
					b.classList.remove('border-foreground', 'bg-foreground', 'text-background')
					b.classList.add('border-border', 'bg-background', 'text-foreground')
					b.setAttribute('aria-pressed', 'false')
				})
				btn.classList.add('border-foreground', 'bg-foreground', 'text-background')
				btn.classList.remove('border-border', 'bg-background', 'text-foreground')
				btn.setAttribute('aria-pressed', 'true')
				tipPercent = Number(btn.getAttribute('data-tip') || 0)
				renderCheckout()
			})
		})

		// ---------- regional ordering options (availability, never PII) ----------

		let orderingOptions: PublicOrderingOptions | null = null

		function applyOrderingOptions(options: PublicOrderingOptions) {
			// Online payment is offered only when the region says it is enabled;
			// otherwise the handoff option stays the only (and default) choice.
			const onlineRow = document.getElementById('pay-online-row')
			const onlineRadio = document.getElementById('pay-online') as HTMLInputElement | null
			const handoffRadio = document.getElementById('pay-handoff') as HTMLInputElement | null
			if (options.onlinePayment?.enabled) {
				onlineRow?.classList.remove('hidden')
			} else {
				onlineRow?.classList.add('hidden')
				if (onlineRadio?.checked && handoffRadio) handoffRadio.checked = true
				paymentMethod = 'handoff'
			}
			updateHoldNote()
			if (!isDrop && (options.delivery?.available === false || options.fulfillment?.delivery === false)) {
				deliveryAvailable = false
				if (radioDelivery) radioDelivery.disabled = true
				const hint = document.getElementById('delivery-hint')
				if (hint) hint.textContent = odLabels.deliveryNotAvailable
				if (mode === 'delivery' && allowedModes.includes('pickup')) {
					details = updateOrderDetails(orgId, details, { mode: 'pickup' })
					mode = 'pickup'
					if (radioPickup) radioPickup.checked = true
					updateHandoffLabel()
					renderCheckout()
				}
			}
			updateTipAvailability(options)
			if (options.ordering?.open === false) {
				showOrderingClosed(
					options.ordering.reason ?? null,
					options.ordering.nextOpen ?? null,
				)
			} else if (isDrop && options.drop && options.drop.status !== 'live') {
				showOrderingClosedNotice(labels.errors.dropClosed)
			}
		}

		async function loadOrderingOptions() {
			const locationId = isDrop
				? (pickupSelection?.locationId ?? null)
				: (meta.locationId ?? null)
			if (!locationId) return
			try {
				orderingOptions = await fetchOrderingOptions({
					locationId,
					dropSlug: isDrop ? drop!.slug : null,
				})
				applyOrderingOptions(orderingOptions)
			} catch {
				// The region is unreachable or options are malformed: stay quiet,
				// keep handoff as the only choice, and let the server judge the
				// order authoritatively at submit time.
				orderingOptions = null
			}
		}

		// Drop windows joined with their location data for pickup revalidation.
		function dropPickupWindows() {
			if (!drop) return []
			return drop.windows.map((window) => ({
				...window,
				location:
					drop.pickupLocations.find((l) => l.id === window.locationId) ?? null,
			}))
		}

		// Place order button
		const placeBtn = document.getElementById('place-order-btn') as HTMLButtonElement | null

		function setBusy(busy: boolean) {
			if (!placeBtn) return
			placeBtn.disabled = busy || !orderingOpen
			placeBtn.setAttribute('aria-busy', busy ? 'true' : 'false')
			const label = document.getElementById('place-order-label')
			if (label) label.textContent = busy ? labels.placingOrder : labels.placeOrder
			else placeBtn.textContent = busy ? labels.placingOrder : labels.placeOrder
			document.getElementById('place-order-spinner')?.classList.toggle('hidden', !busy)
		}

		placeBtn?.addEventListener('click', () => {
			void placeOrder()
		})

		async function placeOrder() {
			hideCheckoutError()
			if (!orderingOpen) return

			// Drop orders revalidate the pickup chosen on the drop page: the slot
			// can sell out or fall inside the lead time while checkout sits open.
			let pickup: { windowId: string; time: string } | null = null
			let orderLocationId: string | null = meta.locationId ?? null
			if (isDrop && drop) {
				const selection = loadPickupSelection(drop.id)
				const resolved = resolvePickup(buildPickupOptions(dropPickupWindows()), selection)
				if (!resolved) {
					showPickupMissing()
					return
				}
				const window = drop.windows.find(
					(candidate) =>
						candidate.locationId === selection!.locationId &&
						candidate.date === selection!.date &&
						(candidate.slots ?? []).some((slot) => slot.time === selection!.slotStart),
				)
				if (!window) {
					showPickupMissing()
					return
				}
				pickup = { windowId: window.id, time: selection!.slotStart }
				orderLocationId = selection!.locationId
			}

			const nameInput = document.getElementById('cust-name') as HTMLInputElement
			const phoneInput = document.getElementById('cust-phone') as HTMLInputElement
			const emailInput = document.getElementById('cust-email') as HTMLInputElement
			const notesInput = document.getElementById('cust-delivery-notes') as HTMLInputElement

			if (!nameInput?.value.trim()) {
				showCheckoutError(labels.validation.name)
				markInvalid(nameInput, labels.validation.name)
				nameInput?.focus()
				return
			}
			if (!phoneInput?.value.trim()) {
				showCheckoutError(labels.validation.phone)
				markInvalid(phoneInput, labels.validation.phone)
				phoneInput?.focus()
				return
			}
			if (!emailInput?.value.trim()) {
				showCheckoutError(labels.validation.email)
				markInvalid(emailInput, labels.validation.email)
				emailInput?.focus()
				return
			}

			const fulfillment: 'pickup' | 'delivery' = isDrop ? 'pickup' : mode
			// Re-read: the quote may have expired while checkout sat open.
			if (!isDrop) details = loadOrderDetails(orgId, { locationId: meta.locationId ?? '', allowedModes })
			const blocked = blockReason()
			if (blocked) {
				renderCheckout()
				showCheckoutError(blocked)
				if (fulfillment === 'delivery' && !validDelivery()) openOrderDetails('delivery')
				else if (currentSchedule() === false) openOrderDetails('time')
				return
			}
			let delivery: Record<string, string> | undefined
			if (fulfillment === 'delivery') {
				const verified = validDelivery()!
				// The address, city and unit are signed into the quote token; the
				// region re-resolves the zone from it. City is only sent when the
				// geocoder returned one (an empty city used to fail validation).
				delivery = {
					address: verified.line1.trim().length >= 5 ? verified.line1.trim() : verified.formatted,
					quoteToken: verified.quoteToken,
				}
				if (verified.city.trim()) delivery.city = verified.city.trim()
				if (verified.unit?.trim()) delivery.unit = verified.unit.trim()
				if (notesInput?.value.trim()) delivery.notes = notesInput.value.trim()
			}
			const scheduledFor = isDrop ? null : currentSchedule() || null

			const successUrl = `${meta.successUrl || '/menu/success'}?order=`

			setBusy(true)
			try {
				const corePayload: Record<string, unknown> = {
					locale: meta.locale,
					locationId: orderLocationId,
					...(isDrop && drop ? { dropSlug: drop.slug, pickup } : {}),
					fulfillment,
					paymentMethod,
					contact: {
						name: nameInput.value.trim(),
						phone: phoneInput.value.trim(),
						email: emailInput.value.trim(),
					},
					...(delivery ? { delivery } : {}),
					...(scheduledFor ? { scheduledFor } : {}),
					tipPercent,
					lines: orderLines(cart),
				}
				const idempotencyKey = await checkoutAttemptKey(orgId, corePayload)
				const created = await submitRegionalOrder({
					...corePayload,
					idempotencyKey,
				})
				saveOrderCapability(orgId, created)
				try {
					localStorage.removeItem(storageKey)
					if (isDrop && drop) clearPickupSelection(drop.id)
					clearCheckoutAttempt(orgId)
				} catch {}

				if (paymentMethod === 'online') {
					try {
						const url = await startOrderPayment(
							orgId,
							created.order.id,
							meta.locale,
						)
						window.location.assign(url)
						return
					} catch {
						// The order is placed and held; payment can resume from the
						// receipt page, so send the customer there with an explanation.
						showCheckoutError(
							labels.orderPlacedPaymentFailed,
							`${successUrl}${encodeURIComponent(created.order.id)}`,
						)
						setBusy(false)
						return
					}
				}
				window.location.assign(
					`${successUrl}${encodeURIComponent(created.order.id)}`,
				)
			} catch (error) {
				const code =
					error instanceof OrderRequestError ? error.code : 'order_failed'
				// Same key, different payload: the next attempt must mint a new key.
				if (code === 'idempotency_conflict') clearCheckoutAttempt(orgId)
				if (code === 'delivery_quote_expired') {
					details = updateOrderDetails(orgId, details, { delivery: undefined })
					renderCheckout()
					showCheckoutError(odLabels.quoteExpired)
					openOrderDetails('delivery')
				} else if (code === 'schedule_unavailable') {
					details = updateOrderDetails(orgId, details, { scheduledFor: null })
					renderCheckout()
					showCheckoutError(odLabels.scheduleExpired)
					openOrderDetails('time')
				} else {
					showCheckoutError(orderErrorMessage(code, labels.errors))
				}
				setBusy(false)
			}
		}

		// Drop order window: a truthful countdown to the configured closing time.
		// Nothing is held before the order exists; the hold only starts after
		// `POST /orders` succeeds and the success page reads `holdExpiresAt`.
		if (isDrop && drop?.ordersCloseAt && cart.length > 0) {
			const closeInstant = new Date(drop.ordersCloseAt)
			if (!Number.isNaN(closeInstant.getTime())) {
				const timezone =
					pickupLocation?.timezone ?? drop.pickupLocations[0]?.timezone ?? 'UTC'
				const banner = document.getElementById('drop-close-banner')
				const text = document.getElementById('drop-close-text')
				if (text) {
					text.textContent = fillTemplate(labels.ordersClose, {
						when: formatDropDateTime(closeInstant, meta.locale, timezone),
					})
				}
				banner?.classList.remove('hidden')
				startCountdown(
					closeInstant,
					(ms) => {
						const el = document.getElementById('drop-close-countdown')
						if (el) el.textContent = formatRemaining(ms, meta.locale)
					},
					() => showOrderingClosedNotice(labels.errors.dropClosed),
				)
			}
		}

		renderCheckout()
		if (isDrop) renderDropPickup()
		updateHandoffLabel()
		void loadOrderingOptions()
	</script>
</SitePage>
