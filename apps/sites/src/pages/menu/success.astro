---
import { msg } from '@lingui/core/macro'
import { getLocalizedMenuValue } from '@repo/common/menu-types'
import { getLocaleHref } from '@repo/common/site-locales'
import SitePage from '~/components/SitePage.astro'
import DropAlertsSignup from '~/components/drops/DropAlertsSignup.astro'
import { translate } from '~/lib/ordering-labels'
import { formatMoney } from '~/lib/ordering/money'
import { fetchPublishedDrops, fetchPublishedSiteMenu } from '~/lib/org'

const organization = Astro.locals.organization
const i18n = Astro.locals.i18n
const orgSlug = Astro.locals.orgSlug
const customHost = Astro.locals.customHost
const requestedLocale =
	Astro.locals.requestedLocale ||
	organization?.locale ||
	organization?.defaultLocale ||
	'en'
const defaultLocale = organization?.defaultLocale || 'en'

if (!organization) {
	return new Response('Not Found', { status: 404, statusText: 'Not Found' })
}

const menuHref = getLocaleHref('/menu', requestedLocale, requestedLocale, defaultLocale)
const homeHref = getLocaleHref('/', requestedLocale, requestedLocale, defaultLocale)
const dropBaseHref = getLocaleHref('/drop', requestedLocale, requestedLocale, defaultLocale)

// Locations (name/address/timezone) let the client render the receipt's
// pickup block without any customer data crossing Sites SSR.
const menuPayload = await fetchPublishedSiteMenu({
	slug: orgSlug,
	host: customHost,
	lng: requestedLocale,
})
const receiptLocations = (menuPayload?.locations ?? []).map((location) => ({
	id: location.id,
	name: getLocalizedMenuValue(location.name, requestedLocale, defaultLocale),
	address: location.address,
	timezone: location.timezone ?? 'UTC',
}))

// Receipts carry only the drop slug; titles come from the public drop listing.
const publishedDrops = await fetchPublishedDrops({
	slug: orgSlug,
	host: customHost,
}).catch(() => [])
const dropTitles = Object.fromEntries(
	publishedDrops.map((drop) => [
		drop.slug,
		getLocalizedMenuValue(drop.title, requestedLocale, defaultLocale),
	]),
)

const hasOrderParam = Boolean(Astro.url.searchParams.get('order'))

const successTitle = i18n._(msg`Order confirmed`)
const dropAlertsTitle = i18n._(msg`Want first dibs next time?`)
const thankYouTitle = i18n._(msg`Thank you for your order!`)
const thankYouDesc = i18n._(msg`We've received your order and our kitchen is preparing your meal.`)
const orderNumLabel = i18n._(msg`Order number`)
const estTimeLabel = i18n._(msg`Estimated time`)
const pickupTimeLabel = i18n._(msg`Pickup time`)
const receiptTitle = i18n._(msg`Receipt`)
const subtotalText = i18n._(msg`Subtotal`)
const taxText = i18n._(msg`Tax`)
const deliveryFeeText = i18n._(msg`Delivery fee`)
const tipText = i18n._(msg`Tip`)
const totalText = i18n._(msg`Total`)
const totalPaidText = i18n._(msg`Total paid`)
const backToMenuLabel = i18n._(msg`Back to menu`)
const returnHomeLabel = i18n._(msg`Return to homepage`)
const pickupOrderText = i18n._(msg`Pickup order`)
const deliveryOrderText = i18n._(msg`Delivery order`)
const addToCalendarLabel = i18n._(msg`Add to calendar`)
/** Kept as a template so the client can fill in the drop title. */
const pickupCalendarTitle = translate(i18n, msg`Pickup: {title}`, { title: '{title}' })

// ---------- regional receipt states ----------

const loadingText = i18n._(msg`Loading your receipt…`)
const missingTitle = i18n._(msg`We couldn't find this order`)
const missingDesc = i18n._(msg`The link may be incomplete. You can start a new order from the menu.`)
const deviceTitle = i18n._(msg`Receipt unavailable on this device`)
const deviceDesc = i18n._(msg`This receipt is only available on the device used to place the order.`)
const loadErrorTitle = i18n._(msg`We couldn't load your receipt`)
const loadErrorDesc = i18n._(msg`Please check your connection and try again.`)
const retryLabel = i18n._(msg`Try again`)
const pendingTitle = i18n._(msg`Waiting for payment confirmation`)
const pendingDesc = i18n._(msg`Keep this page open — we'll confirm your order as soon as your payment completes.`)
const pendingTimeoutDesc = i18n._(msg`We're still waiting for confirmation. Check again in a moment.`)
const checkAgainLabel = i18n._(msg`Check again`)
const paymentFailedTitle = i18n._(msg`Payment failed`)
const paymentFailedDesc = i18n._(msg`Your payment didn't go through. Your order is held for a short time — you can try again.`)
const tryPaymentAgainLabel = i18n._(msg`Try payment again`)
const paymentExpiredTitle = i18n._(msg`Your payment window expired`)
const paymentExpiredDesc = i18n._(msg`The hold on your order was released. Please place a new order.`)

// ---------- checkout hold (pending online payment) ----------

/** Kept as a template; the countdown is spliced in at `{time}`. */
const holdTitleTemplate = translate(i18n, msg`We're holding your order for {time}.`, { time: '{time}' })
const [holdTitleBefore = '', holdTitleAfter = ''] = holdTitleTemplate.split('{time}')
const holdDesc = i18n._(msg`Complete payment to keep it.`)
const completePaymentLabel = i18n._(msg`Complete payment`)

const successLabels = {
	locale: requestedLocale,
	organizationId: organization.id,
	currency: menuPayload?.organization?.currency || 'USD',
	menuHref,
	dropBaseHref,
	dropTitles,
	pickupOrder: pickupOrderText,
	deliveryOrder: deliveryOrderText,
	pickupTime: pickupTimeLabel,
	estTime: estTimeLabel,
	estPickup: i18n._(msg`~15-25 minutes`),
	estDelivery: i18n._(msg`~35-45 minutes`),
	pickupCalendarTitle,
	deliverTo: translate(i18n, msg`Deliver to: {address}`, { address: '{address}' }),
	confirmedBadge: successTitle,
	confirmedTitle: thankYouTitle,
	confirmedDesc: thankYouDesc,
	pendingTitle,
	pendingDesc,
	pendingTimeoutDesc,
	failedTitle: paymentFailedTitle,
	failedDesc: paymentFailedDesc,
	expiredTitle: paymentExpiredTitle,
	expiredDesc: paymentExpiredDesc,
	paymentStartFailed: i18n._(msg`We couldn't start payment. Please try again.`),
	holdTitle: holdTitleTemplate,
	holdDesc,
	holdAnnounce: translate(i18n, msg`{time} left to complete payment.`, { time: '{time}' }),
	total: totalText,
	totalPaid: totalPaidText,
	statuses: {
		pending: i18n._(msg`Order received`),
		accepted: i18n._(msg`Accepted`),
		preparing: i18n._(msg`Preparing`),
		ready: i18n._(msg`Ready`),
		completed: i18n._(msg`Completed`),
		cancelled: i18n._(msg`Cancelled`),
	},
	locations: receiptLocations,
}

const price = (amount: number) =>
	formatMoney(amount, successLabels.currency, requestedLocale)

/** Visual progress only; the script marks reached steps from the receipt. */
const timelineSteps = [
	{ key: 'received', label: successLabels.statuses.pending },
	{ key: 'preparing', label: successLabels.statuses.preparing },
	{ key: 'ready', label: successLabels.statuses.ready },
]

// Shared class recipes (spec §3). Elements the script shows and hides keep
// core display utilities so `.hidden` always wins.
const emptyClass = 'surface flex flex-col items-center gap-3 px-6 py-12 text-center'
const emptyIconClass =
	'flex size-12 items-center justify-center rounded-xl bg-muted text-muted-foreground'
const noticeClass = 'flex items-start gap-3 rounded-lg border p-3 text-sm sm:p-4'
const factIconClass =
	'flex size-9 shrink-0 items-center justify-center rounded-lg bg-muted text-muted-foreground'
const rowClass =
	'flex items-baseline justify-between gap-4 text-sm text-muted-foreground'
const valueClass = 'price font-medium text-foreground'
---

<SitePage
	organization={organization}
	page={{ id: 'success', title: successTitle, slug: 'menu/success', isHomePage: false, sections: [] }}
	title={`${successTitle} - ${organization.name}`}
>
	<div class="min-h-screen bg-background pt-8 pb-16 sm:pt-12 sm:pb-24">
		<div class="mx-auto w-full max-w-2xl px-5 sm:px-8">
			{/* Loading state (only while a receipt fetch is in flight) */}
			<div id="success-loading" class:list={['surface p-6 sm:p-8', hasOrderParam ? '' : 'hidden']} role="status">
				<div class="flex flex-col items-center gap-3" aria-hidden="true">
					<div class="skeleton size-16 rounded-full"></div>
					<div class="skeleton mt-2 h-5 w-28"></div>
					<div class="skeleton h-8 w-64 max-w-full"></div>
					<div class="skeleton h-4 w-80 max-w-full"></div>
				</div>
				<div class="mt-8 space-y-3 border-t border-border pt-6" aria-hidden="true">
					<div class="skeleton h-4 w-full"></div>
					<div class="skeleton h-4 w-5/6"></div>
					<div class="skeleton h-4 w-2/3"></div>
				</div>
				<p class="mt-6 text-center text-sm text-muted-foreground">{loadingText}</p>
			</div>

			{/* No order reference in the URL */}
			<div id="success-missing" class:list={[emptyClass, hasOrderParam ? 'hidden' : '']}>
				<span class={emptyIconClass}>
					<svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="m9.5 12.5 5 5"/><path d="m14.5 12.5-5 5"/></svg>
				</span>
				<h1 class="text-xl font-bold tracking-tight text-foreground">{missingTitle}</h1>
				<p class="max-w-sm text-sm text-muted-foreground">{missingDesc}</p>
				<a href={menuHref} class="btn-cta mt-2">{backToMenuLabel}</a>
			</div>

			{/* Receipt capability lives only in this device's sessionStorage */}
			<div id="success-device" class:list={[emptyClass, 'hidden']}>
				<span class={emptyIconClass}>
					<svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="20" x="5" y="2" rx="2"/><path d="M12 18h.01"/></svg>
				</span>
				<h1 class="text-xl font-bold tracking-tight text-foreground">{deviceTitle}</h1>
				<p class="max-w-sm text-sm text-muted-foreground">{deviceDesc}</p>
				<a href={menuHref} class="btn-cta mt-2">{backToMenuLabel}</a>
			</div>

			{/* Receipt fetch failed (network/region) */}
			<div id="success-error" class:list={[emptyClass, 'hidden']}>
				<span class="flex size-12 items-center justify-center rounded-xl bg-destructive/10 text-destructive">
					<svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
				</span>
				<h1 class="text-xl font-bold tracking-tight text-foreground">{loadErrorTitle}</h1>
				<p class="max-w-sm text-sm text-muted-foreground">{loadErrorDesc}</p>
				<button type="button" id="success-retry" class="btn-cta mt-2">{retryLabel}</button>
			</div>

			{/* Receipt view */}
			<div id="order-view" class="hidden space-y-4 sm:space-y-5">
				<section class="surface px-5 py-8 text-center sm:p-10">
					{/* Celebration / attention mark. The script swaps the success and
					    destructive tints together with the two icons. */}
					<div id="success-icon" class="mx-auto flex size-16 items-center justify-center rounded-full border border-success/25 bg-success/10 text-success">
						<svg id="icon-confirmed" xmlns="http://www.w3.org/2000/svg" class="size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
						<svg id="icon-pending" xmlns="http://www.w3.org/2000/svg" class="hidden size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.25"/><path d="M12 7v5l3 2"/></svg>
						<svg id="icon-attention" xmlns="http://www.w3.org/2000/svg" class="hidden size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 8v5M12 16.5v.5"/><circle cx="12" cy="12" r="9.25"/></svg>
					</div>

					<span id="success-badge-text" class="badge tone-success mt-5">{successTitle}</span>
					<h1 id="success-heading" class="mt-3 text-2xl font-bold tracking-tight text-balance text-foreground sm:text-3xl">
						{thankYouTitle}
					</h1>
					<p id="success-subtext" class="mx-auto mt-2 max-w-md text-sm leading-relaxed text-muted-foreground sm:text-base">
						{thankYouDesc}
					</p>

					<div class="mt-6 inline-flex flex-col items-center gap-1 rounded-lg bg-muted px-5 py-3">
						<span class="text-xs text-muted-foreground">{orderNumLabel}</span>
						<span id="order-num" class="price font-heading text-xl text-foreground" dir="ltr">#—</span>
					</div>

					{/* Status timeline: visual only, filled from the receipt's status. */}
					<ol id="order-timeline" class="mx-auto mt-6 hidden max-w-sm items-center gap-2 [&:not(.hidden)]:flex" aria-describedby="order-status-badge">
						{timelineSteps.map((step, index) => (
							<>
								{index > 0 ? <li class="h-px flex-1 bg-border" aria-hidden="true" data-step-line /> : null}
								<li class="group flex items-center gap-1.5 text-xs text-muted-foreground data-reached:font-semibold data-reached:text-foreground" data-step={step.key}>
									<span class="size-2 shrink-0 rounded-full border border-muted-foreground/50 group-data-reached:border-success group-data-reached:bg-success" aria-hidden="true"></span>
									{step.label}
								</li>
							</>
						))}
					</ol>
					<span id="order-status-badge" class="badge tone-neutral mt-4"></span>
				</section>

				{/* Online payment states */}
				<div id="payment-pending" class:list={[noticeClass, 'tone-warning hidden']} role="status">
					<svg id="payment-pending-spinner" xmlns="http://www.w3.org/2000/svg" class="mt-0.5 size-5 shrink-0 animate-spin motion-reduce:animate-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-6.22-8.56"/></svg>
					<div class="min-w-0 flex-1 space-y-1">
						<p id="payment-pending-title" class="sr-only">{pendingTitle}</p>
						<p id="payment-pending-desc" class="text-foreground/80">{pendingDesc}</p>
						<button type="button" id="payment-check-again" class="btn-secondary mt-2 hidden [&.hidden]:hidden">{checkAgainLabel}</button>
					</div>
				</div>
				{/* Checkout hold: replaces the pending notice while the hold is live.
				    Turns from warning to danger in the final minute; at zero the
				    script swaps in the released state without a reload. Speech is
				    throttled through #payment-hold-live, not this timer. */}
				<section
					id="payment-hold"
					class="tone-warning hidden rounded-lg border p-4 text-sm transition-colors duration-300 ease-out motion-reduce:transition-none sm:p-5"
					aria-labelledby="payment-hold-title"
				>
					<div class="flex items-start gap-3">
						<svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 22h14"/><path d="M5 2h14"/><path d="M17 22v-4.172a2 2 0 0 0-.586-1.414L12 12l-4.414 4.414A2 2 0 0 0 7 17.828V22"/><path d="M7 2v4.172a2 2 0 0 0 .586 1.414L12 12l4.414-4.414A2 2 0 0 0 17 6.172V2"/></svg>
						<div class="min-w-0 flex-1">
							{/* The sentence is ink; the clock keeps the tone color so it reads
							    first and turns with the banner in the final minute. */}
							<p id="payment-hold-title" class="text-base leading-snug font-semibold text-balance sm:text-lg">
								<span class="text-foreground">{holdTitleBefore}</span><span id="payment-hold-timer" role="timer" dir="ltr" class="price bidi-isolate text-lg sm:text-xl">--:--</span><span class="text-foreground">{holdTitleAfter}</span>
							</p>
							<p class="mt-1 text-foreground/80">{holdDesc}</p>
							<div class="mt-4 flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:items-center sm:gap-3">
								<button type="button" id="hold-pay-btn" class="btn-cta w-full sm:w-auto">{completePaymentLabel}</button>
								<button type="button" id="hold-check-again" class="btn-secondary hidden w-full sm:w-auto [&.hidden]:hidden">{checkAgainLabel}</button>
							</div>
							<p id="hold-pay-error" class="hidden pt-2 font-semibold" role="alert"></p>
						</div>
					</div>
				</section>
				<div id="payment-failed" class:list={[noticeClass, 'tone-danger hidden']} role="alert">
					<svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="5" rx="2"/><path d="M2 10h20"/></svg>
					<div class="min-w-0 flex-1 space-y-1">
						<p class="font-semibold">{paymentFailedTitle}</p>
						<p class="sr-only">{paymentFailedDesc}</p>
						<button type="button" id="retry-payment-btn" class="btn-cta mt-2 [&.hidden]:hidden">{tryPaymentAgainLabel}</button>
						<p id="retry-payment-error" class="hidden pt-1 font-semibold"></p>
					</div>
				</div>
				<div id="payment-expired" class:list={[noticeClass, 'tone-warning hidden']} role="alert">
					<svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
					<div class="min-w-0 flex-1 space-y-1">
						<p class="font-semibold">{paymentExpiredTitle}</p>
						<p class="sr-only">{paymentExpiredDesc}</p>
						<a id="payment-expired-link" href={menuHref} class="btn-cta mt-2">{backToMenuLabel}</a>
					</div>
				</div>

				{/* Order details */}
				<section id="order-summary-card" class="surface p-5 sm:p-6">
					<dl class="grid gap-4 sm:grid-cols-2">
						<div class="flex gap-3">
							<span class={factIconClass} aria-hidden="true">
								<svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
							</span>
							<div class="min-w-0">
								<dt id="order-est-time-label" class="text-xs text-muted-foreground">{estTimeLabel}</dt>
								<dd id="order-est-time" dir="auto" class="bidi-isolate text-start mt-0.5 text-sm font-semibold text-foreground"></dd>
							</div>
						</div>
						<div class="flex gap-3">
							<span class={factIconClass} aria-hidden="true">
								<svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
							</span>
							<div class="min-w-0">
								<dt id="order-mode-text" class="text-xs text-muted-foreground">{pickupOrderText}</dt>
								<dd id="order-recipient-text" class="mt-0.5 text-sm font-semibold break-words text-foreground"></dd>
							</div>
						</div>

						{/* Pickup details (pre-orders): location, address, slot, calendar */}
						<div id="drop-pickup-details" class="hidden gap-3 sm:col-span-2 [&:not(.hidden)]:flex">
							<span class={factIconClass} aria-hidden="true">
								<svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
							</span>
							<div class="min-w-0 flex-1">
								<dt id="drop-pickup-when-label" class="text-xs text-muted-foreground">{pickupTimeLabel}</dt>
								<dd class="mt-0.5 space-y-0.5 text-sm">
									<p id="drop-pickup-when" dir="auto" class="bidi-isolate text-start font-semibold text-foreground"></p>
									<p id="drop-pickup-location" class="text-foreground"></p>
									<p id="drop-pickup-address" class="text-muted-foreground"></p>
									<p id="drop-pickup-title" class="text-muted-foreground"></p>
								</dd>
								<a
									id="drop-pickup-calendar"
									download="pickup.ics"
									class="btn-secondary mt-3 hidden [&.hidden]:hidden"
								>
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M12 14v6M9 17h6"/></svg>
									{addToCalendarLabel}
								</a>
							</div>
						</div>
					</dl>

					{/* Receipt breakdown (authoritative, from the regional order) */}
					<div class="mt-6 border-t border-border pt-5">
						<h2 class="text-lg font-semibold text-foreground">{receiptTitle}</h2>
						<ul id="order-items-list" class="mt-1 divide-y divide-border">
							<!-- Injected via client script -->
						</ul>
						<dl class="mt-1 space-y-2 border-t border-border pt-4">
							<div class={rowClass}>
								<dt>{subtotalText}</dt>
								<dd id="order-subtotal" class={valueClass}>{price(0)}</dd>
							</div>
							<div class={rowClass}>
								<dt>{taxText}</dt>
								<dd id="order-tax" class={valueClass}>{price(0)}</dd>
							</div>
							<div id="order-deliv-row" class:list={[rowClass, 'hidden']}>
								<dt>{deliveryFeeText}</dt>
								<dd id="order-delivery-fee" class={valueClass}>{price(0)}</dd>
							</div>
							<div class={rowClass}>
								<dt>{tipText}</dt>
								<dd id="order-tip" class={valueClass}>{price(0)}</dd>
							</div>
							<div class="mt-3 flex items-baseline justify-between gap-4 border-t border-border pt-3 text-base font-semibold text-foreground">
								<dt id="order-total-label">{totalPaidText}</dt>
								<dd id="order-total" class="price font-heading text-xl">{price(0)}</dd>
							</div>
						</dl>
					</div>
				</section>

				<DropAlertsSignup source="order_success" title={dropAlertsTitle} />

				<div class="flex flex-col items-center gap-3 pt-2 sm:flex-row sm:justify-center">
					<a href={menuHref} class="btn-secondary w-full sm:w-auto">
						{backToMenuLabel}
					</a>
					<a href={homeHref} class="focus-ring inline-flex min-h-11 items-center rounded-md px-3 text-sm font-semibold text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">
						{returnHomeLabel}
					</a>
				</div>
			</div>
			{/* Throttled hold announcements (minute marks), kept outside hidden
			    containers so the live region is registered before it speaks. */}
			<p id="payment-hold-live" class="sr-only" aria-live="polite" aria-atomic="true"></p>
		</div>
	</div>

	<script
		id="success-labels"
		type="application/json"
		is:inline
		set:html={JSON.stringify(successLabels).replace(/</g, '\\u003c')}
	/>

	<script>
		import { buildIcsDataUrl } from '~/lib/ordering/calendar'
		import { getLocalizedMenuValue } from '@repo/common/menu-types'
		import { createMoneyFormatter, fillTemplate } from '~/lib/ordering/money'
		import {
			OrderRequestError,
			fetchOrderReceipt,
			loadOrderCapability,
			startOrderPayment,
		} from '~/lib/ordering/order-client'
		import {
			interpretPaymentStatus,
			shouldContinuePolling,
			PAYMENT_POLL_INTERVAL_MS,
		} from '~/lib/ordering/payment-poll'
		import { startCountdown } from '~/lib/ordering/countdown'
		import {
			formatHoldClock,
			formatMinutesLong,
			holdAnnouncement,
			isFinalMinute,
			liveHoldRemainingMs,
			minutesLeft,
		} from '~/lib/ordering/hold-timer'
		import { formatPickupAddress, formatSlot } from '~/lib/ordering/pickup'
		import { zonedTimeToUtc } from '~/lib/drops/format'
		import { getOrgBinding } from '~/lib/client-auth'

		type ReceiptLine = {
			itemId: string
			itemName: string
			variantId: string | null
			quantity: number
			unitPriceCents: number
			totalCents: number
			instructions: string | null
			options: Array<{
				groupId: string
				groupName: string
				optionId: string
				optionName: string
				half: 'whole' | 'left' | 'right' | null
				quantity: number
				priceCents: number
				totalCents: number
			}>
		}

		type ReceiptOrder = {
			id: string
			number: string
			status: string
			paymentStatus: string
			currency: string
			subtotalCents: number
			taxCents: number
			deliveryFeeCents: number
			tipCents: number
			totalCents: number
			holdExpiresAt: string | null
			tipPercent: number
			fulfillment: string
			locale: string
			createdAt: string | null
			location: { id: string; name: string } | null
			pickup: {
				windowId: string
				date: string
				time: string
				timezone: string
			} | null
			drop: { slug: string } | null
			lines: ReceiptLine[]
			contact: { name: string; phone: string; email: string | null }
			delivery: {
				address: string
				city: string | null
				unit: string | null
				notes: string | null
				feeCents: number
				zoneId: string | null
			} | null
		}

		const labelsEl = document.getElementById('success-labels')
		const labels = labelsEl ? JSON.parse(labelsEl.textContent || '{}') : {}
		const orgId: string = labels.organizationId || 'default'
		const orderId = new URLSearchParams(window.location.search).get('order')
		const defaultLocale =
			document.documentElement.dataset.defaultLocale || 'en'

		// Catalog names arrive as locale maps ({"en":…,"ar":…}); pick the page locale.
		const localize = (value: string | null | undefined): string =>
			getLocalizedMenuValue(value, labels.locale || 'en', defaultLocale)

		function show(id: string) {
			document.getElementById(id)?.classList.remove('hidden')
		}
		function hide(id: string) {
			document.getElementById(id)?.classList.add('hidden')
		}

		// Build nodes with textContent so operator/guest text is never parsed as HTML.
		function createEl(tag: string, className?: string, text?: string) {
			const node = document.createElement(tag)
			if (className) node.className = className
			if (text !== undefined) node.textContent = text
			return node
		}

		type HeadingTone = 'success' | 'warning' | 'danger'

		function setHeading(badge: string, title: string, subtext: string, tone: HeadingTone = 'success') {
			const attention = tone === 'danger'
			const pending = tone === 'warning'
			const badgeEl = document.getElementById('success-badge-text')
			const titleEl = document.getElementById('success-heading')
			const subtextEl = document.getElementById('success-subtext')
			if (badgeEl) {
				badgeEl.textContent = badge
				badgeEl.classList.toggle('tone-success', tone === 'success')
				badgeEl.classList.toggle('tone-warning', pending)
				badgeEl.classList.toggle('tone-danger', attention)
			}
			if (titleEl) titleEl.textContent = title
			if (subtextEl) subtextEl.textContent = subtext
			document.getElementById('icon-confirmed')?.classList.toggle('hidden', tone !== 'success')
			document.getElementById('icon-pending')?.classList.toggle('hidden', !pending)
			document.getElementById('icon-attention')?.classList.toggle('hidden', !attention)
			const iconWrap = document.getElementById('success-icon')
			iconWrap?.classList.toggle('bg-success/10', tone === 'success')
			iconWrap?.classList.toggle('text-success', tone === 'success')
			iconWrap?.classList.toggle('border-success/25', tone === 'success')
			iconWrap?.classList.toggle('bg-warning/15', pending)
			iconWrap?.classList.toggle('text-warning', pending)
			iconWrap?.classList.toggle('border-warning/30', pending)
			iconWrap?.classList.toggle('bg-destructive/10', attention)
			iconWrap?.classList.toggle('text-destructive', attention)
			iconWrap?.classList.toggle('border-destructive/30', attention)
		}

		function renderReceipt(order: ReceiptOrder) {
			const money = createMoneyFormatter(order.currency || labels.currency || 'USD', labels.locale)
			const formatCents = (cents: number) => money((Number.isFinite(cents) ? cents : 0) / 100)

			const orderNumEl = document.getElementById('order-num')
			const estTimeEl = document.getElementById('order-est-time')
			const estLabelEl = document.getElementById('order-est-time-label')
			const modeTextEl = document.getElementById('order-mode-text')
			const recipientTextEl = document.getElementById('order-recipient-text')
			const itemsListEl = document.getElementById('order-items-list')
			const subtotalEl = document.getElementById('order-subtotal')
			const taxEl = document.getElementById('order-tax')
			const delivRow = document.getElementById('order-deliv-row')
			const delivFeeEl = document.getElementById('order-delivery-fee')
			const tipEl = document.getElementById('order-tip')
			const totalEl = document.getElementById('order-total')
			const totalLabelEl = document.getElementById('order-total-label')
			const statusEl = document.getElementById('order-status-badge')

			if (orderNumEl) orderNumEl.textContent = `#${order.number}`
			// Visual progress: received → preparing → ready. Statuses outside
			// that path (cancelled, expired) hide the timeline and keep the badge.
			const stepIndex = (
				{ pending: 0, accepted: 0, preparing: 1, ready: 2, completed: 2 } as Record<string, number>
			)[order.status]
			const timeline = document.getElementById('order-timeline')
			if (timeline) {
				timeline.classList.toggle('hidden', stepIndex === undefined)
				timeline.querySelectorAll<HTMLElement>('[data-step]').forEach((node, index) => {
					const reached = stepIndex !== undefined && index <= stepIndex
					node.toggleAttribute('data-reached', reached)
					if (index === stepIndex) node.setAttribute('aria-current', 'step')
					else node.removeAttribute('aria-current')
				})
			}
			if (statusEl) {
				statusEl.textContent =
					(labels.statuses as Record<string, string>)[order.status] ??
					(labels.statuses as Record<string, string>).pending
				statusEl.classList.toggle('sr-only', stepIndex !== undefined)
			}
			if (totalLabelEl) {
				totalLabelEl.textContent =
					order.paymentStatus === 'paid' ? labels.totalPaid : labels.total
			}

			const isDelivery = order.fulfillment === 'delivery'
			if (modeTextEl) {
				modeTextEl.textContent = isDelivery
					? labels.deliveryOrder || 'Delivery order'
					: labels.pickupOrder || 'Pickup order'
			}
			if (recipientTextEl) {
				let text = [order.contact?.name, order.contact?.phone]
					.filter(Boolean)
					.join(' • ')
				if (isDelivery && order.delivery) {
					const address = [
						order.delivery.address,
						order.delivery.unit,
						order.delivery.city,
					]
						.filter(Boolean)
						.join(', ')
					if (address) {
						text += ` • ${fillTemplate(labels.deliverTo || 'Deliver to: {address}', { address })}`
					}
				}
				recipientTextEl.textContent = text
			}

			// Pickup orders (all drop orders): show the slot, not an estimate.
			const pickup = order.pickup
			if (pickup) {
				const timezone = pickup.timezone || 'UTC'
				const when = formatSlot(pickup.date, pickup.time, labels.locale || 'en', timezone)
				show('drop-pickup-details')
				const whenEl = document.getElementById('drop-pickup-when')
				const locationEl = document.getElementById('drop-pickup-location')
				const addressEl = document.getElementById('drop-pickup-address')
				const titleEl = document.getElementById('drop-pickup-title')
				const locationMeta = (labels.locations as Array<{ id: string; name: string; address: unknown }>).find(
					(l) => l.id === order.location?.id,
				)
				if (whenEl) whenEl.textContent = when
				if (locationEl) locationEl.textContent = locationMeta?.name || localize(order.location?.name) || ''
				if (addressEl) addressEl.textContent = formatPickupAddress(locationMeta?.address)
				const dropTitle =
					(order.drop?.slug
						? (labels.dropTitles as Record<string, string>)[order.drop.slug]
						: null) ?? order.drop?.slug ?? ''
				if (titleEl) titleEl.textContent = dropTitle
				if (estLabelEl) estLabelEl.textContent = labels.pickupTime || 'Pickup time'
				if (estTimeEl) estTimeEl.textContent = when

				const calendarEl = document.getElementById(
					'drop-pickup-calendar',
				) as HTMLAnchorElement | null
				const start = zonedTimeToUtc(pickup.date, pickup.time, timezone)
				if (calendarEl && start) {
					// The receipt carries the slot start; calendar entries span a
					// sensible half hour when the window interval is unknown.
					const end = new Date(start.getTime() + 30 * 60_000)
					const dropSlug = order.drop?.slug ?? null
					calendarEl.href = buildIcsDataUrl({
						title: fillTemplate(labels.pickupCalendarTitle || 'Pickup: {title}', {
							title:
								(dropSlug
									? (labels.dropTitles as Record<string, string>)[dropSlug]
									: null) ??
								dropSlug ??
								order.number,
						}),
						start,
						end,
						location: [locationMeta?.name || localize(order.location?.name), formatPickupAddress(locationMeta?.address)]
							.filter(Boolean)
							.join(', '),
						description: `#${order.number}`,
						url: dropSlug
							? new URL(
									`${labels.dropBaseHref || '/drop'}/${encodeURIComponent(dropSlug)}`,
									window.location.origin,
								).toString()
							: null,
					})
					calendarEl.classList.remove('hidden')
				}
			} else {
				// Handoff menu orders keep a plain-language prep estimate.
				if (estLabelEl) estLabelEl.textContent = labels.estTime || 'Estimated Time'
				if (estTimeEl) {
					estTimeEl.textContent = isDelivery
						? labels.estDelivery || '~35-45 minutes'
						: labels.estPickup || '~15-25 minutes'
				}
			}

			if (itemsListEl) {
				const rows = (order.lines ?? []).map((line) => {
					const row = createEl('li', 'flex gap-3 py-3')
					row.appendChild(
						createEl(
							'span',
							'price flex h-6 min-w-6 shrink-0 items-center justify-center rounded-md bg-muted px-1.5 text-xs text-foreground',
							String(line.quantity),
						),
					)
					const info = createEl('div', 'min-w-0 flex-1')
					info.appendChild(
						createEl('p', 'text-sm font-semibold leading-snug text-foreground', localize(line.itemName)),
					)
					if (line.options && line.options.length > 0) {
						info.appendChild(
							createEl(
								'p',
								'mt-0.5 text-xs leading-relaxed text-muted-foreground',
								line.options
									.map((o) => {
										const name = localize(o.optionName)
										return o.quantity > 1 ? `${o.quantity}x ${name}` : name
									})
									.join(', '),
							),
						)
					}
					if (line.instructions) {
						info.appendChild(
							createEl('p', 'mt-0.5 text-xs italic leading-relaxed text-muted-foreground', `“${line.instructions}”`),
						)
					}
					row.appendChild(info)
					row.appendChild(
						createEl('span', 'price shrink-0 text-sm text-foreground', formatCents(line.totalCents)),
					)
					return row
				})
				itemsListEl.replaceChildren(...rows)
			}

			if (subtotalEl) subtotalEl.textContent = formatCents(order.subtotalCents)
			if (taxEl) taxEl.textContent = formatCents(order.taxCents)
			if (delivRow && delivFeeEl) {
				if (isDelivery) {
					delivRow.classList.remove('hidden')
					delivFeeEl.textContent = formatCents(order.deliveryFeeCents)
				} else {
					delivRow.classList.add('hidden')
				}
			}
			if (tipEl) tipEl.textContent = formatCents(order.tipCents)
			if (totalEl) totalEl.textContent = formatCents(order.totalCents)
		}

		// ---------- checkout hold countdown ----------

		let stopHold: (() => void) | null = null

		function announceHold(text: string) {
			const live = document.getElementById('payment-hold-live')
			if (!live) return
			// Clear first so a repeated sentence is still spoken.
			live.textContent = ''
			window.setTimeout(() => {
				live.textContent = text
			}, 100)
		}

		function stopHoldCountdown() {
			stopHold?.()
			stopHold = null
			hide('payment-hold')
		}

		/** Starts the hold banner when the order is pending with a live hold. */
		function startHoldCountdown(order: ReceiptOrder): boolean {
			if (stopHold) return true
			const remaining = liveHoldRemainingMs(order, Date.now())
			if (remaining === null || !order.holdExpiresAt) return false
			const section = document.getElementById('payment-hold')
			const timerEl = document.getElementById('payment-hold-timer')
			const locale: string = labels.locale || 'en'
			hide('hold-check-again')
			section?.classList.remove('hidden')
			announceHold(
				`${fillTemplate(labels.holdTitle, {
					time: formatMinutesLong(minutesLeft(remaining), locale),
				})} ${labels.holdDesc}`,
			)
			let previous: number | null = null
			stopHold = startCountdown(
				Date.parse(order.holdExpiresAt),
				(ms) => {
					if (timerEl) timerEl.textContent = formatHoldClock(ms, locale)
					const urgent = isFinalMinute(ms)
					section?.classList.toggle('tone-warning', !urgent)
					section?.classList.toggle('tone-danger', urgent)
					const mark = holdAnnouncement(previous, ms)
					previous = ms
					if (mark !== null) {
						announceHold(
							fillTemplate(labels.holdAnnounce, {
								time: formatMinutesLong(mark, locale),
							}),
						)
					}
				},
				() => {
					// Released: switch states in place; the expired alert speaks.
					stopHold = null
					showExpired(order)
				},
			)
			return true
		}

		function showConfirmed() {
			stopHoldCountdown()
			hide('payment-pending')
			hide('payment-failed')
			hide('payment-expired')
			setHeading(labels.confirmedBadge, labels.confirmedTitle, labels.confirmedDesc)
		}

		function showPending(order: ReceiptOrder) {
			hide('payment-failed')
			hide('payment-expired')
			setHeading(labels.statuses.pending, labels.pendingTitle, labels.pendingDesc, 'warning')
			// A live hold gets the countdown banner (with its own pay action)
			// in place of the generic pending notice; polling continues.
			if (startHoldCountdown(order)) {
				hide('payment-pending')
				return
			}
			document.getElementById('payment-pending-spinner')?.classList.remove('hidden')
			const desc = document.getElementById('payment-pending-desc')
			if (desc) desc.textContent = labels.pendingDesc
			hide('payment-check-again')
			show('payment-pending')
		}

		function showPendingTimeout() {
			if (stopHold) {
				show('hold-check-again')
				return
			}
			document.getElementById('payment-pending-spinner')?.classList.add('hidden')
			const desc = document.getElementById('payment-pending-desc')
			if (desc) desc.textContent = labels.pendingTimeoutDesc
			show('payment-check-again')
		}

		function showFailed(canRetry: boolean) {
			stopHoldCountdown()
			hide('payment-pending')
			hide('payment-expired')
			setHeading(labels.failedTitle, labels.failedTitle, labels.failedDesc, 'danger')
			const retryBtn = document.getElementById('retry-payment-btn')
			retryBtn?.classList.toggle('hidden', !canRetry)
			show('payment-failed')
		}

		function showExpired(order: ReceiptOrder) {
			stopHoldCountdown()
			hide('payment-pending')
			hide('payment-failed')
			setHeading(labels.expiredTitle, labels.expiredTitle, labels.expiredDesc, 'danger')
			const link = document.getElementById('payment-expired-link') as HTMLAnchorElement | null
			if (link && order.drop?.slug) {
				link.href = `${labels.dropBaseHref || '/drop'}/${encodeURIComponent(order.drop.slug)}`
			}
			show('payment-expired')
		}

		// Poll the App-brokered status proxy. A hosted-payment redirect alone
		// never marks the order paid; only this endpoint and the receipt do.
		async function pollPaymentStatus(order: ReceiptOrder) {
			const capability = loadOrderCapability(orgId, order.id)
			if (!capability?.paymentToken) return
			const startedAt = Date.now()
			const tick = async (): Promise<void> => {
				try {
					const response = await fetch('/api/orders/payment-status', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({
							...getOrgBinding(),
							orderId: order.id,
							paymentToken: capability.paymentToken,
							locale: labels.locale,
						}),
					})
					const value: any = await response.json().catch(() => null)
					if (!response.ok) throw new OrderRequestError('payment_unavailable', response.status)
					const outcome = interpretPaymentStatus({
						status: value?.status,
						orderStatus: value?.orderStatus,
						holdExpiresAt: value?.holdExpiresAt,
					})
					if (outcome.kind === 'paid') {
						await loadReceipt()
						showConfirmed()
						return
					}
					if (outcome.kind === 'failed') {
						showFailed(outcome.canRetry)
						return
					}
					if (outcome.kind === 'expired') {
						showExpired(order)
						return
					}
				} catch {
					// Transient proxy/network failure: keep polling until the cap.
				}
				if (shouldContinuePolling(Date.now() - startedAt)) {
					setTimeout(() => void tick(), PAYMENT_POLL_INTERVAL_MS)
				} else {
					showPendingTimeout()
				}
			}
			await tick()
		}

		async function loadReceipt(): Promise<ReceiptOrder | null> {
			if (!orderId) return null
			try {
				const value: any = await fetchOrderReceipt(orgId, orderId)
				const order = (value?.order ?? null) as ReceiptOrder | null
				if (order) renderReceipt(order)
				return order
			} catch {
				return null
			}
		}

		async function init() {
			if (!orderId) {
				hide('success-loading')
				show('success-missing')
				return
			}
			// The receipt capability never leaves this device's sessionStorage.
			if (!loadOrderCapability(orgId, orderId)) {
				hide('success-loading')
				show('success-device')
				return
			}
			const order = await loadReceipt()
			hide('success-loading')
			if (!order) {
				show('success-error')
				return
			}
			show('order-view')

			// Retry after a failure and "Complete payment" during a hold share
			// one action: start a hosted payment session for this order.
			const wirePayButton = (buttonId: string, errorId: string) => {
				const button = document.getElementById(buttonId) as HTMLButtonElement | null
				button?.addEventListener('click', () => {
					void (async () => {
						const errorEl = document.getElementById(errorId)
						errorEl?.classList.add('hidden')
						button.disabled = true
						try {
							const url = await startOrderPayment(orgId, order.id, labels.locale)
							window.location.assign(url)
						} catch {
							if (errorEl) {
								errorEl.textContent = labels.paymentStartFailed
								errorEl.classList.remove('hidden')
							}
							button.disabled = false
						}
					})()
				})
			}
			wirePayButton('retry-payment-btn', 'retry-payment-error')
			wirePayButton('hold-pay-btn', 'hold-pay-error')
			const checkAgain = () => {
				showPending(order)
				void pollPaymentStatus(order)
			}
			document.getElementById('payment-check-again')?.addEventListener('click', checkAgain)
			document.getElementById('hold-check-again')?.addEventListener('click', () => {
				hide('hold-check-again')
				void pollPaymentStatus(order)
			})

			if (order.paymentStatus === 'pending') {
				showPending(order)
				void pollPaymentStatus(order)
			} else if (order.paymentStatus === 'failed') {
				const live =
					!order.holdExpiresAt || Date.parse(order.holdExpiresAt) > Date.now()
				showFailed(live)
			} else if (order.paymentStatus === 'expired' || order.status === 'expired') {
				showExpired(order)
			} else {
				showConfirmed()
			}
		}

		document.getElementById('success-retry')?.addEventListener('click', () => {
			hide('success-error')
			show('success-loading')
			void init()
		})

		void init()
	</script>
</SitePage>
