---
import { msg } from '@lingui/core/macro'
import { getLocalizedMenuValue } from '@repo/common/menu-types'
import { getLocaleHref } from '@repo/common/site-locales'
import SitePage from '~/components/SitePage.astro'
import DropAlertsSignup from '~/components/drops/DropAlertsSignup.astro'
import { translate } from '~/lib/ordering-labels'
import { formatMoney } from '~/lib/ordering/money'
import { fetchPublishedDrops, fetchPublishedSiteMenu } from '~/lib/org'

const organization = Astro.locals.organization
const i18n = Astro.locals.i18n
const orgSlug = Astro.locals.orgSlug
const customHost = Astro.locals.customHost
const requestedLocale =
	Astro.locals.requestedLocale ||
	organization?.locale ||
	organization?.defaultLocale ||
	'en'
const defaultLocale = organization?.defaultLocale || 'en'

if (!organization) {
	return new Response('Not Found', { status: 404, statusText: 'Not Found' })
}

const menuHref = getLocaleHref('/menu', requestedLocale, requestedLocale, defaultLocale)
const homeHref = getLocaleHref('/', requestedLocale, requestedLocale, defaultLocale)
const dropBaseHref = getLocaleHref('/drop', requestedLocale, requestedLocale, defaultLocale)

// Locations (name/address/timezone) let the client render the receipt's
// pickup block without any customer data crossing Sites SSR.
const menuPayload = await fetchPublishedSiteMenu({
	slug: orgSlug,
	host: customHost,
	lng: requestedLocale,
})
const receiptLocations = (menuPayload?.locations ?? []).map((location) => ({
	id: location.id,
	name: getLocalizedMenuValue(location.name, requestedLocale, defaultLocale),
	address: location.address,
	timezone: location.timezone ?? 'UTC',
	// Seller's VAT registration number, printed on the receipt.
	vatNumber: location.vatNumber?.trim() || null,
	// Public location data (not guest data): the "Call the restaurant" link.
	phone: location.phone?.trim() || null,
}))

// Receipts carry only the drop slug; titles come from the public drop listing.
const publishedDrops = await fetchPublishedDrops({
	slug: orgSlug,
	host: customHost,
}).catch(() => [])
const dropTitles = Object.fromEntries(
	publishedDrops.map((drop) => [
		drop.slug,
		getLocalizedMenuValue(drop.title, requestedLocale, defaultLocale),
	]),
)

const hasOrderParam = Boolean(Astro.url.searchParams.get('order'))

const successTitle = i18n._(msg`Order confirmed`)
const dropAlertsTitle = i18n._(msg`Want first dibs next time?`)
const thankYouTitle = i18n._(msg`Thank you for your order!`)
const thankYouDesc = i18n._(msg`We've received your order and our kitchen is preparing your meal.`)
const orderNumLabel = i18n._(msg`Order number`)
const estTimeLabel = i18n._(msg`Estimated time`)
const pickupTimeLabel = i18n._(msg`Pickup time`)
const receiptTitle = i18n._(msg`Receipt`)
const subtotalText = i18n._(msg`Subtotal`)
const rewardDiscountText = i18n._(msg`Reward`)
const discountText = i18n._(msg`Discount`)
const deliveryDiscountText = i18n._(msg`Delivery discount`)
const deliveryDiscountTemplate = translate(i18n, msg`{name} (delivery)`, {
	name: '{name}',
})
const freeOrderText = i18n._(msg`No payment needed`)
const taxText = i18n._(msg`Tax`)
const includesTaxText = i18n._(msg`Includes VAT`)
const vatNumberText = i18n._(msg`VAT number`)
const deliveryFeeText = i18n._(msg`Delivery fee`)
const tipText = i18n._(msg`Tip`)
const serviceFeeText = i18n._(msg`Service fee`)
const packagingFeeText = i18n._(msg`Packaging fee`)
const pickupInstructionsText = i18n._(msg`Pickup instructions`)
const utensilsTitleText = i18n._(msg`Utensils and napkins`)
const utensilsYesText = i18n._(msg`Utensils: yes`)
const utensilsNoText = i18n._(msg`No utensils`)
const totalText = i18n._(msg`Total`)
const totalPaidText = i18n._(msg`Total paid`)
const backToMenuLabel = i18n._(msg`Back to menu`)
const returnHomeLabel = i18n._(msg`Return to homepage`)
const pickupOrderText = i18n._(msg`Pickup order`)
const deliveryOrderText = i18n._(msg`Delivery order`)
const addToCalendarLabel = i18n._(msg`Add to calendar`)
/** Kept as a template so the client can fill in the drop title. */
const pickupCalendarTitle = translate(i18n, msg`Pickup: {title}`, { title: '{title}' })

// ---------- regional receipt states ----------

const loadingText = i18n._(msg`Loading your receipt…`)
const missingTitle = i18n._(msg`We couldn't find this order`)
const missingDesc = i18n._(msg`The link may be incomplete. You can start a new order from the menu.`)
const deviceTitle = i18n._(msg`Receipt unavailable on this device`)
const deviceDesc = i18n._(msg`This receipt is only available on the device used to place the order.`)
const loadErrorTitle = i18n._(msg`We couldn't load your receipt`)
const loadErrorDesc = i18n._(msg`Please check your connection and try again.`)
const retryLabel = i18n._(msg`Try again`)
const pendingTitle = i18n._(msg`Waiting for payment confirmation`)
const pendingDesc = i18n._(msg`Keep this page open — we'll confirm your order as soon as your payment completes.`)
const pendingTimeoutDesc = i18n._(msg`We're still waiting for confirmation. Check again in a moment.`)
const checkAgainLabel = i18n._(msg`Check again`)
const paymentFailedTitle = i18n._(msg`Payment failed`)
const paymentFailedDesc = i18n._(msg`Your payment didn't go through. Your order is held for a short time — you can try again.`)
const tryPaymentAgainLabel = i18n._(msg`Try payment again`)
const paymentExpiredTitle = i18n._(msg`Your payment window expired`)
const linkInvalidTitle = i18n._(msg`This link has expired or isn't valid.`)
const linkInvalidDesc = i18n._(msg`Contact the restaurant for help with your order.`)
const callRestaurantLabel = i18n._(msg`Call the restaurant`)
const resendLabel = i18n._(msg`Email me this receipt again`)
const paymentExpiredDesc = i18n._(msg`The hold on your order was released. Please place a new order.`)

// ---------- checkout hold (pending online payment) ----------

/** Kept as a template; the countdown is spliced in at `{time}`. */
const holdTitleTemplate = translate(i18n, msg`We're holding your order for {time}.`, { time: '{time}' })
const [holdTitleBefore = '', holdTitleAfter = ''] = holdTitleTemplate.split('{time}')
const holdDesc = i18n._(msg`Complete payment to keep it.`)
const completePaymentLabel = i18n._(msg`Complete payment`)

const successLabels = {
	serviceFee: serviceFeeText,
	packagingFee: packagingFeeText,
	utensilsYes: utensilsYesText,
	utensilsNo: utensilsNoText,
	locale: requestedLocale,
	organizationId: organization.id,
	currency: menuPayload?.organization?.currency || 'USD',
	menuHref,
	dropBaseHref,
	dropTitles,
	pickupOrder: pickupOrderText,
	deliveryOrder: deliveryOrderText,
	pickupTime: pickupTimeLabel,
	estTime: estTimeLabel,
	estPickup: i18n._(msg`~15-25 minutes`),
	estDelivery: i18n._(msg`~35-45 minutes`),
	pickupCalendarTitle,
	deliverTo: translate(i18n, msg`Deliver to: {address}`, { address: '{address}' }),
	confirmedBadge: successTitle,
	confirmedTitle: thankYouTitle,
	confirmedDesc: thankYouDesc,
	pendingTitle,
	pendingDesc,
	pendingTimeoutDesc,
	failedTitle: paymentFailedTitle,
	failedDesc: paymentFailedDesc,
	expiredTitle: paymentExpiredTitle,
	expiredDesc: paymentExpiredDesc,
	paymentStartFailed: i18n._(msg`We couldn't start payment. Please try again.`),
	holdTitle: holdTitleTemplate,
	holdDesc,
	holdAnnounce: translate(i18n, msg`{time} left to complete payment.`, { time: '{time}' }),
	total: totalText,
	totalPaid: totalPaidText,
	discount: discountText,
	deliveryDiscount: deliveryDiscountTemplate,
	deliveryDiscountPlain: deliveryDiscountText,
	freeOrder: freeOrderText,
	readyAround: translate(i18n, msg`Ready around {time}`, { time: '{time}' }),
	arrivingAround: translate(i18n, msg`Arriving around {time}`, { time: '{time}' }),
	arriving: translate(i18n, msg`Arriving {range}`, { range: '{range}' }),
	cancelledTitle: i18n._(msg`This order was cancelled`),
	callRestaurant: callRestaurantLabel,
	refunded: translate(i18n, msg`Refunded {amount}`, { amount: '{amount}' }),
	readyDesc: i18n._(msg`Your order is ready.`),
	completedDesc: i18n._(msg`This order is complete.`),
	cancelButton: i18n._(msg`Cancel order`),
	cancelCountdown: translate(i18n, msg`You can cancel this order for another {time}.`, { time: '{time}' }),
	cancelConfirmTitle: i18n._(msg`Cancel this order?`),
	cancelConfirmRefund: i18n._(msg`Your payment will be refunded in full to your card.`),
	cancelConfirmYes: i18n._(msg`Yes, cancel order`),
	cancelKeep: i18n._(msg`Keep order`),
	cancelFailed: i18n._(msg`We couldn't cancel the order. Please try again.`),
	cancelLimited: i18n._(msg`Too many attempts. Try again in a moment.`),
	cancelClosed: i18n._(msg`The time to cancel has passed. Call the restaurant if you need help.`),
	cancelPreparing: i18n._(msg`The kitchen has already started your order, so it can't be cancelled here.`),
	cancelUnavailable: i18n._(msg`This order can't be cancelled here.`),
	waitingTitle: i18n._(msg`Waiting for the restaurant to confirm`),
	waitingDesc: i18n._(msg`We'll update this page as soon as they reply. You don't need to do anything.`),
	waitingEst: i18n._(msg`Once the restaurant confirms`),
	acceptedAnnounce: i18n._(msg`The restaurant accepted your order.`),
	rejectedTitle: i18n._(msg`The restaurant could not take your order`),
	rejectedOutOfStock: i18n._(msg`Some of the items you ordered ran out.`),
	rejectedKitchenClosed: i18n._(msg`The kitchen is closed right now.`),
	refundPending: i18n._(msg`Refund on its way`),
	refundPendingAmount: translate(i18n, msg`Refund of {amount} on its way`, { amount: '{amount}' }),
	refundFailed: i18n._(msg`We couldn't send your refund automatically. Please call the restaurant.`),
	resendSent: i18n._(msg`If we have your email, the receipt is on its way.`),
	resendLimited: i18n._(msg`Too many requests. Try again later.`),
	resendFailed: i18n._(msg`We couldn't send that. Please try again later.`),
	statuses: {
		pending: i18n._(msg`Order received`),
		pending_acceptance: i18n._(msg`Waiting for confirmation`),
		accepted: i18n._(msg`Accepted`),
		preparing: i18n._(msg`Preparing`),
		ready: i18n._(msg`Ready`),
		completed: i18n._(msg`Completed`),
		cancelled: i18n._(msg`Cancelled`),
	},
	locations: receiptLocations,
}

const price = (amount: number) =>
	formatMoney(amount, successLabels.currency, requestedLocale)

/** Visual progress only; the script marks reached steps from the receipt. */
const timelineSteps = [
	{ key: 'received', label: successLabels.statuses.pending },
	{ key: 'preparing', label: successLabels.statuses.preparing },
	{ key: 'ready', label: successLabels.statuses.ready },
]

// Shared class recipes (spec §3). Elements the script shows and hides keep
// core display utilities so `.hidden` always wins.
const emptyClass = 'surface flex flex-col items-center gap-3 px-6 py-12 text-center'
const emptyIconClass =
	'flex size-12 items-center justify-center rounded-xl bg-muted text-muted-foreground'
const noticeClass = 'flex items-start gap-3 rounded-lg border p-3 text-sm sm:p-4'
const factIconClass =
	'flex size-9 shrink-0 items-center justify-center rounded-lg bg-muted text-muted-foreground'
const rowClass =
	'flex items-baseline justify-between gap-4 text-sm text-muted-foreground'
const valueClass = 'price font-medium text-foreground'
---

<SitePage
	organization={organization}
	page={{ id: 'success', title: successTitle, slug: 'menu/success', isHomePage: false, sections: [] }}
	title={`${successTitle} - ${organization.name}`}
>
	{/* The emailed link's token rides in the URL fragment. Park it and clear the
	    address before any other script can read it: this runs from the head
	    slot, ahead of the analytics integrations the layout adds after it. */}
	<script is:inline slot="head">
		(function () {
			try {
				var hash = window.location.hash
				if (hash.indexOf('link=') === -1) return
				if (hash.length <= 512) {
					try {
						sessionStorage.setItem('menuza_order_link_pending', hash)
					} catch (e) {}
				}
				history.replaceState(null, '', window.location.pathname + window.location.search)
			} catch (e) {}
		})()
	</script>
	<div class="min-h-screen bg-background pt-8 pb-16 sm:pt-12 sm:pb-24">
		<div class="mx-auto w-full max-w-2xl px-5 sm:px-8">
			{/* Loading state (only while a receipt fetch is in flight) */}
			<div id="success-loading" class:list={['surface p-6 sm:p-8', hasOrderParam ? '' : 'hidden']} role="status">
				<div class="flex flex-col items-center gap-3" aria-hidden="true">
					<div class="skeleton size-16 rounded-full"></div>
					<div class="skeleton mt-2 h-5 w-28"></div>
					<div class="skeleton h-8 w-64 max-w-full"></div>
					<div class="skeleton h-4 w-80 max-w-full"></div>
				</div>
				<div class="mt-8 space-y-3 border-t border-border pt-6" aria-hidden="true">
					<div class="skeleton h-4 w-full"></div>
					<div class="skeleton h-4 w-5/6"></div>
					<div class="skeleton h-4 w-2/3"></div>
				</div>
				<p class="mt-6 text-center text-sm text-muted-foreground">{loadingText}</p>
			</div>

			{/* No order reference in the URL */}
			<div id="success-missing" class:list={[emptyClass, hasOrderParam ? 'hidden' : '']}>
				<span class={emptyIconClass}>
					<svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="m9.5 12.5 5 5"/><path d="m14.5 12.5-5 5"/></svg>
				</span>
				<h1 class="text-xl font-bold tracking-tight text-foreground">{missingTitle}</h1>
				<p class="max-w-sm text-sm text-muted-foreground">{missingDesc}</p>
				<a href={menuHref} class="btn-cta mt-2">{backToMenuLabel}</a>
			</div>

			{/* Receipt capability lives only in this device's sessionStorage */}
			<div id="success-device" class:list={[emptyClass, 'hidden']}>
				<span class={emptyIconClass}>
					<svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="20" x="5" y="2" rx="2"/><path d="M12 18h.01"/></svg>
				</span>
				<h1 class="text-xl font-bold tracking-tight text-foreground">{deviceTitle}</h1>
				<p class="max-w-sm text-sm text-muted-foreground">{deviceDesc}</p>
				<a href={menuHref} class="btn-cta mt-2">{backToMenuLabel}</a>
			</div>

			{/* The emailed link is expired, forged or erased: one uniform answer. */}
			<div id="success-link-invalid" class:list={[emptyClass, 'hidden']} role="alert">
				<span class={emptyIconClass}>
					<svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
				</span>
				<h1 class="text-xl font-bold tracking-tight text-foreground">{linkInvalidTitle}</h1>
				<p class="max-w-sm text-sm text-muted-foreground">{linkInvalidDesc}</p>
				<ul id="link-invalid-contacts" class="w-full max-w-sm space-y-2 empty:hidden"></ul>
				<a href={menuHref} class="btn-cta mt-2">{backToMenuLabel}</a>
			</div>

			{/* Receipt fetch failed (network/region) */}
			<div id="success-error" class:list={[emptyClass, 'hidden']}>
				<span class="flex size-12 items-center justify-center rounded-xl bg-destructive/10 text-destructive">
					<svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
				</span>
				<h1 class="text-xl font-bold tracking-tight text-foreground">{loadErrorTitle}</h1>
				<p class="max-w-sm text-sm text-muted-foreground">{loadErrorDesc}</p>
				<button type="button" id="success-retry" class="btn-cta mt-2">{retryLabel}</button>
			</div>

			{/* Receipt view */}
			<div id="order-view" class="hidden space-y-4 sm:space-y-5">
				<section class="surface px-5 py-8 text-center sm:p-10">
					{/* Celebration / attention mark. The script swaps the success and
					    destructive tints together with the two icons. */}
					<div id="success-icon" class="mx-auto flex size-16 items-center justify-center rounded-full border border-success/25 bg-success/10 text-success">
						<svg id="icon-confirmed" xmlns="http://www.w3.org/2000/svg" class="size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
						<svg id="icon-pending" xmlns="http://www.w3.org/2000/svg" class="hidden size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.25"/><path d="M12 7v5l3 2"/></svg>
						<svg id="icon-attention" xmlns="http://www.w3.org/2000/svg" class="hidden size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 8v5M12 16.5v.5"/><circle cx="12" cy="12" r="9.25"/></svg>
					</div>

					<span id="success-badge-text" class="badge tone-success mt-5">{successTitle}</span>
					<h1 id="success-heading" tabindex="-1" class="mt-3 text-2xl outline-none font-bold tracking-tight text-balance text-foreground sm:text-3xl">
						{thankYouTitle}
					</h1>
					<p id="success-subtext" class="mx-auto mt-2 max-w-md text-sm leading-relaxed text-muted-foreground sm:text-base">
						{thankYouDesc}
					</p>

					<div class="mt-6 inline-flex flex-col items-center gap-1 rounded-lg bg-muted px-5 py-3">
						<span class="text-xs text-muted-foreground">{orderNumLabel}</span>
						<span id="order-num" class="price font-heading text-xl text-foreground" dir="ltr">#—</span>
					</div>

					{/* Status timeline: visual only, filled from the receipt's status. */}
					<ol id="order-timeline" class="mx-auto mt-6 hidden max-w-sm items-center gap-2 [&:not(.hidden)]:flex" aria-describedby="order-status-badge">
						{timelineSteps.map((step, index) => (
							<>
								{index > 0 ? <li class="h-px flex-1 bg-border" aria-hidden="true" data-step-line /> : null}
								<li class="group flex items-center gap-1.5 text-xs text-muted-foreground data-reached:font-semibold data-reached:text-foreground" data-step={step.key}>
									<span class="size-2 shrink-0 rounded-full border border-muted-foreground/50 group-data-reached:border-success group-data-reached:bg-success" aria-hidden="true"></span>
									{step.label}
								</li>
							</>
						))}
					</ol>
					<span id="order-status-badge" class="badge tone-neutral mt-4"></span>
					{/* Live: filled and cleared by the status poll. */}
					<p id="order-promised" class="mt-4 hidden text-base font-semibold text-balance text-foreground [&:not(.hidden)]:block" role="status" dir="auto"></p>
					<p id="order-refund-note" class="mt-3 hidden text-sm font-medium text-foreground [&:not(.hidden)]:block" dir="auto"></p>
				</section>

				{/* Cancel while the restaurant allows it (#111). The region decides;
				    this block only shows what the order read says and counts down. */}
				<section id="order-cancel" class="surface hidden space-y-3 p-5 text-center sm:p-6 [&:not(.hidden)]:block" aria-label={successLabels.cancelButton}>
					<p id="cancel-countdown" class="text-sm text-muted-foreground" dir="auto"></p>
					<button type="button" id="cancel-order-btn" class="btn-secondary w-full sm:w-auto [&.hidden]:hidden">{successLabels.cancelButton}</button>
					<div id="cancel-confirm" class="hidden space-y-3 rounded-lg border border-border bg-muted p-4 text-start [&:not(.hidden)]:block" role="group" aria-labelledby="cancel-confirm-title">
						<h2 id="cancel-confirm-title" class="text-base font-semibold text-foreground">{successLabels.cancelConfirmTitle}</h2>
						<p id="cancel-confirm-refund" class="hidden text-sm text-foreground/80 [&:not(.hidden)]:block">{successLabels.cancelConfirmRefund}</p>
						<div class="flex flex-col gap-2 sm:flex-row sm:flex-wrap">
							<button type="button" id="cancel-confirm-yes" class="btn-cta w-full sm:w-auto">{successLabels.cancelConfirmYes}</button>
							<button type="button" id="cancel-confirm-keep" class="btn-secondary w-full sm:w-auto">{successLabels.cancelKeep}</button>
						</div>
					</div>
				</section>
				<p id="cancel-note" role="status" class="text-center text-sm font-medium text-foreground empty:hidden" dir="auto"></p>

				{/* Online payment states */}
				<div id="payment-pending" class:list={[noticeClass, 'tone-warning hidden']} role="status">
					<svg id="payment-pending-spinner" xmlns="http://www.w3.org/2000/svg" class="mt-0.5 size-5 shrink-0 animate-spin motion-reduce:animate-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-6.22-8.56"/></svg>
					<div class="min-w-0 flex-1 space-y-1">
						<p id="payment-pending-title" class="sr-only">{pendingTitle}</p>
						<p id="payment-pending-desc" class="text-foreground/80">{pendingDesc}</p>
						<button type="button" id="payment-check-again" class="btn-secondary mt-2 hidden [&.hidden]:hidden">{checkAgainLabel}</button>
					</div>
				</div>
				{/* Checkout hold: replaces the pending notice while the hold is live.
				    Turns from warning to danger in the final minute; at zero the
				    script swaps in the released state without a reload. Speech is
				    throttled through #payment-hold-live, not this timer. */}
				<section
					id="payment-hold"
					class="tone-warning hidden rounded-lg border p-4 text-sm transition-colors duration-300 ease-out motion-reduce:transition-none sm:p-5"
					aria-labelledby="payment-hold-title"
				>
					<div class="flex items-start gap-3">
						<svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 22h14"/><path d="M5 2h14"/><path d="M17 22v-4.172a2 2 0 0 0-.586-1.414L12 12l-4.414 4.414A2 2 0 0 0 7 17.828V22"/><path d="M7 2v4.172a2 2 0 0 0 .586 1.414L12 12l4.414-4.414A2 2 0 0 0 17 6.172V2"/></svg>
						<div class="min-w-0 flex-1">
							{/* The sentence is ink; the clock keeps the tone color so it reads
							    first and turns with the banner in the final minute. */}
							<p id="payment-hold-title" class="text-base leading-snug font-semibold text-balance sm:text-lg">
								<span class="text-foreground">{holdTitleBefore}</span><span id="payment-hold-timer" role="timer" dir="ltr" class="price bidi-isolate text-lg sm:text-xl">--:--</span><span class="text-foreground">{holdTitleAfter}</span>
							</p>
							<p class="mt-1 text-foreground/80">{holdDesc}</p>
							<div class="mt-4 flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:items-center sm:gap-3">
								<button type="button" id="hold-pay-btn" class="btn-cta w-full sm:w-auto">{completePaymentLabel}</button>
								<button type="button" id="hold-check-again" class="btn-secondary hidden w-full sm:w-auto [&.hidden]:hidden">{checkAgainLabel}</button>
							</div>
							<p id="hold-pay-error" class="hidden pt-2 font-semibold" role="alert"></p>
						</div>
					</div>
				</section>
				<div id="payment-failed" class:list={[noticeClass, 'tone-danger hidden']} role="alert">
					<svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="5" rx="2"/><path d="M2 10h20"/></svg>
					<div class="min-w-0 flex-1 space-y-1">
						<p class="font-semibold">{paymentFailedTitle}</p>
						<p class="sr-only">{paymentFailedDesc}</p>
						<button type="button" id="retry-payment-btn" class="btn-cta mt-2 [&.hidden]:hidden">{tryPaymentAgainLabel}</button>
						<p id="retry-payment-error" class="hidden pt-1 font-semibold"></p>
					</div>
				</div>
				<div id="payment-expired" class:list={[noticeClass, 'tone-warning hidden']} role="alert">
					<svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
					<div class="min-w-0 flex-1 space-y-1">
						<p class="font-semibold">{paymentExpiredTitle}</p>
						<p class="sr-only">{paymentExpiredDesc}</p>
						<a id="payment-expired-link" href={menuHref} class="btn-cta mt-2">{backToMenuLabel}</a>
					</div>
				</div>

				{/* Order details */}
				<section id="order-summary-card" class="surface p-5 sm:p-6">
					<dl class="grid gap-4 sm:grid-cols-2">
						<div class="flex gap-3">
							<span class={factIconClass} aria-hidden="true">
								<svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
							</span>
							<div class="min-w-0">
								<dt id="order-est-time-label" class="text-xs text-muted-foreground">{estTimeLabel}</dt>
								<dd id="order-est-time" dir="auto" class="bidi-isolate text-start mt-0.5 text-sm font-semibold text-foreground"></dd>
							</div>
						</div>
						<div class="flex gap-3">
							<span class={factIconClass} aria-hidden="true">
								<svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
							</span>
							<div class="min-w-0">
								<dt id="order-mode-text" class="text-xs text-muted-foreground">{pickupOrderText}</dt>
								<dd id="order-recipient-text" class="mt-0.5 text-sm font-semibold break-words text-foreground"></dd>
							</div>
						</div>

						{/* Pickup details (pre-orders): location, address, slot, calendar */}
						<div id="drop-pickup-details" class="hidden gap-3 sm:col-span-2 [&:not(.hidden)]:flex">
							<span class={factIconClass} aria-hidden="true">
								<svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
							</span>
							<div class="min-w-0 flex-1">
								<dt id="drop-pickup-when-label" class="text-xs text-muted-foreground">{pickupTimeLabel}</dt>
								<dd class="mt-0.5 space-y-0.5 text-sm">
									<p id="drop-pickup-when" dir="auto" class="bidi-isolate text-start font-semibold text-foreground"></p>
									<p id="drop-pickup-location" class="text-foreground"></p>
									<p id="drop-pickup-address" class="text-muted-foreground"></p>
									<p id="drop-pickup-title" class="text-muted-foreground"></p>
								</dd>
								<a
									id="drop-pickup-calendar"
									download="pickup.ics"
									class="btn-secondary mt-3 hidden [&.hidden]:hidden"
								>
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M12 14v6M9 17h6"/></svg>
									{addToCalendarLabel}
								</a>
							</div>
						</div>

						{/* The pickup instructions the guest saw at checkout (#251), kept with
						    the order. Plain text set with textContent; line breaks by CSS. */}
						<div id="order-pickup-instructions" class="hidden gap-3 sm:col-span-2 [&:not(.hidden)]:flex">
							<span class={factIconClass} aria-hidden="true">
								<svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
							</span>
							<div class="min-w-0 flex-1">
								<dt class="text-xs text-muted-foreground">{pickupInstructionsText}</dt>
								<dd id="order-pickup-instructions-text" dir="auto" class="mt-0.5 whitespace-pre-line text-sm text-pretty text-foreground [text-align:match-parent]"></dd>
							</div>
						</div>

						{/* What the guest chose about utensils (#257); only when it was asked. */}
						<div id="order-utensils" class="hidden gap-3 sm:col-span-2 [&:not(.hidden)]:flex">
							<span class={factIconClass} aria-hidden="true">
								<svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg>
							</span>
							<div class="min-w-0 flex-1 self-center">
								<dt class="sr-only">{utensilsTitleText}</dt>
								<dd id="order-utensils-text" class="text-sm font-semibold text-foreground"></dd>
							</div>
						</div>
					</dl>

					{/* Receipt breakdown (authoritative, from the regional order) */}
					<div class="mt-6 border-t border-border pt-5">
						<h2 class="text-lg font-semibold text-foreground">{receiptTitle}</h2>
						<ul id="order-items-list" class="mt-1 divide-y divide-border">
							<!-- Injected via client script -->
						</ul>
						<dl class="mt-1 space-y-2 border-t border-border pt-4">
							<div class={rowClass}>
								<dt>{subtotalText}</dt>
								<dd id="order-subtotal" class={valueClass}>{price(0)}</dd>
							</div>
							<div id="order-discount-lines" class="contents hidden"></div>
							<div id="order-discount-row" class:list={[rowClass, 'hidden']}>
								<dt>{rewardDiscountText}</dt>
								<dd id="order-discount" class={valueClass}></dd>
							</div>
							<div class={rowClass}>
								<dt
									id="order-tax-label"
									data-exclusive-label={taxText}
									data-inclusive-label={includesTaxText}
								>
									{taxText}
								</dt>
								<dd id="order-tax" class={valueClass}>{price(0)}</dd>
							</div>
							<div id="order-deliv-row" class:list={[rowClass, 'hidden']}>
								<dt>{deliveryFeeText}</dt>
								<dd id="order-delivery-fee" class={valueClass}>{price(0)}</dd>
							</div>
							<div id="order-fee-row" class:list={[rowClass, 'hidden']}>
								<dt id="order-fee-label" class="min-w-0">{serviceFeeText}</dt>
								<dd id="order-fee" class={valueClass}></dd>
							</div>
							{/* The packaging or bag fee (#408), under the name the guest saw. */}
							<div id="order-packaging-row" class:list={[rowClass, 'hidden']}>
								<dt id="order-packaging-label" dir="auto" class="min-w-0">{packagingFeeText}</dt>
								<dd id="order-packaging" class={valueClass}></dd>
							</div>
							<div class={rowClass}>
								<dt>{tipText}</dt>
								<dd id="order-tip" class={valueClass}>{price(0)}</dd>
							</div>
							<div class="mt-3 flex items-baseline justify-between gap-4 border-t border-border pt-3 text-base font-semibold text-foreground">
								<dt id="order-total-label">{totalPaidText}</dt>
								<dd id="order-total" class="price font-heading text-xl">{price(0)}</dd>
							</div>
							<div id="order-vat-row" class:list={[rowClass, 'hidden']}>
								<dt>{vatNumberText}</dt>
								<dd id="order-vat-number" class="bidi-isolate font-medium text-foreground"></dd>
							</div>
						</dl>
						<p id="order-free-note" class="mt-2 hidden text-sm text-muted-foreground"></p>
					</div>
				</section>

				{/* Set by checkout when an email opt-in is waiting for its link. */}
				{/* Empty live region: the text is inserted when it should show, so screen readers announce it. */}
				<p
					id="marketing-email-note"
					role="status"
					data-text={i18n._(msg`We sent a link to confirm your email`)}
					class="text-center text-sm text-muted-foreground empty:hidden"
				></p>

				<DropAlertsSignup source="order_success" title={dropAlertsTitle} />

				{/* Help: the restaurant's phone (public location data) and a re-send
				    of the receipt email. Shown only when they can work. */}
				<div class="flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
					<a id="order-call" href="tel:" class="btn-secondary hidden w-full sm:w-auto [&.hidden]:hidden">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
						<span>{callRestaurantLabel}</span>
						<span id="order-call-number" dir="ltr" class="bidi-isolate font-normal text-muted-foreground"></span>
					</a>
					<button type="button" id="resend-receipt" class="btn-secondary w-full sm:w-auto">{resendLabel}</button>
				</div>
				<p id="resend-status" role="status" class="text-center text-sm text-muted-foreground empty:hidden"></p>

				<div class="flex flex-col items-center gap-3 pt-2 sm:flex-row sm:justify-center">
					<a href={menuHref} class="btn-secondary w-full sm:w-auto">
						{backToMenuLabel}
					</a>
					<a href={homeHref} class="focus-ring inline-flex min-h-11 items-center rounded-md px-3 text-sm font-semibold text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">
						{returnHomeLabel}
					</a>
				</div>
			</div>
			{/* Throttled hold announcements (minute marks), kept outside hidden
			    containers so the live region is registered before it speaks. */}
			<p id="payment-hold-live" class="sr-only" aria-live="polite" aria-atomic="true"></p>
			{/* Status changes (accepted, turned down, cancelled). */}
			<p id="order-live" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
			{/* Minute marks of the cancel countdown (the visible text ticks every second and is not live). */}
			<p id="cancel-live" class="sr-only" aria-live="polite" aria-atomic="true"></p>
		</div>
	</div>

	<script
		id="success-labels"
		type="application/json"
		is:inline
		set:html={JSON.stringify(successLabels).replace(/</g, '\\u003c')}
	/>

	<script>
		import { buildIcsDataUrl } from '~/lib/ordering/calendar'
		import { takeEmailConfirmationPending } from '~/lib/marketing-consent-client'
		import { getLocalizedMenuValue } from '@repo/common/menu-types'
		import { createMoneyFormatter, fillTemplate } from '~/lib/ordering/money'
		import { DEFAULT_SERVICE_FEE_LABEL } from '@repo/common/service-fee'
		import {
			OrderRequestError,
			cancelOrder,
			fetchOrderWithCredential,
			randomAttemptKey,
			loadOrderCapability,
			resendOrderLink,
			startOrderPayment,
		} from '~/lib/ordering/order-client'
		import {
			chooseOrderCredential,
			claimOrderLink,
			type OrderCredential,
		} from '~/lib/ordering/order-link'
		import { createStatusPoller, isTerminalStatus, type StatusPoller } from '~/lib/ordering/status-poll'
		import { formatPromisedTime } from '~/lib/ordering/promised-time'
		import {
			interpretPaymentStatus,
			shouldContinuePolling,
			PAYMENT_POLL_INTERVAL_MS,
		} from '~/lib/ordering/payment-poll'
		import { startCountdown } from '~/lib/ordering/countdown'
		import {
			cancelHiddenKey,
			cancelRefusalKey,
			cancelWindowEnd,
			clockOffsetMs,
			createCancelAttempt,
			formatCancelRemaining,
			nextCancelAnnouncement,
			orderStage,
			paidOnline,
			refundView,
			visibleCancelReason,
			type OrderStage,
		} from '~/lib/ordering/guest-cancel'
		import {
			formatHoldClock,
			formatMinutesLong,
			holdAnnouncement,
			isFinalMinute,
			liveHoldRemainingMs,
			minutesLeft,
		} from '~/lib/ordering/hold-timer'
		import { receiptDiscounts } from '~/lib/ordering/discount-view'
		import { formatPickupAddress, formatSlot } from '~/lib/ordering/pickup'
		import {
			receiptLineNote,
			receiptPackagingLine,
			receiptPickupInstructions,
			receiptRecipientText,
			receiptTaxIncluded,
			receiptUtensilsText,
		} from '~/lib/ordering/order-view'
		import { zonedTimeToUtc } from '~/lib/drops/format'
		import { getOrgBinding } from '~/lib/client-auth'

		type ReceiptLine = {
			itemId: string
			itemName: string
			variantId: string | null
			quantity: number
			unitPriceCents: number
			totalCents: number
			instructions: string | null
			/** The size or other variant chosen ("Large"). */
			variantNames?: string[]
			options: Array<{
				groupId: string
				groupName: string
				optionId: string
				optionName: string
				half: 'whole' | 'left' | 'right' | null
				quantity: number
				priceCents: number
				totalCents: number
			}>
		}

		type ReceiptOrder = {
			id: string
			number: string
			status: string
			paymentStatus: string
			/** `online` or `handoff`, when the region sends it. */
			paymentMethod?: string
			/** A cancel refunds a card payment (the region's own answer), when it sends it. */
			refundsOnCancel?: boolean
			/** The region's clock when it answered (ISO text or epoch ms), to judge `cancel.until`. */
			serverNow?: string | number | null
			currency: string
			subtotalCents: number
			/** A loyalty reward's saving. */
			loyaltyDiscountCents: number
			/** Coupons and automatic discounts on the items. */
			discountCents?: number
			/** Delivery fee taken off by a discount. */
			deliveryDiscountCents?: number
			discounts?: Array<{
				discountId?: string
				name?: string
				code?: string | null
				amountMinor?: number
				deliveryAmountMinor?: number
			}>
			taxCents: number
			deliveryFeeCents: number
			tipCents: number
			/** The guest service fee before its tax, and the name the guest saw. Absent on older nodes. */
			serviceFeeCents?: number
			serviceFeeLabel?: string | null
			/** The packaging or bag fee before its tax, and the name the guest saw. Absent on older nodes. */
			packagingFeeCents?: number
			packagingFeeLabel?: string | null
			/** The utensils answer; null when it was not asked, absent on older nodes. */
			utensilsRequested?: boolean | null
			/** The pickup text the guest saw at checkout; plain text. */
			pickupInstructions?: string | null
			totalCents: number
			holdExpiresAt: string | null
			tipPercent: number | null
			/** Amount recorded as returned; absent on older nodes. */
			refundedCents?: number
			/** Acceptance and self-cancel (`publicOrderLifecycleSchema`). */
			acceptanceDeadlineAt?: string | null
			rejected?: boolean
			cancelledBy?: string | null
			cancelReason?: string | null
			refundStatus?: string
			refundPendingCents?: number
			cancel?: { allowed: boolean; until: string | null }
			/** When the order should be ready / start arriving. */
			promisedAt?: string | null
			/** End of an ASAP delivery range. */
			promisedUntil?: string | null
			fulfillment: string
			locale: string
			createdAt: string | null
			location: { id: string; name: string } | null
			pickup: {
				windowId: string
				date: string
				time: string
				timezone: string
			} | null
			drop: { slug: string } | null
			lines: ReceiptLine[]
			/** Absent on a read authorised by the emailed link. */
			contact?: { name: string; phone: string; email: string | null }
			/** Link reads carry only `feeCents` and `zoneId`. */
			delivery: {
				address?: string
				city?: string | null
				unit?: string | null
				notes?: string | null
				feeCents: number
				zoneId: string | null
			} | null
		}

		const labelsEl = document.getElementById('success-labels')
		const labels = labelsEl ? JSON.parse(labelsEl.textContent || '{}') : {}
		const orgId: string = labels.organizationId || 'default'
		const orderId = new URLSearchParams(window.location.search).get('order')
		const defaultLocale =
			document.documentElement.dataset.defaultLocale || 'en'
		// The emailed link carries its token in the fragment only, so Sites SSR
		// never sees it; it goes to the regional tenant-api from this browser.
		// The head script already cleared the fragment; the token now lives in
		// this tab's sessionStorage (memory if that throws). The emailed link
		// still brings the guest back later.
		const orderLink = claimOrderLink({
			orgId,
			orderId,
			location: window.location,
			history: window.history,
			storage: () => window.sessionStorage,
		})
		const hasPaymentToken = Boolean(
			orderId && loadOrderCapability(orgId, orderId)?.paymentToken,
		)

		function currentCredential(): OrderCredential | null {
			return chooseOrderCredential({
				link: orderLink,
				receiptToken: orderId
					? (loadOrderCapability(orgId, orderId)?.receiptToken ?? null)
					: null,
			})
		}

		// Catalog names arrive as locale maps ({"en":…,"ar":…}); pick the page locale.
		const localize = (value: string | null | undefined): string =>
			getLocalizedMenuValue(value, labels.locale || 'en', defaultLocale)

		function show(id: string) {
			document.getElementById(id)?.classList.remove('hidden')
		}
		function hide(id: string) {
			document.getElementById(id)?.classList.add('hidden')
		}

		// Build nodes with textContent so operator/guest text is never parsed as HTML.
		function createEl(tag: string, className?: string, text?: string) {
			const node = document.createElement(tag)
			if (className) node.className = className
			if (text !== undefined) node.textContent = text
			return node
		}

		type HeadingTone = 'success' | 'warning' | 'danger'

		function setHeading(badge: string, title: string, subtext: string, tone: HeadingTone = 'success') {
			const attention = tone === 'danger'
			const pending = tone === 'warning'
			const badgeEl = document.getElementById('success-badge-text')
			const titleEl = document.getElementById('success-heading')
			const subtextEl = document.getElementById('success-subtext')
			if (badgeEl) {
				badgeEl.textContent = badge
				badgeEl.classList.toggle('tone-success', tone === 'success')
				badgeEl.classList.toggle('tone-warning', pending)
				badgeEl.classList.toggle('tone-danger', attention)
			}
			if (titleEl) titleEl.textContent = title
			if (subtextEl) subtextEl.textContent = subtext
			document.getElementById('icon-confirmed')?.classList.toggle('hidden', tone !== 'success')
			document.getElementById('icon-pending')?.classList.toggle('hidden', !pending)
			document.getElementById('icon-attention')?.classList.toggle('hidden', !attention)
			const iconWrap = document.getElementById('success-icon')
			iconWrap?.classList.toggle('bg-success/10', tone === 'success')
			iconWrap?.classList.toggle('text-success', tone === 'success')
			iconWrap?.classList.toggle('border-success/25', tone === 'success')
			iconWrap?.classList.toggle('bg-warning/15', pending)
			iconWrap?.classList.toggle('text-warning', pending)
			iconWrap?.classList.toggle('border-warning/30', pending)
			iconWrap?.classList.toggle('bg-destructive/10', attention)
			iconWrap?.classList.toggle('text-destructive', attention)
			iconWrap?.classList.toggle('border-destructive/30', attention)
		}

		let latestOrder: ReceiptOrder | null = null

		function renderReceipt(order: ReceiptOrder) {
			const money = createMoneyFormatter(order.currency || labels.currency || 'USD', labels.locale)
			const formatCents = (cents: number) => money((Number.isFinite(cents) ? cents : 0) / 100)

			const orderNumEl = document.getElementById('order-num')
			const estTimeEl = document.getElementById('order-est-time')
			const estLabelEl = document.getElementById('order-est-time-label')
			const modeTextEl = document.getElementById('order-mode-text')
			const recipientTextEl = document.getElementById('order-recipient-text')
			const itemsListEl = document.getElementById('order-items-list')
			const subtotalEl = document.getElementById('order-subtotal')
			const taxEl = document.getElementById('order-tax')
			const delivRow = document.getElementById('order-deliv-row')
			const delivFeeEl = document.getElementById('order-delivery-fee')
			const tipEl = document.getElementById('order-tip')
			const totalEl = document.getElementById('order-total')
			const totalLabelEl = document.getElementById('order-total-label')
			const statusEl = document.getElementById('order-status-badge')

			if (orderNumEl) orderNumEl.textContent = `#${order.number}`
			// Visual progress: received → preparing → ready. Statuses outside
			// that path (cancelled, expired) hide the timeline and keep the badge.
			const stepIndex = (
				{ pending: 0, accepted: 0, preparing: 1, ready: 2, completed: 2 } as Record<string, number>
			)[order.status]
			const timeline = document.getElementById('order-timeline')
			if (timeline) {
				timeline.classList.toggle('hidden', stepIndex === undefined)
				timeline.querySelectorAll<HTMLElement>('[data-step]').forEach((node, index) => {
					const reached = stepIndex !== undefined && index <= stepIndex
					node.toggleAttribute('data-reached', reached)
					if (index === stepIndex) node.setAttribute('aria-current', 'step')
					else node.removeAttribute('aria-current')
				})
			}
			if (statusEl) {
				statusEl.textContent =
					(labels.statuses as Record<string, string>)[order.status] ??
					(labels.statuses as Record<string, string>).pending
				statusEl.classList.toggle('sr-only', stepIndex !== undefined)
			}
			if (totalLabelEl) {
				totalLabelEl.textContent =
					order.paymentStatus === 'paid' ? labels.totalPaid : labels.total
			}

			const isDelivery = order.fulfillment === 'delivery'
			if (modeTextEl) {
				modeTextEl.textContent = isDelivery
					? labels.deliveryOrder || 'Delivery order'
					: labels.pickupOrder || 'Pickup order'
			}
			if (recipientTextEl) {
				// The link view has no contact or address: show only the mode label.
				const text = receiptRecipientText(
					order,
					labels.deliverTo || 'Deliver to: {address}',
				)
				recipientTextEl.textContent = text
				recipientTextEl.classList.toggle('hidden', !text)
			}

			// Pickup orders (all drop orders): show the slot, not an estimate.
			const pickup = order.pickup
			if (pickup) {
				const timezone = pickup.timezone || 'UTC'
				const when = formatSlot(pickup.date, pickup.time, labels.locale || 'en', timezone)
				show('drop-pickup-details')
				const whenEl = document.getElementById('drop-pickup-when')
				const locationEl = document.getElementById('drop-pickup-location')
				const addressEl = document.getElementById('drop-pickup-address')
				const titleEl = document.getElementById('drop-pickup-title')
				const locationMeta = (labels.locations as Array<{ id: string; name: string; address: unknown }>).find(
					(l) => l.id === order.location?.id,
				)
				if (whenEl) whenEl.textContent = when
				if (locationEl) locationEl.textContent = locationMeta?.name || localize(order.location?.name) || ''
				if (addressEl) addressEl.textContent = formatPickupAddress(locationMeta?.address)
				const dropTitle =
					(order.drop?.slug
						? (labels.dropTitles as Record<string, string>)[order.drop.slug]
						: null) ?? order.drop?.slug ?? ''
				if (titleEl) titleEl.textContent = dropTitle
				if (estLabelEl) estLabelEl.textContent = labels.pickupTime || 'Pickup time'
				if (estTimeEl) estTimeEl.textContent = when

				const calendarEl = document.getElementById(
					'drop-pickup-calendar',
				) as HTMLAnchorElement | null
				const start = zonedTimeToUtc(pickup.date, pickup.time, timezone)
				if (calendarEl && start) {
					// The receipt carries the slot start; calendar entries span a
					// sensible half hour when the window interval is unknown.
					const end = new Date(start.getTime() + 30 * 60_000)
					const dropSlug = order.drop?.slug ?? null
					calendarEl.href = buildIcsDataUrl({
						title: fillTemplate(labels.pickupCalendarTitle || 'Pickup: {title}', {
							title:
								(dropSlug
									? (labels.dropTitles as Record<string, string>)[dropSlug]
									: null) ??
								dropSlug ??
								order.number,
						}),
						start,
						end,
						location: [locationMeta?.name || localize(order.location?.name), formatPickupAddress(locationMeta?.address)]
							.filter(Boolean)
							.join(', '),
						description: `#${order.number}`,
						url: dropSlug
							? new URL(
									`${labels.dropBaseHref || '/drop'}/${encodeURIComponent(dropSlug)}`,
									window.location.origin,
								).toString()
							: null,
					})
					calendarEl.classList.remove('hidden')
				}
			} else {
				// Handoff menu orders keep a plain-language prep estimate.
				if (estLabelEl) estLabelEl.textContent = labels.estTime || 'Estimated Time'
				if (estTimeEl && orderStage(order) === 'waiting') {
					estTimeEl.textContent = labels.waitingEst
				} else if (estTimeEl) {
					estTimeEl.textContent = isDelivery
						? labels.estDelivery || '~35-45 minutes'
						: labels.estPickup || '~15-25 minutes'
				}
			}

			if (itemsListEl) {
				const rows = (order.lines ?? []).map((line) => {
					const row = createEl('li', 'flex gap-3 py-3')
					row.appendChild(
						createEl(
							'span',
							'price flex h-6 min-w-6 shrink-0 items-center justify-center rounded-md bg-muted px-1.5 text-xs text-foreground',
							String(line.quantity),
						),
					)
					const info = createEl('div', 'min-w-0 flex-1')
					info.appendChild(
						createEl('p', 'text-sm font-semibold leading-snug text-foreground', localize(line.itemName)),
					)
					const choices = [
						...(line.variantNames ?? []).map((name) => localize(name)),
						...(line.options ?? []).map((o) => {
							const name = localize(o.optionName)
							return o.quantity > 1 ? `${o.quantity}x ${name}` : name
						}),
					]
					if (choices.length > 0) {
						info.appendChild(
							createEl(
								'p',
								'mt-0.5 text-xs leading-relaxed text-muted-foreground',
								choices.join(', '),
							),
						)
					}
					const lineNote = receiptLineNote(line.instructions)
					if (lineNote) {
						info.appendChild(
							createEl('p', 'mt-0.5 text-xs italic leading-relaxed text-muted-foreground', `“${lineNote}”`),
						)
					}
					row.appendChild(info)
					row.appendChild(
						createEl('span', 'price shrink-0 text-sm text-foreground', formatCents(line.totalCents)),
					)
					return row
				})
				itemsListEl.replaceChildren(...rows)
			}

			if (subtotalEl) subtotalEl.textContent = formatCents(order.subtotalCents)
			const savings = receiptDiscounts(order, {
				discount: labels.discount || 'Discount',
				deliveryDiscount: labels.deliveryDiscount || '{name} (delivery)',
				deliveryDiscountPlain: labels.deliveryDiscountPlain || 'Delivery discount',
			}, { locale: labels.locale || 'en', defaultLocale })
			const discountLinesEl = document.getElementById('order-discount-lines')
			if (discountLinesEl) {
				const rowClassName =
					'flex items-baseline justify-between gap-4 text-sm text-muted-foreground'
				const valueClassName = 'price font-medium text-foreground'
				discountLinesEl.replaceChildren(
					...savings.lines.map((line) => {
						const row = createEl('div', rowClassName)
						// The code is isolated so it keeps its order inside right-to-left text.
						const label = line.code ? `${line.label} (\u2066${line.code}\u2069)` : line.label
						row.appendChild(createEl('dt', undefined, label))
						row.appendChild(
							createEl('dd', valueClassName, formatCents(-line.amountMinor)),
						)
						return row
					}),
				)
				discountLinesEl.classList.toggle('hidden', savings.lines.length === 0)
			}
			const loyaltyCents = Math.max(0, order.loyaltyDiscountCents)
			const discountRow = document.getElementById('order-discount-row')
			const discountEl = document.getElementById('order-discount')
			discountRow?.classList.toggle('hidden', loyaltyCents === 0)
			if (discountEl) discountEl.textContent = loyaltyCents > 0 ? formatCents(-loyaltyCents) : ''
			const freeNote = document.getElementById('order-free-note')
			if (freeNote) {
				freeNote.textContent = labels.freeOrder || 'No payment needed'
				freeNote.classList.toggle('hidden', !savings.free)
			}
			if (taxEl) taxEl.textContent = formatCents(order.taxCents)
			// Tax-inclusive (VAT) prices: the tax is contained in the subtotal and
			// the total does not add it, which the receipt's own amounts show.
			const netDelivery = Math.max(
				0,
				order.deliveryFeeCents - savings.deliveryCents,
			)
			const taxIncluded = receiptTaxIncluded({
				taxCents: order.taxCents,
				totalCents: order.totalCents,
				subtotalCents: order.subtotalCents,
				itemSavingCents: savings.itemsCents,
				loyaltyCents,
				deliveryNetCents: netDelivery,
				tipCents: order.tipCents,
				serviceFeeCents: order.serviceFeeCents,
				packagingFeeCents: order.packagingFeeCents,
			})
			const taxLabelEl = document.getElementById('order-tax-label')
			const taxLabelText = taxIncluded
				? taxLabelEl?.dataset.inclusiveLabel
				: taxLabelEl?.dataset.exclusiveLabel
			if (taxLabelEl && taxLabelText) taxLabelEl.textContent = taxLabelText
			const vatNumber =
				(labels.locations as Array<{ id: string; vatNumber?: string | null }>).find(
					(l) => l.id === order.location?.id,
				)?.vatNumber ?? null
			const vatRow = document.getElementById('order-vat-row')
			const vatNumberEl = document.getElementById('order-vat-number')
			if (vatNumberEl) vatNumberEl.textContent = vatNumber ?? ''
			if (vatRow) vatRow.classList.toggle('hidden', !vatNumber)
			if (delivRow && delivFeeEl) {
				if (isDelivery) {
					delivRow.classList.remove('hidden')
					delivFeeEl.textContent = formatCents(order.deliveryFeeCents)
				} else {
					delivRow.classList.add('hidden')
				}
			}
			if (tipEl) tipEl.textContent = formatCents(order.tipCents)
			// The service fee as its own line, under the name the guest saw.
			const feeRow = document.getElementById('order-fee-row')
			const feeLabelEl = document.getElementById('order-fee-label')
			const feeEl = document.getElementById('order-fee')
			const feeCents = order.serviceFeeCents ?? 0
			feeRow?.classList.toggle('hidden', feeCents <= 0)
			if (feeCents > 0) {
				if (feeLabelEl) {
					feeLabelEl.textContent =
						order.serviceFeeLabel && order.serviceFeeLabel !== DEFAULT_SERVICE_FEE_LABEL
							? order.serviceFeeLabel
							: (labels.serviceFee as string)
				}
				if (feeEl) feeEl.textContent = formatCents(feeCents)
			}
			// The packaging fee as its own line, under the name the guest saw (#408).
			const packaging = receiptPackagingLine(order, labels.packagingFee as string)
			const packagingRow = document.getElementById('order-packaging-row')
			packagingRow?.classList.toggle('hidden', !packaging)
			if (packaging) {
				const packagingLabelEl = document.getElementById('order-packaging-label')
				const packagingEl = document.getElementById('order-packaging')
				if (packagingLabelEl) packagingLabelEl.textContent = packaging.label
				if (packagingEl) packagingEl.textContent = formatCents(packaging.cents)
			}
			// Where to go (#251) and the utensils answer (#257), as the guest saw them
			// at checkout. textContent only: line breaks come from CSS, never markup.
			const pickupText = receiptPickupInstructions(order)
			const pickupTextEl = document.getElementById('order-pickup-instructions-text')
			if (pickupTextEl) pickupTextEl.textContent = pickupText ?? ''
			document.getElementById('order-pickup-instructions')?.classList.toggle('hidden', !pickupText)
			const utensilsText = receiptUtensilsText(order, {
				yes: labels.utensilsYes as string,
				no: labels.utensilsNo as string,
			})
			const utensilsTextEl = document.getElementById('order-utensils-text')
			if (utensilsTextEl) utensilsTextEl.textContent = utensilsText ?? ''
			document.getElementById('order-utensils')?.classList.toggle('hidden', !utensilsText)
			if (totalEl) totalEl.textContent = formatCents(order.totalCents)

			latestOrder = order

			// Promised time: live orders only, in the location's time zone.
			const locationFacts = (labels.locations as Array<{ id: string; timezone?: string; phone?: string | null }>).find(
				(l) => l.id === order.location?.id,
			)
			const promised = orderStage(order) === 'waiting' ? null : formatPromisedTime(
				{
					promisedAt: order.promisedAt,
					promisedUntil: order.promisedUntil,
					fulfillment: order.fulfillment,
					status: order.status,
					paymentStatus: order.paymentStatus,
					timeZone: locationFacts?.timezone || 'UTC',
					locale: labels.locale || 'en',
				},
				labels,
			)
			const promisedEl = document.getElementById('order-promised')
			if (promisedEl) {
				promisedEl.textContent = promised ?? ''
				promisedEl.classList.toggle('hidden', !promised)
			}

			// A recorded refund, cancelled or not.
			const refund = refundView(order)
			const refundEl = document.getElementById('order-refund-note')
			if (refundEl) {
				const refundText =
					refund.kind === 'refunded'
						? fillTemplate(labels.refunded, { amount: formatCents(refund.amountCents) })
						: refund.kind === 'pending'
							? refund.amountCents > 0
								? fillTemplate(labels.refundPendingAmount, { amount: formatCents(refund.amountCents) })
								: labels.refundPending
							: refund.kind === 'failed'
								? labels.refundFailed
								: ''
				refundEl.textContent = refundText
				refundEl.classList.toggle('hidden', !refundText)
			}

			// "Call the restaurant": the location's public phone.
			const callEl = document.getElementById('order-call') as HTMLAnchorElement | null
			const phone = locationFacts?.phone ?? null
			if (callEl) {
				const dial = phone ? phone.replace(/[^\d+]/g, '') : ''
				if (dial) callEl.href = `tel:${dial}`
				const numberEl = document.getElementById('order-call-number')
				if (numberEl) numberEl.textContent = phone ?? ''
				callEl.classList.toggle('hidden', !dial)
			}
		}

		// ---------- checkout hold countdown ----------

		let stopHold: (() => void) | null = null

		function announceHold(text: string) {
			const live = document.getElementById('payment-hold-live')
			if (!live) return
			// Clear first so a repeated sentence is still spoken.
			live.textContent = ''
			window.setTimeout(() => {
				live.textContent = text
			}, 100)
		}

		function stopHoldCountdown() {
			stopHold?.()
			stopHold = null
			hide('payment-hold')
		}

		/** Starts the hold banner when the order is pending with a live hold. */
		function startHoldCountdown(order: ReceiptOrder): boolean {
			if (stopHold) return true
			const remaining = liveHoldRemainingMs(order, Date.now())
			if (remaining === null || !order.holdExpiresAt) return false
			const section = document.getElementById('payment-hold')
			const timerEl = document.getElementById('payment-hold-timer')
			const locale: string = labels.locale || 'en'
			hide('hold-check-again')
			section?.classList.remove('hidden')
			announceHold(
				`${fillTemplate(labels.holdTitle, {
					time: formatMinutesLong(minutesLeft(remaining), locale),
				})} ${labels.holdDesc}`,
			)
			let previous: number | null = null
			stopHold = startCountdown(
				Date.parse(order.holdExpiresAt),
				(ms) => {
					if (timerEl) timerEl.textContent = formatHoldClock(ms, locale)
					const urgent = isFinalMinute(ms)
					section?.classList.toggle('tone-warning', !urgent)
					section?.classList.toggle('tone-danger', urgent)
					const mark = holdAnnouncement(previous, ms)
					previous = ms
					if (mark !== null) {
						announceHold(
							fillTemplate(labels.holdAnnounce, {
								time: formatMinutesLong(mark, locale),
							}),
						)
					}
				},
				() => {
					// Released: switch states in place; the expired alert speaks.
					stopHold = null
					showExpired(order)
				},
			)
			return true
		}

		// ---------- guest cancel and acceptance (#111, #107) ----------

		const cancelAttempt = createCancelAttempt(randomAttemptKey)
		let stopCancelTimer: (() => void) | null = null
		/** The region refused a cancel: keep the button away until the page reloads. */
		let cancelRefused = false
		let lastStage: OrderStage | null = null
		/** Region clock minus this device clock (ms), from the order read. */
		let clockOffset = 0
		/** The last minute mark spoken (`cancelAnnounceKey`), null before the first. */
		let lastCancelKey: number | null = null

		function setCancelNote(text: string) {
			const note = document.getElementById('cancel-note')
			if (note) note.textContent = text
		}

		function cancelNoteFor(key: 'closed' | 'preparing' | 'unavailable'): string {
			return key === 'closed'
				? labels.cancelClosed
				: key === 'preparing'
					? labels.cancelPreparing
					: labels.cancelUnavailable
		}

		function announceCancel(text: string) {
			const live = document.getElementById('cancel-live')
			if (!live) return
			// Clear first so a repeated sentence is still spoken.
			live.textContent = ''
			window.setTimeout(() => {
				live.textContent = text
			}, 100)
		}

		function announceOrder(text: string) {
			const live = document.getElementById('order-live')
			if (!live) return
			live.textContent = ''
			window.setTimeout(() => {
				live.textContent = text
			}, 100)
		}

		function hideCancel() {
			stopCancelTimer?.()
			stopCancelTimer = null
			lastCancelKey = null
			hide('order-cancel')
			hide('cancel-confirm')
		}

		/** Shows the cancel button with its countdown while the window is open. */
		function renderCancel(order: ReceiptOrder) {
			if (order.serverNow != null) clockOffset = clockOffsetMs(order.serverNow, Date.now())
			const end = cancelRefused ? null : cancelWindowEnd(order, Date.now(), clockOffset)
			stopCancelTimer?.()
			stopCancelTimer = null
			if (end === null) {
				// Hiding the box under the guest's focus would drop it on <body>
				// and say nothing: move it to the heading and say why.
				const hadFocus = document.getElementById('order-cancel')?.contains(document.activeElement)
				hideCancel()
				if (hadFocus) {
					const key = cancelRefused ? null : cancelHiddenKey(order, Date.now(), clockOffset)
					if (key) setCancelNote(cancelNoteFor(key))
					document.getElementById('success-heading')?.focus()
				}
				return
			}
			document.getElementById('cancel-confirm-refund')?.classList.toggle('hidden', !paidOnline(order))
			const countdownEl = document.getElementById('cancel-countdown')
			show('order-cancel')
			stopCancelTimer = startCountdown(
				end,
				(ms) => {
					const text = fillTemplate(labels.cancelCountdown, {
						time: formatCancelRemaining(ms, labels.locale || 'en'),
					})
					if (countdownEl) countdownEl.textContent = text
					const next = nextCancelAnnouncement(lastCancelKey, ms)
					if (next.announce) {
						lastCancelKey = next.key
						announceCancel(text)
					}
				},
				() => {
					// Time is up: no request needed, the button just goes away.
					stopCancelTimer = null
					const hadFocus = document.getElementById('order-cancel')?.contains(document.activeElement)
					hideCancel()
					setCancelNote(labels.cancelClosed)
					if (hadFocus) document.getElementById('success-heading')?.focus()
				},
			)
		}

		function renderLifecycle(order: ReceiptOrder) {
			const stage = orderStage(order)
			if (lastStage !== null && lastStage !== stage) {
				if (stage === 'rejected') announceOrder(labels.rejectedTitle)
				else if (stage === 'cancelled') announceOrder(labels.cancelledTitle)
				else if (lastStage === 'waiting' && stage === 'normal') announceOrder(labels.acceptedAnnounce)
			}
			lastStage = stage
			renderCancel(order)
		}

		/** Whether the payment banner state is "paid / nothing to pay". */
		let confirmedView = false

		/**
		 * The headline follows the order's own status once payment is settled:
		 * cancelled says so plainly; ready and completed say so too.
		 */
		function applyStatusHeading() {
			const order = latestOrder
			if (!order) return
			renderLifecycle(order)
			if (orderStage(order) === 'rejected') {
				stopHoldCountdown()
				hide('payment-pending')
				hide('payment-failed')
				hide('payment-expired')
				const reason = visibleCancelReason(order)
				const reasonText =
					reason === 'out_of_stock'
						? labels.rejectedOutOfStock
						: reason === 'kitchen_closed'
							? labels.rejectedKitchenClosed
							: ''
				setHeading(labels.statuses.cancelled, labels.rejectedTitle, reasonText, 'danger')
				return
			}
			if (order.status === 'cancelled') {
				stopHoldCountdown()
				hide('payment-pending')
				hide('payment-failed')
				hide('payment-expired')
				setHeading(labels.statuses.cancelled, labels.cancelledTitle, '', 'danger')
				return
			}
			if (!confirmedView) return
			if (orderStage(order) === 'waiting') {
				setHeading(labels.statuses.pending_acceptance, labels.waitingTitle, labels.waitingDesc, 'warning')
				return
			}
			const desc =
				order.status === 'ready'
					? labels.readyDesc
					: order.status === 'completed'
						? labels.completedDesc
						: labels.confirmedDesc
			setHeading(labels.confirmedBadge, labels.confirmedTitle, desc)
		}

		function showConfirmed() {
			confirmedView = true
			stopHoldCountdown()
			hide('payment-pending')
			hide('payment-failed')
			hide('payment-expired')
			setHeading(labels.confirmedBadge, labels.confirmedTitle, labels.confirmedDesc)
			applyStatusHeading()
		}

		function showPending(order: ReceiptOrder) {
			confirmedView = false
			hide('payment-failed')
			hide('payment-expired')
			setHeading(labels.statuses.pending, labels.pendingTitle, labels.pendingDesc, 'warning')
			// A live hold gets the countdown banner (with its own pay action)
			// in place of the generic pending notice; polling continues.
			if (startHoldCountdown(order)) {
				hide('payment-pending')
				return
			}
			document.getElementById('payment-pending-spinner')?.classList.remove('hidden')
			const desc = document.getElementById('payment-pending-desc')
			if (desc) desc.textContent = labels.pendingDesc
			hide('payment-check-again')
			show('payment-pending')
		}

		function showPendingTimeout() {
			if (stopHold) {
				show('hold-check-again')
				return
			}
			document.getElementById('payment-pending-spinner')?.classList.add('hidden')
			const desc = document.getElementById('payment-pending-desc')
			if (desc) desc.textContent = labels.pendingTimeoutDesc
			show('payment-check-again')
		}

		function showFailed(canRetry: boolean) {
			confirmedView = false
			stopHoldCountdown()
			hide('payment-pending')
			hide('payment-expired')
			setHeading(labels.failedTitle, labels.failedTitle, labels.failedDesc, 'danger')
			const retryBtn = document.getElementById('retry-payment-btn')
			// Opened from the emailed link there is no payment token to retry with.
			retryBtn?.classList.toggle('hidden', !canRetry || !hasPaymentToken)
			show('payment-failed')
		}

		function showExpired(order: ReceiptOrder) {
			confirmedView = false
			stopHoldCountdown()
			hide('payment-pending')
			hide('payment-failed')
			setHeading(labels.expiredTitle, labels.expiredTitle, labels.expiredDesc, 'danger')
			const link = document.getElementById('payment-expired-link') as HTMLAnchorElement | null
			if (link && order.drop?.slug) {
				link.href = `${labels.dropBaseHref || '/drop'}/${encodeURIComponent(order.drop.slug)}`
			}
			show('payment-expired')
		}

		// Poll the App-brokered status proxy. A hosted-payment redirect alone
		// never marks the order paid; only this endpoint and the receipt do.
		async function pollPaymentStatus(order: ReceiptOrder) {
			const capability = loadOrderCapability(orgId, order.id)
			if (!capability?.paymentToken) return
			const startedAt = Date.now()
			const tick = async (): Promise<void> => {
				try {
					const response = await fetch('/api/orders/payment-status', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({
							...getOrgBinding(),
							orderId: order.id,
							paymentToken: capability.paymentToken,
							locale: labels.locale,
						}),
					})
					const value: any = await response.json().catch(() => null)
					if (!response.ok) throw new OrderRequestError('payment_unavailable', response.status)
					const outcome = interpretPaymentStatus({
						status: value?.status,
						orderStatus: value?.orderStatus,
						holdExpiresAt: value?.holdExpiresAt,
					})
					if (outcome.kind === 'paid') {
						await loadReceipt()
						showConfirmed()
						return
					}
					if (outcome.kind === 'failed') {
						showFailed(outcome.canRetry)
						return
					}
					if (outcome.kind === 'expired') {
						showExpired(order)
						return
					}
				} catch {
					// Transient proxy/network failure: keep polling until the cap.
				}
				if (shouldContinuePolling(Date.now() - startedAt)) {
					setTimeout(() => void tick(), PAYMENT_POLL_INTERVAL_MS)
				} else {
					showPendingTimeout()
				}
			}
			await tick()
		}

		type ReadResult =
			| { kind: 'order'; order: ReceiptOrder }
			| { kind: 'gone' }
			| { kind: 'error' }

		/** Reads the order with the link token or this browser's receipt token. */
		async function readOrder(): Promise<ReadResult> {
			const credential = currentCredential()
			if (!orderId || !credential) return { kind: 'error' }
			try {
				const value: any = await fetchOrderWithCredential(orderId, credential)
				const order = (value?.order ?? null) as ReceiptOrder | null
				return order ? { kind: 'order', order } : { kind: 'error' }
			} catch (error) {
				// A refused link is always a 404: expired, forged, erased or not ours.
				if (error instanceof OrderRequestError && error.status === 404) {
					return { kind: 'gone' }
				}
				return { kind: 'error' }
			}
		}

		let linkRefused = false

		async function loadReceipt(): Promise<ReceiptOrder | null> {
			const result = await readOrder()
			if (result.kind === 'gone') linkRefused = true
			if (result.kind !== 'order') return null
			renderReceipt(result.order)
			return result.order
		}

		function showLinkInvalid() {
			hide('success-loading')
			hide('order-view')
			const list = document.getElementById('link-invalid-contacts')
			const withPhone = (labels.locations as Array<{ name: string; phone?: string | null }>).filter(
				(l) => l.phone && l.phone.replace(/[^\d+]/g, ''),
			)
			if (list) {
				list.replaceChildren(
					...withPhone.map((l) => {
						const item = createEl('li')
						const link = createEl(
							'a',
							'btn-secondary w-full justify-between gap-3',
						) as HTMLAnchorElement
						link.href = `tel:${(l.phone as string).replace(/[^\d+]/g, '')}`
						if (withPhone.length > 1) link.appendChild(createEl('span', undefined, l.name))
						else link.appendChild(createEl('span', undefined, labels.callRestaurant))
						const number = createEl('span', 'bidi-isolate font-normal text-muted-foreground', l.phone as string)
						number.setAttribute('dir', 'ltr')
						link.appendChild(number)
						item.appendChild(link)
						return item
					}),
				)
			}
			show('success-link-invalid')
		}

		// ---------- live status ----------

		/** Payment state last drawn, so a poll only redraws it when it changed. */
		let paymentKey = ''

		function syncPaymentView(order: ReceiptOrder) {
			const key = `${order.status}|${order.paymentStatus}`
			if (key === paymentKey) return
			paymentKey = key
			if (order.paymentStatus === 'pending') showPending(order)
			else if (order.paymentStatus === 'failed') {
				showFailed(!order.holdExpiresAt || Date.parse(order.holdExpiresAt) > Date.now())
			} else if (order.paymentStatus === 'expired' || order.status === 'expired') {
				showExpired(order)
			} else showConfirmed()
		}

		/** Done polling: finished orders, except a cancel whose refund is still on its way. */
		function isSettled(order: ReceiptOrder) {
			return (
				isTerminalStatus(order.status) &&
				!(order.status === 'cancelled' && order.refundStatus === 'pending')
			)
		}

		let poller: StatusPoller | null = null

		function applyOrder(order: ReceiptOrder) {
			renderReceipt(order)
			syncPaymentView(order)
			applyStatusHeading()
		}

		function startLiveStatus(initial: ReceiptOrder) {
			poller?.stop()
			poller = null
			if (isSettled(initial)) return
			poller = createStatusPoller<ReceiptOrder>({
				isSettled,
				fetchOnce: async () => {
					const result = await readOrder()
					if (result.kind === 'gone') return { kind: 'gone' }
					if (result.kind === 'error') throw new Error('status_unavailable')
					return result
				},
				onOrder: applyOrder,
				onGone: () => {
					// An expired or invalid link says so; a receipt stays as last drawn.
					if (currentCredential()?.kind === 'link') showLinkInvalid()
				},
				isHidden: () => document.visibilityState === 'hidden',
				onVisibilityChange: (listener) => {
					document.addEventListener('visibilitychange', listener)
					return () => document.removeEventListener('visibilitychange', listener)
				},
			})
			poller.start({ immediate: false })
		}

		function wireCancel() {
			const trigger = document.getElementById('cancel-order-btn') as HTMLButtonElement | null
			const yes = document.getElementById('cancel-confirm-yes') as HTMLButtonElement | null
			const keep = document.getElementById('cancel-confirm-keep') as HTMLButtonElement | null
			const setNote = setCancelNote
			trigger?.addEventListener('click', () => {
				setNote('')
				show('cancel-confirm')
				trigger.classList.add('hidden')
				keep?.focus()
			})
			keep?.addEventListener('click', () => {
				hide('cancel-confirm')
				trigger?.classList.remove('hidden')
				trigger?.focus()
			})
			yes?.addEventListener('click', () => {
				const credential = currentCredential()
				if (!orderId || !credential) return
				if (yes) yes.disabled = true
				if (keep) keep.disabled = true
				setNote('')
				void (async () => {
					let done = false
					try {
						await cancelOrder(orderId, credential, cancelAttempt.current())
						// The region answered: the next confirm tap is a new attempt.
						cancelAttempt.settle()
						done = true
					} catch (error) {
						if (error instanceof OrderRequestError) {
							cancelAttempt.settle()
							if (error.status === 409) {
								cancelRefused = true
								setNote(cancelNoteFor(cancelRefusalKey(error.code)))
								hideCancel()
							} else if (error.status === 429) {
								setNote(labels.cancelLimited)
							} else {
								setNote(labels.cancelFailed)
							}
						} else {
							// No answer (network): keep the key so a retry cannot cancel twice.
							setNote(labels.cancelFailed)
						}
					}
					if (yes) yes.disabled = false
					if (keep) keep.disabled = false
					if (done) {
						// Read the order again at once: Cancelled, and the refund state.
						hideCancel()
						trigger?.classList.remove('hidden')
						const result = await readOrder()
						if (result.kind === 'order') {
							applyOrder(result.order)
							startLiveStatus(result.order)
						}
						document.getElementById('success-heading')?.focus()
					} else if (cancelRefused) {
						trigger?.classList.remove('hidden')
						document.getElementById('success-heading')?.focus()
					} else {
						yes?.focus()
					}
				})()
			})
		}

		function wireResend() {
			const button = document.getElementById('resend-receipt') as HTMLButtonElement | null
			const status = document.getElementById('resend-status')
			button?.addEventListener('click', () => {
				const credential = currentCredential()
				if (!orderId || !credential) return
				button.disabled = true
				if (status) status.textContent = ''
				void (async () => {
					let message: string = labels.resendSent
					try {
						await resendOrderLink(orderId, credential)
					} catch (error) {
						message =
							error instanceof OrderRequestError &&
							(error.status === 429 || error.code === 'rate_limit_exceeded')
								? labels.resendLimited
								: labels.resendFailed
					}
					if (status) status.textContent = message
					button.disabled = false
				})()
			})
		}

		async function init() {
			if (!orderId) {
				hide('success-loading')
				show('success-missing')
				return
			}
			// Without the emailed link, the receipt capability lives only in this
			// device's sessionStorage.
			if (!currentCredential()) {
				hide('success-loading')
				if (orderLink.status === 'invalid') showLinkInvalid()
				else show('success-device')
				return
			}
			const order = await loadReceipt()
			hide('success-loading')
			if (!order) {
				if (linkRefused && currentCredential()?.kind === 'link') showLinkInvalid()
				else show('success-error')
				return
			}
			show('order-view')
			if (!hasPaymentToken) hide('hold-pay-btn')
			// Once: checkout left a flag when an email opt-in awaits its link.
			if (takeEmailConfirmationPending(orderId)) {
				const note = document.getElementById('marketing-email-note')
				if (note) note.textContent = note.dataset.text ?? ''
			}

			// Retry after a failure and "Complete payment" during a hold share
			// one action: start a hosted payment session for this order.
			const wirePayButton = (buttonId: string, errorId: string) => {
				const button = document.getElementById(buttonId) as HTMLButtonElement | null
				button?.addEventListener('click', () => {
					void (async () => {
						const errorEl = document.getElementById(errorId)
						errorEl?.classList.add('hidden')
						button.disabled = true
						try {
							const url = await startOrderPayment(orgId, order.id, labels.locale)
							window.location.assign(url)
						} catch {
							if (errorEl) {
								errorEl.textContent = labels.paymentStartFailed
								errorEl.classList.remove('hidden')
							}
							button.disabled = false
						}
					})()
				})
			}
			wirePayButton('retry-payment-btn', 'retry-payment-error')
			wirePayButton('hold-pay-btn', 'hold-pay-error')
			const checkAgain = () => {
				showPending(order)
				void pollPaymentStatus(order)
			}
			document.getElementById('payment-check-again')?.addEventListener('click', checkAgain)
			document.getElementById('hold-check-again')?.addEventListener('click', () => {
				hide('hold-check-again')
				void pollPaymentStatus(order)
			})

			paymentKey = `${order.status}|${order.paymentStatus}`
			if (order.paymentStatus === 'pending') {
				showPending(order)
				void pollPaymentStatus(order)
			} else if (order.paymentStatus === 'failed') {
				const live =
					!order.holdExpiresAt || Date.parse(order.holdExpiresAt) > Date.now()
				showFailed(live)
			} else if (order.paymentStatus === 'expired' || order.status === 'expired') {
				showExpired(order)
			} else {
				showConfirmed()
			}
			applyStatusHeading()
			wireResend()
			wireCancel()
			startLiveStatus(order)
		}

		document.getElementById('success-retry')?.addEventListener('click', () => {
			hide('success-error')
			show('success-loading')
			void init()
		})

		void init()
	</script>
</SitePage>
