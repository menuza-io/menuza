---
import { ENV } from 'varlock/env'
import { getPageTitle } from '@repo/config/brand'
import SitePage from '~/components/SitePage.astro'
import RenderBlocks from '~/components/blocks/RenderBlocks.astro'
import { fetchPublishedSitePage, recordSiteNotFound } from '~/lib/org'
import { buildSiteThemeCss } from '@repo/common/site-theme'

const orgSlug = Astro.locals.orgSlug
const customHost = Astro.locals.customHost
const requestedLocale = Astro.locals.requestedLocale
const organization = Astro.locals.organization
const slug = Astro.params.slug?.replace(/^\/+|\/+$/g, '') ?? ''

if (!organization) {
	return new Response('Not Found', { status: 404, statusText: 'Not Found' })
}

if (!slug) {
	return Astro.rewrite('/')
}

const page = await (Astro.locals.publishedPagePromise ??
	fetchPublishedSitePage({
		slug: orgSlug,
		host: customHost,
		pageSlug: slug,
		preview: Astro.url.searchParams.get('preview') === 'true',
		previewToken: Astro.url.searchParams.get('pt'),
		lng: requestedLocale,
	}))

if (!page) {
	const logPromise = recordSiteNotFound({
		slug: orgSlug,
		host: customHost,
		path: Astro.url.pathname,
		referrer: Astro.request.headers.get('referer'),
		userAgent: Astro.request.headers.get('user-agent'),
	})
	const cfContext = (Astro.locals as any)?.cfContext
	if (typeof cfContext?.waitUntil === 'function') {
		cfContext.waitUntil(logPromise)
	} else {
		void logPromise
	}
	return new Response('Not Found', { status: 404, statusText: 'Not Found' })
}

if (Astro.url.searchParams.get('preview') === 'true') {
	let sectionsCookie = Astro.cookies.get('epic_preview_sections')?.value
	let themeCookie = Astro.cookies.get('epic_preview_theme')?.value

	if (Astro.request.method === 'POST') {
		try {
			const body = await Astro.request.json()
			if (body.sections) sectionsCookie = encodeURIComponent(JSON.stringify(body.sections))
			if (body.theme) themeCookie = encodeURIComponent(JSON.stringify(body.theme))
		} catch (err) {}
	}

	if (sectionsCookie) {
		try {
			function deepLocalize(value: any, locale: string, defaultLocale: string): any {
					if (typeof value === 'string') {
						if (value.startsWith('{')) {
							try {
								const obj = JSON.parse(value);
								if (typeof obj === 'object' && obj !== null) {
									return obj[locale] || obj[defaultLocale] || obj[Object.keys(obj)[0]] || value;
								}
							} catch (e) {}
						}
						return value;
					}
					if (Array.isArray(value)) {
						return value.map((item: any) => deepLocalize(item, locale, defaultLocale));
					}
					if (typeof value === 'object' && value !== null) {
						const keys = Object.keys(value);
						const looksLikeLocalizedMap = keys.length > 0 && keys.every(k => /^[a-z]{2}(-[A-Z]{2})?$/.test(k)) && Object.values(value).every(v => typeof v === 'string');
						if (looksLikeLocalizedMap) {
							return value[locale] || value[defaultLocale] || value[keys[0]] || '';
						}
						const result: Record<string, any> = {};
						for (const key of keys) {
							result[key] = deepLocalize(value[key], locale, defaultLocale);
						}
						return result;
					}
					return value;
				}
			const parsedSections = JSON.parse(decodeURIComponent(sectionsCookie))
			page.sections = parsedSections.map((s: any) => {
				if (typeof s.config === 'string') {
					try { 
						const parsed = JSON.parse(s.config);
						s.config = deepLocalize(parsed, requestedLocale || 'en', 'en');
					} catch (e) {}
				} else {
					s.config = deepLocalize(s.config, requestedLocale || 'en', 'en');
				}
				return s;
			})
		} catch (err) {}
	}
	if (themeCookie) {
		try {
			const parsedTheme = JSON.parse(decodeURIComponent(themeCookie))
			organization.theme = {
				...parsedTheme,
				css: buildSiteThemeCss(parsedTheme)
			}
		} catch (err) {}
	}
}


const seoTitle = page.seo?.title || page.title
const pageTitle = getPageTitle(`${seoTitle} - ${organization.name}`)
const seoDescription = page.seo?.description || undefined
const appOrigin = (ENV.PUBLIC_APP_URL || 'http://localhost:3001').replace(
	/\/$/,
	'',
)
const rawSeoImage = page.seo?.imageUrl || null
const seoImageUrl = rawSeoImage
	? rawSeoImage.startsWith('http')
		? rawSeoImage
		: `${appOrigin}${rawSeoImage}`
	: null
const seoNoIndex = page.seo?.noIndex ?? false
---

<SitePage
	organization={organization}
	page={page}
	title={pageTitle}
	description={seoDescription}
	imageUrl={seoImageUrl}
	noIndex={seoNoIndex}
>
	<RenderBlocks sections={page.sections} />
</SitePage>
