---
import { msg } from '@lingui/core/macro'
import { getLocaleHref } from '@repo/common/site-locales'
import SitePage from '~/components/SitePage.astro'
import DropAlertsSignup from '~/components/drops/DropAlertsSignup.astro'
import DropCard from '~/components/drops/DropCard.astro'
import { getDropPhase, type DropPhase } from '~/lib/drops/format'
import { siteContainer } from '~/lib/media'
import { fetchPublishedDrops, type PublicDropListing } from '~/lib/org'

const organization = Astro.locals.organization
const i18n = Astro.locals.i18n
const orgSlug = Astro.locals.orgSlug
const customHost = Astro.locals.customHost

if (!organization) {
	return new Response('Not Found', { status: 404, statusText: 'Not Found' })
}

const defaultLocale = organization.defaultLocale || Astro.locals.defaultLocale || 'en'
const locale = Astro.locals.requestedLocale || organization.locale || defaultLocale

const heading = i18n._(msg`Drops`)
const explainer = i18n._(msg`Limited menus you pre-order for a pickup window.`)
const liveHeading = i18n._(msg`Ordering now`)
const upcomingHeading = i18n._(msg`Coming up`)
const pastHeading = i18n._(msg`Past drops`)
const emptyTitle = i18n._(msg`No drops right now.`)
const emptyBody = i18n._(msg`Check the menu for what we are serving today.`)
const viewMenu = i18n._(msg`View menu`)
const emptyAlertsTitle = i18n._(msg`Be first when the next drop opens`)

const drops = await fetchPublishedDrops({ slug: orgSlug, host: customHost })
const now = new Date()
const toTime = (value: string | null, fallback: number) =>
	value ? new Date(value).getTime() : fallback

const grouped: Record<DropPhase, PublicDropListing[]> = { live: [], upcoming: [], ended: [] }
for (const drop of drops) grouped[getDropPhase(drop, now)].push(drop)
grouped.live.sort(
	(a, b) => toTime(a.ordersCloseAt, Infinity) - toTime(b.ordersCloseAt, Infinity),
)
grouped.upcoming.sort(
	(a, b) => toTime(a.ordersOpenAt, Infinity) - toTime(b.ordersOpenAt, Infinity),
)
grouped.ended.sort(
	(a, b) => toTime(b.ordersCloseAt, -Infinity) - toTime(a.ordersCloseAt, -Infinity),
)

const hasActive = grouped.live.length > 0 || grouped.upcoming.length > 0
const menuHref = getLocaleHref('/menu', locale, locale, defaultLocale)
const pageTitle = `${heading} - ${organization.name}`

const sections = [
	{ key: 'live', id: 'drops-live-heading', heading: liveHeading, drops: grouped.live },
	{ key: 'upcoming', id: 'drops-upcoming-heading', heading: upcomingHeading, drops: grouped.upcoming },
].filter((section) => section.drops.length > 0)
const formatCount = (n: number) => new Intl.NumberFormat(locale).format(n)
---

<SitePage
	organization={organization}
	page={{ id: 'drops', title: heading, slug: 'drops', isHomePage: false, sections: [] }}
	title={pageTitle}
	description={explainer}
>
	<div class:list={[siteContainer, 'pb-16 sm:pb-20']}>
		<div class:list={[hasActive && 'lg:grid lg:grid-cols-[22.5rem_minmax(0,1fr)] lg:items-start lg:gap-16']}>
			<aside class:list={[hasActive && 'lg:sticky lg:top-24']}>
				<header class="pt-6 pb-4 sm:pt-10 sm:pb-6">
					<h1 class="text-3xl font-bold leading-tight tracking-tight text-balance text-foreground sm:text-4xl">
						{heading}
					</h1>
					<p class="mt-2 max-w-2xl text-sm text-muted-foreground sm:text-base lg:max-w-xs">{explainer}</p>
				</header>

				{hasActive ? <DropAlertsSignup source="drops_page" layout="panel" /> : null}
			</aside>

			<div class:list={[hasActive && 'mt-8 lg:mt-0 lg:pt-10']}>
				{hasActive ? (
					<div class="space-y-10 sm:space-y-12">
						{sections.map((section) => (
							<section aria-labelledby={section.id}>
								<div class="mb-4 flex items-center gap-2.5">
									<h2 id={section.id} class="text-xl font-bold tracking-tight text-foreground sm:text-2xl">
										{section.heading}
									</h2>
									<span class="badge tone-neutral price">{formatCount(section.drops.length)}</span>
								</div>
								<div class:list={['grid gap-4', section.drops.length > 1 && 'xl:grid-cols-2']}>
									{section.drops.map((drop) => (
										<DropCard
											drop={drop}
											locale={locale}
											defaultLocale={defaultLocale}
											variant={section.drops.length === 1 ? 'banner' : 'full'}
											now={now}
										/>
									))}
								</div>
							</section>
						))}
					</div>
				) : (
				<div class="surface mt-4 flex flex-col items-center gap-3 px-6 py-12 text-center sm:mt-6">
					<span class="flex size-12 items-center justify-center rounded-xl bg-muted text-muted-foreground">
						<svg
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.75"
							stroke-linecap="round"
							stroke-linejoin="round"
							class="size-6"
							aria-hidden="true"
						>
							<rect x="3" y="4" width="18" height="18" rx="2" />
							<path d="M16 2v4M8 2v4M3 10h18" />
						</svg>
					</span>
					<p class="text-base font-semibold text-foreground">{emptyTitle}</p>
					<p class="max-w-sm text-sm text-muted-foreground">{emptyBody}</p>
					<a href={menuHref} class="btn-secondary mt-2">{viewMenu}</a>
					<DropAlertsSignup
						source="drops_page"
						layout="card"
						title={emptyAlertsTitle}
						class="mt-8 w-full max-w-md"
					/>
				</div>
				)}

			{grouped.ended.length > 0 ? (
				<section aria-labelledby="drops-past-heading" class="mt-10 sm:mt-12">
					<div class="mb-4 flex items-center gap-2.5">
						<h2 id="drops-past-heading" class="text-xl font-bold tracking-tight text-foreground sm:text-2xl">
							{pastHeading}
						</h2>
						<span class="badge tone-neutral price">{formatCount(grouped.ended.length)}</span>
					</div>
					<ul class="surface divide-y divide-border overflow-hidden">
						{grouped.ended.map((drop) => (
							<DropCard drop={drop} locale={locale} defaultLocale={defaultLocale} variant="compact" now={now} />
						))}
					</ul>
				</section>
			) : null}
			</div>
		</div>
	</div>
</SitePage>
