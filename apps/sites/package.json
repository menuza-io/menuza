{
  "name": "sites",
  "version": "0.0.1",
  "private": true,
  "description": "Epic Stack organization Sites built with Astro",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=\"--use-system-ca\" astro dev --port 3008",
    "start": "astro dev --port 3008",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "astro check",
    "test": "vitest run",
    "lingui:extract": "lingui extract --clean",
    "dummy": "echo"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.7",
    "@astrojs/partytown": "^2.1.7",
    "@lingui/core": "^5.8.0",
