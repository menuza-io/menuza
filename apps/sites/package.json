    "@repo/common": "*",
    "@repo/payments": "*",
    "@tailwindcss/vite": "^4.1.5",
    "@varlock/astro-integration": "^0.1.0",
    "astro": "^7.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fontless": "^0.1.0",
    "sanitize-html": "^2.17.7",
    "shadcn": "^3.6.0",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^4.1.8",
    "tw-animate-css": "^1.2.9"
  },
  "peerDependencies": {
    "varlock": "^0.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
