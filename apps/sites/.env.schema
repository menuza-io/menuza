# Epic Stack - Organization Sites (Astro)
# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# NOTE: Astro uses import.meta.env for environment variables.
# PUBLIC_ prefix makes variables available in client-side code.
#
# @defaultRequired=infer @defaultSensitive=false
# @generateTypes(lang=ts, path=env.d.ts)
# ----------

# Main app URL used by Sites SSR to fetch published org data
# Prefer localhost in local dev to avoid proxy TLS when Sites talks to the app.
# @required @type=url @sensitive=false
PUBLIC_APP_URL=https://app.epic-startup.test:2999

# US tenant-api URL. Injected into pages (`data-tenant-api-url`) for browser calls.
# Customer PII must not be proxied through this Sites process.
# @type=url @sensitive=false
TENANT_API_URL=http://localhost:3007

# KSA tenant-api URL for orgs with dataRegion=ksa.
# @type=url @sensitive=false
TENANT_API_URL_KSA=http://localhost:3009

# Platform apex whose first subdomain is an org slug (`acme.epic-startup.com`).
# Also listed in PUBLIC_SITE_HOST_SUFFIXES when you have extra Worker routes.
# Not a cookie domain on Sites — customers do not share App sessions.
# @sensitive=false
ROOT_APP=epic-startup.test

# Extra apex domains whose first subdomain is an org slug (Worker routes)
# @sensitive=false
PUBLIC_SITE_HOST_SUFFIXES=

# Shop checkout experience on tenant sites.
# `redirect` — Stripe-hosted Checkout page (default).
# `inline` — card fields on the shop page, styled with the site theme (Stripe Elements).
# @type=enum(redirect, inline) @sensitive=false
PUBLIC_SHOP_PAYMENT_MODE=redirect

# Cloudflare Turnstile site key for public form blocks. Empty disables the widget (local dev).
# @sensitive=false
PUBLIC_TURNSTILE_SITE_KEY=
