# Voice Agent Worker Environment Variables (US only)
#
# @currentEnv=$NODE_ENV
# @defaultRequired=infer @defaultSensitive=false
# @generateTypes(lang=ts, path=env.d.ts)
# ----------

# @type=enum(production, development, test) @sensitive=false
NODE_ENV=development

# Region of the customer data this worker handles. Only "us" is allowed: the
# speech and language providers it calls are US-hosted. The worker refuses to
# start otherwise.
# @required @type=enum(us, ksa) @sensitive=false
DATA_REGION=us

# Shared secret with App and the US tenant-api for /resources/phone-agent-config
# and /api/voice/*. Distinct from INTERNAL_COMMAND_TOKEN. Dev default only.
# @required @sensitive @type=string(minLength=32)
VOICE_AGENT_TOKEN=dev-voice-agent-token-do-not-use-in-prod-32b

# LiveKit server websocket URL. Local: `livekit-server --dev` listens on ws://localhost:7880.
# @required @sensitive=false
LIVEKIT_URL=ws://localhost:7880

# LiveKit API key/secret. `livekit-server --dev` uses devkey / secret.
# @required @sensitive
LIVEKIT_API_KEY=devkey

# @required @sensitive
LIVEKIT_API_SECRET=secret

# Outbound SIP trunk for warm transfers: staff is dialed into the room and the
# agent leaves once they answer, so an unanswered transfer can continue down
# the flow. Unset: transfers use a cold SIP REFER, which can't detect no-answer.
# @sensitive=false
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=

# App origin; the worker loads agent config from /resources/phone-agent-config.
# @required @sensitive=false
APP_URL=http://localhost:3001

# US tenant-api origin; calls, texted links, and requests are stored there.
# @required @sensitive=false
TENANT_API_URL=http://localhost:3007

# Deepgram speech-to-text (nova-3).
# @sensitive
DEEPGRAM_API_KEY=

# Gemini API key for the conversation model.
# @sensitive
GOOGLE_API_KEY=

# Gemini model id.
# @sensitive=false
PHONE_AGENT_LLM_MODEL=gemini-2.5-flash

# Cartesia text-to-speech (sonic-3).
# @sensitive
CARTESIA_API_KEY=

# Default Cartesia voice when the business has not chosen one.
# @sensitive=false
CARTESIA_DEFAULT_VOICE_ID=

# Call recording through LiveKit Egress to S3-compatible storage. Recording is
# skipped (with a warning) when the bucket is not set, even if a business
# turned recording on.
# @sensitive=false
RECORDING_S3_BUCKET=

# @sensitive=false
RECORDING_S3_REGION=

# Custom endpoint for S3-compatible storage (R2, OCI Object Storage, MinIO).
# @sensitive=false
RECORDING_S3_ENDPOINT=

# @sensitive
RECORDING_S3_ACCESS_KEY=

# @sensitive
RECORDING_S3_SECRET=
