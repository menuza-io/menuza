<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (minSdk is 26, so there is no legacy bitmap icon to
  keep in sync). The background colour and the foreground
  artwork are rewritten per tenant by scripts/generate-tenant.mjs.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
	<background android:drawable="@color/ic_launcher_background" />
	<foreground android:drawable="@mipmap/ic_launcher_foreground" />
	<!-- Themed icons (Android 13+) tint the foreground's silhouette. -->
	<monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
