# Epic Stack - Admin Dashboard
# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# NOTE: Admin does not use integration OAuth, GitHub login, or Stripe.
# Email: platform marketing uses `sendEmail()` — set EMAIL_PROVIDER + OCI_* or
# RESEND_API_KEY to match App. Shares SESSION_SECRET, SSO_ENCRYPTION_KEY,
# AUDIT_LOG_SECRET_KEY, and INTERNAL_COMMAND_TOKEN with the App.
#
# @currentEnv=$NODE_ENV
# @defaultRequired=infer @defaultSensitive=false
# @generateTypes(lang=ts, path=env.d.ts)
# @import(../../packages/database/.env.schema, pick=[DATABASE_URL,DATABASE_PATH])
# @import(../../packages/auth/.env.schema, pick=[SESSION_SECRET,IMPERSONATION_SESSION_SECRET,GITHUB_CLIENT_ID,GITHUB_CLIENT_SECRET,GITHUB_REDIRECT_URI,GITHUB_TOKEN,GOOGLE_CLIENT_ID,GOOGLE_CLIENT_SECRET,GOOGLE_REDIRECT_URI])
# @import(../../packages/security/.env.schema, pick=[HONEYPOT_SECRET,SSO_ENCRYPTION_KEY,TRUST_PROXY,TRUSTED_PROXY_COUNT])
# @import(../../packages/audit/.env.schema, pick=[AUDIT_LOG_SECRET_KEY,AUDIT_LOG_OLD_SECRET_KEY,AUDIT_LOG_SECRET_KEYS])
# @import(../../packages/cache/.env.schema, pick=[CACHE_DATABASE_PATH,INTERNAL_COMMAND_TOKEN])
# @import(../../packages/email/.env.schema, pick=[EMAIL_PROVIDER,RESEND_API_KEY,MOCKS,OCI_TENANCY_OCID,OCI_USER_OCID,OCI_FINGERPRINT,OCI_PRIVATE_KEY,OCI_REGION,OCI_EMAIL_COMPARTMENT_ID,OCI_EMAIL_SENDER_EMAIL,OCI_EMAIL_SENDER_NAME,OCI_EMAIL_SENDER_OCID,OCI_EMAIL_LOG_OCID])
# @import(../../packages/observability/.env.schema, pick=[BETTERSTACK_API_KEY,BETTERSTACK_URL])
# ----------

# @type=enum(production, development, test)
NODE_ENV=development

# Public origin (`https://admin.{apex}`). Cookie Domain is inferred from this.
# @required @type=url @sensitive=false @dynamic
BASE_URL="https://admin.epic-startup.test:2999"

# @type=enum(CLOSED_BETA, PUBLIC_BETA, LAUNCHED) @sensitive=false
# Must match apps/app. See docs/launch-checklist.md.
LAUNCH_STATUS=LAUNCHED

# @type=boolean @sensitive=false
ALLOW_INDEXING=true

# Tigris Object Storage (S3-compatible) Configuration
# Access key ID is an identifier (also appears in SigV4 presigned URLs); not secret.
# @required @sensitive=false
AWS_ACCESS_KEY_ID=mock-access-key

# @required @sensitive
AWS_SECRET_ACCESS_KEY=mock-secret-key

# @required @sensitive=false
AWS_REGION=auto

# @required @type=url @sensitive=false
AWS_ENDPOINT_URL_S3=https://example.r2.cloudflarestorage.com

# @required @sensitive=false
BUCKET_NAME=mock-bucket

# @sensitive=false
COMMIT_SHA=

# @sensitive=false
ROOT_APP=epic-startup.test
