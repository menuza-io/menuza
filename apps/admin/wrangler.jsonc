{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "menuza-admin",
	"main": "./workers/app.ts",
	"compatibility_date": "2026-08-20",
	"compatibility_flags": [
		"nodejs_compat",
		"nodejs_compat_populate_process_env",
	],
	"observability": {
		"enabled": true,
	},
	"workers_dev": true,
	// Binding IDs are injected at deploy time by scripts/patch-wrangler.mjs.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "menuza-db",
			"database_id": "00000000-0000-0000-0000-000000000001",
			"migrations_dir": "../../packages/database/drizzle",
		},
	],
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "00000000000000000000000000000001",
		},
	],
	// Secrets (set via `wrangler secret put`) — see docs/launch-checklist.md
	"vars": {
		"NODE_ENV": "production",
	},
	"env": {
		"staging": {
			"name": "menuza-admin-staging",
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "menuza-db-staging",
					"database_id": "00000000-0000-0000-0000-000000000003",
					"migrations_dir": "../../packages/database/drizzle",
				},
			],
			"kv_namespaces": [
				{
					"binding": "CACHE",
					"id": "00000000000000000000000000000002",
				},
			],
			"vars": {
				"NODE_ENV": "production",
			},
		},
	},
}
