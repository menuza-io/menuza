  "type": "module",
  "imports": {
    "#app/*": "./app/*",
    "#tests/*": "./tests/*"
  },
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=6144 react-router build",
    "build:cf": "cross-env NODE_OPTIONS=--max-old-space-size=6144 DEPLOY_TARGET=cloudflare react-router build",
    "deploy:cf": "npm run build:cf && node ../../scripts/patch-wrangler.mjs --app admin && wrangler deploy --config build/server/wrangler.deploy.json",
    "dev": "cross-env NODE_ENV=development MOCKS=true node --conditions development index.ts",
    "dev:cf": "cross-env DEPLOY_TARGET=cloudflare vite dev",
    "dev:no-mocks": "cross-env NODE_ENV=development node --conditions development index.ts",
    "dev:all-mocks": "cross-env NODE_ENV=development MOCKS=true node --conditions development index.ts",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:oxc": "oxlint .",
    "lint:oxc:fix": "oxlint --fix .",
    "lint:all": "oxlint . && eslint .",
    "setup": "npm run build && npm run db:migrate:deploy && npm run db:generate && playwright install",
    "db:generate": "cd ../../packages/database && npm run db:generate",
    "db:migrate:deploy": "cd ../../packages/database && npm run db:migrate:deploy",
    "db:seed": "cd ../../packages/database && npm run db:seed",
    "db:migrate:dev": "cd ../../packages/database && npm run db:migrate:dev",
    "start": "cross-env NODE_ENV=production node index.ts",
    "start:mocks": "cross-env NODE_ENV=production MOCKS=true node index.ts",
    "test": "vitest --run",
    "test:mcp": "npx @modelcontextprotocol/inspector",
    "coverage": "vitest run --coverage",
    "test:e2e": "npm run test:e2e:dev --silent",
    "test:e2e:dev": "playwright test --ui",
    "pretest:e2e:run": "npm run build",
    "test:e2e:run": "cross-env CI=true playwright test",
    "typecheck": "react-router typegen && tsc",
    "validate": "run-p \"test -- --run\" lint typecheck test:e2e:run",
    "lingui:extract": "lingui extract",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "eslintIgnore": [
    "/node_modules",
    "/build",
    "/public/build",
    "/playwright-report"
  ],
