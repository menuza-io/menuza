// Shared build settings for the tenant iOS app (identity + version defaults).
//
// Endpoints live in Debug.xcconfig / Release.xcconfig so a Release archive can
// never inherit localhost. Both files include the per-tenant file last, so a
// generated tenant config wins over everything here.
//
// NOTE: xcconfig treats `//` as a comment start, so URLs are written as plain
// hosts and `TenantConfiguration.from(infoDictionary:)` adds the scheme.

// App identity defaults. These live here (not in project.yml) so that a
// per-tenant file can override them — Xcode gives target build settings
// precedence over xcconfig values.
EPIC_APP_DISPLAY_NAME = Tenant
PRODUCT_BUNDLE_IDENTIFIER = com.epicstartup.tenant
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

// White-label binding. Empty = the customer connects their own site in the app
// (the un-branded, multi-tenant build). A generated tenant config fills these.
EPIC_SITE_SLUG =
EPIC_SITE_HOST =
EPIC_SITE_ORIGIN =
