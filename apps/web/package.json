{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "description": "Epic Stack marketing website built with Astro",
  "type": "module",
  "scripts": {
    "predev": "node scripts/patch-emdash-admin.mjs",
    "prebuild": "node scripts/patch-emdash-admin.mjs",
    "dev": "npm run predev && NODE_OPTIONS=\"--use-system-ca\" astro dev --port 3002",
    "start": "astro dev --port 3002",
    "build": "npm run prebuild && CLOUDFLARE_BUILD=true astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "astro check",
    "test": "vitest run",
    "types": "emdash types",
    "db:seed": "emdash seed --database=./.emdash/data.db --on-conflict=update",
    "db:migrate:manifest": "CLOUDFLARE_BUILD=true astro sync"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.7",
    "@astrojs/partytown": "^2.1.4",
    "@astrojs/react": "^6.0.2",
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.6.0",
    "@emdash-cms/cloudflare": "^0.37.0",
    "@paper-design/shaders": "^0.0.71",
    "@repo/common": "*",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.3",
    "@varlock/astro-integration": "^0.1.0",
    "astro": "^7.1.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "emdash": "^0.37.0",
    "fontless": "^0.1.0",
    "marked": "^18.0.11",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^8.3.0",
    "tailwindcss": "^4.1.8"
  },
  "peerDependencies": {
    "varlock": "^0.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@posthog/rollup-plugin": "^1.6.0",
    "@repo/config": "*",
    "@types/node": "^22.19.6",
    "eslint": "^9.26.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  },
  "optionalDependencies": {
    "@cloudflare/workerd-linux-64": "^1.20250214.0"
  },
  "engines": {
    "node": ">=18.20.8"
  },
  "volta": {
    "node": "22.18.0"
  }
}
