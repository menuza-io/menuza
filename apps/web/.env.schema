# Epic Stack - Marketing Website (Astro)
# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# NOTE: Astro uses import.meta.env for environment variables.
# PUBLIC_ prefix makes variables available in client-side code.
#
# @defaultRequired=infer @defaultSensitive=false
# @generateTypes(lang=ts, path=env.d.ts)
# ----------

# CMS Configuration
# Removed PUBLIC_CMS_URL as part of Emdash migration

# Apex hostname for the theme cookie Domain (`.${PUBLIC_ROOT_APP}`).
# Must be public so the ThemeSwitcher script can set it. Do not derive from
# window.location — www vs apex vs workers.dev is not eTLD+1-safe in the browser.
# @sensitive=false
PUBLIC_ROOT_APP=menuza.test

# Operator App origin for login links and shared preference cookie names/domains
# (`en_theme` / `cconsent` vs their staging variants).
# Patched at deploy from PUBLIC_APP_URL / PUBLIC_APP_URL_STAGING.
# @sensitive=false
PUBLIC_APP_URL=https://app.menuza.io

# Public PostHog project token. Keep empty to disable analytics locally.
# @sensitive=false
PUBLIC_POSTHOG_PROJECT_TOKEN=

# PostHog ingestion host for the project's data region.
# @type=url @sensitive=false
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional release identifier for correlating logs and source maps.
# @sensitive=false
PUBLIC_POSTHOG_RELEASE=

# Build-only credentials for source map uploads.
# @sensitive
POSTHOG_PERSONAL_API_KEY=

# @sensitive=false
POSTHOG_PROJECT_ID=
