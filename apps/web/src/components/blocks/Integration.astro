---
import { sanitizeSvg } from '../../lib/sanitize-markup'
import Section from '../site/Section.astro'
import SectionHead from '../site/SectionHead.astro'

interface Integration {
	name: string
	icon: string
}

interface Props {
	title?: string
	subtitle?: string
	description?: string
	integrations?: Integration[]
	blockType: 'integration'
}

const {
	title = 'Seamlessly integrate with your favorite tools',
	subtitle = 'Integrations',
	description = 'Connect with the tools you already use and love. Our platform integrates seamlessly with popular services to streamline your workflow.',
	integrations = [
		{ name: 'Gemini', icon: 'AI' },
		{ name: 'Vercel', icon: '▲' },
		{ name: 'Supabase', icon: '⚡' },
		{ name: 'OpenAI', icon: '◎' },
		{ name: 'Stripe', icon: '$' },
		{ name: 'Cloudflare', icon: '☁' },
	],
} = Astro.props
---

<Section class="py-16 sm:py-20 lg:py-24">
	<SectionHead eyebrow={subtitle} title={title} description={description} />

	<div class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
		{
			integrations.map((integration) => (
				<div
					class="flex flex-col items-center justify-center gap-3 rounded-3xl border border-hairline bg-card px-4 py-8 text-center transition-colors hover:bg-muted"
					role="img"
					aria-label={`${integration.name} integration`}
				>
					{
						integration.icon && integration.icon.startsWith('<') ? (
							<div class="text-muted-foreground" set:html={sanitizeSvg(integration.icon)} />
						) : (
							<span class="text-[20px] font-medium text-brand" aria-hidden="true">
								{integration.icon || '?'}
							</span>
						)
					}
					<span class="text-[13px] font-medium text-foreground">{integration.name}</span>
				</div>
			))
		}
	</div>
</Section>
