---
import MarkdownInline from '../site/MarkdownInline.astro'
import MarkdownText from '../site/MarkdownText.astro'
import Section from '../site/Section.astro'
import SectionHead from '../site/SectionHead.astro'

interface Feature {
	title: string
	description: string
	icon: string
}

interface Props {
	title?: string
	subtitle?: string
	description?: string
	features?: Feature[]
	blockType: 'featureGrid'
}

const {
	title = 'Why choose us',
	subtitle = 'Features',
	description,
	features = [
		{
			title: 'Built for developers',
			description:
				'Built for engineers, developers, dreamers, thinkers and doers.',
			icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 9l3 3l-3 3" /><path d="M13 15l3 0" /><path d="M3 4m0 2a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2z" /></svg>`,
		},
		{
			title: 'Ease of use',
			description:
				"Ship faster with batteries-included auth, billing, and multi-tenancy.",
			icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20c8 0 10 -16 18 -16" /></svg>`,
		},
		{
			title: 'Production ready',
			description:
				'Deploy to Cloudflare Workers, Vercel, and OCI with instant deploys built in.',
			icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16.7 8a3 3 0 0 0 -2.7 -2h-4a3 3 0 0 0 0 6h4a3 3 0 0 1 0 6h-4a3 3 0 0 1 -2.7 -2" /><path d="M12 3v3m0 12v3" /></svg>`,
		},
		{
			title: '100% Uptime guarantee',
			description: 'Cloudflare Workers with global edge deployment keeps your app online.',
			icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6.657 18c-2.572 0 -4.657 -2.007 -4.657 -4.483c0 -2.475 2.085 -4.482 4.657 -4.482c.393 -1.762 1.794 -3.2 3.675 -3.773c1.88 -.572 3.956 -.193 5.444 1c1.488 1.19 2.162 3.007 1.77 4.769h.99c1.913 0 3.464 1.56 3.464 3.486c0 1.927 -1.551 3.487 -3.465 3.487h-11.878" /></svg>`,
		},
		{
			title: 'Multi-tenant Architecture',
			description: 'Regional tenant databases with data residency built in from day one.',
			icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3h-5v5" /><path d="M16 3h5v5" /><path d="M3 3l7.536 7.536a5 5 0 0 1 1.464 3.534v6.93" /></svg>`,
		},
		{
			title: '24/7 Customer Support',
			description:
				'Comprehensive docs, E2E tests, and a community ready to help you ship.',
			icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" /><path d="M12 17l0 .01" /><path d="M12 13.5a1.5 1.5 0 0 1 1 -1.5a2.6 2.6 0 1 0 -3 -4" /></svg>`,
		},
	],
} = Astro.props
---

<Section class="py-16 sm:py-20 lg:py-24" aria-labelledby="feature-grid-title">
	<SectionHead eyebrow={subtitle} title={title} description={description} />

	<ul class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 list-none p-0 m-0" role="list">
		{
			features.map((feature) => (
				<li class="border-t-2 border-brand pt-5">
					{feature.icon && <div class="mb-3 text-brand" aria-hidden="true" set:html={feature.icon} />}
					<h3 class="text-[15px] text-foreground">
						<MarkdownInline content={feature.title} />
					</h3>
					<div class="mt-2 text-pretty text-[13px] leading-relaxed text-muted-foreground">
						<MarkdownText content={feature.description} />
					</div>
				</li>
			))
		}
	</ul>
</Section>
