---
import Section from '../site/Section.astro'
import SectionHead from '../site/SectionHead.astro'

interface TeamMember {
	name: string
	role: string
	photo?: string | { url?: string | null; alt?: string | null } | null
}

interface Props {
	title?: string
	description?: string
	members?: TeamMember[]
	blockType: 'team'
}

function getImageUrl(image: string | { url?: string | null } | null | undefined): string {
	if (typeof image === 'string') return image
	return image?.url || ''
}

function getImageAlt(
	image: string | { alt?: string | null } | null | undefined,
	fallback: string,
): string {
	if (typeof image === 'object' && image?.alt) return image.alt
	return fallback
}

const {
	title = 'Meet our team',
	description = 'The people building the platform behind your next startup.',
	members = [
		{ name: 'Alex Turner', role: 'Founder & CEO', photo: 'https://images.unsplash.com/photo-1519244703995-f4e0f30006d5?q=80&w=400&h=400&auto=format&fit=crop' },
		{ name: 'Jordan Lee', role: 'CTO', photo: 'https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?q=80&w=400&h=400&auto=format&fit=crop' },
		{ name: 'Sarah Chen', role: 'Head of Design', photo: 'https://images.unsplash.com/photo-1438761681033-6461ffad8d80?q=80&w=400&h=400&auto=format&fit=crop' },
	],
} = Astro.props
---

<Section class="py-16 sm:py-20 lg:py-24" aria-labelledby={title ? 'team-heading' : undefined}>
	<SectionHead eyebrow="Team" title={title || ''} description={description} />

	<div class="mt-12 grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-4">
		{
			members.map((member) => {
				const photoUrl = getImageUrl(member.photo)
				const photoAlt = getImageAlt(member.photo, member.name)
				return (
					<article class="rounded-3xl border border-hairline bg-card p-5">
						{photoUrl ? (
							<img
								src={photoUrl}
								alt={photoAlt}
								width="120"
								height="120"
								class="aspect-square w-full rounded-2xl object-cover"
								loading="lazy"
								decoding="async"
							/>
						) : (
							<div class="flex aspect-square w-full items-center justify-center rounded-2xl bg-muted text-muted-foreground">
								<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
									<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
									<circle cx="12" cy="7" r="4" />
								</svg>
							</div>
						)}
						<div class="mt-4 space-y-1">
							<p class="text-[15px] text-foreground">{member.name}</p>
							<p class="text-[13px] text-muted-foreground">{member.role}</p>
						</div>
					</article>
				)
			})
		}
	</div>
</Section>
