---
import Section from '../site/Section.astro'
import SectionHead from '../site/SectionHead.astro'
import { renderLexicalContent } from '../../lib/lexical-html'

interface Props {
	richText?: any
	title?: string
	subtitle?: string
	columns?: Array<{
		richText?: any
		size?: 'oneThird' | 'half' | 'twoThirds' | 'full'
		enableLink?: boolean
		link?: any
	}>
	blockType: 'content'
}

const { richText, title, subtitle, columns } = Astro.props

---

{
	richText && (
		<Section class="py-16 sm:py-20" aria-labelledby={subtitle ? 'content-section-title' : undefined}>
			{(title || subtitle) && (
				<SectionHead eyebrow={title || 'Content'} title={subtitle || ''} />
			)}
			<div class="mt-10 max-w-3xl rounded-3xl border border-hairline bg-card px-7 py-8 sm:px-10 sm:py-10">
				<div set:html={renderLexicalContent(richText)} />
			</div>
		</Section>
	)
}

{
	columns && columns.length > 0 && (
		<Section class="py-16 sm:py-20">
			<div class="grid grid-cols-1 gap-8 md:grid-cols-12">
				{columns.map((col) => {
					const colsSpanClasses = {
						full: 'md:col-span-12',
						half: 'md:col-span-6',
						oneThird: 'md:col-span-4',
						twoThirds: 'md:col-span-8',
					}
					const colClass = colsSpanClasses[col.size || 'full']
					return (
						<div class={colClass}>
							{col.richText && <div set:html={renderLexicalContent(col.richText)} />}
							{col.enableLink && col.link && (
								<a
									href={col.link.url}
									class="mt-4 inline-flex items-center text-[15px] font-medium text-brand hover:underline"
								>
									{col.link.label}
								</a>
							)}
						</div>
					)
				})}
			</div>
		</Section>
	)
}
