---
import Section from '../site/Section.astro'
import SectionHead from '../site/SectionHead.astro'
import Button from '../ui/Button.astro'

interface Feature {
	name: string
	icon: string
	iconColor?: string
}

interface Plan {
	id: string
	title: string
	description: string
	highlight?: boolean
	currency?: string
	monthlyPrice: string
	yearlyPrice: string
	buttonText: string
	buttonUrl?: string
	buttonTarget?: '_blank'
	buttonRel?: string
	badge?: string
	features: Feature[]
}

interface Props {
	title?: string
	subtitle?: string
	plans?: Plan[]
	showFooter?: boolean
	footerText?: string
	footerButtonText?: string
	blockType: 'pricing'
}

const {
	title = 'Choose your plan',
	subtitle = 'Pricing',
	plans = [
		{
			id: 'starter',
			title: 'Starter',
			description: 'For developers testing out locally.',
			currency: '$',
			monthlyPrice: '0',
			yearlyPrice: '0',
			buttonText: 'Start today for free',
			features: [
				{ name: 'Authentication', icon: 'check' },
				{ name: 'Basic Support', icon: 'check' },
				{ name: 'Core Features', icon: 'check' },
			],
		},
		{
			id: 'pro',
			title: 'Pro',
			description: 'For companies in production.',
			currency: '$',
			monthlyPrice: '20',
			yearlyPrice: '199',
			buttonText: 'Sign up',
			badge: 'Most popular',
			highlight: true,
			features: [
				{ name: 'Everything in Starter', icon: 'check' },
				{ name: 'Priority Support', icon: 'check' },
				{ name: 'Advanced Analytics', icon: 'check' },
				{ name: 'Team Collaboration', icon: 'check' },
			],
		},
		{
			id: 'enterprise',
			title: 'Enterprise',
			description: 'For organizations with advanced needs.',
			currency: '$',
			monthlyPrice: 'Custom',
			yearlyPrice: 'Custom',
			buttonText: 'Contact sales',
			features: [
				{ name: 'Everything in Pro', icon: 'check' },
				{ name: 'Custom Integration', icon: 'check' },
				{ name: 'Dedicated Support', icon: 'check' },
				{ name: 'SLA & Compliance', icon: 'check' },
			],
		},
	],
	showFooter = true,
	footerText = 'Pre-negotiated discounts are available to early-stage startups and nonprofits.',
	footerButtonText = 'Apply now',
} = Astro.props

const calculateDiscount = (monthlyPrice: string, yearlyPrice: string): number => {
	const monthly = parseFloat(monthlyPrice)
	const yearly = parseFloat(yearlyPrice)
	if (
		monthlyPrice.toLowerCase() === 'custom' ||
		yearlyPrice.toLowerCase() === 'custom' ||
		isNaN(monthly) ||
		isNaN(yearly) ||
		monthly === 0
	) {
		return 0
	}
	return Math.round(((monthly * 12 - yearly) / (monthly * 12)) * 100)
}

const yearlyDiscount = plans.length
	? Math.max(...plans.map((plan) => calculateDiscount(plan.monthlyPrice, plan.yearlyPrice)))
	: 0

const gridCols =
	plans.length === 1
		? 'grid-cols-1 max-w-md mx-auto'
		: plans.length === 2
			? 'grid-cols-1 md:grid-cols-2 max-w-4xl mx-auto'
			: 'grid-cols-1 md:grid-cols-3'
---

<Section class="py-16 sm:py-20 lg:py-24" aria-labelledby="pricing-title">
	<SectionHead eyebrow={subtitle} title={title} />

	<div class="mt-10 flex flex-col items-center gap-4">
		<div
			class="inline-flex items-center rounded-full border border-hairline bg-muted p-1"
			id="pricing-toggle"
			role="group"
			aria-label="Billing period"
		>
			<button
				class="rounded-full bg-background px-5 py-2 text-[13px] font-medium text-foreground shadow-sm"
				data-period="monthly"
				id="monthly-btn"
				aria-pressed="true"
				type="button"
			>
				Monthly
			</button>
			<button
				class="rounded-full px-5 py-2 text-[13px] font-medium text-muted-foreground"
				data-period="yearly"
				id="yearly-btn"
				aria-pressed="false"
				type="button"
			>
				Yearly
			</button>
		</div>
		{
			yearlyDiscount > 0 && (
				<p class="hidden text-[13px] text-muted-foreground" id="discount-text">
					Save up to {yearlyDiscount}% with yearly billing
				</p>
			)
		}
	</div>

	<div class={`mt-12 grid gap-5 ${gridCols}`}>
		{
			plans.map((plan) => (
				<article
					class:list={[
						'relative flex flex-col rounded-3xl border bg-card p-7 sm:p-8',
						plan.highlight ? 'border-brand shadow-sm' : 'border-hairline',
					]}
					aria-label={`${plan.title} pricing tier`}
				>
					{plan.badge && (
						<span class="absolute -top-3 left-6 rounded-full bg-brand px-3 py-1 text-[12px] font-medium text-brand-foreground">
							{plan.badge}
						</span>
					)}
					<header class="space-y-2">
						<h3 class="text-[20px] text-foreground">{plan.title}</h3>
						<p class="text-[14px] leading-relaxed text-muted-foreground">{plan.description}</p>
					</header>

					<div class="mt-6 border-t border-hairline pt-6">
						<div class="pricing-monthly">
							<div class="flex items-baseline gap-1">
								<span class="font-display text-[40px] font-medium tracking-[-0.03em] text-foreground">
									{parseFloat(plan.monthlyPrice) >= 0 && plan.currency}
									{plan.monthlyPrice}
								</span>
								{parseFloat(plan.monthlyPrice) >= 0 && (
									<span class="text-[14px] text-muted-foreground">/month</span>
								)}
							</div>
						</div>
						<div class="pricing-yearly hidden">
							<div class="flex flex-wrap items-baseline gap-2">
								<span class="font-display text-[40px] font-medium tracking-[-0.03em] text-foreground">
									{parseFloat(plan.yearlyPrice) >= 0 && plan.currency}
									{plan.yearlyPrice}
								</span>
								{parseFloat(plan.yearlyPrice) >= 0 && (
									<span class="text-[14px] text-muted-foreground">/year</span>
								)}
								{calculateDiscount(plan.monthlyPrice, plan.yearlyPrice) > 0 && (
									<span class="rounded-full bg-brand-soft px-2.5 py-1 text-[12px] font-medium text-brand">
										Save {calculateDiscount(plan.monthlyPrice, plan.yearlyPrice)}%
									</span>
								)}
							</div>
						</div>
					</div>

					<ul class="mt-6 flex-1 space-y-3" aria-label={`${plan.title} plan features`}>
						{plan.features.map((feature) => (
							<li class="flex items-start gap-3 text-[14px] text-foreground">
								<span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-brand" aria-hidden="true"></span>
								{feature.name}
							</li>
						))}
					</ul>

					<footer class="mt-8">
						<Button
							href={plan.buttonUrl ?? `#plan-${plan.id}`}
							target={plan.buttonTarget}
							rel={plan.buttonRel}
							variant={plan.highlight ? 'brand' : 'outline'}
							class="w-full"
						>
							{plan.buttonText}
						</Button>
					</footer>
				</article>
			))
		}
	</div>

	{
		showFooter && (
			<div class="mt-8 rounded-3xl border border-hairline bg-muted px-6 py-5 sm:px-8">
				<div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
					<p class="text-[15px] text-foreground">{footerText}</p>
					<Button href="#apply" variant="outline">
						{footerButtonText}
					</Button>
				</div>
			</div>
		)
	}
</Section>

<script>
	let pricingCleanup: (() => void) | null = null

	function initPricingToggle() {
		if (pricingCleanup) {
			pricingCleanup()
			pricingCleanup = null
		}

		const monthlyBtn = document.getElementById('monthly-btn')
		const yearlyBtn = document.getElementById('yearly-btn')
		const discountText = document.getElementById('discount-text')
		if (!monthlyBtn || !yearlyBtn) return

		const listeners: Array<{ el: EventTarget; type: string; fn: EventListener }> = []

		function addListener(el: EventTarget, type: string, fn: EventListener) {
			el.addEventListener(type, fn)
			listeners.push({ el, type, fn })
		}

		function setActiveButton(period: 'monthly' | 'yearly') {
			const monthly = document.getElementById('monthly-btn')
			const yearly = document.getElementById('yearly-btn')
			if (!monthly || !yearly) return

			const activeBtn = period === 'monthly' ? monthly : yearly
			const inactiveBtn = period === 'monthly' ? yearly : monthly

			activeBtn.classList.add('bg-background', 'text-foreground', 'shadow-sm')
			activeBtn.classList.remove('text-muted-foreground')
			activeBtn.setAttribute('aria-pressed', 'true')
			inactiveBtn.classList.remove('bg-background', 'text-foreground', 'shadow-sm')
			inactiveBtn.classList.add('text-muted-foreground')
			inactiveBtn.setAttribute('aria-pressed', 'false')
		}

		function togglePricing(period: 'monthly' | 'yearly') {
			const monthlyPrices = document.querySelectorAll('.pricing-monthly')
			const yearlyPrices = document.querySelectorAll('.pricing-yearly')

			if (period === 'yearly') {
				monthlyPrices.forEach((el) => el.classList.add('hidden'))
				yearlyPrices.forEach((el) => el.classList.remove('hidden'))
				discountText?.classList.remove('hidden')
			} else {
				yearlyPrices.forEach((el) => el.classList.add('hidden'))
				monthlyPrices.forEach((el) => el.classList.remove('hidden'))
				discountText?.classList.add('hidden')
			}

			setActiveButton(period)
		}

		addListener(monthlyBtn, 'click', () => togglePricing('monthly'))
		addListener(yearlyBtn, 'click', () => togglePricing('yearly'))
		togglePricing('monthly')

		pricingCleanup = () => {
			listeners.forEach(({ el, type, fn }) => el.removeEventListener(type, fn))
		}
	}

	initPricingToggle()
	document.addEventListener('astro:page-load', initPricingToggle)
</script>
