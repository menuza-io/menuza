---
import MarkdownInline from '../site/MarkdownInline.astro'
import MarkdownText from '../site/MarkdownText.astro'
import Section from '../site/Section.astro'
import Button from '../ui/Button.astro'

interface FAQItem {
	question: string
	answer: string
}

interface Props {
	title?: string
	subtitle?: string
	fAQs?: FAQItem[]
	supportText?: string
	supportLinkLabel?: string
	supportLinkUrl?: string
	blockType: 'faq'
}

const {
	title = 'Frequently asked questions',
	subtitle = "Everything you need to know before you get started.",
	fAQs: items = [
		{
			question: 'What is Menuza?',
			answer:
				'Menuza is a production-ready SaaS boilerplate with auth, billing, multi-tenancy, CMS, and deployment tooling built in.',
		},
		{
			question: 'What payment methods do you accept?',
			answer:
				'We accept major credit cards, Apple Pay, Google Pay, and PayPal. For enterprise plans, we also support invoices and wire transfers.',
		},
		{
			question: 'Can I self-host?',
			answer:
				'Yes. The monorepo includes configs for Cloudflare Workers, Vercel, and OCI so you can deploy wherever your team prefers.',
		},
		{
			question: 'Is there a free trial?',
			answer:
				'You can explore the open-source template and run the full stack locally before committing to a plan.',
		},
		{
			question: 'Do you offer support?',
			answer:
				'Comprehensive documentation, E2E tests, and community channels are included. Enterprise support is available on request.',
		},
	],
	supportText = "Can't find what you're looking for?",
	supportLinkLabel = 'Contact us',
	supportLinkUrl = '/support',
} = Astro.props
---

<Section class="py-10 sm:py-16" aria-labelledby="faq-heading">
	<div class="grid gap-5 lg:grid-cols-2">
		<div class="grain relative flex min-h-[480px] overflow-hidden rounded-3xl bg-brand-soft px-7 py-12 sm:px-12 sm:py-16 lg:min-h-[560px]">
			<div
				aria-hidden="true"
				class="absolute inset-x-[18%] top-[28%] h-64 rounded-full bg-brand/45 blur-3xl"
			></div>
			<div class="relative flex max-w-lg flex-col items-start justify-center">
				<h2 id="faq-heading" class="font-display text-balance text-[40px] font-medium tracking-[-0.04em] text-foreground sm:text-[52px]">
					<MarkdownInline content={title} />
				</h2>
				<div class="mt-6 max-w-md text-pretty text-[17px] leading-relaxed text-foreground/65">
					<MarkdownText content={subtitle} />
				</div>
				<p class="mt-4 text-[15px] text-foreground/65">
					{supportText}{' '}
					<a href={supportLinkUrl} class="font-medium text-foreground underline-offset-4 hover:underline">
						{supportLinkLabel}
					</a>
				</p>
				<Button href={supportLinkUrl} variant="solid" class="mt-10 h-14 px-8 text-[17px]">
					Get started
				</Button>
			</div>
		</div>

		<div class="overflow-hidden rounded-3xl bg-muted px-7 py-3 sm:px-10">
			{
				items.map((faq, index) => (
					<details
						class="group border-b border-foreground/10 last:border-b-0"
						open={index === 0}
					>
						<summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-8 text-left text-[19px] font-medium leading-snug marker:content-none sm:text-[22px] [&::-webkit-details-marker]:hidden">
							<span><MarkdownInline content={faq.question} /></span>
							<svg
								aria-hidden="true"
								class="size-5 shrink-0 text-muted-foreground transition-transform duration-300 group-open:rotate-180"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
							>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9 6 6 6-6" />
							</svg>
						</summary>
						<div class="max-w-xl pb-8 text-pretty text-[16px] leading-relaxed text-muted-foreground sm:text-[18px]">
							<MarkdownText content={faq.answer} />
						</div>
					</details>
				))
			}
		</div>
	</div>
</Section>
