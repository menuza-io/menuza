---
import MarkdownInline from '../site/MarkdownInline.astro'
import MarkdownText from '../site/MarkdownText.astro'
import Section from '../site/Section.astro'
import Button from '../ui/Button.astro'

interface Feature {
	title: string
	description: string
	image?: string | { url?: string | null; alt?: string | null } | null
	backgroundImage?: string | { url?: string | null; alt?: string | null } | null
	testimonial?: {
		logo?: string | { url?: string | null; alt?: string | null } | null
		logoAlt?: string
		text: string
		companyName?: string
	}
}

function getImageUrl(image: string | { url?: string | null } | null | undefined): string {
	if (typeof image === 'string') return image
	return image?.url || ''
}

interface Props {
	title?: string
	subtitle?: string
	features?: Feature[]
	blockType: 'featureList'
}

const {
	title = 'Data for every industry',
	subtitle = 'Regardless of your industry, get the most relevant type of data for you.',
	features = [
		{
			title: 'Authentication & Security',
			description: 'Complete auth system with social logins, role-based access, and session management built with industry best practices.',
			image: 'https://images.unsplash.com/photo-1555949963-aa79dcee981c?w=600&h=400&fit=crop',
			backgroundImage: 'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?w=800&h=600&fit=crop',
			testimonial: {
				logo: 'https://cdn.magicui.design/companies/Google.svg',
				logoAlt: 'Google',
				text: 'Secure authentication that just works out of the box',
				companyName: 'Google'
			}
		},
		{
			title: 'Payment Processing',
			description: 'Stripe integration with subscription management, usage-based billing, and comprehensive invoicing system.',
			image: 'https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=600&h=400&fit=crop',
			backgroundImage: 'https://images.unsplash.com/photo-1563013544-824ae1b704d3?w=800&h=600&fit=crop',
			testimonial: {
				logo: 'https://cdn.magicui.design/companies/Stripe.svg',
				logoAlt: 'Stripe',
				text: 'Seamless payment processing with enterprise-grade security',
				companyName: 'Stripe'
			}
		},
		{
			title: 'Database & API',
			description: 'Production-ready setup with TypeScript, Drizzle, and RESTful APIs with comprehensive documentation.',
			image: 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=600&h=400&fit=crop',
			backgroundImage: 'https://images.unsplash.com/photo-1518186285589-2f7649de83e0?w=800&h=600&fit=crop',
			testimonial: {
				logo: 'https://cdn.magicui.design/companies/Microsoft.svg',
				logoAlt: 'Microsoft',
				text: 'Robust database architecture that scales with your business',
				companyName: 'Microsoft'
			}
		},
		{
			title: 'Email & Notifications',
			description: 'Automated email campaigns, transactional emails, and real-time notifications with multiple provider support.',
			image: 'https://images.unsplash.com/photo-1596526131083-e8c633c948d2?w=600&h=400&fit=crop',
			backgroundImage: 'https://images.unsplash.com/photo-1611224923853-80b023f02d71?w=800&h=600&fit=crop',
			testimonial: {
				logo: 'https://cdn.magicui.design/companies/Slack.svg',
				logoAlt: 'Slack',
				text: 'Reliable email delivery and notification system',
				companyName: 'Slack'
			}
		},
		{
			title: 'Analytics & Monitoring',
			description: 'Built-in analytics dashboard, error tracking, and performance monitoring with real-time insights.',
			image: 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=600&h=400&fit=crop',
			backgroundImage: 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=800&h=600&fit=crop',
			testimonial: {
				logo: 'https://cdn.magicui.design/companies/Netflix.svg',
				logoAlt: 'Netflix',
				text: 'Comprehensive analytics that drive business decisions',
				companyName: 'Netflix'
			}
		},
		{
			title: 'Deployment & DevOps',
			description: 'One-click deployment to multiple platforms with CI/CD pipelines, automated testing, and environment management.',
			image: 'https://images.unsplash.com/photo-1667372393119-3d4c48d07fc9?w=600&h=400&fit=crop',
			backgroundImage: 'https://images.unsplash.com/photo-1518432031352-d6fc5c10da5a?w=800&h=600&fit=crop',
			testimonial: {
				logo: 'https://cdn.magicui.design/companies/Amazon.svg',
				logoAlt: 'Amazon',
				text: 'Scalable infrastructure that grows with your needs',
				companyName: 'Amazon'
			}
		}
	],
} = Astro.props

const hasMultipleFeatures = features.length > 1
---

<Section class="py-16 sm:py-20 lg:py-24" aria-labelledby="feature-list-title">
	<header class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
		<div class="max-w-2xl">
			<h2
				id="feature-list-title"
				class="font-display text-balance text-[32px] font-medium tracking-[-0.02em] sm:text-[40px]"
			>
				<MarkdownInline content={title} />
			</h2>
			{subtitle && (
				<div class="mt-4 max-w-xl text-pretty text-[16px] leading-relaxed text-muted-foreground">
					<MarkdownText content={subtitle} />
				</div>
			)}
		</div>

		{
			hasMultipleFeatures && (
				<nav class="flex shrink-0 items-center gap-2" aria-label="Feature carousel navigation">
					<Button
						id="prev-btn"
						variant="outline"
						size="icon"
						class="h-9 w-9 disabled:cursor-not-allowed disabled:opacity-30"
						aria-label="Previous feature"
					>
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="m15 18-6-6 6-6"></path>
						</svg>
					</Button>
					<div
						class="flex items-center gap-1.5 rounded-full border border-hairline px-3 py-2"
						id="pagination-dots"
						role="tablist"
						aria-label="Feature slides"
					>
						{features.map((_, index) => (
							<button
								class="pagination-dot flex h-6 w-6 items-center justify-center rounded-full transition-colors"
								data-index={index}
								role="tab"
								aria-label={`Go to feature ${index + 1}`}
								aria-selected={index === 0 ? 'true' : 'false'}
								type="button"
							>
								<span class="dot-indicator block h-1.5 w-1.5 rounded-full bg-muted-foreground transition-all duration-200" aria-hidden="true" />
							</button>
						))}
					</div>
					<Button
						id="next-btn"
						variant="outline"
						size="icon"
						class="h-9 w-9 disabled:cursor-not-allowed disabled:opacity-30"
						aria-label="Next feature"
					>
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="m9 18 6-6-6-6"></path>
						</svg>
					</Button>
				</nav>
			)
		}
	</header>

	<div
		class:list={[
			'mt-10',
			hasMultipleFeatures && 'overflow-hidden',
		]}
		role="region"
		aria-label="Feature carousel"
	>
		<div
			id="features-container"
			class:list={[
				'flex gap-5',
				hasMultipleFeatures && 'transition-transform duration-500 ease-in-out',
			]}
			style={hasMultipleFeatures ? 'transform: translateX(0px);' : undefined}
		>
			{features.map((feature, index) => {
				const hasLayeredVisual = Boolean(feature.backgroundImage)
				const imageUrl = getImageUrl(feature.image)
				const backgroundUrl = getImageUrl(feature.backgroundImage)

				return (
					<div
						class:list={[
							'feature-card',
							hasMultipleFeatures && 'w-[min(90vw,544px)] shrink-0',
							!hasMultipleFeatures && 'w-full max-w-3xl',
						]}
						data-index={index}
						role="tabpanel"
						aria-label={feature.title}
					>
						<div class="min-h-[100px] py-2">
							<h3 class="text-[22px] text-foreground">
								<MarkdownInline content={feature.title} />
							</h3>
							<div class="mt-3 max-w-[500px] text-[14px] leading-relaxed text-muted-foreground">
								<MarkdownText content={feature.description} />
							</div>
						</div>

						{(hasLayeredVisual || imageUrl) && (
							<div class="relative mt-4">
								{hasLayeredVisual ? (
									<div class="relative overflow-hidden rounded-3xl border border-hairline">
										<div class="dithered-bg relative h-80 overflow-hidden">
											<img
												src={backgroundUrl}
												alt=""
												class="dithered-bg-source"
												style="display:none;"
											/>
											{feature.testimonial && (
												<div class="absolute inset-x-0 top-0 z-10 border-b border-hairline bg-background/95 p-4 backdrop-blur-md">
													<div class="flex flex-col items-start justify-between gap-3 md:flex-row md:items-center">
														<p class="max-w-[380px] text-sm leading-relaxed text-muted-foreground">
															{feature.testimonial.text}
														</p>
														<div class="flex items-center gap-3">
															{!feature.testimonial.logo && feature.testimonial.companyName && (
																<div class="text-sm font-medium text-foreground">
																	{feature.testimonial.companyName}
																</div>
															)}
															{feature.testimonial.logo && (
																<img
																	src={getImageUrl(feature.testimonial.logo)}
																	alt={feature.testimonial.logoAlt || feature.testimonial.companyName}
																	class="h-7 w-auto object-contain"
																	width="100"
																	height="28"
																/>
															)}
														</div>
													</div>
												</div>
											)}
										</div>
										{imageUrl && (
											<div class="absolute left-1/2 top-8 w-[min(85%,380px)] -translate-x-1/2 md:top-16">
												<div class="overflow-hidden rounded-2xl border border-hairline bg-card shadow-lg">
													<img
														src={imageUrl}
														alt={feature.title}
														class="aspect-[4/3] w-full object-cover"
														loading="lazy"
														width="380"
														height="285"
													/>
												</div>
											</div>
										)}
										<div class="h-28 md:h-32" aria-hidden="true" />
									</div>
								) : (
									<div class="overflow-hidden rounded-3xl border border-hairline bg-card">
										{feature.testimonial && (
											<div class="border-b border-hairline px-5 py-4">
												<div class="flex flex-col items-start justify-between gap-3 sm:flex-row sm:items-center">
													<p class="max-w-xl text-sm leading-relaxed text-muted-foreground">
														{feature.testimonial.text}
													</p>
													{feature.testimonial.companyName && (
														<div class="shrink-0 text-sm font-medium text-foreground">
															{feature.testimonial.companyName}
														</div>
													)}
												</div>
											</div>
										)}
										<img
											src={imageUrl}
											alt={feature.title}
											class="aspect-[16/10] w-full object-cover"
											loading="lazy"
											width="800"
											height="500"
										/>
									</div>
								)}
							</div>
						)}
					</div>
				)
			})}
		</div>
	</div>
</Section>

<script>
	import {
		ShaderMount,
		imageDitheringFragmentShader,
		getShaderColorFromString,
		ShaderFitOptions,
		DitheringTypes,
	} from '@paper-design/shaders'

	document.addEventListener('DOMContentLoaded', function() {
		const container = document.getElementById('features-container') as HTMLElement | null
		const prevBtn = document.getElementById('prev-btn') as HTMLButtonElement | null
		const nextBtn = document.getElementById('next-btn') as HTMLButtonElement | null
		const paginationDots = document.querySelectorAll('.pagination-dot')
		const featureCards = document.querySelectorAll('.feature-card')

		const ditheredBgs = document.querySelectorAll('.dithered-bg') as NodeListOf<HTMLElement>
		ditheredBgs.forEach((el) => {
			const sourceImg = el.querySelector('.dithered-bg-source') as HTMLImageElement | null
			if (!sourceImg) return

			const imageUrl = sourceImg.src

			const mountShader = (img: HTMLImageElement) => {
				try {
					new ShaderMount(
						el,
						imageDitheringFragmentShader,
						{
							u_image: img,
							u_colorFront: getShaderColorFromString('#000000'),
							u_colorBack: getShaderColorFromString('#ffffff'),
							u_colorHighlight: getShaderColorFromString('#000000'),
							u_type: DitheringTypes['8x8'],
							u_pxSize: 3,
							u_colorSteps: 4,
							u_originalColors: true,
							u_inverted: false,
							u_fit: ShaderFitOptions.cover,
							u_scale: 1,
							u_rotation: 0,
							u_originX: 0.5,
							u_originY: 0.5,
							u_offsetX: 0,
							u_offsetY: 0,
							u_worldWidth: 0,
							u_worldHeight: 0,
						},
						undefined,
						0,
					)
				} catch {
					applyFallback()
				}
			}

			const applyFallback = () => {
				el.style.backgroundImage = `url(${imageUrl})`
				el.style.backgroundSize = 'cover'
				el.style.backgroundPosition = 'center'
			}

			const corsImg = new Image()
			corsImg.crossOrigin = 'anonymous'
			corsImg.onload = () => mountShader(corsImg)
			corsImg.onerror = () => applyFallback()
			corsImg.src = imageUrl
		})

		if (!container || !prevBtn || !nextBtn || featureCards.length <= 1) return

		let currentIndex = 0
		const totalFeatures = featureCards.length

		function getStepWidth() {
			const firstCard = featureCards[0] as HTMLElement
			const styles = window.getComputedStyle(container!)
			const gap = Number.parseFloat(styles.columnGap || styles.gap || '0') || 20
			return firstCard.offsetWidth + gap
		}

		function updateCarousel() {
			const translateX = -currentIndex * getStepWidth()
			container!.style.transform = `translateX(${translateX}px)`

			paginationDots.forEach((dot, index: number) => {
				const indicator = dot.querySelector('.dot-indicator') as HTMLElement | null
				const isActive = index === currentIndex
				dot.setAttribute('aria-selected', isActive.toString())
				if (indicator) {
					indicator.classList.toggle('bg-brand', isActive)
					indicator.classList.toggle('h-2', isActive)
					indicator.classList.toggle('w-2', isActive)
					indicator.classList.toggle('bg-muted-foreground', !isActive)
					indicator.classList.toggle('h-1.5', !isActive)
					indicator.classList.toggle('w-1.5', !isActive)
				}
			})

			prevBtn!.disabled = currentIndex === 0
			nextBtn!.disabled = currentIndex === totalFeatures - 1
		}

		function goToSlide(index: number) {
			currentIndex = Math.max(0, Math.min(index, totalFeatures - 1))
			updateCarousel()
		}

		prevBtn.addEventListener('click', () => {
			if (currentIndex > 0) goToSlide(currentIndex - 1)
		})

		nextBtn.addEventListener('click', () => {
			if (currentIndex < totalFeatures - 1) goToSlide(currentIndex + 1)
		})

		paginationDots.forEach((dot, index: number) => {
			dot.addEventListener('click', () => goToSlide(index))
		})

		window.addEventListener('resize', () => updateCarousel())

		updateCarousel()
	})
</script>

<style>
	.dithered-bg :global(canvas) {
		z-index: 0 !important;
	}
</style>
