---
import Section from '../site/Section.astro'
import Button from '../ui/Button.astro'

interface Props {
	companies?: Array<{ 
		name: string
		logo?: string | { url?: string | null; alt?: string | null } | null
	}>
	title?: string
	blockType: 'logos'
}

function getImageUrl(image: string | { url?: string | null } | null | undefined): string {
	if (typeof image === 'string') return image
	return image?.url || ''
}

const {
	companies = [
		{ name: 'Google' },
		{ name: 'Microsoft' },
		{ name: 'Amazon' },
		{ name: 'Netflix' },
		{ name: 'YouTube' },
		{ name: 'Instagram' },
		{ name: 'Uber' },
		{ name: 'Spotify' },
		{ name: 'Tesla' },
		{ name: 'Airbnb' },
		{ name: 'Dropbox' },
		{ name: 'Slack' },
	],
	title = 'Trusted by teams building the next generation of startups',
} = Astro.props
---

<Section seam={false} class="pt-6 pb-4">
	<div class="flex items-center justify-between gap-4 pb-2">
		<h2 class="text-[15px] font-medium text-foreground">{title}</h2>
		<Button href="/posts" variant="outline" size="sm">
			See customer stories
		</Button>
	</div>

	<div class="grid grid-cols-3 gap-y-10 border-t border-hairline py-12 sm:grid-cols-3 md:grid-cols-6">
		{
			companies.map((company) => (
				<div class="flex items-center justify-center px-2">
					{
						company.logo ? (
							<img
								width={112}
								height={40}
								src={getImageUrl(company.logo) || `https://cdn.magicui.design/companies/${company.name}.svg`}
								class="h-8 w-auto max-w-[7rem] opacity-40 transition-opacity hover:opacity-70"
								alt={`${company.name} logo`}
								loading="lazy"
								decoding="async"
							/>
						) : (
							<span class="text-center text-[16px] tracking-tight text-foreground/35 transition-colors hover:text-foreground/60">
								{company.name}
							</span>
						)
					}
				</div>
			))
		}
	</div>
</Section>
