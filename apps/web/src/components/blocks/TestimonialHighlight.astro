---
import Section from '../site/Section.astro'
import Eyebrow from '../site/Eyebrow.astro'

interface Author {
	name: string
	title: string
	company: string
	companyUrl?: string
	image: string
}

interface CMSTestimonialHighlight {
	tagline?: string
	quote: string
	authorName: string
	authorTitle: string
	authorCompany: string
	authorCompanyUrl?: string
	authorImage: string | { url?: string | null; alt?: string | null } | null
}

interface Props {
	tagline?: string
	quote?: string
	author?: Author
	testimonial?: CMSTestimonialHighlight
	blockType: 'testimonialHighlight'
}

const {
	tagline = 'Used by the best developers',
	quote = 'The starter kit is a game-changer. Easy to customize and fast to ship with.',
	author = {
		name: 'OrcDev',
		title: 'Creator of',
		company: '8bitcn',
		companyUrl: 'https://www.8bitcn.com/',
		image: 'https://i.pravatar.cc/150?img=42',
	},
	testimonial,
} = Astro.props

const finalTestimonial = testimonial
	? {
			tagline: testimonial.tagline || tagline,
			quote: testimonial.quote,
			author: {
				name: testimonial.authorName,
				title: testimonial.authorTitle,
				company: testimonial.authorCompany,
				companyUrl: testimonial.authorCompanyUrl,
				image:
					typeof testimonial.authorImage === 'string'
						? testimonial.authorImage
						: testimonial.authorImage?.url || author.image,
			},
		}
	: { tagline, quote, author }
---

<Section class="py-16 sm:py-20" aria-labelledby="testimonial-heading">
	<figure class="mx-auto max-w-3xl text-center">
		<Eyebrow class="mb-5">{finalTestimonial.tagline}</Eyebrow>
		<blockquote class="font-display text-balance text-[28px] font-medium tracking-[-0.02em] text-foreground sm:text-[36px]">
			<p>"{finalTestimonial.quote}"</p>
		</blockquote>
		<figcaption class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
			<img
				class="size-12 rounded-full object-cover"
				alt={finalTestimonial.author.name}
				src={finalTestimonial.author.image}
				width="48"
				height="48"
			/>
			<div class="text-center sm:text-left">
				<cite class="text-[15px] not-italic text-foreground">
					{finalTestimonial.author.name}
				</cite>
				<p class="text-[14px] text-muted-foreground">
					{finalTestimonial.author.title}{' '}
					{finalTestimonial.author.companyUrl ? (
						<a
							target="_blank"
							rel="noopener noreferrer"
							class="underline-offset-4 hover:underline"
							href={finalTestimonial.author.companyUrl}
						>
							{finalTestimonial.author.company}
						</a>
					) : (
						finalTestimonial.author.company
					)}
				</p>
			</div>
		</figcaption>
	</figure>
</Section>
