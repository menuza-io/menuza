---
import Section from '../site/Section.astro'
import SectionHead from '../site/SectionHead.astro'

interface Avatar {
	name: string
	avatar: string
	position: 'left' | 'right'
}

interface Stat {
	title: string
	value?: string
	description: string
	variant: 'default' | 'icon' | 'chart' | 'dashboard'
	icon?: string
	chartSvg?: string
	avatars?: Avatar[]
	colSpan?: 'auto' | 'full' | 'half' | '2' | '3'
}

interface Props {
	title?: string
	subtitle?: string
	stats?: Stat[]
	blockType: 'statsGrid'
}

const { title, subtitle, stats = [] } = Astro.props

const getColSpanClass = (colSpan?: string) => {
	switch (colSpan) {
		case 'full':
			return 'col-span-full'
		case 'half':
			return 'col-span-full sm:col-span-2'
		case '2':
			return 'col-span-full lg:col-span-2'
		case '3':
			return 'col-span-full lg:col-span-3'
		default:
			return 'col-span-full sm:col-span-2 lg:col-span-2'
	}
}
---

<Section class="py-16 sm:py-20 lg:py-24" aria-labelledby={title ? 'stats-grid-title' : undefined}>
	{(title || subtitle) && (
		<SectionHead eyebrow={subtitle || 'Stats'} title={title || ''} />
	)}

	<div class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
		{
			stats.map((stat) => (
				<article class={`rounded-3xl border border-hairline bg-card p-6 sm:p-8 ${getColSpanClass(stat.colSpan)}`}>
					{stat.variant === 'default' && stat.value && (
						<div class="font-display text-[40px] font-medium tracking-[-0.03em] text-brand">
							{stat.value}
						</div>
					)}
					{stat.variant === 'icon' && stat.icon && (
						<div class="mb-4 text-brand" set:html={stat.icon} />
					)}
					{stat.variant === 'chart' && stat.chartSvg && (
						<div class="mb-4" set:html={stat.chartSvg} />
					)}
					{stat.variant === 'dashboard' && stat.icon && (
						<div class="mb-4 text-brand" set:html={stat.icon} />
					)}
					<h3 class="text-[17px] text-foreground">{stat.title}</h3>
					<p class="mt-2 text-[14px] leading-relaxed text-muted-foreground">{stat.description}</p>
				</article>
			))
		}
	</div>
</Section>
