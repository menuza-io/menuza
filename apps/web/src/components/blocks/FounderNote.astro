---
import Section from '../site/Section.astro'
import MarkdownText from '../site/MarkdownText.astro'

interface Props {
	heading: string
	content: any
	authorName: string
	authorTitle: string
	companyName?: string
	signatureSvg?: string
	authorImage?: string | { url?: string | null; alt?: string | null } | null
	blockType: 'founderNote'
}

const {
	heading = 'We care about more than pretty pixels',
	content = 'We believe in building great products that solve real problems. Everything we do is driven by a passion for quality and craftsmanship.',
	authorName = 'John Doe',
	authorTitle = 'Founder & CEO',
	companyName,
	signatureSvg,
	authorImage,
} = Astro.props

const authorImageUrl =
	typeof authorImage === 'string' ? authorImage : authorImage?.url || null

const stringContent = typeof content === 'string' ? content : ''
---

<Section class="py-16 sm:py-20 lg:py-24">
	<div class="mx-auto max-w-3xl">
		<div class="group relative overflow-hidden rounded-[32px] border border-hairline bg-card p-8 sm:p-12 md:p-16 transition-transform duration-500 ease-out hover:-rotate-1 hover:scale-[1.01] shadow-sm hover:shadow-md">
			
			<!-- Note header -->
			<div class="mb-10">
				<p class="mb-4 text-[12px] font-medium tracking-[0.1em] text-muted-foreground uppercase">
					A note from the founder
				</p>
				<h2 class="font-display text-balance text-[32px] font-medium tracking-[-0.02em] text-foreground sm:text-[40px] md:text-[48px] leading-tight">
					{heading}
				</h2>
			</div>

			<!-- Note body -->
			<div class="max-w-2xl text-pretty">
				<MarkdownText
					content={stringContent}
					class="text-[16px] leading-relaxed text-muted-foreground sm:text-[18px] [&>p]:mb-6 last:[&>p]:mb-0 [&_a]:text-foreground [&_a]:underline [&_a]:font-medium hover:[&_a]:text-muted-foreground [&_strong]:font-semibold [&_strong]:text-foreground"
				/>
			</div>

			<!-- Note footer -->
			<div class="mt-16 flex flex-col sm:flex-row sm:items-end justify-between gap-8">
				
				<!-- Signature and name -->
				<div class="space-y-1">
					{signatureSvg ? (
						<div class="mb-6 opacity-80 dark:invert [&>svg]:max-w-[140px] [&>svg]:h-auto">
							<Fragment set:html={signatureSvg} />
						</div>
					) : (
						<div class="mb-6 font-serif text-3xl sm:text-4xl italic text-foreground/80 tracking-tight">
							{authorName}
						</div>
					)}
					<p class="text-[15px] text-foreground">{authorName}</p>
					<p class="text-[13px] text-muted-foreground">
						{authorTitle}{companyName ? `, ${companyName}` : ''}
					</p>
				</div>

				<!-- Author Image -->
				{authorImageUrl && (
					<div class="shrink-0">
						<img
							src={authorImageUrl}
							alt={authorName}
							class="size-28 sm:size-40 rounded-3xl object-cover grayscale transition-all duration-500 group-hover:grayscale-0 sm:-mb-6 sm:-mr-6"
							loading="lazy"
						/>
					</div>
				)}

			</div>
		</div>
	</div>
</Section>
