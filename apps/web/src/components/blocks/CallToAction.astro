---
import Section from '../site/Section.astro'
import Button from '../ui/Button.astro'
import { escapeHtml } from '../../lib/markdown'

interface Props {
	richText?: any
	links?: any[]
	blockType: 'cta'
}

const { richText, links } = Astro.props

const renderLexicalContent = (content: any) => {
	if (!content || !content.root || !content.root.children) {
		return ''
	}

	return content.root.children
		.map((node: any) => {
			if (node.type === 'paragraph' && node.children) {
				const text = node.children.map((child: any) => escapeHtml(String(child.text ?? ''))).join('')
				return `<p class="text-[17px] leading-relaxed text-foreground/65">${text}</p>`
			}
			if (node.type === 'heading' && node.children) {
				const text = node.children.map((child: any) => escapeHtml(String(child.text ?? ''))).join('')
				const tag = ['h1', 'h2', 'h3', 'h4', 'h5', 'h6'].includes(node.tag) && node.tag !== 'h1' ? node.tag : 'h2'
				const idAttr = tag === 'h2' ? ' id="cta-heading"' : ''
				return `<${tag}${idAttr} class="font-display text-balance text-[40px] font-medium tracking-[-0.03em] text-foreground sm:text-[52px]">${text}</${tag}>`
			}
			return ''
		})
		.join('')
}
---

<Section class="py-10 sm:py-16" aria-labelledby="cta-heading">
	<div class="grain relative overflow-hidden rounded-3xl bg-brand-soft px-7 py-16 sm:px-12 sm:py-20">
		<div
			aria-hidden="true"
			class="absolute inset-x-[20%] top-[20%] h-72 rounded-full bg-brand/40 blur-3xl"
		></div>
		<div class="relative mx-auto max-w-2xl text-center">
			{richText && <div class="space-y-4" set:html={renderLexicalContent(richText)} />}
			{
				links && links.length > 0 && (
					<div class="mt-10 flex flex-wrap items-center justify-center gap-3">
						{links.map((link, index) => (
							<Button
								href={link.url || '#'}
								variant={index === 0 ? 'solid' : 'outline'}
								class="h-14 px-8 text-[17px]"
							>
								{link.label}
							</Button>
						))}
					</div>
				)
			}
		</div>
	</div>
</Section>
