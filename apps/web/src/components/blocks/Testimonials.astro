---
import Section from '../site/Section.astro'
import SectionHead from '../site/SectionHead.astro'
import { brand } from '@repo/config/brand'

interface Testimonial {
	name: string
	role: string
	image: string
	company?: string
	quote: string
}

interface CMSTestimonial {
	quote: string
	authorName: string
	authorTitle: string
	authorCompany?: string
	authorImage: string | { url?: string | null; alt?: string | null } | null
}

interface Props {
	title?: string
	subtitle?: string
	testimonials?: CMSTestimonial[]
	blockType: 'testimonials'
}

const {
	title = 'What our customers say',
	subtitle = 'about collaborating with us',
	testimonials: rawTestimonials = [
		{
			quote:
				'I was going to build my own authentication system... then I discovered this and saved months of work.',
			name: 'Captain Deploy',
			role: 'Chief Meme Officer',
			company: 'Deploy or Die Inc.',
			image: 'https://i.pravatar.cc/150?img=68',
		},
		{
			quote:
				'The integrations are incredible. We connected all our tools in minutes instead of spending weeks building custom solutions.',
			name: 'Bugs Bunyan',
			role: 'Lead Developer',
			company: 'Log Overflow',
			image: 'https://i.pravatar.cc/150?img=11',
		},
		{
			quote: `${brand.name} saved me countless hours of boilerplate setup.`,
			name: 'Ctrl Alt Delete',
			role: 'Reformed Code Artist',
			company: 'Infinite Loop Labs',
			image: 'https://i.pravatar.cc/150?img=23',
		},
	],
} = Astro.props

const testimonials: Testimonial[] = rawTestimonials.map((testimonial) => {
	if ('authorName' in testimonial) {
		const cms = testimonial as CMSTestimonial
		const imageUrl =
			typeof cms.authorImage === 'string'
				? cms.authorImage
				: cms.authorImage?.url || 'https://i.pravatar.cc/150?img=1'
		return {
			quote: cms.quote,
			name: cms.authorName,
			role: cms.authorTitle,
			company: cms.authorCompany,
			image: imageUrl,
		}
	}
	return testimonial as Testimonial
})
---

<Section class="py-16 sm:py-20 lg:py-24" aria-labelledby="testimonials-heading">
	<SectionHead eyebrow="Testimonials" title={`${title} ${subtitle}`} />

	<ul class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3 list-none p-0 m-0" role="list">
		{
			testimonials.map((testimonial) => (
				<li class="flex h-full flex-col rounded-3xl border border-hairline bg-card p-6 sm:p-7">
					<blockquote class="flex-1 text-[16px] leading-relaxed text-foreground">
						"{testimonial.quote}"
					</blockquote>
					<footer class="mt-6 flex items-center gap-3 border-t border-hairline pt-5">
						<img
							src={testimonial.image}
							alt={testimonial.name}
							class="size-11 rounded-full object-cover"
							width="44"
							height="44"
							loading="lazy"
						/>
						<div>
							<cite class="text-[14px] not-italic text-foreground">
								{testimonial.name}
							</cite>
							<p class="text-[13px] text-muted-foreground">
								{testimonial.role}
								{testimonial.company && `, ${testimonial.company}`}
							</p>
						</div>
					</footer>
				</li>
			))
		}
	</ul>
</Section>
