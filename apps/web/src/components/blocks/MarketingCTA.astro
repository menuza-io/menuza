---
import MarkdownInline from '../site/MarkdownInline.astro'
import MarkdownText from '../site/MarkdownText.astro'
import Section from '../site/Section.astro'
import Button from '../ui/Button.astro'

interface Props {
	node: {
		title?: string
		description?: string
		primaryButtonText?: string
		primaryButtonUrl?: string
		secondaryButtonText?: string
		secondaryButtonUrl?: string
	}
}

const { node = {} as any } = Astro.props
const {
	title = 'Ready to build faster?',
	description = 'Join thousands of developers shipping with Menuza today.',
	primaryButtonText = 'Get Started',
	primaryButtonUrl = '/signup',
	secondaryButtonText,
	secondaryButtonUrl,
} = node
---

<Section class="py-10 sm:py-16" aria-labelledby="cta-heading">
	<div class="grain relative overflow-hidden rounded-3xl bg-brand-soft px-7 py-16 sm:px-12 sm:py-20">
		<div
			aria-hidden="true"
			class="absolute inset-x-[20%] top-[20%] h-72 rounded-full bg-brand/40 blur-3xl"
		></div>
		<div class="relative mx-auto max-w-2xl text-center">
			<h2 id="cta-heading" class="font-display text-balance text-[40px] font-medium tracking-[-0.03em] text-foreground sm:text-[56px]">
				<MarkdownInline content={title} />
			</h2>
			{
				description && (
					<MarkdownText content={description} class="mx-auto mt-6 max-w-lg text-pretty text-[17px] leading-relaxed text-foreground/65" />
				)
			}
			<div class="mt-10 flex flex-wrap items-center justify-center gap-3">
				<Button href={primaryButtonUrl} variant="solid" class="h-14 px-8 text-[17px]">
					{primaryButtonText}
				</Button>
				{
					secondaryButtonText && (
						<Button href={secondaryButtonUrl || '#'} variant="outline" class="h-14 px-8 text-[17px]">
							{secondaryButtonText}
						</Button>
					)
				}
			</div>
		</div>
	</div>
</Section>
