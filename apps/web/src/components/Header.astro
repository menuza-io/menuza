---
import { brand } from '@repo/config/brand'
import type { Menu, SiteSettings } from 'emdash'
import ThemeSwitcher from './ThemeSwitcher.astro'
import Button from './ui/Button.astro'
import Navigation from './Navigation.astro'
import { resolveSiteLogo } from '../lib/emdash'
import { getWebEnv } from '../lib/runtime-env'

interface Props {
	bannerEnabled?: boolean
	settings?: Partial<SiteSettings> | null
	primaryMenu?: Menu | null
}

const {
	bannerEnabled = false,
	settings = null,
	primaryMenu = null,
} = Astro.props

const siteTitle = settings?.title || brand.name
const siteLogo = resolveSiteLogo(settings)

const currentUrl = Astro.url
const port = currentUrl.port

const appOrigin = getWebEnv('PUBLIC_APP_URL').replace(/\/$/, '')
const demoUrl = `${appOrigin}${port ? `:2999` : ''}/signup`
const loginUrl = `${appOrigin}${port ? `:2999` : ''}/login`
---

<header class="fixed inset-x-0 top-0 z-50" data-banner-enabled={bannerEnabled}>
	<div
		id="site-header-bar"
		class="border-b border-transparent transition-colors duration-300"
	>
		<div
			class="mx-auto flex h-16 max-w-[1312px] items-center justify-between px-5 sm:px-8 lg:px-14"
		>
			<div class="flex items-center gap-2">
				<a href="/" aria-label={`${siteTitle} home`} class="flex items-center gap-2.5 text-foreground">
					{
						siteLogo ? (
							<>
								<img
									src={siteLogo.url}
									alt={siteLogo.alt || siteTitle}
									class="h-5 w-auto"
								/>
								<span id="header-wordmark" class="text-[19px] leading-none tracking-[-0.025em]">
										{siteTitle}
								</span>
							</>
						) : (
							<>
								<svg aria-hidden="true" viewBox="0 0 34 21" fill="none" class="h-[19px] w-[31px] shrink-0 text-brand"><path d="M28.4 20.638H33.5V2.83797C33.5 0.337973 30.4 -0.962027 28.5 0.837973L21.6 7.23797C19.2 9.63797 15.1 10.338 12 7.43797L5.5 0.937973C3.5 -0.862027 0.3 0.237973 0 2.53797V20.638H5.7V12.838C5.7 11.438 4.5 9.43797 4.5 9.43797C7.5 11.238 11 12.038 16.8 12.138C21.2 12.138 26.2 11.538 29.1 9.53797C29.1 9.53797 27.8 11.338 27.8 12.638V20.638H28.4Z" fill="currentColor"></path><path d="M9.90002 14.938C10.4 17.238 12.6 20.638 16.8 20.738C20.6 20.738 23 18.138 23.8 15.038C19 15.938 14.9 16.038 9.90002 14.938Z" fill="currentColor"></path></svg>
								<span id="header-wordmark" class="text-[19px] leading-none tracking-[-0.025em]">
									{siteTitle}
								</span>
							</>
						)
					}
				</a>
			</div>

			<div
				id="header-center-nav"
				class="absolute left-1/2 hidden -translate-x-1/2 lg:block"
			>
				<Navigation menu={primaryMenu} />
			</div>

			<div class="flex items-center gap-2">
				<ThemeSwitcher />
				<!-- <LanguageSwitcher /> -->
				<Button
					id="header-login-btn"
					href={loginUrl}
					target="_blank"
					variant="outline"
					size="sm"
					class="hidden sm:inline-flex"
				>
					Log in
				</Button>
				<Button href={demoUrl} target="_blank" variant="solid" size="sm">
					Get started
				</Button>
				<button
					id="mobile-menu-trigger"
					type="button"
					class="grid size-11 place-items-center rounded-full text-foreground outline-none transition-colors hover:bg-muted focus-visible:ring-2 focus-visible:ring-foreground/30 lg:hidden"
					aria-label="Open menu"
					aria-expanded="false"
					aria-controls="mobile-menu-panel"
				>
					<svg id="mobile-menu-icon-open" class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
					</svg>
					<svg id="mobile-menu-icon-close" class="hidden size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
					</svg>
				</button>
			</div>
		</div>

		<div
			id="mobile-menu-panel"
			class="max-h-0 overflow-y-auto border-t border-hairline bg-background/95 backdrop-blur-xl transition-[max-height] duration-300 motion-reduce:transition-none lg:hidden"
			inert
		>
			<div class="flex flex-col gap-1 px-5 py-4 sm:px-8">
				<Navigation menu={primaryMenu} isMobile={true} />
				<div class="mt-2 flex gap-2 px-3">
					<Button href={loginUrl} target="_blank" variant="outline" size="sm" class="flex-1">
						Log in
					</Button>
					<Button href={demoUrl} target="_blank" variant="solid" size="sm" class="flex-1">
						Get started
					</Button>
				</div>
			</div>
		</div>
	</div>
</header>

<script>
	let cleanup: (() => void) | null = null

	function initHeader() {
		if (cleanup) {
			cleanup()
			cleanup = null
		}

		const header = document.querySelector('header[data-banner-enabled]') as HTMLElement | null
		const bar = document.getElementById('site-header-bar')
		const centerNav = document.getElementById('header-center-nav')
		const wordmark = document.getElementById('header-wordmark')
		const loginBtn = document.getElementById('header-login-btn')
		const mobileTrigger = document.getElementById('mobile-menu-trigger')
		const mobilePanel = document.getElementById('mobile-menu-panel')
		const iconOpen = document.getElementById('mobile-menu-icon-open')
		const iconClose = document.getElementById('mobile-menu-icon-close')

		if (!header || !bar) return

		const isBannerEnabled = header.dataset.bannerEnabled === 'true'
		const listeners: Array<{ el: EventTarget; type: string; fn: EventListener }> = []

		function addListener(el: EventTarget, type: string, fn: EventListener, options?: AddEventListenerOptions) {
			el.addEventListener(type, fn, options)
			listeners.push({ el, type, fn })
		}

		function setScrolled(scrolled: boolean) {
			bar!.classList.toggle('border-hairline', scrolled)
			bar!.classList.toggle('bg-background/80', scrolled)
			bar!.classList.toggle('backdrop-blur-xl', scrolled)
			bar!.classList.toggle('border-transparent', !scrolled)
			centerNav?.classList.toggle('lg:hidden', scrolled)
			wordmark?.classList.toggle('hidden', scrolled)
			loginBtn?.classList.toggle('sm:hidden', scrolled)
		}

		function handleScroll() {
			const threshold = isBannerEnabled ? 72 : 24
			setScrolled(window.scrollY > threshold)

			if (isBannerEnabled) {
				header!.style.top = window.scrollY > 48 ? '0' : '3rem'
			}
		}

		function closeMobileMenu(restoreFocus = false) {
			mobilePanel?.classList.remove('max-h-[calc(100dvh-4rem)]')
			mobilePanel?.classList.add('max-h-0', 'border-t-0')
			if (mobilePanel) mobilePanel.inert = true
			mobileTrigger?.setAttribute('aria-expanded', 'false')
			mobileTrigger?.setAttribute('aria-label', 'Open menu')
			iconOpen?.classList.remove('hidden')
			iconClose?.classList.add('hidden')
			if (restoreFocus) mobileTrigger?.focus()
		}

		function openMobileMenu() {
			mobilePanel?.classList.remove('max-h-0', 'border-t-0')
			mobilePanel?.classList.add('max-h-[calc(100dvh-4rem)]')
			if (mobilePanel) mobilePanel.inert = false
			mobileTrigger?.setAttribute('aria-expanded', 'true')
			mobileTrigger?.setAttribute('aria-label', 'Close menu')
			iconOpen?.classList.add('hidden')
			iconClose?.classList.remove('hidden')
		}

		function toggleMobileMenu() {
			const isOpen = mobileTrigger?.getAttribute('aria-expanded') === 'true'
			if (isOpen) closeMobileMenu()
			else openMobileMenu()
		}

		addListener(window, 'scroll', handleScroll, { passive: true })
		handleScroll()

		if (isBannerEnabled) {
			header.style.top = '3rem'
		}

		if (mobileTrigger) {
			addListener(mobileTrigger, 'click', toggleMobileMenu)
		}

		addListener(document, 'keydown', (event) => {
			const keyboardEvent = event as KeyboardEvent
			if (
				keyboardEvent.key === 'Escape' &&
				mobileTrigger?.getAttribute('aria-expanded') === 'true'
			) {
				keyboardEvent.preventDefault()
				closeMobileMenu(true)
			}
		})

		mobilePanel?.querySelectorAll('a').forEach((link) => {
			addListener(link, 'click', () => closeMobileMenu())
		})

		cleanup = () => {
			listeners.forEach(({ el, type, fn }) => el.removeEventListener(type, fn))
		}
	}

	initHeader()
	document.addEventListener('astro:page-load', initHeader)
</script>
