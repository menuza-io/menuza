---
import { cn } from '../../lib/utils'

interface Props {
	variant?:
		| 'solid'
		| 'brand'
		| 'outline'
		| 'ghost'
		| 'invert'
		| 'ghostInvert'
		| 'default'
		| 'destructive'
		| 'secondary'
		| 'link'
	size?: 'xs' | 'sm' | 'md' | 'default' | 'lg' | 'xl' | 'icon' | 'icon-xs' | 'icon-sm' | 'icon-lg'
	href?: string
	class?: string
	disabled?: boolean
	type?: 'button' | 'submit' | 'reset'
	target?: '_blank' | '_self' | '_parent' | '_top'
	rel?: string
	id?: string
	name?: string
	value?: string
}

const {
	variant = 'solid',
	size = 'md',
	href,
	class: className = '',
	disabled = false,
	type = 'button',
	target,
	rel,
	id,
	...rest
} = Astro.props

const baseClasses =
	'inline-flex items-center justify-center gap-1.5 rounded-full font-medium whitespace-nowrap transition-colors duration-200 outline-none focus-visible:ring-2 focus-visible:ring-foreground/30 disabled:opacity-50 disabled:pointer-events-none'

const variantClasses: Record<string, string> = {
	solid: 'bg-foreground text-background hover:bg-foreground/85',
	brand: 'bg-brand text-brand-foreground hover:bg-brand/90',
	outline: 'border border-border bg-background text-foreground hover:bg-muted',
	ghost: 'text-foreground hover:bg-muted',
	invert: 'bg-background text-foreground hover:bg-background/85',
	ghostInvert: 'border border-background/25 text-background hover:bg-background/10',
	default: 'bg-foreground text-background hover:bg-foreground/85',
	destructive: 'bg-destructive/10 text-destructive hover:bg-destructive/20',
	secondary: 'bg-secondary text-secondary-foreground hover:bg-secondary/80',
	link: 'text-brand underline-offset-4 hover:underline',
}

const sizeClasses: Record<string, string> = {
	xs: 'h-8 px-3 text-[12px]',
	sm: 'h-9 px-4 text-[13px]',
	md: 'h-11 px-5 text-[15px]',
	default: 'h-11 px-5 text-[15px]',
	lg: 'h-11 px-5 text-[15px]',
	xl: 'h-12 px-6 text-[16px]',
	icon: 'size-10',
	'icon-xs': 'size-8',
	'icon-sm': 'size-9',
	'icon-lg': 'size-11',
}

const resolvedVariant =
	variant === 'default' ? 'solid' : variant === 'secondary' ? 'outline' : variant

const classes = cn(
	baseClasses,
	variantClasses[resolvedVariant] ?? variantClasses.solid,
	sizeClasses[size] ?? sizeClasses.md,
	className,
)

const Element = href ? 'a' : 'button'
---

<Element
	data-slot="button"
	class={classes}
	href={href}
	disabled={disabled && !href ? disabled : undefined}
	type={!href ? type : undefined}
	target={target}
	rel={rel}
	id={id}
	{...rest}
>
	<slot />
</Element>
