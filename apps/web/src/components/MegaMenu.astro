---
interface Props {
  menuLabel: string
  columns?: any[]
  isMobile?: boolean
}

const { menuLabel, columns = [], isMobile = false } = Astro.props
const uniqueId = `mega-menu-${Math.random().toString(36).slice(2, 11)}`
---

{isMobile ? (
  <div class="mobile-mega-menu">
    <button
      id={`${uniqueId}-trigger`}
      class="mobile-mega-menu-trigger w-full flex items-center justify-between text-lg py-2 text-foreground hover:text-primary transition-colors"
      aria-expanded="false"
      aria-controls={uniqueId}
      data-target={uniqueId}
    >
      <span class="text-[15px] font-medium">{menuLabel}</span>
      <svg
        class="h-4 w-4 text-muted-foreground transition-transform mobile-chevron"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M19 9l-7 7-7-7"></path>
      </svg>
    </button>
    
    <div
      id={uniqueId}
      class="mobile-mega-menu-content hidden pl-4 pt-2 pb-4 space-y-4"
      aria-labelledby={`${uniqueId}-trigger`}
    >
      {
        columns.map((column: any) => (
          <div class="space-y-2">
            <p class="text-sm text-foreground">
              {column.columnTitle}
            </p>
            {column.columnDescription && (
              <p class="text-xs text-muted-foreground mb-2">
                {column.columnDescription}
              </p>
            )}
            <ul class="space-y-1.5">
              {column.links?.map((linkItem: any) => {
                const link = linkItem.link
                const href =
                  link.type === 'custom'
                    ? link.url || '#'
                    : `/`
                const target = link.newTab ? '_blank' : undefined

                return (
                  <li>
                    <a
                      href={href}
                      target={target}
                      class="block py-2 px-3 hover:bg-accent rounded-md text-sm text-foreground hover:text-primary transition-colors"
                    >
                      {link.label}
                    </a>
                  </li>
                )
              })}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
) : (
  <div class="relative group mega-menu-container">
    <button
      id={`${uniqueId}-desktop-trigger`}
      class="mega-menu-trigger flex items-center space-x-1 text-sm font-medium hover:text-primary transition-colors"
      aria-expanded="false"
      aria-haspopup="true"
    >
      <span class="text-[15px] font-medium">{menuLabel}</span>
      <svg
        class="h-3 w-3 text-muted-foreground transition-transform group-hover:rotate-180"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M19 9l-7 7-7-7"></path>
      </svg>
    </button>

    <div
      class="mega-menu-panel absolute top-full left-0 mt-2 bg-background border rounded-lg shadow-xl opacity-0 invisible transition-all duration-200 z-50 min-w-max"
      aria-labelledby={`${uniqueId}-desktop-trigger`}
    >
      <div class="p-6">
        <div class="grid gap-8" style={`grid-template-columns: repeat(${Math.min(columns.length, 4)}, minmax(200px, 1fr))`}>
          {
            columns.map((column: any) => (
              <div class="space-y-3">
                <div>
                  <p class="text-sm text-foreground mb-1">
                    {column.columnTitle}
                  </p>
                  {column.columnDescription && (
                    <p class="text-xs text-muted-foreground mb-3">
                      {column.columnDescription}
                    </p>
                  )}
                </div>
                <ul class="space-y-2">
                  {column.links?.map((linkItem: any) => {
                    const link = linkItem.link
                    const href =
                      link.type === 'custom'
                        ? link.url || '#'
                        : `/`
                    const target = link.newTab ? '_blank' : undefined

                    return (
                      <li>
                        <a
                          href={href}
                          target={target}
                          class="block p-2 hover:bg-accent rounded-md text-sm text-foreground hover:text-primary transition-colors"
                        >
                          {link.label}
                        </a>
                      </li>
                    )
                  })}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
)}

<style>
  /* Desktop styles */
  .group:hover .mega-menu-panel,
  .mega-menu-panel:hover {
    opacity: 1;
    visibility: visible;
  }
  
  /* Mobile accordion animation */
  .mobile-mega-menu-trigger[aria-expanded="true"] .mobile-chevron {
    transform: rotate(180deg);
  }
</style>

<script>
  let cleanup: (() => void) | null = null

  function initMegaMenu() {
    if (cleanup) {
      cleanup()
      cleanup = null
    }

    const listeners: Array<{ el: EventTarget; type: string; fn: EventListener }> = []

    function addListener(el: EventTarget, type: string, fn: EventListener) {
      el.addEventListener(type, fn)
      listeners.push({ el, type, fn })
    }

    const triggers = document.querySelectorAll('.mega-menu-trigger')

    triggers.forEach((trigger) => {
      const panel = trigger.parentElement?.querySelector('.mega-menu-panel')
      if (!panel) return
      const targetPanel = panel

      function handleKeydown(e: Event) {
        const keyEvent = e as KeyboardEvent
        if (keyEvent.key === 'Enter' || keyEvent.key === ' ') {
          keyEvent.preventDefault()
          const isExpanded = trigger.getAttribute('aria-expanded') === 'true'
          trigger.setAttribute('aria-expanded', String(!isExpanded))
          targetPanel.classList.toggle('opacity-0')
          targetPanel.classList.toggle('invisible')
        }

        if (keyEvent.key === 'Escape') {
          trigger.setAttribute('aria-expanded', 'false')
          targetPanel.classList.add('opacity-0', 'invisible')
          ;(trigger as HTMLElement).focus()
        }
      }

      function handleMouseEnter() {
        trigger.setAttribute('aria-expanded', 'true')
      }

      function handleMouseLeave() {
        trigger.setAttribute('aria-expanded', 'false')
      }

      function handleFocus() {
        trigger.setAttribute('aria-expanded', 'true')
        targetPanel.classList.remove('opacity-0', 'invisible')
      }

      function handleFocusOut(e: Event) {
        const focusEvent = e as FocusEvent
        const container = trigger.parentElement
        if (container && !container.contains(focusEvent.relatedTarget as Node)) {
          trigger.setAttribute('aria-expanded', 'false')
          targetPanel.classList.add('opacity-0', 'invisible')
        }
      }

      addListener(trigger, 'keydown', handleKeydown)
      addListener(trigger, 'focus', handleFocus)
      if (trigger.parentElement) {
        addListener(trigger.parentElement, 'mouseenter', handleMouseEnter)
        addListener(trigger.parentElement, 'mouseleave', handleMouseLeave)
        addListener(trigger.parentElement, 'focusout', handleFocusOut)
      }
    })

    function handleDocumentClick(e: Event) {
      const target = e.target as HTMLElement
      if (!target.closest('.mega-menu-trigger') && !target.closest('.mega-menu-panel')) {
        triggers.forEach((trigger) => {
          trigger.setAttribute('aria-expanded', 'false')
          const panel = trigger.parentElement?.querySelector('.mega-menu-panel')
          panel?.classList.add('opacity-0', 'invisible')
        })
      }
    }

    addListener(document, 'click', handleDocumentClick)

    // Mobile accordion functionality
    const mobileTriggers = document.querySelectorAll('.mobile-mega-menu-trigger')

    mobileTriggers.forEach((trigger) => {
      function handleMobileClick(e: Event) {
        e.preventDefault()
        const targetId = trigger.getAttribute('data-target')
        const content = document.getElementById(targetId!)
        const isExpanded = trigger.getAttribute('aria-expanded') === 'true'

        mobileTriggers.forEach((otherTrigger) => {
          if (otherTrigger !== trigger) {
            otherTrigger.setAttribute('aria-expanded', 'false')
            const otherId = otherTrigger.getAttribute('data-target')
            const otherContent = document.getElementById(otherId!)
            otherContent?.classList.add('hidden')
          }
        })

        trigger.setAttribute('aria-expanded', String(!isExpanded))
        content?.classList.toggle('hidden')
      }

      addListener(trigger, 'click', handleMobileClick)
    })

    cleanup = () => {
      listeners.forEach(({ el, type, fn }) => el.removeEventListener(type, fn))
    }
  }

  initMegaMenu()
  document.addEventListener('astro:page-load', initMegaMenu)
</script>
