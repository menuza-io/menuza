---
// Theme Switcher Component for Astro
// Toggles between light and dark themes using the operator theme cookie (shared with App/Admin).
import { getThemeFromCookie, resolveThemeCookieName } from '~/utils/theme'
import { getWebEnv } from '../lib/runtime-env'

const themeCookieName = resolveThemeCookieName(getWebEnv('PUBLIC_APP_URL'))
const cookieHeader = Astro.request.headers.get('cookie')
const initialTheme = getThemeFromCookie(cookieHeader, themeCookieName)
---

<button
	class="theme-switcher grid size-9 place-items-center rounded-full text-foreground transition-colors hover:bg-muted"
	aria-label="Toggle theme"
	type="button"
>
	<svg
		class={`theme-icon-sun h-5 w-5 ${initialTheme === 'dark' ? 'hidden' : ''}`}
		fill="none"
		stroke="currentColor"
		viewBox="0 0 24 24"
		xmlns="http://www.w3.org/2000/svg"
		aria-hidden="true"
	>
		<path
			stroke-linecap="round"
			stroke-linejoin="round"
			stroke-width="2"
			d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
		></path>
	</svg>
	<svg
		class={`theme-icon-moon h-5 w-5 ${initialTheme === 'dark' ? '' : 'hidden'}`}
		fill="none"
		stroke="currentColor"
		viewBox="0 0 24 24"
		xmlns="http://www.w3.org/2000/svg"
		aria-hidden="true"
	>
		<path
			stroke-linecap="round"
			stroke-linejoin="round"
			stroke-width="2"
			d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
		></path>
	</svg>
</button>

<script define:vars={{ themeCookieName, publicRootApp: getWebEnv('PUBLIC_ROOT_APP') }}>
	function setCookie(name, value) {
		const domain = publicRootApp ? `.${publicRootApp}` : ''
		const domainAttr = domain ? `; domain=${domain}` : ''
		const maxAge = 31536000 // 1 year
		document.cookie = `${name}=${value}; path=/${domainAttr}; max-age=${maxAge}; samesite=lax`
	}

	// Store cleanup to avoid duplicate listeners
	let cleanup = null

	function getCurrentTheme() {
		return document.documentElement.classList.contains('dark') ? 'dark' : 'light'
	}

	function updateThemeIcon(theme) {
		const sunIcons = document.querySelectorAll('.theme-icon-sun')
		const moonIcons = document.querySelectorAll('.theme-icon-moon')

		if (theme === 'dark') {
			sunIcons.forEach(icon => icon.classList.add('hidden'))
			moonIcons.forEach(icon => icon.classList.remove('hidden'))
		} else {
			sunIcons.forEach(icon => icon.classList.remove('hidden'))
			moonIcons.forEach(icon => icon.classList.add('hidden'))
		}
	}

	function toggleTheme() {
		const currentTheme = getCurrentTheme()
		const newTheme = currentTheme === 'dark' ? 'light' : 'dark'

		document.documentElement.classList.remove(currentTheme)
		document.documentElement.classList.add(newTheme)
		setCookie(themeCookieName, newTheme)
		updateThemeIcon(newTheme)
	}

	function initThemeSwitcher() {
		// Clean up previous listeners
		if (cleanup) {
			cleanup()
			cleanup = null
		}

		const theme = getCurrentTheme()
		updateThemeIcon(theme)

		const buttons = document.querySelectorAll('.theme-switcher')
		buttons.forEach(button => {
			button.addEventListener('click', toggleTheme)
		})

		// Store cleanup function
		cleanup = () => {
			buttons.forEach(button => {
				button.removeEventListener('click', toggleTheme)
			})
		}
	}

	// Initialize
	initThemeSwitcher()

	// Re-initialize on Astro page transitions
	document.addEventListener('astro:page-load', initThemeSwitcher)
</script>
