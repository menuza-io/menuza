---
import type { Menu, MenuItem } from 'emdash'

import NavigationMenu from './ui/NavigationMenu.astro'

interface Props {
	menu: Menu | null
	isMobile?: boolean
}

const { menu, isMobile = false } = Astro.props
const navItems: MenuItem[] = menu?.items ?? []
---

<NavigationMenu
	items={navItems}
	currentPath={Astro.url.pathname}
	isMobile={isMobile}
/>
