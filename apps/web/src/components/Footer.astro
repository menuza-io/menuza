---
import { brand, getCopyright } from '@repo/config/brand'
import type { SiteSettings } from 'emdash'
import SectionSeam from './site/SectionSeam.astro'
import { type FooterMenuColumn, resolveSiteLogo } from '../lib/emdash'

interface Props {
	settings?: Partial<SiteSettings> | null
	footerColumns?: FooterMenuColumn[]
}

const { settings = null, footerColumns = [] } = Astro.props

const siteTitle = settings?.title || brand.name
const tagline = settings?.tagline || brand.description
const copyrightText = getCopyright()
const siteLogo = resolveSiteLogo(settings)
const displayColumns = footerColumns
---

<footer class="relative px-5 pb-12 pt-16 sm:px-8">
	<SectionSeam />
	<div class="grid grid-cols-2 gap-x-8 gap-y-12 md:grid-cols-6">
		<div class="col-span-2">
			<span class="flex items-center gap-2.5 text-foreground">
				{
					siteLogo ? (
						<>
							<img
								src={siteLogo.url}
								alt={siteLogo.alt || siteTitle}
								class="h-5 w-auto"
							/>
							<span class="text-[19px] font-semibold leading-none tracking-[-0.025em]">
									{siteTitle}
							</span>
						</>
					) : (
						<>
							<svg aria-hidden="true" viewBox="0 0 34 21" fill="none" class="h-[19px] w-[31px] shrink-0 text-brand"><path d="M28.4 20.638H33.5V2.83797C33.5 0.337973 30.4 -0.962027 28.5 0.837973L21.6 7.23797C19.2 9.63797 15.1 10.338 12 7.43797L5.5 0.937973C3.5 -0.862027 0.3 0.237973 0 2.53797V20.638H5.7V12.838C5.7 11.438 4.5 9.43797 4.5 9.43797C7.5 11.238 11 12.038 16.8 12.138C21.2 12.138 26.2 11.538 29.1 9.53797C29.1 9.53797 27.8 11.338 27.8 12.638V20.638H28.4Z" fill="currentColor"></path><path d="M9.90002 14.938C10.4 17.238 12.6 20.638 16.8 20.738C20.6 20.738 23 18.138 23.8 15.038C19 15.938 14.9 16.038 9.90002 14.938Z" fill="currentColor"></path></svg>
							<span class="text-[19px] font-semibold leading-none tracking-[-0.025em]">
								{siteTitle}
							</span>
						</>
					)
				}
			</span>
			<p class="mt-5 max-w-xs text-pretty text-[14px] leading-relaxed text-muted-foreground">
				{tagline}
			</p>
		</div>

		{
			displayColumns.map((column) => (
				<nav aria-label={column.heading} class="flex flex-col">
					<p class="text-[13px] font-medium text-foreground">{column.heading}</p>
					<ul class="mt-4 flex flex-col gap-3">
						{column.menu.items.map((item) => (
							<li>
								<a
									href={item.url}
									target={item.target}
									rel={item.target ? 'noopener noreferrer' : undefined}
									class="text-[14px] text-muted-foreground transition-colors hover:text-foreground"
								>
									{item.label}
								</a>
							</li>
						))}
					</ul>
				</nav>
			))
		}
	</div>

	<div class="mt-16 flex flex-col gap-4 border-t border-border pt-7 sm:flex-row sm:items-center sm:justify-between">
		<p class="text-[13px] text-muted-foreground">{copyrightText}</p>
		<div class="flex items-center gap-6">
			<!-- <LanguageSwitcher variant="footer" /> -->
			<a href="/tos" class="text-[13px] text-muted-foreground transition-colors hover:text-foreground">
				Terms
			</a>
			<a href="/privacy" class="text-[13px] text-muted-foreground transition-colors hover:text-foreground">
				Privacy
			</a>
		</div>
	</div>
</footer>
