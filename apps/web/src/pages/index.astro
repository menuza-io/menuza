---
import MarketingLayout from '../layouts/MarketingLayout.astro'
import { getHomePage } from '../lib/emdash'
import RenderHero from '../components/RenderHero.astro'
import RenderBlocks from '../components/RenderBlocks.astro'
import MarketingBlocks from '../components/MarketingBlocks.astro'
import SEO from '../components/SEO.astro'
import { brand } from '@repo/config/brand'
import { stripMarkdown } from '../lib/markdown'

// Fetch home page content
const currentLocale = Astro.currentLocale ?? 'en'
const homePage = await getHomePage(currentLocale)

// SEO data - always available regardless of CMS content
const seoTitle = stripMarkdown(
	homePage?.seo?.title ||
		(homePage as any)?.meta?.title ||
		homePage?.title ||
		`${brand.name} - ${brand.tagline}`,
)
const seoDescription = homePage?.seo?.description || (homePage as any)?.meta?.description || brand.description
const seoImage = homePage?.seo?.image || (homePage as any)?.meta?.image
---

<MarketingLayout>
	<Fragment slot="head">
		<SEO
			title={seoTitle}
			description={seoDescription}
			image={seoImage}
		/>
	</Fragment>

	{/* If we have CMS content for home page, use it */}
	{
		homePage ? (
			<article>
				{/* Native Emdash PortableText sections */}
				{homePage.content && Array.isArray(homePage.content) && homePage.content.length > 0 ? (
					<MarketingBlocks value={homePage.content} />
				) : (
					<>
						{/* Render CMS Hero Section */}
						{homePage.hero && (
							<div>
								<RenderHero {...(homePage.hero as any)} />
							</div>
						)}

						{/* Render CMS Layout Blocks */}
						{homePage.layout && homePage.layout.length > 0 && (
							<RenderBlocks blocks={homePage.layout} />
						)}
					</>
				)}
			</article>
		) : (
			<main class="min-h-[60vh]">
				<section class="px-5 pt-28 pb-16 sm:px-8 sm:pt-32">
					<div class="mx-auto max-w-2xl text-center">
						<h1 class="font-display text-balance text-[40px] font-medium tracking-[-0.03em] text-foreground sm:text-[52px]">
							The {brand.name}
						</h1>
						<p class="mt-6 text-pretty text-[17px] leading-relaxed text-muted-foreground">
							Check the{' '}
							<a
								class="font-medium text-foreground underline-offset-4 hover:underline"
								href="https://github.com/mohammedzamakhan/epic-startup/blob/main/docs/getting-started.md"
							>
								Getting Started guide
							</a>{' '}
							to get your project off the ground.
						</p>
					</div>
				</section>
			</main>
		)
	}

	<!-- Blog Section -->
