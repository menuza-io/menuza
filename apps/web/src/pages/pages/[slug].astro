---
import MarketingLayout from '../../layouts/MarketingLayout.astro'
import { getPage } from '../../lib/emdash'
import PageContent from '../../components/PageContent.astro'
import SEO from '../../components/SEO.astro'
import Button from '../../components/ui/Button.astro'

const { slug } = Astro.params

if (!slug) {
  return new Response(null, {
    status: 404,
    statusText: 'Not found'
  })
}

const currentLocale = Astro.currentLocale ?? 'en'
let page = await getPage(slug, currentLocale)
if (!page && currentLocale !== 'en') {
  page = await getPage(slug, 'en')
}
if (!page) {
  page = await getPage(slug)
}

if (!page) {
  Astro.response.status = 404
}
const { title, content, hero, layout, seo } = (page || {}) as any
---

{page ? (
  <MarketingLayout>
    <Fragment slot="head">
      <SEO
        title={seo?.title || title}
        description={seo?.description}
        image={seo?.image}
      />
    </Fragment>

    <PageContent title={title} content={content} hero={hero} layout={layout} meta={seo} />
  </MarketingLayout>
) : (
  <MarketingLayout>
    <Fragment slot="head">
      <SEO
        title="Page Not Found - Menuza"
        description="The page you are looking for does not exist."
      />
    </Fragment>

    <section class="flex min-h-[70vh] items-center justify-center px-5 py-24 text-center sm:px-8">
      <div class="mx-auto max-w-xl space-y-6">
        <p class="text-[13px] font-medium text-brand">404</p>
        <h1 class="font-display text-[40px] font-medium tracking-[-0.03em] text-foreground sm:text-[52px]">
          Page not found
        </h1>
        <p class="text-[17px] leading-relaxed text-muted-foreground">
          Sorry, we couldn't find the page you're looking for.
        </p>
        <div class="flex flex-wrap justify-center gap-3 pt-2">
          <Button href="/" variant="brand">Return home</Button>
          <Button href="/posts" variant="outline">Visit blog</Button>
        </div>
      </div>
    </section>
  </MarketingLayout>
)}
