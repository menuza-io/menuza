---
import MarketingLayout from '../layouts/MarketingLayout.astro'
import Button from '../components/ui/Button.astro'
import SEO from '../components/SEO.astro'
---

<MarketingLayout>
	<Fragment slot="head">
		<SEO
			title="Page Not Found - Menuza"
			description="The page you are looking for does not exist."
		/>
	</Fragment>

	<section class="flex min-h-[70vh] items-center justify-center px-5 py-24 text-center sm:px-8">
		<div class="mx-auto max-w-xl space-y-6">
			<p class="text-[13px] font-medium text-brand">404</p>
			<h1 class="font-display text-balance text-[40px] font-medium tracking-[-0.03em] text-foreground sm:text-[52px]">
				Page not found
			</h1>
			<p class="text-[17px] leading-relaxed text-muted-foreground">
				Sorry, we couldn't find the page you're looking for. It might have been moved or deleted.
			</p>
			<div class="flex flex-wrap justify-center gap-3 pt-2">
				<Button href="/" variant="brand">
					Return home
				</Button>
				<Button href="/posts" variant="outline">
					Visit blog
				</Button>
			</div>
		</div>
	</section>
</MarketingLayout>
