{
  "name": "menuza-monorepo",
  "private": true,
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "supportedArchitectures": {
    "os": [
      "darwin",
      "linux"
    ],
    "cpu": [
      "arm64",
      "x64"
    ],
    "libc": [
      "glibc"
    ]
  },
  "scripts": {
    "build": "turbo run build",
    "generate:icons": "node packages/ui/generate-icons.js",
    "dev": "node scripts/kill-dev-ports.mjs && npx turbo run build --filter=@repo/observability && NODE_TLS_REJECT_UNAUTHORIZED=0 npm-run-all --parallel dev:proxy dev:all dev:tenant-api:ksa",
    "dev:http": "node scripts/kill-dev-ports.mjs && npm-run-all --parallel dev:proxy:http dev:all",
    "dev:all": "turbo run dev --filter=app --filter=web --filter=admin --filter=studio --filter=docs --filter=sites --filter=tenant-api --filter=jobs-cron --concurrency=20",
    "dev:proxy": "node dev-proxy.js",
    "dev:proxy:http": "PROXY_PROTOCOL=http node dev-proxy.js",
    "dev:web": "turbo run dev --filter=web",
    "dev:app": "turbo run dev --filter=app",
    "dev:sites": "turbo run dev --filter=sites",
    "dev:tenant-api": "turbo run dev --filter=tenant-api",
    "dev:tenant-api:ksa": "npm run dev:ksa -w tenant-api",
    "dev:mobile": "turbo run dev --filter=mobile",
    "lint": "turbo run lint",
    "lint:oxc": "oxlint .",
    "lint:oxc:fix": "oxlint --fix .",
    "lint:all": "npm run lint:oxc && npm run lint",
    "typecheck": "turbo run typecheck",
    "validate": "npm run lint:all && npm run typecheck && npm run test && npm run test:e2e:run",
    "test": "turbo run test",
    "test:e2e:run": "turbo run test:e2e:run --concurrency=1 --log-order=stream",
    "test:e2e:install": "npx playwright install --with-deps",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lingui:check": "node scripts/check-lingui.mjs",
    "lingui:extract": "npm run lingui:extract -w app",
    "setup": "npm run db:setup && node scripts/setup-brand.mjs && node scripts/setup-ssl.mjs && node scripts/setup-hosts.mjs",
    "launch:setup": "node scripts/launch-setup.mjs",
    "launch:patch-wrangler": "node scripts/patch-wrangler.mjs",
    "launch:workers-builds": "node scripts/setup-workers-builds.mjs",
    "cf:workers:build": "node scripts/cf-workers-ci.mjs build",
    "cf:workers:deploy": "node scripts/cf-workers-ci.mjs deploy",
    "setup:ssl": "node scripts/setup-ssl.mjs",
    "setup:brand": "node scripts/setup-brand.mjs",
    "setup:hosts": "node scripts/setup-hosts.mjs",
    "db:setup": "cd packages/database && npm run setup",
    "db:generate": "cd packages/database && npm run db:generate",
    "db:push": "cd packages/database && npm run db:push",
    "db:migrate:deploy": "cd packages/database && npm run db:migrate:deploy",
    "db:seed": "turbo run db:seed --filter=@repo/database",
    "db:migrate:dev": "cd packages/database && npm run db:migrate:dev",
    "db:studio": "cd packages/database && npm run db:studio",
    "audit:integrity-backfill": "npx tsx scripts/audit-integrity-backfill.ts --dry-run",
    "docs:dev": "cd apps/docs && npx mint dev",
    "docs:build": "cd apps/docs && npx mint build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@epic-web/config": "^1.20.1",
    "@inquirer/prompts": "^7.5.3",
    "@storybook/addon-docs": "10.0.6",
    "@storybook/addon-links": "10.0.6",
    "@storybook/react-vite": "10.0.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/http-proxy": "^1.17.16",
    "ajv": "^8.17.1",
    "http-proxy": "^1.18.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "npm-run-all": "^4.1.5",
    "oxlint": "^1.23.0",
    "prettier": "^3.5.3",
    "prettier-plugin-sql": "^0.19.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "react-test-renderer": "^19.1.1",
    "storybook": "^10.5.6",
    "turbo": "2.10.8",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "^22.18.0"
  },
  "prettier": "@epic-web/config/prettier",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "eslint --fix"
    ]
  },
  "volta": {
    "node": "22.18.0",
    "npm": "10.9.0"
  },
  "dependencies": {
    "@opentelemetry/propagator-jaeger": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.217.0",
    "@varlock/nextjs-integration": "^0.1.2",
    "astro": "^7.1.6",
    "liquidjs": "^10.28.0",
    "motion": "^12.23.1",
    "react-dom": "^19.2.8",
    "react-image-crop": "^11.0.10",
    "react-router": "^8.3.0",
    "turbo-stream": "^3.2.0",
    "uuid": "^11.1.1",
    "varlock": "^1.18.0",
    "ws": "^8.21.1",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "@astrojs/compiler-binding-darwin-arm64": "^0.3.2",
    "@astrojs/compiler-binding-linux-x64-gnu": "^0.3.2",
    "@esbuild/linux-x64": "^0.25.12",
    "@libsql/darwin-arm64": "^0.5.29",
    "@libsql/linux-x64-gnu": "^0.5.29",
    "@next/swc-linux-x64-gnu": "^15.5.12",
    "@oxlint/binding-linux-x64-gnu": "^1.23.0",
    "@oxlint/binding-linux-x64-musl": "^1.23.0",
    "@rolldown/binding-darwin-arm64": "^1.2.2",
    "@rolldown/binding-linux-x64-gnu": "^1.2.2",
    "@rollup/rollup-linux-x64-gnu": "^4.32.1",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.0.0",
    "lightningcss-linux-x64-gnu": "^1.29.0"
  },
  "overrides": {
    "@next/env": "npm:@varlock/nextjs-integration@0.1.2",
    "sharp": "^0.35.3",
    "next": "^16.2.12",
    "postcss": "^8.5.25",
    "storybook": "^10.5.6",
    "protobufjs": "^8.7.1",
    "astro": "^7.1.6",
    "deepmerge-ts": "^8.0.1",
    "engine.io": "^6.6.9",
    "nanoid": "^3.3.18",
    "@opentelemetry/core": "^2.8.0",
    "ws": "^8.21.1",
    "uuid": "$uuid",
    "undici": "7.29.0",
    "@opentelemetry/propagator-jaeger": "$@opentelemetry/propagator-jaeger",
    "@opentelemetry/sdk-node": "$@opentelemetry/sdk-node",
    "turbo-stream": "$turbo-stream",
    "@tiptap/core": "^3.30.4",
    "@xmldom/xmldom": "^0.9.12",
    "decode-uri-component": "^0.5.0",
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.6",
    "qs": "^6.16.0"
  }
}
