# DoorDash (JWT access keys — not OAuth client_id/secret)
# @sensitive=false
DOORDASH_DEVELOPER_ID=
# @sensitive=false
DOORDASH_KEY_ID=
# @sensitive
DOORDASH_SIGNING_SECRET=
# @sensitive=false
DOORDASH_BASE_URL=
# Local dev only: allow manual DoorDash store ID linking without SSIO verification.
DOORDASH_ALLOW_MANUAL_STORE_LINK=
