# Third-party integrations OAuth package (App only)
# See https://varlock.dev/guides/monorepos/
#
# @currentEnv=$NODE_ENV
# @defaultRequired=infer @defaultSensitive=false
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ----------

# @type=enum(production, development, test)
NODE_ENV=development

# OAuth state signing (oauth-manager.ts)
# @required @sensitive
INTEGRATIONS_OAUTH_STATE_SECRET=

# App public origin for OAuth callbacks (integration-manager.ts)
# @type=url @sensitive=false
BASE_URL=

# @sensitive=false
JIRA_CLIENT_ID=

# @sensitive
JIRA_CLIENT_SECRET=

# @sensitive=false
SLACK_CLIENT_ID=

# @sensitive
SLACK_CLIENT_SECRET=

# @sensitive=false
LINEAR_CLIENT_ID=

# @sensitive
LINEAR_CLIENT_SECRET=

# @sensitive=false
GITLAB_CLIENT_ID=

# @sensitive
GITLAB_CLIENT_SECRET=

# @sensitive=false
CLICKUP_CLIENT_ID=

# @sensitive
CLICKUP_CLIENT_SECRET=

# @sensitive=false
NOTION_CLIENT_ID=

# @sensitive
NOTION_CLIENT_SECRET=

# @sensitive=false
ASANA_CLIENT_ID=

# @sensitive
ASANA_CLIENT_SECRET=

# @sensitive
TRELLO_API_KEY=

# @sensitive
TRELLO_API_SECRET=

# @sensitive=false
GITHUB_INTEGRATION_CLIENT_ID=

# @sensitive
GITHUB_INTEGRATION_CLIENT_SECRET=

# Google Business Profile OAuth client. Register {BASE_URL}/api/integrations/oauth/callback.
# @sensitive=false
GBP_CLIENT_ID=
# @sensitive
GBP_CLIENT_SECRET=

# Clover
# @sensitive=false
CLOVER_APP_ID=
# @sensitive
CLOVER_APP_SECRET=
# @sensitive=false
CLOVER_BASE_URL=
# @sensitive=false
CLOVER_AUTHORIZE_URL=

# Square
# @sensitive=false
SQUARE_APP_ID=
# @sensitive
SQUARE_APP_SECRET=
# @sensitive=false
SQUARE_BASE_URL=
# @sensitive=false
SQUARE_AUTHORIZE_URL=

# Toast
# @sensitive=false
TOAST_CLIENT_ID=
# @sensitive
TOAST_CLIENT_SECRET=
# @sensitive=false
TOAST_BASE_URL=
# @sensitive=false
TOAST_AUTHORIZE_URL=

# Uber Eats
# @sensitive=false
UBER_EATS_ENVIRONMENT=
# @sensitive=false
UBER_EATS_CLIENT_ID=
# @sensitive
UBER_EATS_CLIENT_SECRET=
# @sensitive=false
UBER_EATS_BASE_URL=
