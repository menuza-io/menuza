# @sensitive=false
NOTION_CLIENT_ID=

# @sensitive
NOTION_CLIENT_SECRET=

# @sensitive=false
ASANA_CLIENT_ID=

# @sensitive
ASANA_CLIENT_SECRET=

# @sensitive
TRELLO_API_KEY=

# @sensitive
TRELLO_API_SECRET=

# @sensitive=false
