{
  "name": "@repo/integrations",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./pos/sandbox": {
      "types": "./src/pos/sandbox.ts",
      "import": "./src/pos/sandbox.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage --reporter=verbose",
    "test:coverage:watch": "vitest --coverage",
    "test:coverage:force": "vitest --run --coverage --reporter=verbose --passWithNoTests",
    "coverage:report": "vitest --run --coverage --reporter=verbose",
    "coverage:summary": "npx c8 --reporter=text-summary --reports-dir=coverage npx vitest --run || true",
    "coverage": "npx c8 --all --include='src/**/*.ts' --exclude='src/index.ts' --exclude='src/types.ts' --reporter=text --reports-dir=coverage vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@remix-run/server-runtime": "^2.17.5",
    "@repo/common": "*",
    "@repo/config": "*",
    "@repo/database": "*",
    "@repo/security": "*",
    "lru-cache": "^11.1.0",
    "msw": "^2.11.4",
    "react-router": "^8.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.1",
    "msw": "^2.11.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
