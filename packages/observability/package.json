    "react-router": "^8.3.0",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "react": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.6",
    "@types/react": "^19.1.2",
    "@vitest/coverage-v8": "^4.0.1",
    "jsdom": "^27.1.0",
    "react": "^19.1.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
