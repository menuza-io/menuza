{
  "name": "@repo/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "eslint-preset.js",
    "brand.ts",
    "manifest.ts",
    "marketing-email.ts",
    "tsconfig.base-package.json",
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf node_modules dist",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.build.json --noEmit"
  },
  "exports": {
    "./eslint-preset": "./eslint-preset.js",
    "./brand": {
      "types": "./brand.ts",
      "import": "./brand.ts",
      "default": "./dist/brand.js"
    },
    "./brand.ts": "./brand.ts",
    "./manifest": {
      "types": "./manifest.ts",
      "import": "./manifest.ts",
      "default": "./dist/manifest.js"
    },
    "./manifest.ts": "./manifest.ts",
    "./marketing-email": {
      "types": "./marketing-email.ts",
      "import": "./marketing-email.ts",
      "default": "./dist/marketing-email.js"
    },
    "./marketing-email.ts": "./marketing-email.ts"
  },
  "dependencies": {
    "@epic-web/config": "^1.20.1",
    "@remix-run/server-runtime": "^2.17.5",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.1.0",
    "eslint": "^9.26.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "eslint": "^9.26.0"
  }
}
