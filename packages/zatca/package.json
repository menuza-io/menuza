{
  "name": "@repo/zatca",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ZATCA (Saudi e-invoicing) Phase 2 for the walk-in point of sale: EGS keys and CSR, UBL 2.1 simplified tax invoices and credit/debit notes, the XAdES signature, the Phase 2 QR code, and the Fatoora API client. Pure TypeScript, runs on the till and on tenant-api.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./api": {
      "types": "./src/api.ts",
      "import": "./src/api.ts",
      "default": "./src/api.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sandbox-check": "tsx scripts/sandbox-check.ts"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@noble/secp256k1": "^3.2.0"
  },
  "devDependencies": {
    "@repo/config": "*",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10",
    "@types/node": "^22.19.6"
  }
}
