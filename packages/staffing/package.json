{
  "name": "@repo/staffing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared staffing domain code: Zod schemas, permission and flag keys, PIN rules, formula-safe CSV export, time math, clock state machine, and rule packs as data. No UI strings, no I/O.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./demo-roster": {
      "types": "./src/demo-roster.ts",
      "import": "./src/demo-roster.ts",
      "default": "./src/demo-roster.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@repo/config": "*",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
