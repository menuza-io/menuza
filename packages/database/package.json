{
  "type": "module",
  "name": "@repo/database",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./db.server.ts",
      "import": "./db.server.ts",
      "default": "./db.server.ts"
    },
    "./schema": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./types": {
      "types": "./types.ts",
      "import": "./types.ts",
      "default": "./types.ts"
    }
  },
  "scripts": {
    "build": "npm run codegen && tsc",
    "codegen": "../../node_modules/.bin/varlock codegen --path .",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "../../node_modules/.bin/varlock run -- tsx seed.ts",
    "db:migrate:dev": "drizzle-kit generate",
    "db:migrate:deploy": "../../node_modules/.bin/varlock run -- tsx src/migrate.ts",
    "db:reset": "rm -f db/data.db db/data.db-wal db/data.db-shm && npm run db:migrate:deploy && npm run db:seed",
    "db:studio": "drizzle-kit studio --port 5555",
    "setup": "npm run db:migrate:deploy",
    "test": "../../node_modules/.bin/varlock run -- vitest run",
    "test:watch": "../../node_modules/.bin/varlock run -- vitest",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@epic-web/remember": "^1.1.0",
    "@libsql/client": "^0.17.4",
    "@paralleldrive/cuid2": "^2.2.2",
    "@remix-run/server-runtime": "^2.17.5",
    "drizzle-orm": "^0.45.2",
    "react-router": "^8.3.0",
    "tsx": "^4.19.4",
    "varlock": "^1.18.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "drizzle-kit": "^0.30.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
