{
  "type": "module",
  "name": "@repo/payments",
  "version": "0.0.0",
  "private": true,
  "sideEffects": false,
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts",
      "default": "./index.ts"
    },
    "./mock": {
      "types": "./src/mocks/index.ts",
      "import": "./src/mocks/index.ts",
      "default": "./src/mocks/index.ts"
    },
    "./mock/store-contract": {
      "types": "./src/mocks/store-contract.ts",
      "import": "./src/mocks/store-contract.ts",
      "default": "./src/mocks/store-contract.ts"
    },
    "./shop/client": {
      "types": "./src/shop/client.ts",
      "import": "./src/shop/client.ts",
      "default": "./src/shop/client.ts"
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@playwright/test": "1.57.0",
    "@polar-sh/sdk": "^0.42.4",
    "@react-email/preview-server": "^5.0.8",
    "@remix-run/server-runtime": "^2.17.5",
    "@repo/observability": "^0.1.0",
    "checkout-sdk-node": "^4.1.0",
    "react-router": "^8.3.0",
    "stripe": "^18.5.0"
  },
  "devDependencies": {
    "@repo/config": "*",
    "@types/node": "^22.19.6",
    "@vitest/coverage-v8": "^4.0.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
